// Cloudflare Worker for AMA OS. Serves the static site/ folder as assets (no backend code yet).
// Deploys with `npx wrangler deploy`. The apps-script/ folder is a backup and is NOT served.
// Later, the hub's backend goes here as a Worker (add a "main" entry) alongside these assets.
{
  "name": "ama-os",
  "compatibility_date": "2026-11-07",
  "assets": { "directory": "./site" }
}
