  const h = enr.head.map(function (x) { return x.toLowerCase(); });
  const cR = h.indexOf('referral'), cB = h.indexOf('referred by member'), cI = h.indexOf('contact id'), cS = h.indexOf('student name'), cD = h.indexOf('enrolled date'), cL = h.indexOf('location');
  if (cR < 0 || cB < 0) return 0;
