function actTime_(ms) { return Utilities.formatDate(new Date(ms), CONFIG.timezone, 'h:mma').toLowerCase(); }

function actReportText_(R) {
  const names = Object.keys(R.by).sort(function (a, b) { return R.by[b].n - R.by[a].n; });
  const doers = names.filter(function (n) { return R.by[n].n; }), lookers = names.filter(function (n) { return !R.by[n].n; });
  const line = function (n) {
    const p = R.by[n], a = Object.keys(p.acts).sort(function (x, y) { return p.acts[y] - p.acts[x]; }).map(function (k) { return p.acts[k] + ' ' + k.charAt(0).toLowerCase() + k.slice(1); });
    return n.split(' ')[0] + (p.f ? ' (' + actTime_(p.f) + '-' + actTime_(p.l) + ')' : '') + ': ' + a.join(', ');
  };
  return 'AMA staff today (' + R.day + '):\n' + (doers.length ? doers.map(line).join('\n') : 'No actions recorded in the hub.') +
    (lookers.length ? '\nSigned in, no actions: ' + lookers.map(function (n) { return n.split(' ')[0]; }).join(', ') : '') +
    (R.waiting.length ? '\nStill waiting: ' + R.waiting.join('; ') + '.' : '\nNothing waiting.') +
