      const due = Number(r.due || 0), paid = Number(r.paid || 0);
      const f = function (o) { o.students++; o.due += due; o.collected += paid; o.owing += Math.max(0, due - paid); if (due > 0 && paid >= due) o.full++; o.cash += Number(r.cash || 0); o.online += Number(r.online || 0); o.refunds += Number(r.refunds || 0); o.week += Number(r.paid_week || 0); };
      if (r.kind === 'sessions') { f(ses); return; }
      f(bt); const k = r.target_rank || 'Not set';
      f(byRank[k] || (byRank[k] = { k: k, label: k, students: 0, full: 0, due: 0, collected: 0, owing: 0, cash: 0, online: 0, refunds: 0, week: 0 }));
    });
    const rankOrder = function (s) { const m = String(s).match(/(\d)(?:st|nd|rd|th) Dan(?: Level (\d))?/); if (/Probationary/.test(s)) return 0; return m ? Number(m[1]) * 10 + Number(m[2] || 0) : 99; };
    out.black = { cycle: cycle, gradingDate: gdate, total: bt, sessions: ses,
      belts: Object.keys(byRank).map(function (k) { return byRank[k]; }).sort(function (a, b) { return rankOrder(a.k) - rankOrder(b.k); }) };
    const po = { orders: 0, paid: 0, qty: 0, collected: 0, week: 0 };
    (T.data.polo || []).forEach(function (o) { po.orders++; if (o.paid_at || /paid/i.test(String(o.status))) { po.paid++; po.qty += Number(o.qty || 1); po.collected += Number(o.amount || 0); if (inWeek(o.paid_at)) po.week += Number(o.amount || 0); } });
    out.polo = po;
  }

  // ---- Colour Belt Prep Session (the hub's own bookings sheet)
  try {
    const p = { kids: 0, teens: 0, bookings: 0, collected: 0, week: 0, cap: 0, date: PREP.dateShort };
    Object.keys(PREP.sessions).forEach(function (k) { p.cap += PREP.sessions[k].cap; });
    prepRows_().forEach(function (r) {
      if (!/payment/i.test(String(r.Source)) || /cancel|refund/i.test(String(r.Notes))) return;
      if (p[r.Session] != null) p[r.Session]++;
      p.bookings++; p.collected += GMONEY.prepPrice; if (inWeek(r.At)) p.week += GMONEY.prepPrice;
    });
    out.prep = p;
  } catch (e) { out.prep = { error: String(e.message || e).slice(0, 120) }; }

  // ---- Totals
  const c = out.colour ? out.colour.total : null, b = out.black ? out.black : null;
  out.totals = {
    collected: r2((c ? c.collected : 0) + (b ? b.total.collected + b.sessions.collected : 0) + (out.polo ? out.polo.collected : 0) + (out.prep && out.prep.collected ? out.prep.collected : 0)),
    toCollect: r2((c ? c.toCollect : 0) + (b ? b.total.owing + b.sessions.owing : 0)),
    week: r2((c ? c.week : 0) + (b ? b.total.week + b.sessions.week : 0) + (out.polo ? out.polo.week : 0) + (out.prep && out.prep.week ? out.prep.week : 0))
  };
  return out;
}
function gmoney_(who, b) {
  if (!mgmtCanSee_(who)) return { ok: false, error: 'Management only.' };
  if (mgmtNoMoney_(who)) return { ok: false, noMoney: true, error: 'Grading money is for the management team.' };
  const cache = CacheService.getScriptCache();
  if (!(b && b.fresh)) { try { const hit = cache.get(GMONEY.cacheKey); if (hit) return JSON.parse(hit); } catch (e) { } }
  const o = gmoneyBuild_();
  try { const s = JSON.stringify(o); if (s.length < 95000) cache.put(GMONEY.cacheKey, s, 600); } catch (e) { }
  return o;
}
function gmoneyPeek8Nov() { const o = gmoneyBuild_(); Logger.log(JSON.stringify({ toolkit: o.toolkit, totals: o.totals, prep: o.prep, colour: o.colour && o.colour.total, black: o.black && o.black.total, sessions: o.black && o.black.sessions, polo: o.polo })); }


