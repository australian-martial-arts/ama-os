/* 26 Nov 2026 (Mark): lateness heads-up text, wording approved by Mark. Sent from the staff profile by management, or automatically once a day only when switched on. */
const LATEHU = { min: 3, gap: 14, prop: 'LATEHU_ON', sentProp: 'LATEHU_SENT', hour: 10 };
