  const L = JSON.parse(CacheService.getScriptCache().get('perf_log') || '[]'), by = {};
  L.forEach(function (x) { const b = by[x[0]] || (by[x[0]] = { kind: x[0], n: 0, total: 0, max: 0 }); b.n++; b.total += x[1]; b.max = Math.max(b.max, x[1]); });
