// ============================================================ HOLD CARE TEXTS (24 Oct 2026)
// Families on an approved hold get three texts from the AMA number: on the day the hold starts, a check-in halfway
// through (holds of 4 weeks or more), and a welcome back 5 days before it ends. Replies land in GHL Conversations.
// Runs daily at 10am. While HOLDCARE.on is false nothing is sent (previewHoldCare / holdCareDaily only log).
const HOLDCARE = { on: true, hour: 10, backDays: 5, midMinDays: 28 };

function holdKids_(s) {
  const seen = {}, n = String(s || '').split(/,|&|\band\b|\//i).map(function (x) { return x.trim().split(/\s+/)[0]; })
    .filter(function (x) { if (!x || seen[x.toLowerCase()]) return false; seen[x.toLowerCase()] = 1; return true; });
  const text = !n.length ? 'your child' : n.length === 1 ? n[0] : n.slice(0, -1).join(', ') + ' and ' + n[n.length - 1];
  return { text: text, plural: n.length > 1 };
}
function holdWarmLine_(d) {
  const k = holdKids_(d.students).text;
  return d.reason === 'Injury or illness'
    ? 'We are sorry to hear that ' + k + ' can’t train for a while, and we wish them a smooth recovery. Their place in class will be kept for them.'
    : 'We look forward to welcoming ' + k + ' back on ' + d.end + '.';
}
function holdCareText_(kind, x) {
  const k = holdKids_(x.students), is = k.plural ? 'are' : 'is', hi = 'Hi ' + (x.first || 'there') + ', ';
  if (kind === 'start') return x.medical
    ? hi + "it's the team at AMA " + x.loc + ". We're thinking of " + k.text + " and hope the recovery goes smoothly. Their spot is saved and we'll check in before they're back. Please let us know if there's anything we can do."
    : hi + "it's the team at AMA " + x.loc + ". " + k.text + "'s hold starts today. Their spot is saved and we look forward to having them back on " + x.endS + ". Please let us know if there's anything we can do.";
  if (kind === 'mid') return hi + "just checking in from AMA " + x.loc + ". How " + is + " " + k.text + " going? We're looking forward to having them back on " + x.endS + ". If they need a little longer, just reply here and we'll sort it.";
  return hi + k.text + " " + is + " due back at AMA " + x.loc + " from " + x.endS + ", and the class can't wait to see them. Payments restart from that date, as agreed. If they need more time, please reply here before then.";
}
// Works out which care texts are due today. send=true actually texts (only when HOLDCARE.on) and records them.
function holdCareRun_(send) {
  const sh = holdSheet_(), last = sh.getLastRow(), out = [];
  if (last < 2) return out;
  const C = {}; HOLD.headers.forEach(function (h, i) { C[h] = i; });
  const tz = CONFIG.timezone, ymd = function (d) { return Utilities.formatDate(d, tz, 'yyyy-MM-dd'); };
  const today = hubStartOfDay_(new Date()), t = ymd(today), DAY = 86400000;
  const vals = sh.getRange(2, 1, last - 1, HOLD.headers.length).getValues();
  vals.forEach(function (v, i) {
    const st = String(v[C['Status']] || ''), holder = String(v[C['Account holder']] || '');
    if (!/^approved|^auto/i.test(st) || /declin|no freeze/i.test(st) || v[C['Resumed at']] || /^zz/i.test(holder) || !v[C['Mobile']]) return;
    const fs = holdAsDate_(v[C['Freeze starts']]), fe = holdAsDate_(v[C['Freeze ends']]);
    if (!fs || !fe) return;
    const s0 = hubStartOfDay_(fs), e0 = hubStartOfDay_(fe), days = Math.round((e0 - s0) / DAY);
    const sent = String(v[C['Care texts']] || '');
    const x = { first: holder.split(' ')[0], students: v[C['Students']], loc: v[C['Trains at']], medical: String(v[C['Reason']]) === 'medical',
      endS: Utilities.formatDate(fe, tz, 'EEE d MMM') };
    const due = [];
    if (String(v[C['Extended by']] || '')) return;
    if (!String(v[C['Extends']] || '') && !/start/.test(sent) && ymd(s0) === t) due.push('start');
    if (!/mid/.test(sent) && days >= HOLDCARE.midMinDays) {
      const mid = new Date(s0.getTime() + Math.floor(days / 2) * DAY);
      if (today >= mid && today < new Date(e0.getTime() - HOLDCARE.backDays * DAY)) due.push('mid');
    }
    if (!/back/.test(sent) && today >= new Date(e0.getTime() - HOLDCARE.backDays * DAY) && today < e0) due.push('back');
    due.forEach(function (kind) {
      const text = holdCareText_(kind, x);
      let r = 'preview';
      if (send && HOLDCARE.on) { try { sendSms_(v[C['Mobile']], text); r = 'sent'; } catch (e) { r = 'failed: ' + e; } }
      if (r === 'sent') { const cell = sh.getRange(i + 2, C['Care texts'] + 1); cell.setValue((cell.getValue() ? cell.getValue() + '; ' : '') + kind + ' ' + t); }
      out.push(v[C['Request ID']] + ' ' + kind + ' [' + r + ']: ' + text);
    });
  });
  return out;
}
