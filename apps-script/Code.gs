// Removes every 'ZZ Test' row from the Holds and Cancellations tabs, and their signed PDFs.
function qaCleanup() {
  let n = 0;
  [[holdSheet_(), holdCol_('Account holder')], [cxSheet_(), cxCols_()['Account holder'] + 1]].forEach(function (p) {
    const sh = p[0], last = sh.getLastRow(); if (last < 2) return;
    const v = sh.getRange(2, 1, last - 1, sh.getLastColumn()).getValues();
    for (let i = v.length - 1; i >= 0; i--) {
      if (/^ZZ Test/i.test(String(v[i][p[1] - 1]))) {
        if (sh.getName() === CANCEL.tab) { const u = String(v[i][cxCols_()['Agreement PDF']] || ''); const m = u.match(/\/d\/([\w-]+)/); if (m) { try { DriveApp.getFileById(m[1]).setTrashed(true); } catch (e) { Logger.log('pdf: ' + e); } } }
        sh.deleteRow(i + 2); n++;
      }
    }
  });
  CacheService.getScriptCache().remove(HUBDASH.cacheKey);
  Logger.log('Removed ' + n + ' test rows');
}

