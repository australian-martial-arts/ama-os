    out.push({ t: d.getTime(), k: String(r[1]), f: String(r[2] || ''), by: String(r[3] || ''), ty: String(r[4] || ''), n: String(r[5] || '').slice(0, 300), w: Utilities.formatDate(d, CONFIG.timezone, 'EEE d/M h:mm a') });
  });
  try { cache.put('clog:rows', JSON.stringify(out), 120); } catch (e) { }
