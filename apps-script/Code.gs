// ============================================================ COVER BY TEXT (24 Oct 2026)
// Mark or Sarah text the AMA number: "COVER Bianca Marrickville" (today), or add a day: "COVER Bianca Marrickville Sat",
// "... tomorrow", "... 31/10". That person also gets the after-trial check text for that school on that day only.
// "COVER CANCEL Marrickville [day]" removes it. "COVER LIST" shows what's set.
function tcCovers_() {
  try { return JSON.parse(PropertiesService.getScriptProperties().getProperty('tc_cover') || '{}'); } catch (e) { return {}; }
}

function tcCoverSave_(c) {
  const today = Utilities.formatDate(new Date(), CONFIG.timezone, 'yyyy-MM-dd');
  Object.keys(c).forEach(function (k) { if (k.split('|')[0] < today) delete c[k]; });
  PropertiesService.getScriptProperties().setProperty('tc_cover', JSON.stringify(c));
}

// Names (first names, lower case) covering this school on this day.
function tcCoverNames_(now, loc) {
  const k = Utilities.formatDate(now, CONFIG.timezone, 'yyyy-MM-dd') + '|' + loc;
  return (tcCovers_()[k] || []).map(function (n) { return n.toLowerCase(); });
}

function coverParseDay_(words, now) {
  const tz = CONFIG.timezone, DAY = 86400000, base = hubStartOfDay_(now);
  const DN = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
  for (let i = 0; i < words.length; i++) {
    const w = words[i].toLowerCase();
    if (w === 'today') return { d: base, i: i };
    if (w === 'tomorrow' || w === 'tmrw') return { d: new Date(base.getTime() + DAY + 3600000), i: i };
    const di = DN.indexOf(w.slice(0, 3));
    if (di > -1 && /^(mon|tue|tues|wed|thu|thur|thurs|fri|sat|sun)(day|nesday|sday|urday)?$/.test(w)) {
      const cur = Number(Utilities.formatDate(base, tz, 'u')) - 1;
      return { d: new Date(base.getTime() + ((di - cur + 7) % 7) * DAY + 3600000), i: i };
    }
    const m = w.match(/^(\d{1,2})\/(\d{1,2})$/);
    if (m) {
      let d = new Date(Number(Utilities.formatDate(base, tz, 'yyyy')), Number(m[2]) - 1, Number(m[1]), 12);
      if (d < base) d = new Date(d.getFullYear() + 1, d.getMonth(), d.getDate(), 12);
      return { d: d, i: i };
    }
  }
  return { d: base, i: -1 };
}

function coverHandle_(who, text) {
  const now = new Date(), tz = CONFIG.timezone;
  const words = text.replace(/^\s*cover\b/i, '').trim().split(/[\s,]+/).filter(String);
  const say = function (msg) { try { sendSms_(who.mobile, msg); } catch (e) { Logger.log('cover sms: ' + e); } return { ok: true, cover: msg }; };
  const help = 'To set cover, text: COVER Bianca Marrickville (today), or add a day: COVER Bianca Marrickville Sat. To remove: COVER CANCEL Marrickville Sat. To check: COVER LIST';
  const covers = tcCovers_();
  if (!words.length || /^help$/i.test(words[0])) return say(help);
  if (/^list$/i.test(words[0])) {
    const ks = Object.keys(covers).filter(function (k) { return k.split('|')[0] >= Utilities.formatDate(now, tz, 'yyyy-MM-dd') && covers[k].length; }).sort();
    return say(ks.length ? 'Cover set: ' + ks.map(function (k) { const p = k.split('|'); return covers[k].join(' and ') + ' at ' + p[1] + ' ' + Utilities.formatDate(new Date(p[0] + 'T12:00:00'), tz, 'EEE d MMM'); }).join('; ') + '.' : 'No cover set.');
  }
  const day = coverParseDay_(words, now);
  const rest = words.filter(function (w, i) { return i !== day.i; });
  const schoolIx = rest.findIndex(function (w) { return HUBDASH.locations.some(function (l) { return w.length >= 3 && l.toLowerCase().indexOf(w.toLowerCase()) === 0; }); });
  if (schoolIx < 0) return say('I couldn\'t tell which school. ' + help);
  const loc = HUBDASH.locations.filter(function (l) { return l.toLowerCase().indexOf(rest[schoolIx].toLowerCase()) === 0; })[0];
  const ymd = Utilities.formatDate(day.d, tz, 'yyyy-MM-dd'), key = ymd + '|' + loc, dayTxt = ymd === Utilities.formatDate(now, tz, 'yyyy-MM-dd') ? 'today' : Utilities.formatDate(day.d, tz, 'EEE d MMM');
  const others = rest.filter(function (w, i) { return i !== schoolIx; });
  if (others.length && /^(cancel|none|off|remove)$/i.test(others[0])) {
    delete covers[key]; tcCoverSave_(covers);
    return say('Done: no cover at ' + loc + ' ' + dayTxt + '. The usual roster applies.');
  }
  const staff = hubInviteRows_().filter(function (p) { return p.active; });
  const nm = others[0] ? staff.filter(function (p) { return p.name.toLowerCase().split(' ')[0] === others[0].toLowerCase(); })[0] : null;
  if (!nm) return say('I couldn\'t find ' + (others[0] ? '"' + others[0] + '"' : 'a name') + ' on the Hub staff list. ' + help);
  const first = nm.name.split(' ')[0];
  covers[key] = (covers[key] || []).filter(function (n) { return n.toLowerCase() !== first.toLowerCase(); }).concat([first]);
  tcCoverSave_(covers);
  const sent = dayTxt === 'today' && PropertiesService.getScriptProperties().getProperty('tc_sent_' + loc + '_' + tcYmd_(now));
  return say('Done: ' + first + ' will get the ' + loc + ' after-trial check text ' + dayTxt + ' (as well as anyone on the roster).' +
    (sent ? ' Today\'s text has already gone out, so ' + first + ' can fill it in on the hub: Admin Hub > After-trial check.' : ''));
}

