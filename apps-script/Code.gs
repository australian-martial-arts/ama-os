  const tz = CONFIG.timezone, when = Utilities.formatDate(sd, tz, 'EEE d MMM yyyy');
  const fam = (String(b.first || '') + ' ' + String(b.last || '')).trim() || 'A family', kids = String(b.students || '');
  const by = String(b.staff || (who && who.name) || '');
