function winback_(who, b) {
  const op = String(b.op || 'list'), me = String(who.name || 'Staff'), sh = wbSheet_(), H = WINBACK.headers;
  const col = function (h) { return H.indexOf(h) + 1; };
  if (op === 'add') {
    const family = String(b.family || '').trim().slice(0, 80);
    if (!family) return { ok: false, error: 'No family name on this card.' };
    let by;
    if (b.date) by = new Date(String(b.date).slice(0, 10) + 'T09:00:00');
    else { const m = parseInt(b.months, 10); if (!(m > 0 && m <= 12)) return { ok: false, error: 'Choose when they plan to come back.' }; by = hubStartOfDay_(new Date()); by.setMonth(by.getMonth() + m); }
    if (isNaN(by) || by.getTime() < hubStartOfDay_(new Date()).getTime()) return { ok: false, error: 'Choose a date in the future.' };
    const note = String(b.note || '').trim().slice(0, 300), cx = String(b.cx || '').slice(0, 30);
