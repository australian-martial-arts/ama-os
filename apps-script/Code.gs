  const fam = {};
  Object.keys(open).forEach(function (k) {
    const o = open[k], v = o.v, row = o.row;
    const lastAt = absDate_(v[C['Last attended']]);
    const mob0 = holdLast9_(String(v[C['Mobile']] || ''));
    const hp = P.hold[mob0], cp = P.cx[mob0];
    if (cp && cp.gone) { writes.push([row, 'Closed', 'Cancelled (left)']); return; }
    // after a hold, the absence clock starts again from the end of the freeze
    let base = lastAt ? hubStartOfDay_(lastAt) : null; if (hp && hp.end && hp.end < today && (!base || hp.end > base)) base = hp.end;
    const days = base ? Math.max(0, Math.round((today - base) / DAY) - xmasPauseDays_(base, today)) : null; // 17 Nov 2026 (Mark): the absence clock pauses over Christmas
    const rawDays = lastAt ? Math.round((today - hubStartOfDay_(lastAt)) / DAY) : null;
    const rec = absDate_(v[C['Received at']]);
    // came in at 7 or 9 days, now past 16 days and EFC never sent the 14-day alert: they have trained since
    if (o.id && /^(7|9)$/.test(String(v[C['Days absent']]).trim()) && !hp && rawDays !== null && rawDays >= 16 && !has14[o.id + '|' + o.lk] && rec && rec >= ABS.fourteenFrom) {
      writes.push([row, 'Closed', 'Back (no 14-day alert)']); return;
    }
    const mob = String(v[C['Mobile']] || ''), d9 = holdLast9_(mob), email = String(v[C['Email']] || '').trim().toLowerCase();
    const fk = d9.length === 9 ? 'm' + d9 : email ? 'e' + email : 'r' + row;
    const parent = absParent_(v[C['Notes']]);
    let f = fam[fk];
    if (!f) f = fam[fk] = { key: fk, rows: [], members: [], parent: parent, mobile: d9.length === 9 ? hubPrettyMobile_(mob) : mob, e164: d9.length === 9 ? '+61' + d9 : '',
      email: email, school: String(v[C['School']] || ''), status: '', by: '', log: '', done: -1, reason: '', retDate: '', received: rec, pause: null };
    if (hp && hp.active) f.pause = { g: 'hold', t: hp.text };
    if (cp) f.pause = { g: 'cancel', t: cp.text };
    const es = C['EFC status'] !== undefined ? String(v[C['EFC status']] || '').trim() : '';
