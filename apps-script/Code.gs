    const r = find(b.id); if (!r || !/approved/.test(String(r['Status']))) return { ok: false, error: 'Not approved yet' };
    if (!r['Reference']) { const e = ldgEfc_(r['School'], r['Member ID']); if (e && e.ref) { ldgSheet_().getRange(r._row, ldgCol_('Reference')).setValue(e.ref); r['Reference'] = e.ref; } else return { ok: false, error: 'Still no EFC reference' }; }
