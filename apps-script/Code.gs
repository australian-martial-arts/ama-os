// ---------------------------------------------------------------- OVERLAP AUDIT

/**
 * Read-only. Works out how many separate GHL users each location needs so
 * that concurrent classes stop blocking one another.
 *
 * Two calendars can share a user ONLY if their class times never overlap.
 * So the users needed at a site = the most classes it ever runs at once.
 */
function auditOverlaps() {
  const DAYNAMES = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  // Map every trial group id -> location name.
  const groups = ghlGroups_();
  const groupToLoc = {};
  Object.keys(CONFIG.locations).forEach(function (loc) {
    CONFIG.locations[loc].groups.forEach(function (gn) {
      const g = groups.filter(function (x) { return x.name === gn; })[0];
      if (g) groupToLoc[g.id] = loc;
      else Logger.log('WARNING: group not found - ' + gn);
    });
  });

  const data = ghlFetch_('/calendars/', { locationId: CONFIG.locationId });
  const cals = data.calendars || data.data || [];
  Logger.log('Fetched ' + cals.length + ' calendars from GHL.');

  // location -> dayIndex -> [{name, start, end}]
  const grid = {};
  let parsed = 0, skipped = 0;

  cals.forEach(function (c) {
    const loc = groupToLoc[c.groupId];
    if (!loc) { skipped++; return; }

    const oh = c.openHours || c.open_hours || [];
    if (!oh.length) { Logger.log('No open hours on: ' + c.name); return; }

    oh.forEach(function (block) {
      const days = block.daysOfTheWeek || block.days || [];
      const hours = block.hours || [];
      days.forEach(function (d) {
        hours.forEach(function (h) {
          const start = (h.openHour != null ? h.openHour : h.startHour) * 60 +
                        (h.openMinute != null ? h.openMinute : h.startMinute || 0);
          const end = (h.closeHour != null ? h.closeHour : h.endHour) * 60 +
                      (h.closeMinute != null ? h.closeMinute : h.endMinute || 0);
          if (isNaN(start) || isNaN(end)) return;
          if (!grid[loc]) grid[loc] = {};
          if (!grid[loc][d]) grid[loc][d] = [];
          grid[loc][d].push({ name: c.name, start: start, end: end });
          parsed++;
        });
      });
    });
  });

  Logger.log(parsed + ' time blocks parsed, ' + skipped + ' calendars outside the trial groups.');
  Logger.log('');

  const usersNeeded = {};

  Object.keys(grid).sort().forEach(function (loc) {
    let locMax = 1;
    const findings = [];

    Object.keys(grid[loc]).forEach(function (d) {
      const items = grid[loc][d];

      // Sweep line: how many classes run at once at the busiest moment.
      const marks = [];
      items.forEach(function (i) {
        marks.push({ t: i.start, delta: 1 });
        marks.push({ t: i.end, delta: -1 });
      });
      marks.sort(function (a, b) { return a.t - b.t || a.delta - b.delta; });

      let cur = 0, peak = 0, peakAt = null;
      marks.forEach(function (m) {
        cur += m.delta;
        if (cur > peak) { peak = cur; peakAt = m.t; }
      });

      if (peak > locMax) locMax = peak;

      if (peak > 1) {
        const clashing = items.filter(function (i) {
          return i.start <= peakAt && i.end > peakAt;
        });
        findings.push({
          day: DAYNAMES[d],
          at: hhmm_(peakAt),
          peak: peak,
          names: clashing.map(function (i) {
            return '      ' + hhmm_(i.start) + '-' + hhmm_(i.end) + '  ' + i.name;
          })
        });
      }
    });

    usersNeeded[loc] = locMax;

    Logger.log('=== ' + loc + '  ->  needs ' + locMax + ' user(s)');
    if (!findings.length) {
      Logger.log('    No overlapping classes. One user is enough.');
    } else {
      findings.forEach(function (f) {
        Logger.log('    ' + f.day + ' ' + f.at + ': ' + f.peak + ' classes at once');
        f.names.forEach(function (n) { Logger.log(n); });
      });
    }
    Logger.log('');
  });

  let total = 0;
  Object.keys(usersNeeded).forEach(function (l) { total += usersNeeded[l]; });

  Logger.log('---------------------------------------------');
  Object.keys(usersNeeded).sort().forEach(function (l) {
    Logger.log('  ' + l + ': ' + usersNeeded[l]);
  });
  Logger.log('  TOTAL USERS NEEDED: ' + total + ' (currently 1 - Laurie Mock)');
  Logger.log('---------------------------------------------');
}

function hhmm_(mins) {
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  return (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
}


function auditOverlapsFull() {
  const groups = ghlGroups_();
  const groupToLoc = {};
  Object.keys(CONFIG.locations).forEach(function (loc) {
    CONFIG.locations[loc].groups.forEach(function (gname) {
      groups.forEach(function (g) { if (g.name === gname) groupToLoc[g.id] = loc; });
    });
  });

  const list = ghlFetch_('/calendars/', { locationId: CONFIG.locationId });
  const all = list.calendars || list.data || [];
  const cals = all.filter(function (c) { return groupToLoc[c.groupId]; });
  Logger.log('Trial calendars: ' + cals.length + ' of ' + all.length);

  const DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const blocks = {};
  let parsed = 0; const noHours = []; let dumped = false;

  cals.forEach(function (c) {
    const loc = groupToLoc[c.groupId];
    let detail;
    try {
      const d = ghlFetch_('/calendars/' + c.id, {});
      detail = d.calendar || d;
    } catch (err) { Logger.log('ERR ' + c.name + ': ' + err.message); return; }

    const oh = detail.openHours || [];
    if (!oh.length) {
      noHours.push(c.name);
      if (!dumped) { Logger.log('SAMPLE KEYS: ' + Object.keys(detail).join(', ')); dumped = true; }
      return;
    }
    oh.forEach(function (blk) {
      (blk.daysOfTheWeek || []).forEach(function (dow) {
        (blk.hours || []).forEach(function (h) {
          const s = (h.openHour || 0) * 60 + (h.openMinute || 0);
          const e = (h.closeHour || 0) * 60 + (h.closeMinute || 0);
          const day = DAYS[dow];
          blocks[loc] = blocks[loc] || {};
          blocks[loc][day] = blocks[loc][day] || [];
          blocks[loc][day].push({ s: s, e: e, name: c.name });
          parsed++;
        });
      });
    });
  });

  Logger.log('Time blocks parsed: ' + parsed);
  if (noHours.length) Logger.log('No open hours on ' + noHours.length + ': ' + noHours.join(' // '));

  const usersNeeded = {};
  Object.keys(blocks).sort().forEach(function (loc) {
    Logger.log('');
    Logger.log('=== ' + loc + ' ===');
    let peakLoc = 0;
    DAYS.forEach(function (day) {
      const arr = blocks[loc][day];
      if (!arr || !arr.length) return;
      const pts = [];
      arr.forEach(function (b) { pts.push({ t: b.s, d: 1 }); pts.push({ t: b.e, d: -1 }); });
      pts.sort(function (a, b) { return a.t - b.t || a.d - b.d; });
      let cur = 0, peak = 0, peakAt = 0;
      pts.forEach(function (p) { cur += p.d; if (cur > peak) { peak = cur; peakAt = p.t; } });
      if (peak > peakLoc) peakLoc = peak;
      const at = arr.filter(function (b) { return b.s <= peakAt && b.e > peakAt; })
                    .map(function (b) { return b.name.replace('Book a Trial | ', '').replace('Open Day | ', 'OPENDAY '); });
      Logger.log('  ' + day + ': peak ' + peak + ' at ' + hhmm_(peakAt) + (peak > 1 ? '  -> ' + at.join('  ||  ') : ''));
    });
    usersNeeded[loc] = peakLoc;
  });

  let total = 0;
  Logger.log('');
  Logger.log('--------------- USERS NEEDED ---------------');
  Object.keys(usersNeeded).sort().forEach(function (l) {
    total += usersNeeded[l];
    Logger.log('  ' + l + ': ' + usersNeeded[l]);
  });
  Logger.log('  TOTAL: ' + total + ' (currently 1 - Laurie Mock)');
  Logger.log('--------------------------------------------');
}

