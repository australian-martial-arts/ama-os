      const prog = r.programme && r.programme !== 'Taekwondo' ? String(r.programme).replace('Taekwondo - ', '') + ': ' : '';
      const short = function (b) { return String(b || '').replace(/ Belt$/, ''); };
      [tot, put(bySchool, r.school || r.location), put(byDay, String(r.date) + ' ' + (r.time || '') + ' ' + r.location + ' ' + (r.programme || ''), dayLabel), put(byBelt, prog + short(r.belt_from) + ' to ' + short(r.belt_to))].forEach(function (o) {
        o.students++; if (r.invited) o.invited++; if (r.yes) o.yes++;
