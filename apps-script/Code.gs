/* 17 Nov 2026 (Mark): Black Friday on the recommendation tool. Runs in the browser on /staff-recommend (served by pageJs_). Never called on the server.
   1. Adds "Black Friday" to the promotions dropdown. Any promotion already takes the uniform off (it was given on Black Friday); the joining fee stays.
   2. Black Friday families pay the joining fee AND the first week on the day they sign, so the first week is put back on after Part 5 works out "Due today".
   3. Ticks "Start at a later date" so staff pick the date the membership starts: the end of their 4 paid weeks, later if they missed a week.
   4. No EFC link: it routes to manual billing for the office, like the School Promo. */
function recBlackFridayJs_() {
  if (window.__amaBF) return; window.__amaBF = 1;
  var LABEL = 'Black Friday';
  var n = 0, t = setInterval(function () {
    var s = document.getElementById('promoSel');
    if (s) {
      var have = false; for (var i = 0; i < s.options.length; i++) { if (s.options[i].value === LABEL) have = true; }
      if (!have) { var o = document.createElement('option'); o.value = LABEL; o.text = LABEL; s.appendChild(o); }
      clearInterval(t);
    }
    if (++n > 150) clearInterval(t);
  }, 200);
  function isBF() { var s = document.getElementById('promoSel'); return !!(s && s.value === LABEL); }
  var base = window.efcPromoLink;
  window.efcPromoLink = function () { if (isBF()) return ''; return base ? base.apply(this, arguments) : ''; };
  function fire(el) { ['input', 'change'].forEach(function (k) { el.dispatchEvent(new Event(k, { bubbles: true })); }); }
  document.addEventListener('change', function (e) {
    if (!e.target || e.target.id !== 'promoSel' || !isBF()) return;
    var chk = document.getElementById('amaLaterChk');
    if (chk && !chk.checked) { chk.checked = true; fire(chk); }
    var wr = document.getElementById('amaLaterWrap'); if (wr) wr.style.display = 'block';
  }, false);
  document.addEventListener('click', function (e) {
    if (!e.target || e.target.id !== 'calc') return;
    setTimeout(function () {
      try {
        if (!isBF() || typeof state !== 'object' || !state || typeof state.upfront !== 'number') return;
        var wk = typeof state.weekly === 'number' ? state.weekly : 0;
        if (wk > 0 && !state.firstWeekToday) { state.upfront = state.upfront + wk; state.firstWeekToday = wk; }
        var fees = typeof state.feesToday === 'number' ? state.feesToday : (state.upfront - (state.firstWeekToday || 0));
        var fmt = typeof money === 'function' ? money : function (x) { return '$' + Number(x).toFixed(2); };
        var tt = document.getElementById('uptot'); if (tt) tt.textContent = fmt(state.upfront);
        var d = document.getElementById('amaLaterDate');
        var when = d && d.value ? new Date(d.value + 'T00:00:00').toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'short' }) : '';
        var s = document.getElementById('upsub');
        if (s) s.innerHTML = '<strong>Black Friday</strong>: their 4 weeks are already paid and the uniform was given. Today: joining fee ' + fmt(fees) + ' plus the first week ' + fmt(state.firstWeekToday || 0) + '.' + (when ? ' Membership starts ' + when + '.' : ' Pick the start date above: the end of their 4 paid weeks, later if they missed a week.');
      } catch (err) { }
    }, 80);
  }, false);
}

