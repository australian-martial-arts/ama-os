    const ap = HOLD.approvers.filter(function (a) { return a.name.toLowerCase() === first; })[0];
    if (!ap) return { ok: false, error: 'Only Mark or Sarah can approve or decline a hold.' };
    const r = holdHandleReply_({ from: ap.mobile, body: (b.act === 'approve' ? 'yes ' : 'no ') + String(b.id || '') });
    try { CacheService.getScriptCache().remove(HUBDASH.cacheKey); } catch (e) { }
    return r && r.ok && r.decision ? { ok: true, decision: r.decision } : (r && r.decision === undefined && r.ok ? { ok: true, decision: b.act === 'approve' ? 'approved' : 'declined' } : { ok: false, error: (r && r.error) || 'Not saved' });
  }
  const sh = holdSheet_(), last = sh.getLastRow();
