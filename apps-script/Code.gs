// Billing restarted at the end of an extension: close the earlier hold(s) too.
function holdExtResumeChain_(row, now, name) {
  const sh = holdSheet_(), C = {}; HOLD.headers.forEach(function (h, i) { C[h] = i; });
  let v = sh.getRange(row, 1, 1, HOLD.headers.length).getValues()[0], guard = 0;
