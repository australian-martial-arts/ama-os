/* ===== 4 Nov 2026 (Mark): add a new staff member from the Pack Builder tile.
   Creates them in Deputy at their school (Deputy emails its own invite), adds them to the hub with the right access and texts
   their hub login, and makes sure they are a GHL contact so shift texts reach them. Invites go straight away (Mark, 4 Nov). ===== */
const NEWSTAFF = { roles: { 'Front desk': 'staff', 'Instructor': 'staff', 'Head Instructor': 'head', 'Manager': 'head' } };
function epbNewStaff_(who, b) {
  if (!epbCan_(who)) return { ok: false, error: 'Not allowed.' };
  const clean = function (s, n) { return String(s || '').replace(/\s+/g, ' ').trim().slice(0, n || 40); };
  const first = clean(b.first), last = clean(b.last), email = clean(b.email, 120).toLowerCase(), role = clean(b.role);
  let mob = String(b.mobile || '').replace(/\D/g, ''); if (/^61\d{9}$/.test(mob)) mob = '0' + mob.slice(2); if (/^4\d{8}$/.test(mob)) mob = '0' + mob;
  if (!first || !last) return { ok: false, error: 'Enter their first and last name.' };
  if (!/^04\d{8}$/.test(mob)) return { ok: false, error: 'Enter their Australian mobile (04…).' };
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return { ok: false, error: 'Enter their email.' };
  if (!NEWSTAFF.roles[role]) return { ok: false, error: 'Choose their role.' };
  const meta = payMeta_(), school = meta.schools.filter(function (s) { return s.id === +b.school; })[0];
  if (!school) return { ok: false, error: 'Choose their school.' };
  const full = first + ' ' + last, m9 = mob.slice(1), e164 = '+61' + m9;
  if (meta.people.some(function (p) { return String(p.name).toLowerCase() === full.toLowerCase(); })) return { ok: false, error: full + ' is already in Deputy. Choose them from the list instead.' };
  if (hubInviteRows_().some(function (p) { return p.m9 === m9; })) return { ok: false, error: 'That mobile is already on the hub. Check whether they are already set up.' };
  const done = [], tz = payTz_();
  /* 1. Deputy */
  let emp;
  try {
    emp = deputy_('/supervise/employee', { strFirstName: first, strLastName: last, intCompanyId: school.id, strCountryCode: 'au', strStartDate: Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd'), strMobilePhone: e164, strEmail: email });
  } catch (e) { return { ok: false, error: 'Deputy would not create them: ' + String(e.message || e).slice(0, 160) }; }
  const empId = +(emp && (emp.Id || emp.EmployeeId || (emp.object && emp.object.Id)));
  if (!empId) return { ok: false, error: 'Deputy did not return the new staff member. Check Deputy before trying again.' };
  done.push('Deputy: added at ' + school.name);
  try { const e = deputy_('/resource/Employee/' + empId); if (e && e.Contact) { const c = deputy_('/resource/Contact/' + e.Contact); if (c && String(c.Email1 || c.Email || '').toLowerCase() !== email) deputy_('/resource/Contact/' + e.Contact, { Email1: email, Email: email }); } } catch (e) { done.push('Deputy: email not set (' + String(e.message || e).slice(0, 60) + ')'); }
  try { deputy_('/supervise/employee/' + empId + '/invite', {}); done.push('Deputy: invite emailed to ' + email); } catch (e) { done.push('Deputy: invite not sent (' + String(e.message || e).slice(0, 80) + '). Send it from their Deputy profile.'); }
  CacheService.getScriptCache().remove('pay_meta_v1');
  /* 2. GHL contact (shift texts go through GHL) */
  try {
    if (ghlContactIdByPhone_(e164)) done.push('GHL: contact already there');
    else { ghlPost_('/contacts/', { locationId: CONFIG.locationId, firstName: first, lastName: last, phone: e164, email: email, tags: ['staff'], source: 'AMA hub - new staff' }); done.push(ghlContactIdByPhone_(e164) ? 'GHL: contact added' : 'GHL: contact may not have saved'); }
  } catch (e) { done.push('GHL: contact not added (' + String(e.message || e).slice(0, 80) + ')'); }
  /* 3. Hub login */
  try {
    const hubRole = NEWSTAFF.roles[role];
    hubSheet_().appendRow([full, mob, hubRole, true, hubNewPin_(), '', 0, '', '', 'Added ' + Utilities.formatDate(new Date(), tz, 'd MMM yyyy') + ' by ' + who.name + ' - ' + role + ', ' + school.name + ' | ' + email]);
    const p = hubInviteRows_().filter(function (x) { return x.m9 === m9; })[0];
    hubSendInvite_(p); done.push('Hub: ' + hubRole + ' access, login texted to ' + mob);
  } catch (e) { done.push('Hub: not added (' + String(e.message || e).slice(0, 80) + ')'); }
  actRow_(who.name, 'Staff', 'New staff added', full, done.join(' | '));
  return { ok: true, empId: empId, name: full, done: done };
}

/* ===== 4 Nov 2026 (Mark): pre-fill the builder's "new team member" page from Deputy (name, mobile, email, date of birth, start date, school).
   Public like epbupload, but only answers for a live one-time token from the hub tile. Nothing goes in the URL. ===== */
function epbPrefill_(b) {
  const raw = CacheService.getScriptCache().get('epbt_' + String(b.token || '').replace(/[^a-f0-9]/g, ''));
  if (!raw) return { ok: false, error: 'expired' };
  const t = JSON.parse(raw), out = { ok: true };
  try {
    const e = deputy_('/resource/Employee/' + t.empId);
    out.name = String((e.FirstName || '') + ' ' + (e.LastName || '')).trim() || t.name;
    const d = function (v) { const m = String(v || '').match(/^(\d{4}-\d{2}-\d{2})/); return m ? m[1] : ''; };
    out.dob = d(e.DateOfBirth);
    const sd = d(e.StartDate); if (sd && sd >= Utilities.formatDate(new Date(Date.now() - 60 * 864e5), payTz_(), 'yyyy-MM-dd')) out.startDate = sd;
    if (e.Contact) {
      const c = deputy_('/resource/Contact/' + e.Contact);
      let ph = String(c.Mobile || c.Phone1 || '').replace(/[^\d+]/g, ''); if (/^\+61\d{9}$/.test(ph)) ph = '0' + ph.slice(3); else if (/^61\d{9}$/.test(ph)) ph = '0' + ph.slice(2);
      if (/^04\d{8}$/.test(ph)) ph = ph.slice(0, 4) + ' ' + ph.slice(4, 7) + ' ' + ph.slice(7);
      out.phone = ph; out.email = String(c.Email1 || c.Email || '').trim();
    }
    const sch = (payMeta_().schools || []).filter(function (s) { return s.id === e.Company; })[0];
    if (sch && !/default|pay centre/i.test(sch.name)) out.location = 'AMA ' + sch.name;
  } catch (x) { out.name = t.name; }
  return out;
}

