// ============================================================ LEAD SOURCES + SPEED TO LEAD (23 Oct 2026)
// Reads GHL's own first-touch attribution (Laurie's UTM links, ad clicks, QR banners) for every enquiry and
// enrolment, and how long each new enquiry waited for its first reply. Results are kept on the
// 'Lead sources' tab so each contact is only looked up once (speed to lead is re-checked until a reply is found).
// Filled a little at a time by hubMgmtWarm (every 30 minutes).
const LEADSRC = {
  tab: 'Lead sources',
  headers: ['Contact ID', 'Enquiry at', 'Channel', 'Source', 'Medium', 'Campaign', 'Session source', 'Landing page',
    'First reply at', 'Minutes to first reply', 'Reply type', 'Checked at'],
  perRun: 150,         // contacts looked up per run
  replyDays: 90        // speed to lead only for enquiries in the last 90 days
};

function leadSheet_() {
  const ss = SpreadsheetApp.openById(HOLD.sheetId);
  let sh = ss.getSheetByName(LEADSRC.tab);
  if (!sh) {
    sh = ss.insertSheet(LEADSRC.tab);
    sh.getRange(1, 1, 1, LEADSRC.headers.length).setValues([LEADSRC.headers]).setFontWeight('bold').setBackground('#0d1511').setFontColor('#ffd200');
    sh.setFrozenRows(1);
  }
  return sh;
}

function leadRead_() {
  const sh = leadSheet_(), last = sh.getLastRow(), out = {};
  if (last < 2) return out;
  sh.getRange(2, 1, last - 1, LEADSRC.headers.length).getValues().forEach(function (r, i) {
    if (!r[0]) return;
    out[String(r[0])] = { row: i + 2, at: r[1] instanceof Date ? r[1] : null, channel: String(r[2] || ''), source: String(r[3] || ''), medium: String(r[4] || ''),
      campaign: String(r[5] || ''), session: String(r[6] || ''), replyAt: r[8] instanceof Date ? r[8] : null,
      mins: r[9] === '' || r[9] === null ? null : Number(r[9]), replyType: String(r[10] || ''), checked: r[11] instanceof Date ? r[11] : null };
  });
  return out;
}

function leadParam_(url, k) {
  const m = String(url || '').match(new RegExp('[?&]' + k + '=([^&#]*)', 'i'));
  if (!m) return '';
  try { return decodeURIComponent(m[1].replace(/\+/g, ' ')); } catch (e) { return m[1]; }
}

function leadChannel_(a) {
  a = a || {};
  const url = a.url || '';
  const src = String(a.utmSource || leadParam_(url, 'utm_source') || '').toLowerCase();
  const med = String(a.utmMedium || leadParam_(url, 'utm_medium') || '').toLowerCase();
  const camp = String(a.utmCampaign || a.campaign || leadParam_(url, 'utm_campaign') || '');
  const sess = String(a.sessionSource || '');
  const gclid = a.gclid || leadParam_(url, 'gclid'), fbclid = a.fbclid || leadParam_(url, 'fbclid');
  let ch = 'Unknown';
  if (/paid_social|paid-social|cpm|paidsocial/.test(med) || (/^(meta|fb|facebook)$/.test(src) && /paid|ad/.test(med))) ch = 'Meta ads';
  else if (/cpc|ppc|paid_search|paidsearch/.test(med) || gclid || /paid search/i.test(sess)) ch = 'Google ads';
  else if (/qr/.test(med) || /banner|flyer|poster/.test(src)) ch = 'Banners and QR codes';
  else if (/^(ig|instagram|fb|facebook|meta|tiktok)$/.test(src) || /social/i.test(sess) || fbclid) ch = 'Social (not paid)';
  else if (/email|sms/.test(med)) ch = 'Email or SMS';
  else if (/organic search/i.test(sess)) ch = 'Google search (not paid)';
  else if (/referral/i.test(sess)) ch = 'Website or link';
  else if (/direct/i.test(sess)) ch = 'Direct';
  return { channel: ch, source: src, medium: med, campaign: camp, session: sess, page: String(url).split('?')[0] };
}

function leadHeaders_() {
  return { Authorization: 'Bearer ' + PropertiesService.getScriptProperties().getProperty('GHL_TOKEN'), Version: CONFIG.ghlVersion, Accept: 'application/json' };
}

function leadFetchAll_(urls) {
  const h = leadHeaders_(), out = [];
  for (let i = 0; i < urls.length; i += 10) {
    const batch = urls.slice(i, i + 10).map(function (u) { return { url: CONFIG.ghlBase + u, headers: h, muteHttpExceptions: true }; });
    UF_.fetchAll(batch).forEach(function (r) {
      let j = null;
      try { if (r.getResponseCode() < 300) j = JSON.parse(r.getContentText()); } catch (e) { j = null; }
      out.push(j);
    });
    if (i + 10 < urls.length) Utilities.sleep(1200);
  }
  return out;
}

// items: [{cid, at (enquiry date or null)}]. Fills missing attribution and pending speed-to-lead, up to perRun contacts.
function leadSync_(items, notes, fresh) {
  const known = leadRead_(), now = new Date(), DAY = 86400000, replyFrom = new Date(now.getTime() - LEADSRC.replyDays * DAY);
  const seen = {}, todo = [];
  items.forEach(function (it) {
    if (!it.cid || seen[it.cid]) return; seen[it.cid] = 1;
    const k = known[it.cid];
    const wantReply = it.at && it.at >= replyFrom;
    const needAttr = !k;
    const recheck = k && !k.replyAt && k.checked && ((fresh && now - k.checked > 5 * 60000) || (now - it.at < 3 * DAY && now - k.checked > 25 * 60000) || (now - k.checked > 6 * 3600000 && now - it.at < 14 * DAY));
    const needReply = wantReply && (!k || !k.replyType || recheck) && !/^staff/.test((k && k.replyType) || '');
    if (needAttr || needReply) todo.push({ cid: it.cid, at: it.at, attr: needAttr, reply: !!needReply, k: k });
  });
  const pending = todo.length;
  const run = todo.slice(0, LEADSRC.perRun);
  if (!run.length) return { known: known, pending: 0 };
  // 1. contacts (attribution)
  const attrRun = run.filter(function (t) { return t.attr; });
  const contacts = leadFetchAll_(attrRun.map(function (t) { return '/contacts/' + t.cid; }));
  const attrBy = {};
  attrRun.forEach(function (t, i) { const c = contacts[i] && contacts[i].contact; if (c) attrBy[t.cid] = leadChannel_(c.attributionSource || c.lastAttributionSource || {}); });
  // 2. conversations -> first outbound after the enquiry
  const repRun = run.filter(function (t) { return t.reply; });
  const convs = leadFetchAll_(repRun.map(function (t) { return '/conversations/search?locationId=' + CONFIG.locationId + '&contactId=' + t.cid; }));
  const convIds = [];
  repRun.forEach(function (t, i) { ((convs[i] && convs[i].conversations) || []).slice(0, 2).forEach(function (cv) { convIds.push({ cid: t.cid, id: cv.id }); }); });
  const msgs = leadFetchAll_(convIds.map(function (c) { return '/conversations/' + c.id + '/messages?limit=100'; }));
  const replyBy = {};
  convIds.forEach(function (c, i) {
    const m = msgs[i] && msgs[i].messages, list = (m && m.messages) || (Array.isArray(m) ? m : []);
    const t = repRun.filter(function (x) { return x.cid === c.cid; })[0];
    list.forEach(function (x) {
      if (x.direction !== 'outbound') return;
      const d = new Date(x.dateAdded);
      if (t.at && d < new Date(t.at.getTime() - 60000)) return;
      const mt = String(x.messageType || ''), srcx = String(x.source || '');
      if (/ACTIVITY/.test(mt)) return;
      const isCall = /CALL/.test(mt);
      const auto = /workflow|api|campaign|bulk|automation|trigger/i.test(srcx) || /confirming your trial|reminder|is tomorrow|is today/i.test(String(x.body || '')) || (t.at && d - t.at < 90000 && !isCall);
      const human = isCall || !auto;
      const cur = replyBy[c.cid] || {};
      if (human && (!cur.human || d < cur.human)) cur.human = d;
      if (!cur.any || d < cur.any) cur.any = d;
      replyBy[c.cid] = cur;
    });
  });
  // 3. write
  const sh = leadSheet_(), appendRows = [];
  run.forEach(function (t) {
    const k = t.k, a = attrBy[t.cid] || (k ? { channel: k.channel, source: k.source, medium: k.medium, campaign: k.campaign, session: k.session, page: '' } : { channel: 'Unknown', source: '', medium: '', campaign: '', session: '', page: '' });
    const rp = replyBy[t.cid] || {}, first = rp.human || null;
    const mins = first && t.at ? Math.max(0, Math.round((first - t.at) / 60000)) : (k ? k.mins : null);
    const row = [t.cid, t.at || (k && k.at) || '', a.channel, a.source, a.medium, a.campaign, a.session, a.page || '',
      first || (k && k.replyAt) || '', mins === null || mins === undefined ? '' : mins, first ? 'staff' : (rp.any ? 'automatic only' : (t.reply ? 'none yet' : (k ? k.replyType : ''))), now];
    if (k) sh.getRange(k.row, 1, 1, row.length).setValues([row]);
    else appendRows.push(row);
    known[t.cid] = { at: t.at, channel: a.channel, source: a.source, medium: a.medium, campaign: a.campaign, session: a.session,
      replyAt: first || (k && k.replyAt) || null, mins: mins === '' ? null : mins, replyType: row[10], checked: now };
  });
  if (appendRows.length) sh.getRange(sh.getLastRow() + 1, 1, appendRows.length, LEADSRC.headers.length).setValues(appendRows);
  if (pending > run.length) notes.push('Lead sources still filling in: ' + (pending - run.length) + ' contacts to look up (done a batch every 30 minutes).');
  return { known: known, pending: pending - run.length };
}

// ============================================================ REPLY TO NEW ENQUIRIES (Follow up today page)
// Enquiries from the last 7 days with no text, email or call from a person yet. Uses the Lead sources tab,
// which the 30-minute warm-up keeps fresh (recent enquiries are rechecked every 30 minutes).
function hubReplyList_(who) {
  const known = leadRead_(), now = new Date(), DAY = 86400000, tz = CONFIG.timezone;
  const ss = SpreadsheetApp.openById(HOLD.sheetId), enT = hubRows_(ss, HUBDASH.enrolTab), ci = enT.head.indexOf('Contact ID'), joined = {};
  if (ci > -1) enT.rows.forEach(function (r) { if (r[ci]) joined[String(r[ci])] = 1; });
  const elsewhere = {}; // already booked a trial or in the Enrolment 2026 pipeline: handled there, so not a new enquiry
  try { chaseOpps_().forEach(function (o) { elsewhere[o.cid] = 1; }); } catch (e) { }
  try { const tf = tcSheet_(), tl = tf.getLastRow(), tC = tcCols_(); if (tl > 1) tf.getRange(2, tC['Contact ID'] + 1, tl - 1, 1).getValues().forEach(function (r) { if (r[0]) elsewhere[String(r[0])] = 1; }); } catch (e) { }
  try { const tb = replyTrialCids_(); Object.keys(tb).forEach(function (c) { elsewhere[c] = 1; }); } catch (e) { Logger.log('reply list trials: ' + e); }
  const list = Object.keys(known).map(function (cid) { const k = known[cid]; k.cid = cid; return k; }).filter(function (k) {
    return k.at && now - k.at <= 7 * DAY && k.replyType && !/^staff/.test(k.replyType) && !joined[k.cid] && !elsewhere[k.cid];
  }).sort(function (a, b) { return a.at - b.at; }).slice(0, 40);
  const cs = leadFetchAll_(list.map(function (k) { return '/contacts/' + k.cid; }));
  const items = [];
  list.forEach(function (k, i) {
    const c = (cs[i] && cs[i].contact) || {};
    // 29 Oct 2026 (Mady): contacts deleted in GHL drop off; blank names show the email or number instead.
    if (cs[i] && !cs[i].contact && /not ?found|40[04]/i.test(JSON.stringify(cs[i]).slice(0, 300))) return;
    const name = ((c.firstName || '') + ' ' + (c.lastName || '')).trim() || c.contactName || c.name || c.email || c.phone || 'No name (blank enquiry)';
    if (hubIsTest_(name) || /\btest\b/i.test(name)) return;
    const hrs = (now - k.at) / 3600000;
    items.push({ cid: k.cid, name: name, phone: c.phone || '', at: Utilities.formatDate(k.at, tz, 'EEE d MMM, h:mm a'),
      waited: hrs < 1 ? Math.max(1, Math.round(hrs * 60)) + ' min' : hrs < 48 ? Math.round(hrs) + ' hrs' : Math.round(hrs / 24) + ' days',
      type: k.replyType === 'automatic only' ? 'Automatic message only' : 'No message yet', channel: k.channel || '',
      link: 'https://app.gohighlevel.com/v2/location/' + CONFIG.locationId + '/contacts/detail/' + k.cid });
  });
  return { ok: true, items: items };
}

// Staff replied from their own phone: record it so the enquiry drops off the list and counts in speed to lead.
function hubReplyDone_(who, b) {
  const cid = String(b.cid || ''), known = leadRead_(), k = known[cid];
  if (!k) return { ok: false, error: 'Enquiry not found.' };
  const now = new Date(), mins = k.at ? Math.max(0, Math.round((now - k.at) / 60000)) : '';
  const sh = leadSheet_();
  // 27 Oct 2026: Spam is tagged in GHL so it can be left out of enquiry numbers.
  if (/spam/i.test(String(b.how || ''))) { try { ghlPost_('/contacts/' + cid + '/tags', { tags: ['spam'] }); } catch (e) { Logger.log('spam tag: ' + e); } }
  sh.getRange(k.row, 9, 1, 4).setValues([[now, mins, 'staff (marked by ' + String((who && who.name) || 'staff') + ')' + (b.how && !/replied/i.test(b.how) ? ' - ' + String(b.how).slice(0, 60) : ''), now]]);
  return { ok: true };
}

// ============================================================ ENQUIRY ALERTS (24 Oct 2026)
// Every 15 minutes: a new enquiry with no text, email or call from a person after ALERT.firstMins gets one text to
// whoever is working right now (hours on the 'Enquiry alerts' tab). Still no reply ALERT.escalateMins after that:
// a text to Mark. Only enquiries made after the alerts were switched on; nothing between 9pm and 7am.
// Switch on: installEnquiryAlerts. Switch off: stopEnquiryAlerts. Check first: previewEnquiryAlerts.
const ALERT = { tab: 'Enquiry alerts', firstMins: 60, escalateMins: 60, escalateTo: ['mark'], quietFrom: 21, quietTo: 7,
  link: 'https://train.australianmartialarts.com.au/admin#followup' };

function alertTab_() {
  const ss = SpreadsheetApp.openById(HOLD.sheetId);
  let sh = ss.getSheetByName(ALERT.tab);
  if (!sh) {
    sh = ss.insertSheet(ALERT.tab);
    sh.getRange(1, 1, 1, 8).setValues([['Name', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']]).setFontWeight('bold').setBackground('#0d1511').setFontColor('#ffd200');
    sh.getRange(2, 1, 2, 1).setValues([['Bianca'], ['Mady']]);
    sh.getRange(5, 1).setValue('Working hours like 9am-5pm or 3pm-8pm. Two shifts: 9am-12pm, 3pm-8pm. Blank = not working. Names must match the Hub staff tab.');
    sh.setFrozenRows(1);
  }
  return sh;
}

// "9am-5pm", "3-8pm", "15:00-20:00", "9am-12pm, 3pm-8pm" -> [[startMinute, endMinute], ...]
function alertParseHours_(s) {
  return String(s || '').split(/,|;|&| and /).map(function (part) {
    const m = part.trim().toLowerCase().replace(/\s+/g, '').match(/^(\d{1,2})(?:[:.](\d{2}))?(am|pm)?(?:-|–|to)(\d{1,2})(?:[:.](\d{2}))?(am|pm)?$/);
    if (!m) return null;
    const t = function (h, mi, ap) { h = Number(h); if (ap === 'pm' && h < 12) h += 12; if (ap === 'am' && h === 12) h = 0; return h * 60 + Number(mi || 0); };
    let a = t(m[1], m[2], m[3]), b = t(m[4], m[5], m[6]);
    if (!m[3] && m[6] === 'pm' && a + 720 < b) a += 720;
    if (!m[3] && !m[6] && b <= a) b += 720;
    return b > a ? [a, b] : null;
  }).filter(Boolean);
}

// First names of who is working at this moment.
function alertOnShiftNames_(now) {
  const v = alertTab_().getDataRange().getValues(), tz = CONFIG.timezone;
  const day = Number(Utilities.formatDate(now, tz, 'u')) - 1;
  const mins = Number(Utilities.formatDate(now, tz, 'H')) * 60 + Number(Utilities.formatDate(now, tz, 'm'));
  const out = [];
  v.slice(1).forEach(function (r) {
    const nm = String(r[0] || '').trim();
    if (!nm || /^working hours/i.test(nm)) return;
    if (alertParseHours_(r[1 + day]).some(function (x) { return mins >= x[0] && mins < x[1]; })) out.push(nm.toLowerCase().split(' ')[0]);
  });
  return out;
}

function alertWaited_(ms) { const h = ms / 3600000; return h < 1 ? Math.max(1, Math.round(h * 60)) + ' min' : h < 48 ? Math.round(h) + (Math.round(h) === 1 ? ' hr' : ' hrs') : Math.round(h / 24) + ' days'; }

function alertStaffText_(list, now) {
  if (list.length === 1) {
    const x = list[0];
    return 'AMA: new enquiry with no reply from a person yet: ' + x.name + (x.channel ? ' (' + x.channel + ')' : '') + ', waiting ' + alertWaited_(now - x.at) +
      (x.phone ? '. ' + x.phone : '') + '. Please call or text now, from GHL if you can. List: ' + ALERT.link;
  }
  return 'AMA: ' + list.length + ' new enquiries have no reply from a person yet: ' +
    list.slice(0, 6).map(function (x) { return x.name + ' (' + alertWaited_(now - x.at) + ')'; }).join(', ') + (list.length > 6 ? ' and ' + (list.length - 6) + ' more' : '') +
    '. Please call or text them now, from GHL if you can. List: ' + ALERT.link;
}

function alertMarkText_(list, st) {
  const tz = CONFIG.timezone;
  return 'AMA: still no reply from a person to ' + list.slice(0, 6).map(function (x) { return x.name + ' (enquired ' + Utilities.formatDate(x.at, tz, 'h:mm a') + ')'; }).join(', ') +
    (list.length > 6 ? ' and ' + (list.length - 6) + ' more' : '') + '. ' + (st[list[0].cid] && st[list[0].cid].to ? st[list[0].cid].to : 'Staff') +
    ' got a text about ' + (list.length === 1 ? 'it' : 'them') + ' an hour ago. List: ' + ALERT.link;
}

// Newest enquiries (last 2 days) with their reply status freshly checked.
function alertWaitingList_(sinceMs) {
  const now = new Date();
  const p = ghlFetch_('/opportunities/pipelines', { locationId: CONFIG.locationId });
  const pipe = (p.pipelines || []).filter(function (x) { return /enquir/i.test(x.name); })[0];
  if (!pipe) return [];
  const r = ghlFetch_('/opportunities/search', { location_id: CONFIG.locationId, pipeline_id: pipe.id, limit: 50 });
  const items = (r.opportunities || []).map(function (o) {
    const c = o.contact || {};
    return { cid: o.contactId || c.id || '', at: new Date(o.createdAt || o.dateAdded || 0), name: c.name || o.name || 'No name', phone: c.phone || '' };
  }).filter(function (x) { return x.cid && x.at.getTime() >= sinceMs && now - x.at < 2 * 86400000 && !hubIsTest_(x.name) && !/\btest\b/i.test(x.name); }).sort(function (a, b) { return a.at - b.at; });
  if (!items.length) return [];
  const LS = leadSync_(items.map(function (x) { return { cid: x.cid, at: x.at }; }), [], true);
  let tb = {}; try { tb = replyTrialCids_(); } catch (e) { }
  return items.filter(function (x) { const k = LS.known[x.cid]; if (k) x.channel = k.channel; return k && k.replyType && !/^staff/.test(k.replyType) && !tb[x.cid]; });
}

function enquiryAlerts() {
  const props = PropertiesService.getScriptProperties();
  if (props.getProperty('alert_on') !== '1') return;
  const now = new Date(), hr = Number(Utilities.formatDate(now, CONFIG.timezone, 'H'));
  let st = {};
  try { st = JSON.parse(props.getProperty('alert_state') || '{}'); } catch (e) { st = {}; }
  const waiting = alertWaitingList_(Number(props.getProperty('alert_start') || 0));
  const live = {};
  waiting.forEach(function (x) { live[x.cid] = 1; });
  Object.keys(st).forEach(function (cid) { if (!live[cid]) delete st[cid]; });
  const quiet = hr >= ALERT.quietFrom || hr < ALERT.quietTo;
  if (!quiet) {
    const first = waiting.filter(function (x) { return !st[x.cid] && now - x.at >= ALERT.firstMins * 60000; });
    const crew = first.length ? mgmtMobiles_(alertOnShiftNames_(now)) : [];
    if (first.length && crew.length) {
      const txt = alertStaffText_(first, now);
      const got = crew.filter(function (p) { try { return sendSms_(p.mobile, txt); } catch (e) { Logger.log('alert sms ' + p.name + ': ' + e); return false; } });
      Logger.log('Enquiry alert to ' + crew.map(function (p) { return p.name + (got.indexOf(p) > -1 ? ' sent' : ' NOT SENT'); }).join(', '));
      const to = got.length ? got.map(function (c) { return c.name.split(' ')[0]; }).join(' and ') : 'Nobody (' + crew.map(function (c) { return c.name.split(' ')[0]; }).join(' and ') + '\'s text failed)';
      first.forEach(function (x) { st[x.cid] = { a: now.getTime(), to: to }; });
    }
    const esc = waiting.filter(function (x) { return st[x.cid] && !st[x.cid].e && now - st[x.cid].a >= ALERT.escalateMins * 60000; });
    if (esc.length) {
      const txt = alertMarkText_(esc, st);
      mgmtMobiles_(ALERT.escalateTo).forEach(function (p) { try { sendSms_(p.mobile, txt); } catch (e) { Logger.log('escalate sms ' + p.name + ': ' + e); } });
      esc.forEach(function (x) { st[x.cid].e = now.getTime(); });
    }
  }
  props.setProperty('alert_state', JSON.stringify(st));
}

// Shows who would get texts and what they would say. Sends nothing.
function previewEnquiryAlerts() {
  const now = new Date(), tz = CONFIG.timezone, sh = alertTab_(), v = sh.getDataRange().getValues();
  const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  v.slice(1).forEach(function (r) {
    const nm = String(r[0] || '').trim(); if (!nm || /^working hours/i.test(nm)) return;
    const mob = mgmtMobiles_([nm.toLowerCase().split(' ')[0]]);
    Logger.log(nm + ' (mobile ' + (mob.length ? 'found, ends ' + mob[0].mobile.slice(-3) : 'NOT FOUND on Hub staff tab') + '): ' +
      days.map(function (d, i) { const h = alertParseHours_(r[1 + i]); return d + ' ' + (h.length ? h.map(function (x) { return Math.floor(x[0] / 60) + ':' + ('0' + x[0] % 60).slice(-2) + '-' + Math.floor(x[1] / 60) + ':' + ('0' + x[1] % 60).slice(-2); }).join(', ') : (String(r[1 + i] || '').trim() ? 'CAN\'T READ "' + r[1 + i] + '"' : 'off')); }).join(' | '));
  });
  const mk = mgmtMobiles_(ALERT.escalateTo);
  Logger.log('Mark mobile: ' + (mk.length ? 'found, ends ' + mk[0].mobile.slice(-3) : 'NOT FOUND'));
  Logger.log('Working right now (' + Utilities.formatDate(now, tz, 'EEE h:mm a') + '): ' + (alertOnShiftNames_(now).join(', ') || 'nobody'));
  const w = alertWaitingList_(0);
  Logger.log('Enquiries in the last 2 days with no reply from a person: ' + w.length);
  const sample = w.length ? w : [{ cid: 'x', name: 'Sample Parent', channel: 'Google ads', phone: '0400 000 000', at: new Date(now.getTime() - 65 * 60000) }];
  Logger.log('TEXT TO STAFF (one enquiry): ' + alertStaffText_(sample.slice(0, 1), now));
  if (sample.length > 1) Logger.log('TEXT TO STAFF (several): ' + alertStaffText_(sample, now));
  const st = {}; st[sample[0].cid] = { to: 'Bianca' };
  Logger.log('TEXT TO MARK: ' + alertMarkText_(sample.slice(0, 1), st));
}

