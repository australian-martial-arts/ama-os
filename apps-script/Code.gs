/* Secrets (6 Nov 2026): the Script properties screen is read-only once a project has more than 50 properties.
   Paste a secret's name and value into the 'Paste secrets' tab of the hub sheet, then run importSecrets: it stores each
   one in Script properties and wipes the value from the sheet. Only the names below are accepted. */
const SECRET_NAMES = ['AMA_SSO_SECRET', 'CB_SKIP_KEY', 'CB_REPLY_KEY'];
function importSecrets() {
  const ss = SpreadsheetApp.openById(HOLD.sheetId); let sh = ss.getSheetByName('Paste secrets');
  if (!sh) { sh = ss.insertSheet('Paste secrets'); sh.getRange(1, 1, 1, 3).setValues([['Name', 'Value (wiped after import)', 'Imported']]); SECRET_NAMES.forEach(function (n, i) { sh.getRange(i + 2, 1).setValue(n); }); Logger.log('Created the Paste secrets tab.'); return; }
  const have = sh.getDataRange().getValues().map(function (x) { return String(x[0]).trim(); });
  SECRET_NAMES.forEach(function (n) { if (have.indexOf(n) < 0) sh.appendRow([n, '', '']); });
  const v = sh.getDataRange().getValues(), P = PropertiesService.getScriptProperties(), done = [];
  for (let i = 1; i < v.length; i++) { const n = String(v[i][0] || '').trim(), val = String(v[i][1] || '').trim();
    if (!val || SECRET_NAMES.indexOf(n) < 0) continue;
    P.setProperty(n, val); sh.getRange(i + 1, 2).clearContent(); sh.getRange(i + 1, 3).setValue(new Date()); done.push(n); }
  Logger.log(done.length ? 'Stored: ' + done.join(', ') + ' (values wiped from the sheet)' : 'Nothing to import.');
  SECRET_NAMES.forEach(function (n) { Logger.log(n + ': ' + (P.getProperty(n) ? 'set' : 'not set')); });
}
