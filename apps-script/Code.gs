   ({ round, day, dateShort, where, sessions }) and update PREP. Bookings are sorted into rounds by booking date,
   so past sessions keep their own lists and the new one starts at zero. ===== */
const PREP_PAST = [];
function prepRounds_() { return PREP_PAST.concat([{ round: PREP.round, day: PREP.day, dateShort: PREP.dateShort, date: PREP.date, where: PREP.where, sessions: PREP.sessions, current: true }]).sort(function (a, b) { return String(a.day).localeCompare(String(b.day)); }); }
function prepRoundOf_(r) {
  const R = prepRounds_(), at = r.At instanceof Date ? Utilities.formatDate(r.At, CONFIG.timezone, 'yyyy-MM-dd') : '';
  if (!at) return R[R.length - 1];
