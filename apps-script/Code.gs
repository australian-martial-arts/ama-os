function stage4Tick_() {
  if (!s4On_()) return;
  const now = new Date(), h = Number(Utilities.formatDate(now, CONFIG.timezone, 'H'));
  if (h < STAGE4.hours[0] || h >= STAGE4.hours[1]) return;
  const P = PropertiesService.getScriptProperties();
  if (now.getTime() - Number(P.getProperty('S4_LAST') || 0) < 5 * 60000) return; // every 5 minutes is plenty
  P.setProperty('S4_LAST', String(now.getTime()));
  const lock = LockService.getScriptLock(); if (!lock.tryLock(1000)) return;
  try {
    const fam = s4Families_(), today = hubStartOfDay_(now);
    // Welcome: once per family, within 7 days of enrolling.
    Object.keys(fam).forEach(function (k) {
      const f = fam[k]; if (P.getProperty('s4w_' + k)) return;
      if ((today - f.joined) / 86400000 > 7) { P.setProperty('s4w_' + k, 'old'); return; }
      P.setProperty('s4w_' + k, String(now.getTime()));
      const t = s4WelcomeText_(f.first, f.kids, f.school);
      const sms = f.mobile ? (sendSms_('+61' + f.mobile, t) ? 'sent' : 'not sent') : 'no mobile';
      const em = s4SendMail_(f, s4Welcome_(f));
      s4Note_(f, 'welcome text ' + sms + ', welcome email ' + em);
    });
    // Day 2 and day 14 emails, counted from the start date (later starts included). Not for families on hold or cancelling.
    if (h < 10 || P.getProperty('S4_NMHOUR') === String(h)) return; // these go from 10am, checked once an hour
    P.setProperty('S4_NMHOUR', String(h));
    nmFamilies_().forEach(function (x) {
      if (x.group === 'paused' || x.group === 'complete') return;
      const f = fam[x.key]; if (!f) return;
      [['s4d2_', 2, s4Day2_], ['s4d14_', 14, s4Day14_], ['s4d35_', 35, s4Day35_]].forEach(function (s) {
        if (x.days < s[1] || P.getProperty(s[0] + x.key)) return;
        if (x.days > s[1] + 3) { P.setProperty(s[0] + x.key, 'late'); return; }
        P.setProperty(s[0] + x.key, String(now.getTime()));
        s4Note_(f, 'day ' + s[1] + ' email ' + s4SendMail_(f, s[2](f, now)));
      });
    });
  } finally { lock.releaseLock(); }
}
