// Hub: coordinator actions - email received, EFC done, withdrawn (they stayed).
function cxAction_(b, who) {
  const sh = cxSheet_(), C = cxCols_(), last = sh.getLastRow();
  if (last < 2) return { ok: false, error: 'Not found' };
  const ids = sh.getRange(2, 1, last - 1, 1).getValues().map(function (r) { return String(r[0]); });
  const i = ids.indexOf(String(b.id));
  if (i < 0) return { ok: false, error: 'Not found' };
  const row = i + 2, v = sh.getRange(row, 1, 1, CANCEL.headers.length).getValues()[0];
  if (b.act === 'email') {
    const recv = tcParseYmd_(b.date) || hubStartOfDay_(new Date());
    const ends = new Date(recv.getTime() + CANCEL.noticeDays * 86400000);
    sh.getRange(row, C['Notice email received'] + 1, 1, 2).setValues([[recv, ends]]);
    sh.getRange(row, C['Last class'] + 1).setValue(ends);
    sh.getRange(row, C['Status'] + 1).setValue('notice running');
  } else if (b.act === 'efc') {
    sh.getRange(row, C['EFC actioned at'] + 1, 1, 2).setValues([[new Date(), who.name]]);
  } else if (b.act === 'lastpay') {
    // Mark or Sarah can waive or extend the notice: sets the last payment (and last class) date.
    if (!hubIsOwner_(who)) return { ok: false, error: 'Only owners and full-access admins can change the last payment date.' };
    const lp = tcParseYmd_(b.date);
    if (!lp) return { ok: false, error: 'Choose a date' };
    if (!v[C['Notice email received']]) return { ok: false, error: 'Set this once they have signed and the notice has started.' };
    const was = v[C['Notice ends']] ? cxFmt_(v[C['Notice ends']], 'd MMM yyyy') : '-';
    sh.getRange(row, C['Notice ends'] + 1).setValue(lp);
    sh.getRange(row, C['Last class'] + 1).setValue(lp);
    sh.getRange(row, C['Notes'] + 1).setValue(String(v[C['Notes']] || '') + (v[C['Notes']] ? ' | ' : '') + 'Last payment changed from ' + was + ' to ' + cxFmt_(lp, 'd MMM yyyy') + ' by ' + who.name + ' on ' + Utilities.formatDate(new Date(), CONFIG.timezone, 'd MMM'));
  } else if (b.act === 'resend') {
    const sent = cxSendSignLink_(row, v);
    if (!/^sent|^off/.test(sent)) return { ok: false, error: 'Not sent: ' + sent };
  } else if (b.act === 'saved') {
    // 11 Nov 2026 (Mark): a save on a cancellation already logged. Credits the person who saved them (wins, weekly stats, management, exec meeting).
    const svBy = actStaffName_(b.by || who.name, who), svDay = Utilities.formatDate(new Date(), CONFIG.timezone, 'd MMM');
    sh.getRange(row, C['Status'] + 1).setValue('saved - kept by ' + svBy);
    sh.getRange(row, C['Notes'] + 1).setValue(String(v[C['Notes']] || '') + (v[C['Notes']] ? ' | ' : '') + 'Saved by ' + svBy + (b.note ? ' (' + String(b.note).slice(0, 200) + ')' : '') + ', recorded by ' + who.name + ' ' + svDay);
  } else if (b.act === 'withdrawn') {
    sh.getRange(row, C['Status'] + 1).setValue('withdrawn - stayed');
    sh.getRange(row, C['Notes'] + 1).setValue(String(v[C['Notes']] || '') + (v[C['Notes']] ? ' | ' : '') + 'Withdrawn by ' + who.name + ' ' + Utilities.formatDate(new Date(), CONFIG.timezone, 'd MMM'));
  } else if (b.act === 'complaint') {
    const note = String(b.note || '').trim();
    if (!note) return { ok: false, error: 'Write what happened first' };
    sh.getRange(row, C['Complaint outcome'] + 1).setValue(note + ' - ' + who.name + ' ' + Utilities.formatDate(new Date(), CONFIG.timezone, 'd MMM'));
  } else return { ok: false, error: 'Unknown action' };
  CacheService.getScriptCache().remove(HUBDASH.cacheKey);
  return { ok: true };
}


