function trialSmsDiag4() {
  const from = new Date('2026-10-25T12:00:00+11:00').getTime(), tally = {}, hours = {}; let after = null, n = 0, pages = 0;
  while (pages++ < 25) {
    const q = { locationId: CONFIG.locationId, sort: 'desc', sortBy: 'last_message_date', limit: 100 }; if (after) q.startAfterDate = after;
    const s = ghlFetch_('/conversations/search', q), cs = s.conversations || [];
