// 9 Nov 2026 (Mark): HELP CENTRE extras.
//  - helpmiss: a search in the help centre that found nothing is saved (who, what, when), so we can see which guides to write next.
//  - helpask: "Still stuck? Ask Mark" emails Mark the question (staff to Mark only, never to families) and keeps a copy.
//  - helptrain: records which training steps each staff member has done (guided tours, key guides); management sees everyone's progress.
//  - helpstats: management only, the latest missed searches and questions.
// Everything is kept in Script Properties (small lists, capped), nothing else is touched.
var HELP_TRAIN_STEPS = ['tour:myday', 'tour:lists', 'tour:trials', 'read:logging', 'read:trial-report'];
function helpList_(k) { try { return JSON.parse(PropertiesService.getScriptProperties().getProperty(k) || '[]'); } catch (e) { return []; } }
function helpSave_(k, v, cap) { while (JSON.stringify(v).length > 8500 && v.length) v.shift(); if (cap && v.length > cap) v = v.slice(-cap); PropertiesService.getScriptProperties().setProperty(k, JSON.stringify(v)); }
function helpWho_(who) { return String((who && who.name) || '').trim() || 'Unknown'; }
function helpCentre_(who, b) {
  if (!who || !who.name) return { ok: false, error: 'Sign in again.' };
  var kind = b.kind, now = new Date().toISOString();
  if (kind === 'helpmiss') {
    var q = String(b.q || '').trim().slice(0, 80); if (q.length < 3) return { ok: true };
    var L = helpList_('help_miss'), last = L[L.length - 1];
    if (!(last && last.q === q && last.w === helpWho_(who))) { L.push({ q: q, w: helpWho_(who), at: now }); helpSave_('help_miss', L, 150); }
    return { ok: true };
  }
  if (kind === 'helpask') {
    var text = String(b.text || '').trim().slice(0, 1500); if (!text) return { ok: false, error: 'Type your question first.' };
    var A = helpList_('help_asks'); A.push({ w: helpWho_(who), t: text, q: String(b.q || '').slice(0, 80), at: now }); helpSave_('help_asks', A, 60);
    try {
      MailApp.sendEmail({ to: 'mark.loughran@australianmartialarts.com.au', replyTo: helpReplyTo_(who), name: helpWho_(who) + ' via AMA Hub', subject: 'Hub help question from ' + helpWho_(who),
        body: helpWho_(who) + ' asked in the hub help centre:\n\n' + text + (b.q ? '\n\n(They had searched for: ' + b.q + ')' : '') + '\n\nReply to them directly. All questions are listed in Help > Management > Help questions.' });
    } catch (e) { return { ok: true, mailed: false }; }
    return { ok: true, mailed: true };
  }
  if (kind === 'helptrain') {
    var T; try { T = JSON.parse(PropertiesService.getScriptProperties().getProperty('help_train') || '{}'); } catch (e) { T = {}; }
    var nm = helpWho_(who), me = T[nm] || (T[nm] = { first: now, done: {} });
    var changed = me.seen !== now.slice(0, 10); me.seen = now.slice(0, 10);
    if (b.step && HELP_TRAIN_STEPS.indexOf(String(b.step)) > -1 && !me.done[b.step]) { me.done[b.step] = now.slice(0, 10); changed = true; }
    if (b.step === 'dismiss') { me.dismissed = now.slice(0, 10); changed = true; }
    if (changed || b.step) PropertiesService.getScriptProperties().setProperty('help_train', JSON.stringify(T));
    var out = { ok: true, steps: HELP_TRAIN_STEPS, me: me };
    if (b.all && mgmtCanSee_(who)) out.all = T;
    return out;
  }
  if (kind === 'helpstats') {
    if (!mgmtCanSee_(who)) return { ok: false, error: 'Management only.' };
    return { ok: true, miss: helpList_('help_miss').slice(-60).reverse(), asks: helpList_('help_asks').slice(-30).reverse() };
  }
  return { ok: false, error: 'Unknown help request.' };
}


// 10 Nov 2026 (Mark): EFC API, phase 0 (read-only connection test).
// Keys live ONLY in Script Properties, typed in by Mark or Tate: EFC_KEY_MARRICKVILLE, EFC_KEY_CONCORD, EFC_KEY_SYDENHAM, EFC_KEY_AUBURN, EFC_KEY_SYLVANIA.
// Nothing here ever returns, logs or emails a key. Read-only: only GET requests are made.
var EFC_API = { bases: ['https://api.efcaquila.com', 'https://api.efcaquila.net'], schools: ['Marrickville', 'Concord', 'Sydenham', 'Auburn', 'Sylvania'] };
function efcKey_(school, write) { return PropertiesService.getScriptProperties().getProperty((write === 'pkg' ? 'EFC_PKG_KEY_' : write ? 'EFC_WRITE_KEY_' : 'EFC_KEY_') + String(school).toUpperCase()) || ''; }
function efcGet_(school, path, base, write) {
  var key = efcKey_(school, write); if (!key) return { code: 0, error: 'No key yet' };
  base = base || PropertiesService.getScriptProperties().getProperty('EFC_API_BASE') || EFC_API.bases[0];
  try {
    var r = UF_.fetch(base + path, { method: 'get', headers: { 'X-API-KEY': key, 'Accept': 'application/json' }, muteHttpExceptions: true, followRedirects: true });
    var code = r.getResponseCode(), txt = r.getContentText(), body = null; try { body = JSON.parse(txt); } catch (e) { }
    return { code: code, body: body, text: body ? '' : String(txt || '').slice(0, 200) };
  } catch (e) { return { code: -1, error: String(e.message || e).slice(0, 160) }; }
}
function efcTest_(who) {
  if (!mgmtCanSee_(who)) return { ok: false, error: 'Management only.' };
  var P = PropertiesService.getScriptProperties(), out = [];
  EFC_API.schools.forEach(function (s) {
    if (!efcKey_(s)) { out.push({ school: s, status: 'No key yet' }); return; }
    var tried = [], hit = null, saved = P.getProperty('EFC_API_BASE');
    var order = saved ? [saved].concat(EFC_API.bases.filter(function (b) { return b !== saved; })) : EFC_API.bases;
    for (var i = 0; i < order.length && !hit; i++) {
      var r = efcGet_(s, '/version/1/identity', order[i]);
      tried.push(order[i].replace('https://', '') + ': ' + (r.code > 0 ? r.code : (r.error || 'no answer')));
      if (r.code === 200 && r.body) { hit = { base: order[i], body: r.body }; }
    }
    if (!hit) { out.push({ school: s, status: 'Key found but EFC did not accept it', tried: tried }); return; }
    if (!saved) P.setProperty('EFC_API_BASE', hit.base);
    var b = hit.body, locs = (b.locations || []).map(function (l) { return { name: l.name || l.locationName || '', id: l.id || l.locationId || '', roles: (l.roles || []).filter(function (x) { return efcMarkOnly_(who) || !/statement|report/i.test(x); }) }; });
    out.push({ school: s, status: 'Connected', base: hit.base.replace('https://', ''), principal: (b.principal && (b.principal.name || b.principal.id)) || '', scopes: b.scopes || [], locations: locs, tried: tried });
  });
  /* write keys: only checked (identity is a read), never used for anything yet */
  [[true, ' (write key)'], ['pkg', ' (package key)']].forEach(function (slot) { EFC_API.schools.forEach(function (s) {
    if (!efcKey_(s, slot[0])) return;
    var w = efcGet_(s, '/version/1/identity', null, slot[0]);
    if (w.code !== 200 || !w.body) { out.push({ school: s + slot[1], status: 'Key found but EFC did not accept it', tried: ['' + (w.code || w.error)] }); return; }
    var wl = (w.body.locations || []).map(function (l) { return { name: l.name || '', id: l.id || '', roles: (l.roles || []).filter(function (x) { return efcMarkOnly_(who) || !/statement|report/i.test(x); }) }; });
    out.push({ school: s + slot[1], status: 'Connected', base: '', principal: (w.body.principal && w.body.principal.name) || '', locations: wl, tried: [] });
  }); });
  return { ok: true, results: out };
}

// 10 Nov 2026 (Mark): save a school's EFC key from the management dashboard (Google's settings page can't add more than 50 settings).
// Admins only (Mark, Sarah). The key is stored in Script Properties and never sent back, logged or emailed.
function efcSetKey_(who, b) {
  if (!who || !hubIsOwner_(who)) return { ok: false, error: 'Only owners and full-access admins can save EFC keys.' };
  var school = EFC_API.schools.filter(function (s) { return s === String(b.school || ''); })[0];
  if (!school) return { ok: false, error: 'Pick a school.' };
  var key = String(b.efckey || '').trim();
  if (key.length < 10 || key.length > 600 || /\s/.test(key)) return { ok: false, error: 'That does not look like an EFC key. Copy it again from EFC.' };
  /* a write key is kept apart from the read key; nothing uses it until writes are switched on (preview first) */
  PropertiesService.getScriptProperties().setProperty((b.pkg ? 'EFC_PKG_KEY_' : b.write ? 'EFC_WRITE_KEY_' : 'EFC_KEY_') + school.toUpperCase(), key);
  return { ok: true, school: school + (b.pkg ? ' (package key)' : b.write ? ' (write key)' : '') };
}

// 10 Nov 2026: management-only, read-only explorer for building the EFC integration. GET only, never returns the key.
// Statements and reports (10 Nov 2026, Mark): only Mark, Sarah, Hakan and Ridvan may see them. No one else, Tate included.
function efcMarkOnly_(who) { return !!who && /^(mark|sarah|hakan|ridvan)\b/i.test(String(who.name || '').trim()); }
function efcProbe_(who, b) {
  if (!efcMarkOnly_(who)) return { ok: false, error: 'Not available.' };
  var path = String(b.path || '');
  if (!/^\/(version\/1\/|ingest\/version\/1\/|swagger|openapi|docs|reference)/.test(path)) return { ok: false, error: 'Path not allowed.' };
  var r = efcGet_(b.school || 'Marrickville', path, null, b.slot === 'pkg' ? 'pkg' : b.slot === 'write');
  var s = r.body ? JSON.stringify(r.body) : (r.text || r.error || '');
  return { ok: true, code: r.code, size: s.length, body: s.slice(Number(b.from) || 0, (Number(b.from) || 0) + (Number(b.len) || 20000)) };
