// 31 Oct 2026 (Mark): switch the trial calendars' own family messages over to the hub's TRIALMSG.
// For every trial calendar: family confirmation (SMS + email) and family reminders (SMS + email) off; family cancellation
// SMS reworded (wording approved by Mark 30 Oct). Staff alerts, reschedule and the cancellation email are left as they are.
// calNotifSwitchDry() logs what would change. calNotifSwitchOne() does the first calendar only. calNotifSwitchAll() does all.
function calNotifCancelText_(loc) { return 'Hi {{contact.first_name}}, your booking at AMA ' + loc + " has been cancelled. Whenever you're ready, book a new time here: " + CALL24.bookUrl; }
// Send the notification back with ALL its existing settings, changing only the one field (so nothing else resets).
// Only the notification is touched - never the calendar itself (times, lengths, availability).
function calNotifFull_(x, change) {
  const keep = {};
  Object.keys(x).forEach(function (k) { if (['_id', 'id', 'createdAt', 'updatedAt', 'version', 'deleted', 'altType', 'altId', '__v'].indexOf(k) < 0) keep[k] = x[k]; });
  Object.keys(change).forEach(function (k) { keep[k] = change[k]; });
  return keep;
}
// AFTER calNotifSwitchOne: shows that calendar's slot settings and its notifications, to compare with the GHL screen.
function calNotifCheckOne() {
  const seen = {}, cals = []; tbCalendars_().forEach(function (c) { (c.ids || []).forEach(function (id) { if (!seen[id]) { seen[id] = 1; cals.push({ id: id, loc: c.loc, cls: c.cls }); } }); });
  const c = cals[0], cal = calNotifReq_('get', '/calendars/' + c.id), d = JSON.parse(cal.text).calendar || {};
  Logger.log(c.loc + ' ' + c.cls + ' | slotDuration ' + d.slotDuration + ' ' + (d.slotDurationUnit || '') + ' | slotInterval ' + d.slotInterval + ' | updatedAt ' + d.updatedAt);
  JSON.parse(calNotifReq_('get', '/calendars/' + c.id + '/notifications').text).filter(function (x) { return !x.deleted && x.receiverType === 'contact'; }).forEach(function (x) {
    Logger.log(x.notificationType + ' ' + x.channel + ' active=' + x.isActive + ' times=' + JSON.stringify(x.beforeTime) + (x.channel === 'sms' ? ' body=' + String(x.body || '').slice(0, 160) : ''));
  });
}

function calNotifReq_(method, path, body) {
  const o = { method: method, muteHttpExceptions: true, contentType: 'application/json', headers: { 'Authorization': 'Bearer ' + getToken_(), 'Version': CONFIG.ghlVersion } };
  if (body) o.payload = JSON.stringify(body);
  const r = UF_.fetch(CONFIG.ghlBase + path, o);
  return { code: r.getResponseCode(), text: r.getContentText() };
}
function calNotifSwitch_(live, limit) {
  const seen = {}, cals = [];
  tbCalendars_().forEach(function (c) { (c.ids || []).forEach(function (id) { if (!seen[id]) { seen[id] = 1; cals.push({ id: id, loc: c.loc, cls: c.cls }); } }); });
  Logger.log('Trial calendars: ' + cals.length + (live ? ' (LIVE)' : ' (dry run, nothing changed)'));
  let n = 0, bad = 0;
  cals.slice(0, limit || cals.length).forEach(function (c) {
    const g = calNotifReq_('get', '/calendars/' + c.id + '/notifications');
    if (g.code !== 200) { Logger.log('READ FAIL ' + c.loc + ' ' + c.cls + ' ' + g.code); bad++; return; }
    const todo = [];
    JSON.parse(g.text).forEach(function (x) {
      if (x.deleted || x.receiverType !== 'contact') return;
      if ((x.notificationType === 'confirmation' || x.notificationType === 'reminder') && x.isActive) todo.push({ id: x._id, what: x.notificationType + ' ' + x.channel + ' off', body: calNotifFull_(x, { isActive: false }) });
      if (x.notificationType === 'cancellation' && x.channel === 'sms' && x.body !== calNotifCancelText_(c.loc)) todo.push({ id: x._id, what: 'cancellation sms reworded', body: calNotifFull_(x, { body: calNotifCancelText_(c.loc) }) });
    });
    const res = todo.map(function (t) {
      if (!live) return t.what;
      const p = calNotifReq_('put', '/calendars/' + c.id + '/notifications/' + t.id, t.body);
      if (p.code >= 300) bad++; else n++;
      return t.what + (p.code < 300 ? ' OK' : ' FAIL ' + p.code + ' ' + p.text.slice(0, 120));
    });
    Logger.log(c.loc + ' | ' + c.cls + ' | ' + (res.join(', ') || 'nothing to change'));
  });
  Logger.log('Done. Changed ' + n + ', problems ' + bad);
  return bad;
}
function calNotifSwitchDry() { calNotifSwitch_(false); }
function calNotifSwitchOne() { calNotifSwitch_(true, 1); }
function calNotifSwitchAll() { calNotifSwitch_(true); }

