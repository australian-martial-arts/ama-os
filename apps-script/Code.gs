function payTick_() {
  if (!PAYSEND.on) return;
  const tz = payTz_(), now = new Date(), hr = Number(Utilities.formatDate(now, tz, 'H')), dow = Number(Utilities.formatDate(now, tz, 'u'));
  if (hr < PAYSEND.from || hr > PAYSEND.until) return;
  const P = PropertiesService.getScriptProperties();
  let mon = P.getProperty('pay_cur') || '';
  if (dow === 1 && mon !== payLastMon_(now)) { mon = payLastMon_(now); P.setProperty('pay_cur', mon); }
  if (!mon) return;
  const st = P.getProperty('pay_st_' + mon) || '';
  if (st === 'final') return;
  if (st === 'draft') {
    if (now.getTime() - Number(P.getProperty('pay_t_' + mon) || 0) < 55 * 60000) return;
    if ((now.getTime() - payLocal_(mon + 'T12:00').getTime()) > 13 * 86400000) return; // stop re-checking after the following Sunday
  }
  P.setProperty('pay_t_' + mon, String(now.getTime()));
  const r = payWeek_(mon); r.extra = payExtraForWeek_(r.mon, r.sun);
  if (st === 'draft' && r.draft) return; // still things to fix: no repeat email
  payEmail_(paySubject_(r), payReportHtml_(r, payDay_));
  P.setProperty('pay_st_' + mon, r.draft ? 'draft' : 'final');
