// { 'All schools': { start: {years, rows}, stop: {...} }, 'Marrickville': {...}, ... }
function mgmtTargetsRead_() {
  const sh = SpreadsheetApp.openById(HOLD.sheetId).getSheetByName(TARGETS.tab);
  if (!sh || sh.getLastRow() < 3) return null;
  const v = sh.getDataRange().getValues(), out = {};
  for (let i = 0; i < v.length - 13; i++) {
    const m = String(v[i][0]).trim().match(/^(.+?)\s*-\s*(start|stop)$/i);
    if (!m) continue;
    const school = m[1].trim(), kind = m[2].toLowerCase();
    const h = v[i + 1].map(function (x) { return String(x).trim(); });
    const yc = [];
    h.forEach(function (x, c) { if (/^20\d\d$/.test(x)) yc.push({ y: Number(x), c: c }); });
    const ai = h.findIndex(function (x) { return /^avg/i.test(x); }), bi = h.findIndex(function (x) { return /^best/i.test(x); });
    const ti = h.findIndex(function (x) { return /target|30%/i.test(x); });
    const rows = [];
    for (let r = i + 2; r < i + 14; r++) {
      const by = {};
      yc.forEach(function (o) { const x = v[r][o.c]; by[o.y] = x === '' || x === null ? null : Number(x); });
      // 1 Nov 2026 (Mark): the starts goal is 30% above the average for this month across every previous year with data (zeros and blanks skipped).
      const thisYear = Number(Utilities.formatDate(new Date(), CONFIG.timezone, 'yyyy')), past = yc.filter(function (o) { return o.y < thisYear && by[o.y] > 0; }).map(function (o) { return by[o.y]; });
      const pastAvg = past.length ? past.reduce(function (a, b) { return a + b; }, 0) / past.length : 0;
      const isStart = kind === 'start';
      rows.push({ month: String(v[r][0]).slice(0, 3), byYear: by, avg: isStart && pastAvg ? Math.round(pastAvg) : (Number(v[r][ai]) || 0), best: Number(v[r][bi]) || 0, target: isStart && pastAvg ? Math.round(pastAvg * 1.3) : (Number(v[r][ti]) || 0) });
    }
    (out[school] = out[school] || {})[kind] = { years: yc.map(function (o) { return o.y; }), rows: rows };
  }
  return Object.keys(out).length ? out : null;
}

// Builds the dashboard's Targets section from the tab plus live hub numbers for the current month.
function mgmtTargetsBuild_(en, cx, now, cancelSince, histM) {
  const T = mgmtTargetsRead_();
  if (!T) return null;
  const tz = CONFIG.timezone, y = Number(Utilities.formatDate(now, tz, 'yyyy')), mi = Number(Utilities.formatDate(now, tz, 'M')) - 1;
  const day = Number(Utilities.formatDate(now, tz, 'd')), dim = new Date(y, mi + 1, 0).getDate();
  const MN = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const inMonth = function (d, m) { return d && d.getFullYear() === y && d.getMonth() === m; };
  const enFrom = en.reduce(function (a, e) { return !a || e.d < a ? e.d : a; }, null);
  const hubHas = function (m) { return enFrom && new Date(y, m, 1) >= new Date(enFrom.getFullYear(), enFrom.getMonth() + 1, 1); };
  const out = [];
  Object.keys(T).forEach(function (school) {
    const t = T[school]; if (!t.start || !t.stop) return;
    const mine = function (loc) { return school === 'All schools' || String(loc || '').toLowerCase() === school.toLowerCase(); };
    const hubStarts = function (m) { return en.filter(function (e) { return mine(e.loc) && inMonth(e.d, m); }).length; };
    const hubStops = function (m) { return cx.filter(function (c) { return mine(c.loc) && !c.saved && !c.withdrawn && inMonth(c.d, m); }).reduce(function (s, c) { return s + c.n; }, 0); };
    const rows = [];
    let ytdS = 0, ytdST = 0, ytdSL = 0, ytdP = 0, ytdPT = 0, ytdPL = 0;
    for (let m = 0; m < 12; m++) {
      const rs = t.start.rows[m] || {}, rp = t.stop.rows[m] || {};
      const sheetS = rs.byYear ? rs.byYear[y] : null, sheetP = rp.byYear ? rp.byYear[y] : null;
      const hm = histM && histM[school] ? histM[school][m] : null;
      let s = null, p = null;
      if (m < mi) { s = sheetS !== null && sheetS !== undefined && sheetS !== 0 ? sheetS : (hm && hm.starts ? hm.starts : (hubHas(m) ? hubStarts(m) : null)); p = sheetP !== null && sheetP !== undefined && sheetP !== 0 ? sheetP : (hm ? hm.stops : null); }
      if (m === mi) { s = Math.max(hubStarts(m), hm ? hm.starts : 0); p = Math.max(hubStops(m), hm ? hm.stops : 0); }
      rows.push({ label: rs.month || MN[m].slice(0, 3), starts: s, startsTarget: rs.target || 0, startsAvg: rs.avg || 0,
        stops: p, stopsTarget: rp.target || 0, stopsAvg: rp.avg || 0, lastStarts: rs.byYear ? rs.byYear[y - 1] : null, lastStops: rp.byYear ? rp.byYear[y - 1] : null,
        startsMin: rs.byYear && rs.byYear[y - 1] ? Math.round(rs.byYear[y - 1] * 1.1) : null, stopsMax: rp.byYear && rp.byYear[y - 1] ? Math.round(rp.byYear[y - 1] * 0.9) : null });
      if (m <= mi) {
        if (s !== null) { ytdS += s; ytdST += rs.target || 0; ytdSL += (rs.byYear && rs.byYear[y - 1]) || 0; }
        if (p !== null) { ytdP += p; ytdPT += rp.target || 0; ytdPL += (rp.byYear && rp.byYear[y - 1]) || 0; }
      }
    }
    let l12S = 0, l12P = 0;
    for (let m = 0; m < 12; m++) {
      if (m <= mi) { l12S += rows[m].starts || 0; l12P += rows[m].stops || 0; }
      else { l12S += rows[m].lastStarts || 0; l12P += rows[m].lastStops || 0; }
    }
    const cur = rows[mi];
    out.push({ school: school, monthName: MN[mi], day: day, daysInMonth: dim,
      starts: { actual: cur.starts, target: cur.startsTarget, min: cur.startsMin, avg: cur.startsAvg, lastYear: cur.lastStarts, pace: Math.round(cur.startsTarget * day / dim), minPace: cur.startsMin ? Math.round(cur.startsMin * day / dim) : null },
      stops: { actual: cur.stops, target: cur.stopsTarget, max: cur.stopsMax, avg: cur.stopsAvg, lastYear: cur.lastStops, pace: Math.round(cur.stopsTarget * day / dim) },
      ytd: { starts: ytdS, startsTarget: Math.round(ytdST), startsLastYear: ytdSL, stops: ytdP, stopsTarget: Math.round(ytdPT), stopsLastYear: ytdPL },
      last12: { starts: l12S, stops: l12P }, rows: rows, stopsFrom: cancelSince || '' });
  });
  const order = ['All schools'].concat(HUBDASH.locations);
  out.sort(function (a, b) { const i = order.indexOf(a.school), j = order.indexOf(b.school); return (i < 0 ? 99 : i) - (j < 0 ? 99 : j); });
  return out;
}
// ============================================================ WEEKLY STATS HISTORY (Mark's "2026 Stats - Start, Stop, Hold" sheet)
// Reads the team's weekly start / stop / hold sheet (one tab per school) and writes one tidy row per person
// to the 'History 2026' tab, with a reason category. The old sheet is used up to the week starting 19 Oct 2026;
// from 26 Oct the hub is the only source for stops and holds. The nightly import stops itself after 3 Nov 2026.
const HIST = { sourceId: '1IVjfcApHngMwDwAx8JfXELOkMFcEWetzntoVE0dUIVQ', tab: 'History 2026', year: 2026,
  headers: ['School', 'Week starting', 'Type', 'Name', 'Class', 'Package', 'Source or reason', 'Category', 'Staff',
    'Tenure (months)', 'Hold weeks', 'Resume date', 'Started or notice', 'Comment'],
  hubFrom: new Date(2026, 9, 26), importUntil: new Date(2026, 10, 3) };

function histCatStop_(t) {
  const s = String(t || '').toLowerCase().trim();
  if (!s || s === '-') return 'Not given';
  if (/^[\d.]+\s*(years?|months?|weeks?)$/.test(s)) return 'Not given';
  const R = [['Admin (form not returned or never cancelled)', /never returned|never cancelled|\bform\b/],
    ['Moving or distance', /mov|relocat|overseas|interstate|brisbane|queens|beaches|distance|\bfar\b/],
    ['Cost', /cost|expens|afford|financ|money|price|income/],
    ['Injury or health', /injur|health|medical|surgery|sick|pregnan|operation|anxi|pain|asthma|hamstring/],
    ['Other sport or activity', /other sport|another spo|soccer|footy|afl|swim|danc|gymnast|volleyball|basketball|tennis|taekwondo|different martial|switch gym|other activit|try (another|different)|extra curric|too many activ|taking up|music|arts/],
    ['Time, work or school', /time|schedul|busy|work|commit|homework|school|study|studies|hsc|exam|clash|timing|kindy|job|demands|weekend|attend/],
    ['Lost interest', /interest|intrest|interes|something (else|new|different)|enjoy|bored|doesn.?t want|no longer wants|not want|wish|motivat|not really|growing up|new directions/],
    ['Not the right fit', /overwhelm|loud|young|not ready|too many kids|crowd|tantrum|not suitable/],
    ['Achieved goals', /achiev|goal|graduat/],
    ['Personal or family', /personal|family|domestic|life chang|circumstanc|husband|divorce|baby/],
    ['Unhappy with classes or service', /unhappy|not happy|teacher|coach|instruct|promo|disciplin|quality|bully/],
    ['Needs a break', /break|holiday/]];
  for (let i = 0; i < R.length; i++) if (R[i][1].test(s)) return R[i][0];
  return 'Other';
}

function histCatHold_(t) {
  const s = String(t || '').toLowerCase().trim();
  if (!s || s === '-') return 'Not given';
  const R = [['Package change (not a hold)', /\bbbc\b|kickstarter|\bks\b|\bgold\b|1pw|class(es)? per week|dropped|added/],
    ['Injury or medical', /injur|medical|broken|surgery|sick|fractur|sprain|knee|ankle|wrist|finger|foot|back|cast|concuss|health|pregnan|operation|\bill|hospital|accident|asthma|astma|sciatica|fatigue|acl|menisc|exhaust|medication|torn/],
    ['Travel or holiday', /travel|holiday|hoilday|overseas|oversea|trip|vacation|away|abroad|visit/],
    ['Cost or income', /financ|cost|afford|money|income|job loss/],
    ['Other commitments', /soccer|commit|schedule|clash|ramad|fasting|relig|season|work|exam|hsc|school|study|\buni|transport|time/],
    ['Needs a break', /break|motivation|not wanting|adjust/],
    ['Family', /family|baby|birth|funeral|grief/],
    ['Catch-up classes', /catch ?up|makeup|make up/]];
  for (let i = 0; i < R.length; i++) if (R[i][1].test(s)) return R[i][0];
  return 'Other';
}

function histDate_(s) {
  const m = String(s || '').trim().match(/^(\d{1,2})[.\/-](\d{1,2})[.\/-](\d{2,4})/);
  if (!m) return '';
  let y = Number(m[3]); if (y < 100) y += 2000;
  const d = new Date(y, Number(m[2]) - 1, Number(m[1]));
  return isNaN(d) ? '' : d;
}

function histTenure_(s) {
  const m = String(s || '').toLowerCase().match(/(\d+(?:\.\d+)?)\s*(y|m|w)/);
  if (!m) return '';
  const v = Number(m[1]);
  return Math.round((m[2] === 'y' ? v * 12 : m[2] === 'm' ? v : v / 4.33) * 10) / 10;
}

// Older years of the weekly start / stop / hold sheets (same layout as 2026; added 25 Oct 2026).
const HIST_OLD = [['1CMBALoIzg-eOKek6XOfibkvXt4ANbynvHFehPstcdNc', 2025], ['1GFfxwXxuuq0JlLYlMYMiMtV9zEKGMpHSIOYfHxb0IYA', 2024],
  ['15OQdiC41njlsJ1PJZotcef0eS0f6sGlQXchZAXpthz8', 2023], ['1CCD29adN_JDRFuQgaXKf4dicBmzQaTlm-nuTl2Xwoz8', 2022]];

// "Week 2: 6th January - 12th January", "Week 1 - Jan 2nd - Jan 7th", "Week 3 - Jan 10 to Jan 16",
// "Week 40: September 25th to Oct 1st", "Week 1: 30th December 2024 - 5th January 2025" -> the week's first day.
function histWeekStart_(text, year) {
  const MON = { jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5, jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11 };
  const wn = String(text).match(/week\s*(\d+)/i), wkNo = wn ? Number(wn[1]) : 0;
  const t = String(text).replace(/^.*?week\s*\d+/i, ' ');
  const cands = [];
  let x; const r1 = /(\d{1,2})\s*(?:st|nd|rd|th)?\s*(?:of\s+)?([A-Za-z]{3,})\.?(?:,?\s+(\d{4}))?/g;
  while ((x = r1.exec(t))) if (MON[x[2].slice(0, 3).toLowerCase()] !== undefined) cands.push({ i: x.index, d: Number(x[1]), m: MON[x[2].slice(0, 3).toLowerCase()], y: x[3] ? Number(x[3]) : null });
  const r2 = /([A-Za-z]{3,})\.?\s*(\d{1,2})(?:st|nd|rd|th)?(?:,?\s+(\d{4}))?/g;
  while ((x = r2.exec(t))) if (MON[x[1].slice(0, 3).toLowerCase()] !== undefined) cands.push({ i: x.index, d: Number(x[2]), m: MON[x[1].slice(0, 3).toLowerCase()], y: x[3] ? Number(x[3]) : null });
  cands.sort(function (a, b) { return a.i - b.i; });
  let d = null;
  if (cands.length) {
    const c = cands[0];
    let y = c.y || year;
    if (!c.y && c.m === 11 && wkNo && wkNo <= 2) y = year - 1;
    if (!c.y && c.m === 0 && wkNo >= 50) y = year + 1;
    d = new Date(y, c.m, c.d);
  } else if (wkNo) {
    const j = new Date(year, 0, 1); j.setDate(j.getDate() - ((j.getDay() + 6) % 7));
    d = new Date(j.getTime() + (wkNo - 1) * 7 * 86400000);
  }
  if (!d || isNaN(d)) return null;
  if (d.getDay() === 0) d.setDate(d.getDate() + 1); else d.setDate(d.getDate() - ((d.getDay() + 6) % 7));
  return d;
}

function importHistory() {
  if (new Date() > HIST.importUntil) {
    ScriptApp.getProjectTriggers().filter(function (t) { return t.getHandlerFunction() === 'importHistory'; }).forEach(function (t) { ScriptApp.deleteTrigger(t); });
    Logger.log('The old weekly stats sheet is retired; the hub is the source now. Nightly import removed.');
    return;
  }
  const out = [], counts = {};
  [[HIST.sourceId, HIST.year]].concat(HIST_OLD).forEach(function (srcInfo) {
    const year = srcInfo[1];
    let src; try { src = SpreadsheetApp.openById(srcInfo[0]); } catch (e) { Logger.log('Could not open ' + year + ': ' + e); return; }
    src.getSheets().forEach(function (sh) {
      const school = sh.getName().trim().replace(/\s+taekwondo$/i, '');
      if (/template|issues/i.test(school) || sh.getLastRow() < 2) return;
      const v = sh.getRange(1, 1, sh.getLastRow(), Math.min(sh.getLastColumn(), 20)).getDisplayValues();
      let wk = null, kind = null, head = null;
      v.forEach(function (r) {
        const c = r.map(function (x) { return String(x || '').replace(/\s+/g, ' ').trim(); });
        const joined = c.filter(String).join(' ');
        if (/^week\s*\d+/i.test(joined) && !/^(Start|Stop|Hold)$/.test(c[0])) { wk = histWeekStart_(joined, year) || wk; kind = null; return; }
        if (/^(Start|Stop|Hold)$/.test(c[0]) && /^name$/i.test(c[1] || '')) { kind = c[0]; head = c; return; }
        if (/overview/i.test(c[0])) { kind = null; return; }
        if (!kind || !c[1] || c[1] === '-' || !(c[0] === '' || /^\d+$/.test(c[0]))) return;
        if (/^name$/i.test(c[1])) return;
        if (/requested vs granted|^(holds|stops|starts)\s*[-:]/i.test(c[1])) return;
        const f = {};
        head.forEach(function (h, i) { if (i && h) f[h.replace(/'$/, '')] = c[i] || ''; });
        let week = wk ? new Date(wk.getTime()) : null;
        if (!week) { week = new Date(year, 0, 1); week.setDate(week.getDate() - ((week.getDay() + 6) % 7)); }
        if (week >= HIST.hubFrom) return;
        let row;
        if (kind === 'Start') {
          row = [school, week, 'Start', c[1], f['Class'] || f['Class + Belt + attendance'] || '', f['Package'] || '',
            f['Where from?'] || f['Where from'] || f['How did they hear about us?'] || '', '', f['Signed up'] || f['Instructor'] || '', '', '', '',
            histDate_(f['Day started']) || f['Day started'] || '', ''];
        } else if (kind === 'Stop') {
          const reason = f['Reason'] || '';
          row = [school, week, 'Stop', c[1], f['Class'] || f['Class + Belt + attendance'] || '', f['Package'] || '', reason, histCatStop_(reason),
            f['Signed by'] || f['Instructor'] || '', histTenure_(f['Tenure']), '', '', f['Notice Period Given'] || f['Dates'] || '', (f['Comment'] || f['Comments'] || '').slice(0, 500)];
        } else {
          const reason = f['Reason'] || '';
          const w = String(f['Weeks'] || '').match(/(\d+(?:\.\d+)?)/);
          const resume = histDate_(f['Resume']);
          let weeks = w ? Number(w[1]) : '';
          if (weeks === '' && resume && resume > week) weeks = Math.round((resume - week) / (7 * 86400000));
          row = [school, week, 'Hold', c[1], '', '', reason, histCatHold_(reason), f['Signed by'] || '', '', weeks,
            resume, '', f['# of Holds before'] ? 'Holds before: ' + f['# of Holds before'] : ''];
        }
        out.push(row);
        counts[year + ' ' + kind] = (counts[year + ' ' + kind] || 0) + 1;
      });
    });
  });
  const ss = SpreadsheetApp.openById(HOLD.sheetId), dst = ss.getSheetByName(HIST.tab) || ss.insertSheet(HIST.tab);
  dst.clear();
  dst.getRange(1, 1, 1, HIST.headers.length).setValues([HIST.headers]).setFontWeight('bold').setBackground('#0d1511').setFontColor('#ffd200');
  if (out.length) {
    out.sort(function (a, b) { return a[1] - b[1]; });
    dst.getRange(2, 1, out.length, HIST.headers.length).setValues(out);
    dst.getRange(2, 2, out.length, 1).setNumberFormat('d mmm yyyy');
    dst.getRange(2, 12, out.length, 1).setNumberFormat('d mmm yyyy');
  }
  dst.setFrozenRows(1);
  PropertiesService.getScriptProperties().setProperty('hist_imported', new Date().toISOString());
  Logger.log('History: ' + out.length + ' rows. ' + JSON.stringify(counts));
}

function installHistoryImport() {
