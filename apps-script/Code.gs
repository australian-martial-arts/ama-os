function payClockTick() {
  const xmasToday = Utilities.formatDate(new Date(), CONFIG.timezone, 'yyyy-MM-dd'); // 17 Nov 2026 (Mark): Christmas closed days
  try { xmasAutoReplyTick_(xmasToday); } catch (e) { Logger.log('xmas reply: ' + e); }
  if (XMAS_CLOSED.indexOf(xmasToday) < 0) { try { promoTick_(); } catch (e) { Logger.log('promo: ' + e); } } // 17 Nov 2026: promotions (day-before lists, checks)
  if (DPA.on) { try { dpaTick_(); } catch (e) { Logger.log('dpa: ' + e); } return; } // 16 Nov 2026: the Deputy autopilot replaces this when on
  if (!CLOCKREM.on) return;
  const lock = LockService.getScriptLock(); if (!lock.tryLock(5000)) return;
  try {
    const tz = payTz_(), now = new Date(), hr = Number(Utilities.formatDate(now, tz, 'H')); if (hr < CLOCKREM.from || hr >= CLOCKREM.until) return;
    const today = Utilities.formatDate(now, tz, 'yyyy-MM-dd'), nowS = Math.floor(now.getTime() / 1000);
    const P = PropertiesService.getScriptProperties(); let sent = {}; try { sent = JSON.parse(P.getProperty('clk_sent') || '{}'); } catch (e) { }
    if (sent.day !== today) sent = { day: today, s: {}, b: {} };
    const range = { s1: { field: 'Date', type: 'ge', data: today }, s2: { field: 'Date', type: 'le', data: today } };
    const ro = deputyQuery_('Roster', range).filter(function (r) { return r.Employee && r.Published && r.StartTime <= nowS - CLOCKREM.staffMins * 60 && r.StartTime > nowS - 90 * 60 && r.EndTime > nowS; });
    if (!ro.length) { P.setProperty('clk_sent', JSON.stringify(sent)); return; }
    const ts = deputyQuery_('Timesheet', range).filter(function (t) { return !t.Discarded; });
    const meta = payMeta_(), N = {}, U = {}; meta.people.forEach(function (p) { N[p.id] = p.name; }); meta.units.forEach(function (u) { U[u.id] = u; });
    ro.forEach(function (r) {
      const name = N[r.Employee] || '', first = name.toLowerCase().split(' ')[0];
      if (!name || CLOCKREM.skip.indexOf(first) > -1) return;
      const on = r.MatchedByTimesheet || ts.some(function (t) { return t.Employee === r.Employee && t.StartTime >= r.StartTime - 3 * 3600 && t.StartTime <= nowS; });
      if (on) return;
      const school = (U[r.OperationalUnit] || {}).school || 'AMA', when = payFmt_(r.StartTime, 'h:mma').replace(':00', '');
      if (!sent.s[r.Id]) {
        const mob = payMobile_(r.Employee);
        if (mob) {
          const txt = 'Hi ' + payFirst_(name) + ', your ' + when + ' shift at AMA ' + school + ' has started and you are not clocked on in Deputy yet. Please clock on now: ' + CLOCKREM.link + '. If you are not working this shift, please let Busra know.';
          try { sendSms_(mob, txt); sent.s[r.Id] = 1; payLog_({ name: 'Hub' }, 'Clock-on reminder', name, school, payFmt_(r.StartTime), 'Text sent', '', r.Id, 'Sent'); } catch (e) { Logger.log('clock sms ' + name + ': ' + e); }
        } else { sent.s[r.Id] = 'nomob'; payLog_({ name: 'Hub' }, 'Clock-on reminder', name, school, payFmt_(r.StartTime), 'NOT sent: no mobile in Deputy', '', r.Id, 'No mobile'); }
      }
      if (!sent.b[r.Id] && r.StartTime <= nowS - CLOCKREM.busraMins * 60) {
        const late = Math.round((nowS - r.StartTime) / 60);
        try { payBusraSms_(payFirst_(name) + ' has not clocked on for the ' + when + ' shift at ' + school + ' (' + late + ' min late). Roster: ' + CLOCKREM.hub); sent.b[r.Id] = 1; } catch (e) { Logger.log('busra alert: ' + e); }
      }
    });
    P.setProperty('clk_sent', JSON.stringify(sent));
  } finally { lock.releaseLock(); }
}
