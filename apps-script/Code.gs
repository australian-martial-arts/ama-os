  const now = new Date(), tz = CONFIG.timezone, day = Number(Utilities.formatDate(now, tz, 'd')), hr = Number(Utilities.formatDate(now, tz, 'H'));
  const P = PropertiesService.getScriptProperties(), next = pvMonths_()[1], insts = pvInstructors_().filter(function (i) { return i.active && i.mobile; });
  if ((day === 1 || day === 5) && hr >= 10 && hr < 19) {
