}
function clog_(who, b) {
  const op = String(b.op || 'list'), cache = CacheService.getScriptCache(), me = String(who.name || 'Staff');
  const key = function (k) { return String(k || '').replace(/[^\w:.\-]/g, '').slice(0, 90); };
  const nowHm = function () { return Utilities.formatDate(new Date(), CONFIG.timezone, 'h:mm a'); };
  if (op === 'add') {
    const k = key(b.key);
    if (!k) return { ok: false, error: 'Nothing to log this against.' };
    const type = String(b.type || '');
    if (CLOG.callTypes.concat(CLOG.otherTypes).indexOf(type) < 0) return { ok: false, error: 'Choose what you did.' };
    const note = String(b.note || '').trim().slice(0, 500);
    if (type === 'Note only' && !note) return { ok: false, error: 'Write the note first.' };
    const lock = LockService.getScriptLock(); lock.waitLock(15000);
    try { clogSheet_().appendRow([new Date(), k, String(b.name || '').slice(0, 80), me, type, note]); } finally { lock.releaseLock(); }
    cache.remove('clog:rows'); cache.remove('clog:claim:' + k);
    return { ok: true };
  }
  if (op === 'claim') {
    const k = key(b.key);
    if (!k) return { ok: false, error: 'Nothing to claim.' };
    const cur = cache.get('clog:claim:' + k);
    if (cur) { const c = JSON.parse(cur); if (c.by !== me && !b.force) return { ok: false, taken: true, by: c.by, at: c.at, error: c.by + ' is already on this one (since ' + c.at + ').' }; }
    cache.put('clog:claim:' + k, JSON.stringify({ by: me, at: nowHm() }), CLOG.claimMins * 60);
    return { ok: true };
  }
  if (op === 'release') {
    const k = key(b.key), cur = cache.get('clog:claim:' + k);
    if (cur && JSON.parse(cur).by === me) cache.remove('clog:claim:' + k);
    return { ok: true };
  }
  // list: history for the cards on screen, who is on what right now, who else is working, and today's calls tally
  const keys = (Array.isArray(b.keys) ? b.keys : []).slice(0, 300).map(key).filter(String), want = {};
  keys.forEach(function (k) { want[k] = 1; });
  const rows = clogAll_(), log = {}, t0 = hubStartOfDay_(new Date()).getTime(), by = {};
  rows.forEach(function (r) {
    if (want[r.k]) (log[r.k] = log[r.k] || []).push({ w: r.w, by: r.by, ty: r.ty, n: r.n });
    if (r.t >= t0 && CLOG.callTypes.indexOf(r.ty) > -1) by[r.by] = (by[r.by] || 0) + 1;
  });
  Object.keys(log).forEach(function (k) { log[k] = log[k].slice(-6).reverse(); });
  const claims = {};
  if (keys.length) {
    const got = cache.getAll(keys.map(function (k) { return 'clog:claim:' + k; }));
    Object.keys(got).forEach(function (ck) { try { claims[ck.slice(11)] = JSON.parse(got[ck]); } catch (e) { } });
  }
  let here = {};
  try { here = JSON.parse(cache.get('clog:here') || '{}'); } catch (e) { }
  const nowMs = Date.now(); here[me] = nowMs;
  Object.keys(here).forEach(function (n) { if (nowMs - here[n] > CLOG.hereMins * 60000) delete here[n]; });
  cache.put('clog:here', JSON.stringify(here), 3600);
  const team = Object.keys(by).reduce(function (s, n) { return s + by[n]; }, 0);
  return { ok: true, me: me, log: log, claims: claims, here: Object.keys(here).filter(function (n) { return n !== me; }),
    tally: { me: by[me] || 0, team: team, by: by }, types: CLOG.callTypes.concat(CLOG.otherTypes) };
}

