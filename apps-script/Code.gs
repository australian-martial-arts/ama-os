// ============================================================ TRIAL NUMBER (23 Oct 2026)
// "1st trial", "2nd trial", or "Trial 1 of 2" / "Trial 2 of 2" for families booked on exactly two days.
// Counts visit DAYS per family (siblings on the same day = one visit) over the last 60 days plus the next 14,
// including walk-ins. A day where every booking was marked Absent does not count towards later trials.
var _tnums = null;
function tcTrialNums_() {
  if (_tnums) return _tnums;
  const cache = CacheService.getScriptCache(), hit = cache.get('trialnums_v1');
  if (hit) { _tnums = JSON.parse(hit); return _tnums; }
  const day0 = hubStartOfDay_(new Date()), from = new Date(day0.getTime() - 60 * 86400000), to = new Date(day0.getTime() + 15 * 86400000);
  const groups = ghlGroups_(), byC = {};
  const add = function (cid, ymd, id) { if (!cid || !ymd) return; byC[cid] = byC[cid] || {}; (byC[cid][ymd] = byC[cid][ymd] || []).push(id); };
  HUBDASH.locations.forEach(function (loc) {
    if (!CONFIG.locations[loc]) return;
    eventsForLocation_(loc, groups, from, to).forEach(function (e) { add(e.contactId, tcYmd_(new Date(e.startTime)), e.id); });
  });
  const absent = {};
  try {
    const sh = tcSheet_(), C = tcCols_(), last = sh.getLastRow();
    if (last > 1) sh.getRange(2, 1, last - 1, TRIALCHECK.headers.length).getValues().forEach(function (r) {
      const id = String(r[C['Event ID']]);
      if (r[C['Attended']] === 'Absent') absent[id] = 1;
      if (id.charAt(0) === 'W') { const d = hubDay_(r[C['Trial date']]) || tcParseYmd_(String(r[C['Trial date']])); if (d && d >= from) add(String(r[C['Contact ID']]), tcYmd_(d), id); }
    });
  } catch (err) { Logger.log('tcTrialNums_ sheet: ' + err); }
  const out = {};
  Object.keys(byC).forEach(function (cid) {
    const days = Object.keys(byC[cid]).sort();
    const counted = days.filter(function (d) { return !byC[cid][d].every(function (id) { return absent[id]; }); });
    days.forEach(function (d) { out[cid + '|' + d] = [counted.filter(function (x) { return x < d; }).length + 1, counted.length]; });
  });
  try { cache.put('trialnums_v1', JSON.stringify(out), 300); } catch (err) {}
  _tnums = out;
  return out;
}
function tcTrialLabel_(cid, ymd) {
  try {
    const x = tcTrialNums_()[String(cid) + '|' + ymd];
    if (!x) return '';
    if (x[1] === 2) return 'Trial ' + Math.min(x[0], 2) + ' of 2';
    const k = x[0];
    return (k === 1 ? '1st' : k === 2 ? '2nd' : k === 3 ? '3rd' : k + 'th') + ' trial';
  } catch (err) { return ''; }
}


