// ============================================================ STAFF PIN RESET (23 Oct 2026)
// "Forgot PIN?" on the hub sign-in screen. Texts a new PIN to the mobile already on the Hub staff tab
// (works like an invite: it goes in New PIN, so the old PIN stops working). One reset per 10 minutes.
function hubPinReset_(b) {
  const m9 = holdLast9_(b.mobile);
  if (m9.length !== 9) return { ok: false, error: 'Enter your mobile.' };
  const done = { ok: true, msg: 'If that mobile is on the staff list, a new PIN is on its way by text.' };
  const cache = CacheService.getScriptCache(), ck = 'pinreset_' + m9;
  if (cache.get(ck)) return { ok: false, error: 'A new PIN was sent in the last 10 minutes. Check your texts, or ask Mark.' };
  const lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    const p = hubInviteRows_().filter(function (x) { return x.m9 === m9; })[0];
    if (!p || !p.active) return done;
    const pin = hubNewPin_(), C = hubCols_(), sh = hubSheet_();
    sh.getRange(p.row, C['New PIN'] + 1).setValue(pin);
    sh.getRange(p.row, C['Failed tries'] + 1, 1, 2).setValues([[0, '']]);
    sh.getRange(p.row, C['Notes'] + 1).setValue((p.notes ? p.notes + ' | ' : '') + 'PIN reset by text ' + Utilities.formatDate(new Date(), CONFIG.timezone, 'd MMM h:mm a'));
    cache.put(ck, '1', 600);
    // 27 Oct: staff without a GHL contact never got the text; make sure the contact exists first.
    try {
      if (!ghlContactIdByPhone_('+61' + m9)) {
        const nm = String(p.name || '').trim().split(/\s+/);
        ghlPost_('/contacts/upsert', { locationId: CONFIG.locationId, firstName: nm[0] || '', lastName: nm.slice(1).join(' '), phone: '+61' + m9, tags: ['staff'] });
      }
    } catch (e) { Logger.log('pin reset contact: ' + e); }
    sendSms_('+61' + m9, 'AMA Admin Hub: your new PIN is ' + pin + '. Sign in at https://train.australianmartialarts.com.au/admin with your mobile and this PIN. If you didn\'t ask for this, tell Mark.');
    return done;
  } finally {
    lock.releaseLock();
  }
}


