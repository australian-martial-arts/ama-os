        paid.forEach(function (cid) { if (!has(cp, cid, 'paid')) spkLog_(L, cp.id, cid, '', 'paid', 'baseline', 'tagged before the hub took over'); });
        lead.forEach(function (cid) { if (!has(cp, cid, 'lead')) spkLog_(L, cp.id, cid, '', 'lead', 'baseline', 'tagged before the hub took over'); });
