  Logger.log(Object.keys(slots).length + ' send times: ' + Object.keys(slots).sort().map(function (k) { return k + ' (' + slots[k].join(', ') + ')'; }).join('; '));
  const mon = new Date(); mon.setDate(mon.getDate() + ((8 - mon.getDay()) % 7 || 7)); mon.setHours(0, 0, 0, 0);
  const day = dayCode_(mon), due = [];
  Object.keys(CONFIG.locations).forEach(function (loc) { const times = timesFor_(loc, day); times.forEach(function (t, i) { due.push({ loc: loc, slot: t, next: i + 1 < times.length ? times[i + 1] : null, isMain: i === times.length - 1, first: i === 0 }); }); });
  Logger.log('--- Dry run for ' + Utilities.formatDate(mon, CONFIG.timezone, 'EEE d MMM') + ' (nothing sent):');
  runSends_(mon, due, true);
}
// Swap: removes the per-time sendDue triggers, marks today's earlier send times as done, adds the 15-minute check.
function switchToOneTrialAlarm() {
  let removed = 0;
  ScriptApp.getProjectTriggers().forEach(function (t) { const f = t.getHandlerFunction(); if (f === 'sendDue' || f === 'sendDueTick') { ScriptApp.deleteTrigger(t); if (f === 'sendDue') removed++; } });
  const now = new Date(), props = PropertiesService.getScriptProperties(), ymd = Utilities.formatDate(now, CONFIG.timezone, 'yyyy-MM-dd'), mins = nowMinutes_(now);
  Object.keys(CONFIG.locations).forEach(function (loc) { timesFor_(loc, dayCode_(now)).forEach(function (t) { if (toMinutes_(t) <= mins) props.setProperty('sd_' + ymd + '_' + loc + '_' + t, 'before switch'); }); });
  ScriptApp.newTrigger('sendDueTick').timeBased().everyMinutes(15).create();
  Logger.log('Removed ' + removed + ' sendDue triggers; added one 15-minute sendDueTick. Triggers now: ' + ScriptApp.getProjectTriggers().length);
}

