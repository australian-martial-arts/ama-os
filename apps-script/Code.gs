// Daily: a week before each later start, remind the office and the instructors rostered at that school that day.
function laterDaily() {
  const sh = laterSheet_(), last = sh.getLastRow();
  if (last < 2) return;
  const v = sh.getRange(2, 1, last - 1, LATER.headers.length).getValues(), tz = CONFIG.timezone;
  const today = hubStartOfDay_(new Date()).getTime(), DAY = 86400000;
  v.forEach(function (r, i) {
    const sd = r[1] instanceof Date ? r[1] : tcParseYmd_(String(r[1] || ''));
    if (!sd || r[9]) return;
    const days = Math.round((hubStartOfDay_(sd).getTime() - today) / DAY);
    if (days > LATER.remindDays || days < 0) return;
    const when = Utilities.formatDate(sd, tz, 'EEE d MMM'), loc = String(r[5] || '');
    const txt = 'AMA: ' + r[2] + (r[6] ? ' (' + r[6] + ')' : '') + ' starts at ' + loc + ' on ' + when + '. Please check their EFC first payment is set for ' + when + ' and welcome them in.';
    const people = mgmtMobiles_(LATER.team);
    try { rosterRows_(sd).forEach(function (x) { if (x.loc === loc && !people.some(function (p) { return holdLast9_(p.mobile) === holdLast9_(x.phone); })) people.push({ name: x.name, mobile: x.phone }); }); } catch (e) { Logger.log('later roster: ' + e); }
    const sent = [];
    people.forEach(function (p) { try { if (sendSms_(p.mobile, txt)) sent.push(String(p.name).split(' ')[0]); } catch (e) { } });
    sh.getRange(i + 2, 10).setValue(Utilities.formatDate(new Date(), tz, 'd MMM') + ': ' + (sent.join(', ') || 'not sent'));
  });
}
