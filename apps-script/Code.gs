  if (!sh) { sh = ss.insertSheet(name); if (head) { sh.getRange(1, 1, 1, head.length).setValues([head]).setFontWeight('bold'); sh.setFrozenRows(1); } }
  return sh;
}
function gnWriteLive_(ss, o, res, now) {
