// Who it emails. Blank means it will not send - preview only.
const HOLD_DIGEST_TO = '';

function holdDays_(d) {
if (!d) return null;
const t = new Date(); t.setHours(0,0,0,0);
const x = new Date(d); x.setHours(0,0,0,0);
return Math.round((x - t) / 86400000);
}
function holdAgo_(d) {
const n = holdDays_(d);
if (n === null) return '';
if (n === 0) return 'today';
if (n === -1) return 'yesterday';
if (n < 0) return (-n) + ' days ago';
if (n === 1) return 'tomorrow';
return 'in ' + n + ' days';
}
function holdWhen_(d) {
if (!d) return '';
return Utilities.formatDate(new Date(d), CONFIG.timezone, 'd MMM');
}

function holdsDigest_() {
const sh = holdSheet_();
const last = sh.getLastRow();
const out = { efc: [], cert: [], resume: [], waiting: [] };
if (last < 2) return { text: 'No freezes on the sheet at all.', anything: false, out: out };

const vals = sh.getRange(2, 1, last - 1, HOLD.headers.length).getValues();
const C = {};
HOLD.headers.forEach(function (h, i) { C[h] = i; });

vals.forEach(function (r) {
const id = String(r[C['Request ID']] || '');
if (!id) return;
const status = String(r[C['Status']] || '');
const who = String(r[C['Account holder']] || '');
const kids = String(r[C['Students']] || '');
const label = id + '  ' + who + (kids ? ' (' + kids + ')' : '');
const actioned = r[C['EFC actioned at']];
const resumed = r[C['Resumed at']];
const start = r[C['Freeze starts']];
const end = r[C['Freeze ends']];

if (status === 'awaiting approval') {
out.waiting.push(label + '  -  logged ' + holdAgo_(r[C['Logged at']]) + ', still no answer from Mark or Sarah');
return;
}
if (status === 'declined') return;
if (status.indexOf('no freeze needed') === 0) return;

if (!actioned && status.indexOf('approved') === 0) {
let line = label + '  -  starts ' + holdWhen_(start);
const d = holdDays_(start);
if (d !== null && d < 0) line += '  ** STARTED ' + (-d) + ' DAYS AGO AND STILL BILLING **';
out.efc.push(line);
}
if (String(r[C['Certificate']] || '') === 'tofollow' && !actioned) {
out.cert.push(label + '  -  no medical certificate yet, cannot be actioned in EFC');
}
if (actioned && !resumed && end) {
const d = holdDays_(end);
if (d !== null && d <= 10) {
out.resume.push(label + '  -  resumes ' + holdWhen_(end) + ' (' + holdAgo_(end) + ')' + (d < 0 ? '  ** OVERDUE - NOT BILLING **' : ''));
}
}
});

const parts = [];
parts.push('AMA freezes needing action  -  ' + Utilities.formatDate(new Date(), CONFIG.timezone, 'EEE d MMM'));
parts.push('');
function section(title, arr) {
if (!arr.length) return;
parts.push(title.toUpperCase() + ' (' + arr.length + ')');
arr.forEach(function (l) { parts.push('   ' + l); });
parts.push('');
}
section('Approved but not actioned in EFC', out.efc);
section('Waiting on a medical certificate', out.cert);
section('Resuming soon - needs un-holding in EFC', out.resume);
section('Still waiting on approval', out.waiting);
const anything = out.efc.length || out.cert.length || out.resume.length || out.waiting.length;
if (!anything) parts.push('Nothing outstanding. Every freeze is actioned and nothing is due to resume in the next 10 days.');
else parts.push('Mark a freeze done by putting the date in "EFC actioned at", and "Resumed at" when billing restarts.');
return { text: parts.join('\n'), anything: !!anything, out: out };
}

