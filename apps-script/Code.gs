      if (t.TimeApproved) tsMsg = 'Their timesheet is already approved. Un-approve it in Deputy and set the finish to ' + payFmt_(newEnd, 'h:mma') + '.';
      else if (t.EndTime >= oldEnd - 60) {
        try {
          deputy_('/supervise/timesheet/update', { intTimesheetId: t.Id, intStartTimestamp: t.StartTime, intEndTimestamp: newEnd, intMealbreakMinute: Math.max(0, Math.round(((t.EndTime - t.StartTime) / 3600 - (+t.TotalTime || 0)) * 60)), intOpunitId: t.OperationalUnit, strComment: tag });
          const t2 = deputy_('/resource/Timesheet/' + t.Id);
          tsMsg = t2 && t2.EndTime === newEnd ? 'Their timesheet now finishes at ' + payFmt_(newEnd, 'h:mma') + '.' : 'Deputy did not update the timesheet. Set the finish to ' + payFmt_(newEnd, 'h:mma') + ' when approving.';
        } catch (e) { tsMsg = 'Deputy did not update the timesheet (' + String(e).slice(0, 80) + '). Set the finish to ' + payFmt_(newEnd, 'h:mma') + ' when approving.'; }
