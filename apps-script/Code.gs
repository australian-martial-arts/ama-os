  else if (b.act === 'efc') sh.getRange(row, holdCol_('EFC actioned at'), 1, 2).setValues([[now, who.name]]);
  else if (b.act === 'resume') { sh.getRange(row, holdCol_('Resumed at'), 1, 2).setValues([[now, who.name]]); holdExtResumeChain_(row, now, who.name); }
  else if (b.act === 'resend') { const s = holdSendSignLink_(row); if (!/^sent|^off/.test(s)) return { ok: false, error: 'Not sent: ' + s }; }
  else if (b.act === 'cancelling') sh.getRange(row, holdCol_('Status')).setValue('declined - family cancelling instead (' + who.name + ', ' + Utilities.formatDate(now, CONFIG.timezone, 'd MMM') + ')'); // 17 Nov 2026 (Sarah): clear a hold when the family cancels instead
  else return { ok: false, error: 'Unknown action' };
  CacheService.getScriptCache().remove(HUBDASH.cacheKey);
  return { ok: true };
}
