// 31 Oct 2026 (Mark approved): put the parent's real name on GHL contacts, from EFC's primary contact ('EFC parents' tab).
// Only changes a contact whose first name is one of the students' names (or blank). Creates a GHL contact for families not in GHL.
function gradeGhlNameFix_(live) {
  const ss = SpreadsheetApp.openById(HOLD.sheetId), pv = ss.getSheetByName('EFC parents').getDataRange().getValues(), gv = ss.getSheetByName(GRADE.dataTab).getDataRange().getValues();
  const P = {}; pv[0].forEach(function (h, i) { P[h] = i; }); const G = {}; gv[0].forEach(function (h, i) { G[h] = i; });
  const kid = {}; gv.slice(1).forEach(function (r) { kid[String(r[G['Member ID']])] = String(r[G['First name']] || '').trim(); });
  const fam = {}; pv.slice(1).forEach(function (r) {
    const m = holdLast9_(String(r[P['Parent mobile']] || '')); if (m.length !== 9) return;
    const f = fam[m] = fam[m] || { m: m, first: String(r[P['Parent first name']] || '').trim(), last: String(r[P['Parent last name']] || '').trim(), email: String(r[P['Parent email']] || '').trim(), kids: [] };
    const k = kid[String(r[P['Member ID']])]; if (k && f.kids.indexOf(k.toLowerCase()) < 0) f.kids.push(k.toLowerCase());
  });
  const t0 = Date.now(), done = PropertiesService.getScriptProperties(); let fixed = 0, created = 0, ok = 0, other = 0, adult = 0, skipped = 0; const ex = [], oth = [];
  const allK = Object.keys(fam).sort(), posKey = live ? 'GNF_POS_LIVE' : 'GNF_POS_DRY', start = Number(done.getProperty(posKey) || 0); let last = start;
  allK.slice(start).forEach(function (k, ii) {
    if (Date.now() - t0 > 320000) { skipped++; return; }
    last = start + ii + 1;
    const f = fam[k]; if (!f.first) return;
    if (f.kids.indexOf(f.first.toLowerCase()) > -1) { adult++; return; }
    let id = ''; try { id = ghlContactIdByPhone_('+61' + f.m) || ''; } catch (e) { }
    if (!id) {
      created++; if (ex.length < 12) ex.push('CREATE ' + f.first + ' ' + f.last);
      if (live) try { ghlPost_('/contacts/upsert', { locationId: CONFIG.locationId, firstName: f.first, lastName: f.last, phone: '+61' + f.m, email: f.email || undefined, tags: ['efc parent'] }); } catch (e) { Logger.log('create failed ' + f.m + ' ' + e); }
      return;
    }
    const c = (ghlFetch_('/contacts/' + id, {}) || {}).contact || {}, cf = String(c.firstName || '').trim().toLowerCase();
    if (cf === f.first.toLowerCase()) { ok++; return; }
    if (cf && f.kids.indexOf(cf) < 0) { other++; if (oth.length < 10) oth.push(c.firstName + ' (EFC: ' + f.first + ')'); return; }
    fixed++; if (ex.length < 12) ex.push((c.firstName || '(blank)') + ' ' + (c.lastName || '') + ' -> ' + f.first + ' ' + f.last);
    if (live) {
      const res = UF_.fetch(CONFIG.ghlBase + '/contacts/' + id, { method: 'put', contentType: 'application/json', muteHttpExceptions: true, headers: { 'Authorization': 'Bearer ' + getToken_(), 'Version': CONFIG.ghlVersion }, payload: JSON.stringify({ firstName: f.first, lastName: f.last }) });
      if (res.getResponseCode() >= 300) Logger.log('update failed ' + id + ' ' + res.getResponseCode());
      else try { ghlPost_('/contacts/' + id + '/notes', { body: 'Name corrected from EFC (was "' + (c.firstName || '') + ' ' + (c.lastName || '') + '", the student\'s name).' }); } catch (e) { }
    }
  });
  if (skipped) done.setProperty(posKey, String(last)); else done.deleteProperty(posKey);
