    const dur = (c.slotDuration || 30) * (c.slotDurationUnit === 'hours' ? 60 : 1);
    const nm = c.name.replace('Book a Trial | ', '').replace('Open Day | ', 'OPENDAY ');
    Object.keys(data).forEach(function (k) {
      if (!/^\d{4}-\d{2}-\d{2}$/.test(k)) return;
      const arr = (data[k] && data[k].slots) || [];
      arr.forEach(function (iso) {
        const d = new Date(iso);
        const day = DAYS[d.getDay()];
        const s = d.getHours() * 60 + d.getMinutes();
        blocks[loc] = blocks[loc] || {};
        blocks[loc][day] = blocks[loc][day] || [];
        blocks[loc][day].push({ s: s, e: s + dur, name: nm });
        slots++;
      });
    });
  });

  Logger.log('Slots collected: ' + slots);
  const usersNeeded = {};

  Object.keys(blocks).sort().forEach(function (loc) {
    Logger.log('');
    Logger.log('=== ' + loc + ' ===');
    let peakLoc = 0;
    DAYS.forEach(function (day) {
      const arr = blocks[loc][day];
      if (!arr || !arr.length) return;
      const times = {};
      arr.forEach(function (b) { times[b.s] = true; });
      let peak = 0, peakAt = 0, peakNames = [];
      Object.keys(times).forEach(function (ts) {
        const t = Number(ts);
        const names = {};
        arr.forEach(function (b) { if (b.s <= t && b.e > t) names[b.name] = true; });
        const n = Object.keys(names).length;
        if (n > peak) { peak = n; peakAt = t; peakNames = Object.keys(names); }
      });
      if (peak > peakLoc) peakLoc = peak;
      Logger.log('  ' + day + ': peak ' + peak + ' at ' + hhmm_(peakAt) + (peak > 1 ? '  ->  ' + peakNames.join('   ||   ') : ''));
    });
    usersNeeded[loc] = peakLoc;
  });

  let total = 0;
  Logger.log('');
  Logger.log('--------------- USERS NEEDED ---------------');
  Object.keys(usersNeeded).sort().forEach(function (l) {
    total += usersNeeded[l];
    Logger.log('  ' + l + ': ' + usersNeeded[l]);
  });
  Logger.log('  TOTAL: ' + total + ' (currently 1 - Laurie Mock)');
  Logger.log('--------------------------------------------');
}


function auditOverlaps() {
  const groups = ghlGroups_();
  const groupToLoc = {};
  Object.keys(CONFIG.locations).forEach(function (loc) {
    CONFIG.locations[loc].groups.forEach(function (gname) {
      groups.forEach(function (g) { if (g.name === gname) groupToLoc[g.id] = loc; });
    });
  });

  const list = ghlFetch_('/calendars/', { locationId: CONFIG.locationId });
  const all = list.calendars || list.data || [];
  const cals = all.filter(function (c) { return groupToLoc[c.groupId]; });

  const start = new Date(); start.setHours(0, 0, 0, 0);
  start.setTime(start.getTime() + 21 * 86400000);
  const end = new Date(start.getTime() + 7 * 86400000);
  const JSDAY = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  const recs = [];
  cals.forEach(function (c) {
    let data;
    try {
      data = ghlFetch_('/calendars/' + c.id + '/free-slots', {
        startDate: start.getTime(), endDate: end.getTime(), timezone: CONFIG.timezone });
    } catch (e) { Logger.log('ERR ' + c.name); return; }
    const dur = (c.slotDuration || 30) * (c.slotDurationUnit === 'hours' ? 60 : 1);
    const byDay = {};
    Object.keys(data).forEach(function (k) {
      if (!/^\d{4}-\d{2}-\d{2}$/.test(k)) return;
      ((data[k] && data[k].slots) || []).forEach(function (iso) {
        const d = new Date(iso);
        const day = JSDAY[d.getDay()];
        const s = d.getHours() * 60 + d.getMinutes();
        byDay[day] = byDay[day] || [];
        byDay[day].push([s, s + dur]);
      });
    });
    Object.keys(byDay).forEach(function (day) {
      const a = byDay[day].sort(function (x, y) { return x[0] - y[0]; });
      const m = [];
      a.forEach(function (iv) {
        if (m.length && iv[0] <= m[m.length - 1][1]) m[m.length - 1][1] = Math.max(m[m.length - 1][1], iv[1]);
        else m.push([iv[0], iv[1]]);
      });
      byDay[day] = m;
    });
    recs.push({ id: c.id, name: c.name, loc: groupToLoc[c.groupId], days: byDay, empty: !Object.keys(byDay).length });
  });

  function clash(a, b) {
    let hit = false;
    Object.keys(a.days).forEach(function (day) {
      if (!b.days[day]) return;
      a.days[day].forEach(function (x) {
        b.days[day].forEach(function (y) { if (x[0] < y[1] && y[0] < x[1]) hit = true; });
      });
    });
    return hit;
  }

  const plan = [];
  Object.keys(CONFIG.locations).sort().forEach(function (loc) {
    const mine = recs.filter(function (r) { return r.loc === loc; });
    const colour = {};
    mine.forEach(function (r) {
      if (r.empty) { colour[r.id] = 0; return; }
      const used = {};
      mine.forEach(function (o) {
        if (o.id !== r.id && colour[o.id] > 0 && clash(r, o)) used[colour[o.id]] = true;
      });
      let k = 1; while (used[k]) k++;
      colour[r.id] = k;
    });
    let maxK = 0;
    mine.forEach(function (r) { if (colour[r.id] > maxK) maxK = colour[r.id]; });
    Logger.log('');
    Logger.log('=== ' + loc + ' - ' + maxK + ' users for ' + mine.length + ' calendars ===');
    mine.sort(function (a, b) { return colour[a.id] - colour[b.id] || (a.name < b.name ? -1 : 1); });
    mine.forEach(function (r) {
      const short = r.name.replace('Book a Trial | ', '').replace('Open Day | ', 'OPENDAY ').replace(loc + ' | ', '');
      const user = colour[r.id] === 0 ? '(no slots - leave)' : loc + ' ' + colour[r.id];
      Logger.log('  ' + user + '  <-  ' + short);
      plan.push({ id: r.id, name: r.name, loc: loc, user: user, days: r.days });
    });
  });

  PropertiesService.getScriptProperties().setProperty('ASSIGN_PLAN', JSON.stringify(plan));
  Logger.log('');
  Logger.log('Plan saved (ASSIGN_PLAN), ' + plan.length + ' calendars.');
}


