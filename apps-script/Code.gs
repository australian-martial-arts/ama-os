/* 6 Nov 2026 (Mark): no birthday party automations until Mark switches them back on. Stops automatic stage moves, expired-hold releases and staff texts about parties. Family texts, staff availability texts and the daily summary are separately off (PARTY.familyTextsOn / staffTextsOn / dailyOn). Party enquiries from the website are still saved to the Parties list. */
const PARTYOFF = true;


/* ===== 6 Nov 2026 (Mark): Shop and stock, phase 1 of an integrated POS.
   One row per item and option (size or colour) on the 'Stock' tab with a count for each location.
   Every change is written to 'Stock log' with who, why and the new count. Belts are included in the
   grading fee, so they go out as 'Grading', not 'Sold'. Low stock shows in My work, but only for counts
   someone has actually taken (an item nobody has counted yet never raises a false alarm). ===== */
const STOCK = { tab: 'Stock', logTab: 'Stock log', locs: ['Marrickville', 'Sydenham'],
  headers: ['SKU', 'Category', 'Item', 'Option', 'Price', 'Reorder at', 'Marrickville', 'Sydenham', 'Marrickville counted', 'Sydenham counted', 'Active'],
  logHeaders: ['When', 'Who', 'SKU', 'Item', 'Option', 'Location', 'Change', 'Reason', 'Note', 'After'],
  reasons: ['Sold', 'Grading', 'Given out', 'Received', 'Moved', 'Damaged or lost', 'Count'] };
function stockSheetOf_(tab, headers) {
  const ss = SpreadsheetApp.openById(HOLD.sheetId); let sh = ss.getSheetByName(tab);
  if (!sh) { sh = ss.insertSheet(tab); sh.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold'); sh.setFrozenRows(1); }
  return sh;
}
function stockSheet_() { return stockSheetOf_(STOCK.tab, STOCK.headers); }
function stockLogSheet_() { return stockSheetOf_(STOCK.logTab, STOCK.logHeaders); }
function stockSku_(item, opt) { return (String(item) + (opt ? '-' + opt : '')).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 70); }
function stockRows_() {
  const sh = stockSheet_(), last = sh.getLastRow(); if (last < 2) return [];
  return sh.getRange(2, 1, last - 1, STOCK.headers.length).getValues().map(function (r, i) {
    const o = { row: i + 2 }; STOCK.headers.forEach(function (h, j) { o[h] = r[j]; }); return o;
  }).filter(function (o) { return o.SKU; });
}
function stockCanEdit_(who) { return !hubIsInstr_(who); }
function stockIsAdmin_(who) { try { return !!hubMyAccess_(who).all; } catch (e) { return false; } }
function stockTime_(v) { return v ? new Date(v).getTime() : 0; }
function stockItemOut_(r) {
  const q = {}, c = {};
  STOCK.locs.forEach(function (l) { q[l] = Number(r[l]) || 0; c[l] = stockTime_(r[l + ' counted']); });
  return { sku: String(r.SKU), cat: String(r.Category), item: String(r.Item), opt: String(r.Option || ''), price: Number(r.Price) || 0,
    reorder: Number(r['Reorder at']) || 0, q: q, counted: c };
}
function stockList_(who) {
  const items = stockRows_().filter(function (r) { return String(r.Active).toLowerCase() !== 'no'; }).map(stockItemOut_);
  let log = [];
  try {
    const sh = stockLogSheet_(), last = sh.getLastRow();
    if (last > 1) {
      const n = Math.min(60, last - 1);
      log = sh.getRange(last - n + 1, 1, n, STOCK.logHeaders.length).getValues().reverse().map(function (r) {
        return { t: stockTime_(r[0]), who: String(r[1]), item: String(r[3]), opt: String(r[4]), loc: String(r[5]), ch: Number(r[6]) || 0, why: String(r[7]), note: String(r[8]), after: Number(r[9]) || 0 };
      });
    }
  } catch (e) { Logger.log('stock log ' + e); }
  return { ok: true, locs: STOCK.locs, reasons: STOCK.reasons, items: items, log: log, canEdit: stockCanEdit_(who), admin: stockIsAdmin_(who) };
}
/* b: { loc, reason, note, lines: [{ sku, n }] }  n is how many (always positive), or the counted number for 'Count' */
function stockMove_(who, b) {
  if (!stockCanEdit_(who)) return { ok: false, error: 'Not available on the instructor view.' };
  b = b || {};
  const loc = STOCK.locs.indexOf(b.loc) > -1 ? b.loc : ''; if (!loc) return { ok: false, error: 'Pick Marrickville or Sydenham.' };
  const reason = STOCK.reasons.indexOf(b.reason) > -1 ? b.reason : ''; if (!reason) return { ok: false, error: 'Pick a reason.' };
  const other = STOCK.locs.filter(function (l) { return l !== loc; })[0];
  const lines = (Array.isArray(b.lines) ? b.lines : [{ sku: b.sku, n: b.n }]).slice(0, 60);
  const note = String(b.note || '').slice(0, 200), name = (who && who.name) || 'Staff';
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const sh = stockSheet_(), log = [], now = new Date(), map = {};
    stockRows_().forEach(function (r) { map[r.SKU] = r; });
    const col = function (h) { return STOCK.headers.indexOf(h) + 1; };
    lines.forEach(function (l) {
      const r = map[String(l && l.sku || '')]; if (!r) return;
      const n = Math.round(Number(l.n)); if (!isFinite(n) || n < 0 || n > 5000) return;
      const cur = Number(r[loc]) || 0;
      if (reason === 'Count') {
        sh.getRange(r.row, col(loc)).setValue(n); sh.getRange(r.row, col(loc + ' counted')).setValue(now); r[loc] = n;
        log.push([now, name, r.SKU, r.Item, r.Option, loc, n - cur, reason, note, n]);
        return;
      }
      if (!n) return;
      if (reason === 'Moved') {
        const oc = Number(r[other]) || 0;
        sh.getRange(r.row, col(loc)).setValue(cur - n); sh.getRange(r.row, col(other)).setValue(oc + n); r[loc] = cur - n; r[other] = oc + n;
        log.push([now, name, r.SKU, r.Item, r.Option, loc, -n, 'Moved to ' + other, note, cur - n]);
        log.push([now, name, r.SKU, r.Item, r.Option, other, n, 'Moved from ' + loc, note, oc + n]);
        return;
      }
      const ch = reason === 'Received' ? n : -n;
      sh.getRange(r.row, col(loc)).setValue(cur + ch); r[loc] = cur + ch;
      log.push([now, name, r.SKU, r.Item, r.Option, loc, ch, reason, note, cur + ch]);
    });
    if (log.length) { const ls = stockLogSheet_(); ls.getRange(ls.getLastRow() + 1, 1, log.length, STOCK.logHeaders.length).setValues(log); }
    try { actRow_(name, 'Stock', reason, loc, log.length + ' line' + (log.length === 1 ? '' : 's')); } catch (e) { }
    if (!log.length) return { ok: false, error: 'Nothing changed.' };
  } finally { lock.releaseLock(); }
  return stockList_(who);
}
/* admin only: change price, reorder level or hide an item; or add a new item and option */
function stockItem_(who, b) {
  if (!stockIsAdmin_(who)) return { ok: false, error: 'Only admin can change items and prices.' };
  b = b || {};
  const sh = stockSheet_(), rows = stockRows_(), col = function (h) { return STOCK.headers.indexOf(h) + 1; };
  const r = rows.filter(function (x) { return x.SKU === b.sku; })[0];
  if (r) {
    if (b.price !== undefined && b.price !== '' && isFinite(Number(b.price))) sh.getRange(r.row, col('Price')).setValue(Number(b.price));
    if (b.reorder !== undefined && b.reorder !== '' && isFinite(Number(b.reorder))) sh.getRange(r.row, col('Reorder at')).setValue(Math.max(0, Math.round(Number(b.reorder))));
    if (b.hide) sh.getRange(r.row, col('Active')).setValue('No');
    return stockList_(who);
  }
  const item = String(b.item || '').trim().slice(0, 80), opt = String(b.opt || '').trim().slice(0, 40), cat = String(b.cat || 'Other').trim().slice(0, 40);
  if (!item) return { ok: false, error: 'Item name needed.' };
  const sku = stockSku_(item, opt);
  if (rows.some(function (x) { return x.SKU === sku; })) return { ok: false, error: 'That item and option already exist.' };
  sh.appendRow([sku, cat, item, opt, Number(b.price) || 0, Math.max(0, Number(b.reorder) || 0), 0, 0, '', '', 'Yes']);
  return stockList_(who);
}
/* My work: low stock per location (counted items only), and a count reminder for admin */
function stockWork_(who) {
  const acc = hubMyAccess_(who); if (acc.instructor) return [];
  const areas = (acc.areas || []).map(function (a) { return String(a).toLowerCase(); });
  if (!acc.all && areas.indexOf('front desk') < 0) return [];
  const items = stockRows_().filter(function (r) { return String(r.Active).toLowerCase() !== 'no'; }).map(stockItemOut_), out = [];
  STOCK.locs.forEach(function (loc) {
    const low = items.filter(function (i) { return i.counted[loc] && i.reorder > 0 && i.q[loc] <= i.reorder; });
    if (!low.length) return;
    const list = low.slice(0, 6).map(function (i) { return i.item + (i.opt ? ' ' + i.opt : '') + ' (' + i.q[loc] + ')'; }).join(', ');
    out.push({ area: 'Front desk', stage: 'Low stock at ' + loc, who: low.length + ' item' + (low.length === 1 ? '' : 's'), why: list + (low.length > 6 ? ' and ' + (low.length - 6) + ' more' : '') + '. Reorder or move stock across.', days: 0, verb: 'Open', href: '#stock' });
  });
  if (acc.all) {
    const n = items.filter(function (i) { return STOCK.locs.some(function (l) { return !i.counted[l]; }); }).length;
    if (n) out.push({ area: 'Front desk', stage: 'Stock count needed', who: n + ' item' + (n === 1 ? '' : 's'), why: 'These have no count yet at Marrickville or Sydenham. Open Shop and stock, pick the location and tap Count.', days: 0, verb: 'Open', href: '#stock' });
  }
  return out;
}
