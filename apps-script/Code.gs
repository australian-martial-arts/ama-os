/* ===== 5 Nov 2026 (Mark): Absentee "Call today" is ranked, most likely to come back first; the hub shows the top 25.
   Order: families who replied to a text, call-backs due today, return classes to check, then calls:
   shortest absence first, fewer unanswered tries first, bigger families first, head instructor calls slightly ahead.
   (A call drops off by itself once the family reaches the next step, e.g. the day 15 video or the day 30 text.) ===== */
const ABSRANK = { top: 25 };
function absRank_(r) {
  if (!r || !r.ok || !r.items) return r;
  r.items.forEach(function (x) {
    const note = String(x.note || '');
    let s;
    if (/^Replied/i.test(note)) s = 1000;
    else if (/^Call back today/i.test(note)) s = 900;
    else if (x.group === 'check') s = 800;
    else s = 500 - (Number(x.days) || 0) * 8 - (Number(x.tries) || 0) * 40 + Math.max(0, (x.members || []).length - 1) * 25 + (x.group === 'head' ? 15 : 0);
    x.rank = Math.round(s);
  });
  r.items.sort(function (p, q) { return q.rank - p.rank || (p.days || 0) - (q.days || 0); });
  r.rankTop = ABSRANK.top;
  return r;
}

