/* ===== STUDENT CARD (9 Nov 2026, Mark) =====
   Click a student (or account holder) on the management dashboard or the executive meeting page to see everything the
   hub knows about them: sign-up, EFC record, attendance, holds, cancellations, history and family. Read only. Management
   only; money columns are hidden from MGMT.noMoney (Laurie). Nothing is sent and nothing is changed. */
const STUCARD = {
  tabs: /^(Enrolments|EFC students|Cancellations|Holds|New members|History \d{4}|Joining forms|Grading EFC|EFC feed)$|trial|recommend/i,
  skipTabs: /log|setting|config|exec|roster|count|prep|referral history|request/i,
  skipCols: /^(Combination key|Key|Member ID|Contact ID|Pulled at|Care texts|Sign link sent|Updated at)$/i,
  money: /rate|weekly|due|balance|price|fee|amount|paid|\$|revenue|cost/i,
  dated: ['Enrolled date', 'Logged at', 'Enrolled on', 'Week starting', 'Start date', 'Submitted date', 'Received date', 'Date', 'Booked', 'Trial date', 'Created']
};
function stuCard_(who, b) {
  if (!mgmtCanSee_(who)) return { ok: false, error: 'Management only.' };
  const name = String((b && b.name) || '').replace(/\s+/g, ' ').trim();
  if (name.length < 2) return { ok: false, error: 'No name given.' };
  const noMoney = mgmtNoMoney_(who), key = 'stu1|' + (noMoney ? 'n|' : '') + name.toLowerCase();
  const cache = CacheService.getScriptCache();
  if (!(b && b.fresh)) { try { const hit = cache.get(key); if (hit) return JSON.parse(hit); } catch (e) { } }
  const o = stuCardBuild_(name, noMoney, String((b && b.school) || ''));
  try { const s = JSON.stringify(o); if (s.length < 95000) cache.put(key, s, 300); } catch (e) { }
  return o;
}
function stuCardBuild_(name, noMoney, school) {
  const tz = CONFIG.timezone, ss = SpreadsheetApp.openById(HOLD.sheetId);
  const low = function (x) { return String(x == null ? '' : x).toLowerCase().replace(/\s+/g, ' ').trim(); };
  const toks = low(name).split(' ').filter(Boolean), one = toks.length === 1;
  const m9 = function (x) { const d = String(x || '').replace(/\D/g, ''); return d.length >= 9 ? d.slice(-9) : ''; };
  const fmt = function (x) {
    if (x instanceof Date) { if (isNaN(x)) return ''; const t = Utilities.formatDate(x, tz, 'HH:mm'); return Utilities.formatDate(x, tz, 'EEE d MMM yyyy') + (t !== '00:00' ? ' ' + Utilities.formatDate(x, tz, 'h:mma').toLowerCase() : ''); }
    return String(x == null ? '' : x).trim();
  };
  const fw = new RegExp('(^|[^a-z])' + toks[0].replace(/[^a-z]/g, '') + '([^a-z]|$)');
  const nameCols = function (H) { return H.map(function (h, i) { return /^(student name|students|student|name|account holder|first name|last name|family|child|student first name|student last name)$/i.test(h) ? i : -1; }).filter(function (i) { return i > -1; }); };
  const hits = function (row, nc) {
    const cells = nc && nc.length ? nc.map(function (i) { return row[i]; }) : row;
    if (one) return cells.some(function (c) { return !(c instanceof Date) && low(c) === toks[0]; });
    const txt = ' ' + cells.map(function (c) { return c instanceof Date ? '' : low(c); }).join(' | ') + ' ';
    if (txt.indexOf(low(name)) > -1) return true;
    return txt.indexOf(toks[toks.length - 1]) > -1 && fw.test(txt);
  };
  const sheets = ss.getSheets().filter(function (sh) { const n = sh.getName(); return STUCARD.tabs.test(n) && !STUCARD.skipTabs.test(n); });
  const data = sheets.map(function (sh) { const v = sh.getDataRange().getValues(); return { tab: sh.getName(), H: (v[0] || []).map(String), rows: v.slice(1) }; });
  const mobCols = function (H) { return H.map(function (h, i) { return /mobile|phone/i.test(h) && !/emergency/i.test(h) ? i : -1; }).filter(function (i) { return i > -1; }); };
  const fam = {}, found = [];
  data.forEach(function (t) {
    const mc = mobCols(t.H), nc = nameCols(t.H);
    t.rows.forEach(function (r, i) { if (hits(r, nc)) { found.push({ t: t, r: r, row: i + 2 }); mc.forEach(function (c) { const m = m9(r[c]); if (m) fam[m] = 1; }); } });
  });
  const first = toks[0], famRows = [];
  data.forEach(function (t) {
    const mc = mobCols(t.H); if (!mc.length) return;
    t.rows.forEach(function (r, i) {
      if (!mc.some(function (c) { return fam[m9(r[c])]; })) return;
      if (found.some(function (f) { return f.t === t && f.row === i + 2; })) return;
      const nc = nameCols(t.H);
      if ((nc.length ? nc.map(function (j) { return r[j]; }) : r).some(function (c) { return !(c instanceof Date) && low(c) === first; })) found.push({ t: t, r: r, row: i + 2 });
      else famRows.push({ t: t, r: r });
    });
  });
  const family = {};
  famRows.concat(found).forEach(function (f) {
    ['Student name', 'Students', 'Name'].forEach(function (h) {
      const c = f.t.H.indexOf(h); if (c < 0) return;
      String(f.r[c] || '').split(/,| and | & /).forEach(function (n) { n = n.replace(/\s+/g, ' ').trim(); if (n.length > 1 && low(n) !== low(name) && low(n) !== first && !/family$/i.test(n)) family[n.replace(/(^|[\s-])([a-z])/g, function (x) { return x.toUpperCase(); })] = 1; });
    });
  });
  const sections = {}, timeline = [];
  const facts = { name: name, school: school, contact: {} };
  found.forEach(function (f) {
    const H = f.t.H, kv = [];
    H.forEach(function (h, i) {
      if (!h || STUCARD.skipCols.test(h) || (noMoney && STUCARD.money.test(h))) return;
      const v = fmt(f.r[i]); if (!v) return;
      kv.push([h, v.slice(0, 400)]);
    });
    if (!kv.length) return;
    (sections[f.t.tab] = sections[f.t.tab] || []).push(kv);
    const get = function (h) { const i = H.indexOf(h); return i > -1 ? f.r[i] : ''; };
    if (!facts.school) facts.school = fmt(get('Location') || get('School') || get('Trains at'));
    ['Mobile', 'Email', 'Suburb'].forEach(function (h) { const v = fmt(get(h)); if (v && !facts.contact[h]) facts.contact[h] = v; });
    if (get('Parent first name') && !facts.contact.Parent) facts.contact.Parent = (fmt(get('Parent first name')) + ' ' + fmt(get('Parent last name'))).trim();
    let dh = ''; STUCARD.dated.some(function (h) { const v = get(h); if (v instanceof Date && !isNaN(v)) { dh = h; return true; } return false; });
    if (!dh) return;
    const d = get(dh), tab = f.t.tab;
    let what = tab;
    if (tab === 'Enrolments') what = 'Signed up' + (get('Package') ? ': ' + fmt(get('Package')) : ' (EFC record)') + (get('Days and times') ? ' (' + fmt(get('Days and times')).replace(/\s+/g, ' ').slice(0, 80) + ')' : '');
    else if (tab === 'EFC students') what = 'In EFC since' + (get('EFC groups') ? ' (' + fmt(get('EFC groups')) + ')' : '');
    else if (tab === 'Cancellations') what = 'Cancellation: ' + fmt(get('Status')) + (get('Reason') ? ' - ' + fmt(get('Reason')) : '') + (get('Last class') ? ', last class ' + fmt(get('Last class')) : '');
    else if (tab === 'Holds') what = 'Hold: ' + fmt(get('Status')) + (get('Freeze starts') ? ' (' + fmt(get('Freeze starts')) + ' to ' + fmt(get('Freeze ends')) + ')' : '') + (get('Reason') ? ' - ' + fmt(get('Reason')) : '');
    else if (/^History/.test(tab)) what = fmt(get('Type')) + (get('Class') ? ' ' + fmt(get('Class')) : '') + (get('Source or reason') ? ' - ' + fmt(get('Source or reason')).slice(0, 100) : '') + ' (old weekly sheet)';
    else if (tab === 'New members') what = 'Added to the new member list';
    else if (tab === 'Joining forms') what = 'Joining form submitted';
    else if (tab === 'EFC feed') what = 'EFC record created' + (get('EFC reference') ? ' (' + fmt(get('EFC reference')) + ')' : '');
    else if (tab === 'Grading EFC') what = 'Belt: ' + fmt(get('Belt')) + (get('Next belt') ? ', next ' + fmt(get('Next belt')) : '');
    else what = tab + (get('Status') ? ': ' + fmt(get('Status')) : '');
    timeline.push({ t: d.getTime(), d: Utilities.formatDate(d, tz, 'd MMM yyyy'), what: what });
  });
  timeline.sort(function (a, b) { return b.t - a.t; });
  const efc = (sections['EFC students'] || [])[0] || (sections['Grading EFC'] || [])[0];
  const gr = (sections['Grading EFC'] || [])[0];
  const pick = function (kv, h) { const x = (kv || []).filter(function (p) { return p[0] === h; })[0]; return x ? x[1] : ''; };
  if (efc) ['Reference', 'Age', 'EFC groups', 'Sessions per week', 'Classes last month', 'Last attended', 'Usual classes'].forEach(function (h) { const v = pick(efc, h); if (v) facts[h] = v; });
  if (gr) ['Belt', 'Next belt', 'Classes since belt', 'Classes needed'].forEach(function (h) { const v = pick(gr, h); if (v) facts[h] = v; });
  const cx = (sections['Cancellations'] || []).slice(-1)[0], ho = (sections['Holds'] || []).slice(-1)[0];
  if (cx) facts.Cancellation = pick(cx, 'Status') + (pick(cx, 'Last class') ? ', last class ' + pick(cx, 'Last class') : '');
  if (ho) facts.Hold = pick(ho, 'Status') + (pick(ho, 'Freeze ends') ? ', back ' + pick(ho, 'Freeze ends') : '');
  const order = ['Enrolments', 'EFC students', 'Grading EFC', 'Holds', 'Cancellations', 'Joining forms', 'EFC feed', 'New members'];
  const secList = Object.keys(sections).sort(function (a, b) { const ia = order.indexOf(a), ib = order.indexOf(b); return (ia < 0 ? 50 : ia) - (ib < 0 ? 50 : ib) || a.localeCompare(b); })
    .map(function (k) { return { tab: k, rows: sections[k].slice(-6) }; });
  return { ok: true, name: name, facts: facts, timeline: timeline.slice(0, 40), sections: secList, family: Object.keys(family).slice(0, 12), noMoney: noMoney,
