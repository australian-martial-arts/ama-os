function absActionRaw_(body, who) {
  const R = absSheet_(), C = R.C;
  const rows = String(body.rows || '').split(',').map(Number).filter(function (n) { return n > 1 && n <= R.sh.getLastRow(); });
  if (!rows.length) return { ok: false, error: 'Nothing to update. Refresh and try again.' };
  const act = String(body.act || ''), note = String(body.note || '').trim().slice(0, 300), stamp = Utilities.formatDate(new Date(), CONFIG.timezone, 'd MMM');
  const reason = ABS.reasons.filter(function (x) { return x.k === body.reason; })[0];
  const save = ABS.saves.indexOf(String(body.save || '')) > -1 ? String(body.save) : '';
  const stage = ABS.stages.filter(function (x) { return x.k === body.stage; })[0];
  if (hubIsInstr_(who) && ['video', 'seen'].indexOf(act) < 0) return { ok: false, error: 'Not available on the instructor view.' };
  let st = null, out = '', logText = '', stageDone = stage ? stage.k : '', retDate = '';
  if (act === 'noanswer') { st = ''; logText = 'No answer'; }
  else if (act === 'video') { st = ''; logText = 'Video sent'; stageDone = 'video'; }
  else if (act === 'seen') { st = 'Closed'; out = 'Back (seen in class)'; logText = 'Seen back in class'; }
  else if (act === 'callback') {
    const d = absDate_(body.date); if (!d) return { ok: false, error: 'Pick the call-back date first.' };
    st = 'Call back ' + absYmd_(d); logText = 'Call back ' + Utilities.formatDate(d, CONFIG.timezone, 'd MMM'); stageDone = '';
  } else if (act === 'booked') {
    const d = absDate_(body.date); if (!d) return { ok: false, error: 'Pick the day of their return class first.' };
    if (!reason) return { ok: false, error: 'Pick why they stopped coming first.' };
    st = 'Return booked ' + absYmd_(d); retDate = absYmd_(d); logText = 'Return class booked ' + Utilities.formatDate(d, CONFIG.timezone, 'EEE d MMM');
  } else if (act === 'came') { st = 'Closed'; out = 'Back (return class)'; logText = 'Came to their return class'; }
  else if (act === 'nocame') { st = 'Call back ' + absYmd_(new Date()); logText = 'Did not come to the return class'; stageDone = ''; }
  else if (act === 'close') { st = 'Closed'; out = 'No response'; logText = 'Closed: no response'; }
  else if (act === 'fixed') {
    rows.forEach(function (r) { R.sh.getRange(r, C['Status'] + 1).setValue('EFC fixed ' + absYmd_(new Date()) + ' by ' + who.name); });
    return { ok: true };
  } else {
    const o = ABS.outcomes.filter(function (x) { return x.k === act; })[0];
    if (!o) return { ok: false, error: 'Unknown action' };
    if (o.k === 'other' && !note) return { ok: false, error: 'Write what happened in the notes box first.' };
    if ((o.k === 'hold' || o.k === 'cancel') && !reason) return { ok: false, error: 'Pick why they stopped coming first.' };
    st = 'Closed'; out = o.efc ? 'EFC record wrong' : o.t; logText = o.t;
  }
  const line = stamp + ' ' + who.name + ': ' + logText + (reason ? ' (' + reason.t + ')' : '') + (save ? ' [offered: ' + save + ']' : '') + (note ? ' - ' + note : '');
  rows.forEach(function (r) {
    const cur = String(R.sh.getRange(r, C['Notes'] + 1).getValue() || '');
    R.sh.getRange(r, C['Notes'] + 1).setValue(cur + ' | ' + line);
    if (st !== null) R.sh.getRange(r, C['Status'] + 1).setValue(st);
    R.sh.getRange(r, C['Handled by'] + 1).setValue(who.name);
    if (out) R.sh.getRange(r, C['Outcome'] + 1).setValue(out);
    if (stageDone) R.sh.getRange(r, C['Stage done'] + 1).setValue(stageDone);
    if (reason) R.sh.getRange(r, C['Reason'] + 1).setValue(reason.t);
    if (retDate) R.sh.getRange(r, C['Return date'] + 1).setValue(retDate);
  });
  if (act === 'noanswer' || act === 'booked') {
    try {
      const fx = absFamilyByRows_(body.rows);
      if (fx) {
        const res = absSendTo_(fx, act, { day: retDate ? Utilities.formatDate(absDate_(retDate), CONFIG.timezone, 'EEEE d MMM') : '' });
        absLogRows_(body.rows, (act === 'noanswer' ? 'No-answer' : 'Booking confirmation') + ' text ' + res);
      }
    } catch (e) { Logger.log('abs text: ' + e); }
  }
  return { ok: true };
}

