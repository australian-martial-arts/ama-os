function auditOverlaps() {
  const props = PropertiesService.getScriptProperties();
  const plan = JSON.parse(props.getProperty('ASSIGN_PLAN'));
  const map = JSON.parse(props.getProperty('USER_MAP'));
  const done = JSON.parse(props.getProperty('REASSIGN_DONE') || '{}');
  const DAYIDX = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };

  const start = new Date().getTime();
  let ok = 0, skipped = 0, failed = 0;

  for (let i = 0; i < plan.length; i++) {
    if (new Date().getTime() - start > 280000) { Logger.log('*** time limit - run again to continue ***'); break; }

    const p = plan[i];
    if (done[p.id]) { continue; }
    if (p.user.indexOf('no slots') > -1) { skipped++; done[p.id] = 'skipped-noslots'; continue; }

    const userId = map[p.user];
    if (!userId) { Logger.log('NO USER for ' + p.user + '  (' + p.name + ')'); failed++; continue; }

    let detail;
    try { const d = ghlFetch_('/calendars/' + p.id, {}); detail = d.calendar || d; }
    catch (e) { Logger.log('GET failed ' + p.name); failed++; continue; }

    const tm = (detail.teamMembers && detail.teamMembers[0]) || {};
    tm.userId = userId;
    tm.priority = 0.5;
    tm.selected = true;
    tm.isPrimary = true;

    const oh = [];
    Object.keys(p.days).forEach(function (dayName) {
      const idx = DAYIDX[dayName];
      p.days[dayName].forEach(function (iv) {
        oh.push({ daysOfTheWeek: [idx], hours: [{
          openHour: Math.floor(iv[0] / 60), openMinute: iv[0] % 60,
          closeHour: Math.floor(iv[1] / 60), closeMinute: iv[1] % 60
        }]});
      });
    });

    const body = {
      teamMembers: [tm],
      openHours: oh,
      slotInterval: detail.slotDuration,
      slotIntervalUnit: detail.slotDurationUnit
    };

    const r = ghlPut_('/calendars/' + p.id, body);
    if (r.code >= 200 && r.code < 300) {
      ok++; done[p.id] = p.user;
      Logger.log('OK   ' + p.user + '   ' + p.name.replace('Book a Trial | ', ''));
    } else {
      failed++;
      Logger.log('FAIL ' + r.code + '  ' + p.name + '  ' + r.body.slice(0, 160));
    }
  }

  props.setProperty('REASSIGN_DONE', JSON.stringify(done));
  Logger.log('');
  Logger.log('reassigned ' + ok + ' | skipped ' + skipped + ' | failed ' + failed +
             '  |  total recorded ' + Object.keys(done).length + ' of ' + plan.length);
}


