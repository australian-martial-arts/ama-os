// Email catcher: copy attachments (e.g. medical certificates) into GHL with the email, so they sit on the family's profile.
function mailInAttach_(m, conv, cid) {
  const urls = [];
  let atts = [];
  try { atts = m.getAttachments({ includeInlineImages: false }) || []; } catch (e) { return urls; }
  atts.slice(0, 5).forEach(function (a) {
    try {
      if (a.getSize() > 10 * 1024 * 1024) { Logger.log('mailIn attach too big: ' + a.getName()); return; }
      const res = UF_.fetch(CONFIG.ghlBase + '/conversations/messages/upload', { method: 'post', muteHttpExceptions: true,
        headers: { 'Authorization': 'Bearer ' + getToken_(), 'Version': CONFIG.ghlVersion, 'Accept': 'application/json' },
        payload: { conversationId: conv, locationId: CONFIG.locationId, contactId: cid, fileAttachment: a.copyBlob().setName(a.getName()) } });
      const code = res.getResponseCode(), body = res.getContentText();
      if (code >= 300) { Logger.log('mailIn upload ' + code + ': ' + body.slice(0, 300)); return; }
      const j = JSON.parse(body), up = j.uploadedFiles || {};
      Object.keys(up).forEach(function (k) { if (up[k]) urls.push(up[k]); });
    } catch (e) { Logger.log('mailIn attach: ' + e); }
  });
  return urls;
}
function mailInAttachNote_(m) {
  try { const n = (m.getAttachments({ includeInlineImages: false }) || []).map(function (a) { return a.getName(); }); return n.length ? '<p><i>Attachments: ' + n.join(', ') + '</i></p>' : ''; } catch (e) { return ''; }
}

// Absentee cards: staff reply to a family's text straight from the hub (sent by SMS through GHL, shows in Conversations).
function absTextReplyRaw_(who, b) {
  const text = String(b.text || '').trim();
  if (!text) return { ok: false, error: 'Type a message first.' };
  if (text.length > 600) return { ok: false, error: 'Keep it under 600 characters.' };
  const fam = (absFamilies_().items || []).filter(function (x) { return String(x.rows) === String(b.rows || ''); })[0];
  if (!fam || !fam.e164) return { ok: false, error: 'Could not find this family. Refresh and try again.' };
  const p = PropertiesService.getScriptProperties();
  let cid = p.getProperty('abscid_' + fam.e164) || '';
  if (!cid) { try { cid = ghlContactIdByPhone_(fam.e164) || ''; } catch (e) { } }
  if (!cid) return { ok: false, error: 'This family is not in GHL yet, so the text could not be sent.' };
  try { ghlSend_('post', '/conversations/messages', { type: 'SMS', contactId: cid, message: text }); }
  catch (e) { return { ok: false, error: 'Not sent: ' + String(e).slice(0, 120) }; }
  Logger.log('abstext ' + fam.parent + ' by ' + (who && who.name));
  return { ok: true };
}



