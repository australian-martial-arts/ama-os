// Fixed send time for a location (HH:mm today, Sydney time), or null.
function tcFixedAt_(day, loc) {
  let t = (TRIALCHECK.sendAt || {})[loc];
  if (t && typeof t === 'object') t = t[Utilities.formatDate(day, CONFIG.timezone, 'EEE')];
  const m = String(t || '').match(/^(\d{1,2}):(\d{2})$/);
  if (!m) return null;
  const d = hubStartOfDay_(day); d.setHours(+m[1], +m[2], 0, 0);
  return d.getTime();
}

// Run once (as info@) to start the after-trial texts: checks every 15 minutes.
function installTrialCheckTrigger() {
  // Every 5 minutes so fixed times (e.g. 8:00 pm) go out on time. Replaces any existing sendTrialChecks trigger.
  ScriptApp.getProjectTriggers().filter(function (t) { return t.getHandlerFunction() === 'sendTrialChecks'; })
    .forEach(function (t) { ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('sendTrialChecks').timeBased().everyMinutes(5).create();
