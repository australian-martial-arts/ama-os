  sh.getRange(row, partyCol_('Updated')).setValue(new Date()); sh.getRange(row, partyCol_('Updated by')).setValue((who && who.name) || 'Hub');
}
function partyYmd_(d) { return Utilities.formatDate(d instanceof Date ? d : new Date(d), CONFIG.timezone, 'yyyy-MM-dd'); }
function partyCell_(v) { return v instanceof Date ? partyYmd_(v) : String(v || ''); }
function partyHm_(v) { if (v instanceof Date) return Utilities.formatDate(v, CONFIG.timezone, 'HH:mm'); const m = String(v || '').match(/(\d{1,2}):(\d{2})/); return m ? ('0' + m[1]).slice(-2) + ':' + m[2] : ''; }
function partyMin_(hm) { const p = String(hm).split(':'); return (+p[0]) * 60 + (+p[1] || 0); }
function partyHmOf_(min) { return ('0' + Math.floor(min / 60)).slice(-2) + ':' + ('0' + (min % 60)).slice(-2); }
