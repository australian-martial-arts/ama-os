    const d = new Date(start.getTime() + i * 864e5), dow = +Utilities.formatDate(d, CONFIG.timezone, 'u') % 7, ymd = partyYmd_(d);
    Object.keys(PARTY.days).forEach(function (school) { const c = PARTY.days[school][dow]; if (c) out.push({ date: ymd, school: school, period: c.period, cfg: c }); });
