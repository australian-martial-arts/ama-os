  if (body.kind === 'efcatt') return efcAttRoute_(who, body);
  if (body.kind === 'efcuse') return efcUseRoute_(who, body); // 10 Nov 2026: enrolled vs paying vs attending // 10 Nov 2026: Add missed class (EFC bookings + check-in)
  if (body.kind === 'bbcallout') return bbCallOut_(body, who);
  if (body.kind === 'cxlookup') return cxLookup_(body);
  if (body.kind === 'cancel') return cxSubmit_(body, who);
  if (body.kind === 'cxlist') return cxList_();
  if (body.kind === 'cxsent') return cxSent_(); // 24 Nov 2026: sent cancellation forms history
  if (body.kind === 'cxaction') return cxAction_(body, who);
  if (body.kind === 'reclog') return recLog_(body, who); // from /staff-recommend
  if (body.kind && body.kind !== 'hold') return { ok: false, error: 'Unknown request' };
  // 29 Oct (Mark): use the staff name picked on the form (shared front desk logins); fall back to the signed-in person.
  const picked = String(body.staff || '').trim();
  let okPick = false; try { okPick = !!(picked && hubStaffMobile_(picked)); } catch (e) {}
  body.staff = okPick ? picked : who.name;
  if (okPick && picked.split(' ')[0].toLowerCase() !== String(who.name).split(' ')[0].toLowerCase()) body.staffNotes = ((body.staffNotes || body.staff_notes || '') + ' (submitted on ' + who.name + "'s login)").trim();
  return holdHandleRequest_(body);
}


// =====================================================================
// AMA ADMIN HUB - DASHBOARD DATA  (added 23 Oct 2026)
// Called from the /admin page (signed-in staff only, via hubRoute_).
// Results are cached for 5 minutes so the page is quick and GHL is not hammered.
//  - Enrolments: Enrolments tab (written by GHL)
//  - Holds: Holds tab (ZZ test rows ignored)
//  - Cancellations: Cancellations tab, once the cancellation form exists
//  - Trials booked / upcoming trials: GHL trial calendars (same as the trial SMS)
//  - Enquiries: GHL "Enquiries" pipeline - needs the GHL key to have
//    opportunities read access; shows as unavailable until then
//  - Student counts: starting number per school on the "Student counts" tab,
//    plus enrolments since, minus cancellations since. Retype the number and
//    the date whenever you check EFC (the monthly true-up).
// =====================================================================
const HUBDASH = {
  locations: ['Marrickville', 'Concord', 'Sydenham', 'Auburn', 'Sylvania'],
  countsTab: 'Student counts',
  countsHeaders: ['School', 'Students (from EFC)', 'Correct as of', 'Updated by', 'Notes'],
  cancelTab: 'Cancellations',
  enrolTab: 'Enrolments',
  cacheKey: 'hubdash_v1',
  cacheSecs: 60,
  trialDaysAhead: 7,
  bookedWindowDays: 60
};

function setupStudentCounts() {
  const ss = SpreadsheetApp.openById(HOLD.sheetId);
  let sh = ss.getSheetByName(HUBDASH.countsTab);
  if (!sh) sh = ss.insertSheet(HUBDASH.countsTab);
  sh.getRange(1, 1, 1, HUBDASH.countsHeaders.length).setValues([HUBDASH.countsHeaders]).setFontWeight('bold').setBackground('#0d1511').setFontColor('#ffd200');
  sh.setFrozenRows(1);
  if (sh.getLastRow() < 2) {
    sh.getRange(2, 1, HUBDASH.locations.length, 5).setValues(HUBDASH.locations.map(function (l) {
      return [l, '', '', '', 'Type the EFC number and the date it was correct. Retype both monthly.'];
    }));
  }
  sh.getRange('C2:C').setNumberFormat('d mmm yyyy');
  sh.setColumnWidth(5, 420);
  Logger.log('Student counts tab ready');
  return 'ok';
}

function hubDashRefresh() { CacheService.getScriptCache().remove(HUBDASH.cacheKey); Logger.log('Dashboard cache cleared'); }

function hubDay_(v) {
  if (!v) return null;
  if (Object.prototype.toString.call(v) === '[object Date]') return isNaN(v) ? null : v;
  const s = String(v).trim();
  let m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
  if (m) return new Date(+m[3], +m[2] - 1, +m[1]);
  m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (m) return new Date(+m[1], +m[2] - 1, +m[3]);
  const d = new Date(s);
  return isNaN(d) ? null : d;
}
function hubStartOfDay_(d) { const x = new Date(d); x.setHours(0, 0, 0, 0); return x; }
function hubIsTest_(s) { return /^\s*zz\b|\btest\b/i.test(String(s || '')); } // 'zz ...' or the word 'test' marks a practice entry
function hubShort_(full) {
  const p = String(full || '').trim().split(/\s+/).filter(Boolean);
  if (!p.length) return '';
  return p.length === 1 ? p[0] : p[0] + ' ' + p[p.length - 1].charAt(0).toUpperCase() + '.';
}
function hubZero_() { const o = {}; HUBDASH.locations.forEach(function (l) { o[l] = 0; }); return o; }
function hubRows_(ss, tab) {
  const sh = ss.getSheetByName(tab);
  if (!sh || sh.getLastRow() < 2) return { exists: !!sh, head: [], rows: [] };
  const v = sh.getRange(1, 1, sh.getLastRow(), sh.getLastColumn()).getValues();
  return { exists: true, head: v[0].map(function (h) { return String(h).trim(); }), rows: v.slice(1) };
}

function hubDashboardRaw_(who) {
  const cache = CacheService.getScriptCache();
  const hit = cache.get(HUBDASH.cacheKey);
  if (hit) { const c = JSON.parse(hit); c.cached = true; return c; }

  const tz = CONFIG.timezone, now = new Date();
  const weekStart = new Date(hubStartOfDay_(now).getTime() - 6 * 86400000);
  const ss = SpreadsheetApp.openById(HOLD.sheetId);
  const out = {
    ok: true, generated: now.getTime(),
    generatedText: Utilities.formatDate(now, tz, 'EEE d MMM, h:mm a'),
    weekText: Utilities.formatDate(weekStart, tz, 'd MMM') + ' - ' + Utilities.formatDate(now, tz, 'd MMM'),
    locations: HUBDASH.locations,
    week: {}, students: {}, trials: [], notes: []
  };

  // Enrolments - last 7 days, and all dates (for student counts)
  const enr = hubRows_(ss, HUBDASH.enrolTab);
  const eDate = enr.head.indexOf('Enrolled date'), eLoc = enr.head.indexOf('Location'), eName = enr.head.indexOf('Student name');
  const enrolWeek = hubZero_(), enrolList = [];
  enr.rows = hubEnrolDedupeRows_(enr); // 26 Oct: joining-form row + EFC row = one student
  enr.rows.forEach(function (r) {
    const d = hubDay_(r[eDate]), loc = String(r[eLoc] || '').trim();
    if (!d || HUBDASH.locations.indexOf(loc) < 0 || hubIsTest_(r[eName])) return;
    enrolList.push({ d: d, loc: loc });
    if (d >= weekStart) enrolWeek[loc]++;
  });
  out.week.enrolments = { byLoc: enrolWeek, total: hubSum_(enrolWeek) };

  // Holds - last 7 days (saves counted separately)
  const hol = hubRows_(ss, HOLD.tab);
  const hLog = hol.head.indexOf('Logged at'), hStat = hol.head.indexOf('Status'), hLoc = hol.head.indexOf('Trains at'), hWho = hol.head.indexOf('Account holder');
  const holdWeek = hubZero_(); let saves = 0, waiting = 0;
  hol.rows.forEach(function (r) {
    if (hubIsTest_(r[hWho])) return;
    const d = hubDay_(r[hLog]), st = String(r[hStat] || ''), loc = String(r[hLoc] || '').trim();
    if (st === 'awaiting approval') waiting++;
    if (!d || d < weekStart) return;
    if (st.indexOf('no freeze needed') === 0) { saves++; return; }
    if (st === 'declined' || st === 'awaiting approval') return; // only approved freezes count; waiting ones show separately
    if (holdWeek[loc] !== undefined && !(hol.head.indexOf('Extends') > -1 && r[hol.head.indexOf('Extends')])) holdWeek[loc]++;
  });
  const histW = hubHistWeek_(weekStart); // changeover: holds and stops still logged the old way (Start/Stop/Hold sheet) before the hub took over
  Object.keys(histW.Hold).forEach(function (l) { if (holdWeek[l] !== undefined) holdWeek[l] += histW.Hold[l]; });
  out.week.holds = { byLoc: holdWeek, total: hubSum_(holdWeek), saves: saves, waiting: waiting };

  // Cancellations - last 7 days, and all (for student counts)
  const can = hubRows_(ss, HUBDASH.cancelTab);
  const cancelWeek = hubZero_(), cancelList = []; let cxSaves = 0;
  if (can.exists) {
    const cLog = can.head.indexOf('Logged at'), cLoc = can.head.indexOf('Trains at'), cWho = can.head.indexOf('Account holder');
    const cStat = can.head.indexOf('Status'), cLast = can.head.indexOf('Last class'), cN = can.head.indexOf('Student count');
    can.rows.forEach(function (r) {
      if (hubIsTest_(r[cWho])) return;
      const st = String(r[cStat] || '');
      if (/^saved/i.test(st)) { const sd = hubDay_(r[cLog]); if (sd && sd >= weekStart) cxSaves++; }
      if (/withdrawn|saved|stayed|^duplicate/i.test(st)) return;
      const d = hubDay_(r[cLog]), loc = String(r[cLoc] || '').trim();
      if (!d || HUBDASH.locations.indexOf(loc) < 0) return;
      const n = cN > -1 ? (Number(r[cN]) || 1) : 1;
      for (let k = 0; k < n; k++) cancelList.push({ d: hubDay_(r[cLast]) || d, loc: loc });
      if (d >= weekStart) cancelWeek[loc] += n;
    });
    Object.keys(histW.Stop).forEach(function (l) { if (cancelWeek[l] !== undefined) cancelWeek[l] += histW.Stop[l]; });
    out.week.cancellations = { byLoc: cancelWeek, total: hubSum_(cancelWeek), saves: cxSaves };
  } else {
    out.week.cancellations = { byLoc: cancelWeek, total: 0, pending: true };
  }

  // Student counts
  const cnt = hubRows_(ss, HUBDASH.countsTab);
  let studentTotal = 0, studentKnown = 0;
  HUBDASH.locations.forEach(function (loc) {
    const row = cnt.rows.filter(function (r) { return String(r[0]).trim() === loc; })[0];
    const base = row && row[1] !== '' && row[1] !== null ? Number(row[1]) : null;
    const asOf = row ? hubDay_(row[2]) : null;
    if (base === null || isNaN(base) || !asOf) { out.students[loc] = { count: null }; return; }
    const since = hubStartOfDay_(asOf).getTime() + 86400000;
    const plus = enrolList.filter(function (e) { return e.loc === loc && e.d.getTime() >= since; }).length;
    const minus = cancelList.filter(function (c) { return c.loc === loc && c.d.getTime() >= since; }).length;
    const n = base + plus - minus;
    out.students[loc] = { count: n, base: base, asOf: Utilities.formatDate(asOf, tz, 'd MMM yyyy'), plus: plus, minus: minus };
    studentTotal += n; studentKnown++;
  });
  out.studentsTotal = studentKnown ? studentTotal : null;
  out.studentsComplete = studentKnown === HUBDASH.locations.length;

  // Trials: booked in the last 7 days, and the rolling next 7 days
  const bookedWeek = hubZero_();
  const aheadEnd = new Date(hubStartOfDay_(now).getTime() + (HUBDASH.trialDaysAhead + 1) * 86400000);
  const sctx = tcStatusCtx_();
  try {
    const groups = ghlGroups_();
    const windowEnd = new Date(now.getTime() + HUBDASH.bookedWindowDays * 86400000);
    HUBDASH.locations.forEach(function (loc) {
      if (!CONFIG.locations[loc]) return;
      eventsForLocation_(loc, groups, weekStart, windowEnd).forEach(function (e) {
        const added = e.dateAdded ? new Date(e.dateAdded) : null;
        if (added && added >= weekStart) bookedWeek[loc]++;
        const st = new Date(e.startTime);
        if (st >= weekStart && st < aheadEnd) {
          const c = ghlContact_(e.contactId), cf = (c && c.cf) || {};
          const kids = (tbTitleKids_(e).length ? tbTitleKids_(e) : [cf.student_1, cf.student_2].filter(Boolean)).map(hubShort_);
          out.trials.push({
            t: st.getTime(), id: e.id, cid: e.contactId || '', src: hubTbIds_()[e.id] || 'online',
            day: Utilities.formatDate(st, tz, 'EEE d MMM'),
            time: Utilities.formatDate(st, tz, 'h:mm a').toLowerCase(),
            loc: loc,
            who: kids.length ? kids.join(' & ') : hubShort_(c ? c.name : '') + ' (parent)',
            cls: classOf_(e),
            num: tcTrialLabel_(e.contactId, tcYmd_(st)),
            past: st < now,
            status: tcStatus_(sctx, e, c, st.getTime() + 45 * 60000 < now.getTime())
          });
        }
      });
    });
    // Walk-ins: recommendations logged from /staff-recommend with no trial booked (Event IDs start with W).
    try {
      Object.keys(sctx.fu || {}).forEach(function (id) {
        if (id.charAt(0) !== 'W') return;
        const v = sctx.fu[id].v, C = sctx.C;
        const at = v[C['Reported at']] ? new Date(v[C['Reported at']]) : tcParseYmd_(String(v[C['Trial date']]));
        if (!at || at < weekStart || at >= aheadEnd) return;
        const cid = String(v[C['Contact ID']] || '');
        out.trials.push({ t: at.getTime(), day: Utilities.formatDate(at, tz, 'EEE d MMM'), time: Utilities.formatDate(at, tz, 'h:mm a').toLowerCase(),
          loc: String(v[C['Location']] || ''), who: String(v[C['Child']] || '') || String(v[C['Parent']] || ''), cls: 'Walk-in (no trial booked)', past: true,
          status: sctx.enrolled[cid] ? 'Enrolled' : 'Rec sent', walkin: true, num: tcTrialLabel_(cid, tcYmd_(at)) });
      });
    } catch (e) { Logger.log('walk-ins: ' + e); }
    out.trials.sort(function (a, b) { return a.t - b.t; });
    out.week.trialsBooked = { byLoc: bookedWeek, total: hubSum_(bookedWeek) };
  } catch (err) {
    out.week.trialsBooked = { byLoc: bookedWeek, total: null };
    out.notes.push('Trials could not be read from GHL just now.');
    Logger.log('hubDashboard_ trials: ' + err);
  }

  // Enquiries (needs opportunities read access on the GHL key)
  out.week.enquiries = hubEnquiries_(weekStart);

  cache.put(HUBDASH.cacheKey, JSON.stringify(out), HUBDASH.cacheSecs);
  return out;
}

function hubSum_(o) { return Object.keys(o).reduce(function (a, k) { return a + (o[k] || 0); }, 0); }

function hubEnquiries_(weekStart) {
  try {
    const p = ghlFetch_('/opportunities/pipelines', { locationId: CONFIG.locationId });
    const pipe = (p.pipelines || []).filter(function (x) { return /enquir/i.test(x.name); })[0];
    if (!pipe) return { total: null, note: 'No pipeline with "Enquiries" in its name.' };
    let total = 0, params = { location_id: CONFIG.locationId, pipeline_id: pipe.id, limit: 100 };
    for (let page = 0; page < 10; page++) {
      const r = ghlFetch_('/opportunities/search', params);
      const ops = r.opportunities || [];
      let older = false;
      ops.forEach(function (o) {
        const d = new Date(o.createdAt || o.dateAdded || 0);
        if (d >= weekStart) total++; else older = true;
      });
      const meta = r.meta || {};
      if (older || !ops.length || !meta.startAfterId) break;
      params = { location_id: CONFIG.locationId, pipeline_id: pipe.id, limit: 100, startAfter: meta.startAfter, startAfterId: meta.startAfterId };
    }
    return { total: total, pipeline: pipe.name };
  } catch (err) {
    return { total: null, needsAccess: /401|scope/i.test(String(err)), note: 'GHL key cannot read pipelines yet.' };
  }
}

