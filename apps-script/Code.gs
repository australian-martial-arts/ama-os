// Short joining link: join-page?c=<GHL contact id>. The join page posts {kind:'joindata', c} and reloads itself with the
// full details, so the text message carries a short link and no personal details, and dates of birth arrive in a format
// the form understands.
function chaseDob_(v) {
  if (v == null || v === '') return '';
  const s = String(v);
  if (/^\d{4}-\d\d-\d\d/.test(s)) return s.slice(0, 10);
  const d = /^\d{9,}$/.test(s) ? new Date(Number(s)) : new Date(s);
  return isNaN(d) ? '' : Utilities.formatDate(d, CONFIG.timezone, 'yyyy-MM-dd');
}
function chaseJoinData_(b) {
  const cid = String(b.c || '');
  if (!/^[A-Za-z0-9]{12,40}$/.test(cid)) return { ok: false, error: 'This link is not complete. Reply to our text and we will send it again.' };
  let x; try { x = chaseContact_(cid); } catch (e) { return { ok: false, error: 'This link is not complete. Reply to our text and we will send it again.' }; }
  const c = x.c, F = CHASE.f, params = String(x.f[F.params] || '');
  if (!params) return { ok: false, error: 'This joining link has expired. Reply to our text and we will send you a new one.' };
  const e = function (s) { return encodeURIComponent(String(s == null ? '' : s)); };
  let q = params + '&first_name=' + e(c.firstName) + '&last_name=' + e(c.lastName) + '&email=' + e(c.email) + '&phone=' + e(c.phone);
  [['address', c.address1], ['city', c.city], ['state', c.state], ['postal_code', c.postalCode]].forEach(function (p) { if (p[1]) q += '&' + p[0] + '=' + e(p[1]); });
  // Everything else the family has already told us, by GHL field key: dates of birth for every student, medical, emergency contact, how they heard, days and times.
  let keys = {}; try { keys = chaseFieldKeys_(); } catch (err) { }
  Object.keys(x.f).forEach(function (id) {
    const k = keys[id] || '', v = x.f[id];
    if (v == null || v === '' || (Array.isArray(v) && !v.length)) return;
    if (/^student_\d_date_of_birth$/.test(k)) { const d = chaseDob_(v); if (d) q += '&' + k + '=' + e(d); return; }
    if (CHASE.prefill.indexOf(id) >= 0 && k) q += '&' + k + '=' + e(Array.isArray(v) ? v.join(', ') : v);
  });
  if (!/student_1_date_of_birth=/.test(q) && x.f[F.dob1]) q += '&student_1_date_of_birth=' + e(chaseDob_(x.f[F.dob1]));
  return { ok: true, q: q, first: c.firstName || '' };
}
