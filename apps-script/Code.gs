// 16 Nov 2026 (Mark): live attendance groups a mixed class by program (Dragons, then Ninjas...), using the EFC group, else age.
function liveAttProg_(a) {
  const g = String((a && a.g) || '');
  if (/little\s*dragon/i.test(g)) return 'Little Dragons';
  if (/ninja/i.test(g)) return 'Ninjas';
  if (/dragon/i.test(g)) return 'Dragons';
  if (/teen/i.test(g)) return 'Teens';
  if (/adult/i.test(g)) return 'Adults';
  if (/family/i.test(g)) return 'Family';
  const age = Number(a && a.a);
  if (!(age > 0)) return '';
  return age < 6 ? 'Little Dragons' : age < 9 ? 'Dragons' : age < 13 ? 'Ninjas' : age < 18 ? 'Teens' : 'Adults';
}





