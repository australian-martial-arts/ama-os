      [[p.Host, 'host']].concat(String(p.Assistants || '').split(',').map(function (n) { return [n.trim(), 'assistant']; })).forEach(function (a) {
        const n = String(a[0] || '').trim(), key = 's:' + n.toLowerCase() + ':' + ymd + ':' + partyHm_(p.Start);
        if (!n || sent[key]) return;
