function absSheet_() {
  const sh = SpreadsheetApp.openById(HOLD.sheetId).getSheetByName(ABS.tab);
  if (!sh) throw new Error('Absentees tab not found');
  let head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(function (h) { return String(h).trim(); });
  const add = ABS.extraHeaders.filter(function (h) { return head.indexOf(h) < 0; });
  if (add.length) { sh.getRange(1, head.length + 1, 1, add.length).setValues([add]).setFontWeight('bold'); head = head.concat(add); }
  const C = {}; head.forEach(function (h, i) { C[h] = i; });
  ['Received at', 'First name', 'Last name', 'Mobile', 'Email', 'School', 'Last attended', 'Days absent', 'EFC member ID', 'Status', 'Handled by', 'Outcome', 'Notes'].forEach(function (h) {
    if (C[h] === undefined) throw new Error('Absentees tab is missing the column: ' + h);
  });
  return { sh: sh, C: C, n: head.length };
}
function absYmd_(d) { return Utilities.formatDate(d, CONFIG.timezone, 'yyyy-MM-dd'); }
function absDate_(v) {
  if (v instanceof Date) return v;
  const s = String(v || '').trim(); if (!s) return null;
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(s); if (m) return new Date(+m[1], +m[2] - 1, +m[3]);
  const d = new Date(s); return isNaN(d) ? null : d;
}
function absParent_(notes) {
  const m = /Parent:\s*([^|]*)/i.exec(String(notes || ''));
  let p = m ? m[1].trim() : '';
  if (p && p.indexOf(' ') < 0) p = p.replace(/([a-z])([A-Z])/g, '$1 $2');
  return p;
}
function absLog_(notes) { const s = String(notes || ''), i = s.indexOf(' | '); return i > -1 ? s.slice(i + 3) : ''; }
function absStageIdx_(k) { for (let i = 0; i < ABS.stages.length; i++) if (ABS.stages[i].k === k) return i; return -1; }
function absStageAt_(days) { let s = -1; ABS.stages.forEach(function (x, i) { if (days >= x.d) s = i; }); return s; }
// Holds, cancellations: pause the absentee stages for these families (26 Oct 2026).
function absPauseMaps_(today) {
  const ss = SpreadsheetApp.openById(HOLD.sheetId), out = { hold: {}, cx: {} };
  const fmt = function (d) { return Utilities.formatDate(d, CONFIG.timezone, 'd MMM'); };
  try {
    const h = hubRows_(ss, 'Holds'), H = {}; h.head.forEach(function (x, i) { H[x] = i; });
    h.rows.forEach(function (r) {
      const st = String(r[H['Status']] || '');
      if (/declin|withdrawn|^saved|cancel|test/i.test(st)) return;
      const m = holdLast9_(String(r[H['Mobile']] || '')); if (m.length !== 9) return;
      const start = absDate_(r[H['Freeze starts']]), end = absDate_(r[H['Resumed at']]) || absDate_(r[H['Freeze ends']]);
      const active = !end || hubStartOfDay_(end) >= today;
      const text = /await/i.test(st) ? 'Hold requested (' + st + ')' : start && start > today ? 'Hold starts ' + fmt(start) + (end ? ', until ' + fmt(end) : '') : 'On hold' + (end ? ' until ' + fmt(end) : '');
      const prev = out.hold[m];
      if (!prev || (end && (!prev.end || end > prev.end))) out.hold[m] = { active: active, end: end ? hubStartOfDay_(end) : null, text: text };
    });
  } catch (e) { Logger.log('abs holds: ' + e); }
  try {
    const c = hubRows_(ss, 'Cancellations'), X = {}; c.head.forEach(function (x, i) { X[x] = i; });
    c.rows.forEach(function (r) {
      const st = String(r[X['Status']] || '');
      if (/test|withdrawn|^saved|declin/i.test(st)) return;
      const m = holdLast9_(String(r[X['Mobile']] || '')); if (m.length !== 9) return;
      const last = absDate_(r[X['Last class']]) || absDate_(r[X['Notice ends']]);
      out.cx[m] = { gone: !!(last && hubStartOfDay_(last) < today), text: 'Cancelling (' + st + ')' + (last ? ', last class ' + fmt(last) : '') };
    });
  } catch (e) { Logger.log('abs cancellations: ' + e); }
  return out;
}

// Reads the tab, closes duplicates and members who have come back, and returns one item per open family.
function absFamilies_() {
  const R = absSheet_(), C = R.C, last = R.sh.getLastRow();
  const rows = last > 1 ? R.sh.getRange(2, 1, last - 1, R.n).getValues() : [];
  const today = hubStartOfDay_(new Date()), DAY = 86400000, writes = [];
  const silenced = {}, fixes = [], recentBack = [];
  const P = absPauseMaps_(today);
  const lastKey = function (v) { const d = absDate_(v[C['Last attended']]); return d ? absYmd_(d) : ''; };
  // 1) EFC-record-wrong silencing, the clean-up list, and who already has a 14-day alert
  const has14 = {};
  rows.forEach(function (v, i) {
    const id = String(v[C['EFC member ID']] || '').trim(), out = String(v[C['Outcome']] || ''), st = String(v[C['Status']] || '');
    const rec = absDate_(v[C['Received at']]);
    if (id && (String(v[C['Days absent']]).trim() === '14' || (rec && rec < ABS.fourteenFrom))) has14[id + '|' + lastKey(v)] = 1;
    if (out === 'EFC record wrong' && id) {
      const at = rec || today;
      if (!/^EFC fixed/i.test(st) && (today - at) / DAY < ABS.silenceDays) silenced[id] = 1;
      if (!/^EFC fixed/i.test(st)) fixes.push({ row: i + 2, name: (v[C['First name']] + ' ' + v[C['Last name']]).trim(), school: String(v[C['School']] || ''), note: absLog_(v[C['Notes']]) });
    }
    if (/^Back/.test(out) && rec && (today - rec) / DAY < 10) recentBack.push((v[C['First name']] + ' ' + v[C['Last name']]).trim() + ' (' + out + ')');
  });
  // 2) open rows: newest "Last attended" per member wins; older ones mean they came back in between
  const open = {};
  rows.forEach(function (v, i) {
    const row = i + 2, st = String(v[C['Status']] || '').trim(), id = String(v[C['EFC member ID']] || '').trim();
    if (/^closed|^efc fixed/i.test(st)) return;
    const name = (String(v[C['First name']] || '') + ' ' + String(v[C['Last name']] || '')).trim();
    if (hubIsTest_(name)) return;
    if (id && silenced[id] && String(v[C['Outcome']] || '') !== 'EFC record wrong') { writes.push([row, 'Closed', 'Auto: EFC record wrong']); return; }
    const key = id || 'r' + row, lk = lastKey(v), prev = open[key];
    if (prev) {
      if (lk > prev.lk) { writes.push([prev.row, 'Closed', 'Back (trained since)']); }
      else { writes.push([row, 'Closed', 'Duplicate']); return; }
    }
    open[key] = { row: row, v: v, lk: lk, id: id };
  });
