function mgmtHoldSkip_(v, h) {
  const S = h.indexOf('Status'), M = h.indexOf('Mobile'), D = h.indexOf('Logged at'), FS = h.indexOf('Freeze starts'), FE = h.indexOf('Freeze ends');
  const dup = new Set(), byM = {};
  v.slice(1).filter(function (r) { return hubDay_(r[D]); }).sort(function (x, y) { return hubDay_(x[D]) - hubDay_(y[D]); }).forEach(function (r) {
    const st = String(r[S] || ''), mob = String(r[M] || '').replace(/\D/g, '').slice(-9), fs = hubDay_(r[FS]), fe = hubDay_(r[FE]);
    if (/^duplicate/i.test(st)) { dup.add(r); return; }
    if (!mob || /declin/i.test(st) || !fs || !fe) return;
    if ((byM[mob] || []).some(function (p) { return fs < p.fe && fe > p.fs; })) { dup.add(r); return; }
    (byM[mob] = byM[mob] || []).push({ fs: fs, fe: fe });
  });
  return function (r) { return dup.has(r); };
}
function mgmtPeople_(who, b) {
