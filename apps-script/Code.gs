// Automatic absentee texts (approved by Mark 26 Oct 2026). Sent through GHL (email fallback while the SMS limit is hit).
var ABS_KID_CACHE = null;
function absKid_(id, name) { // 25 Nov 2026: age from EFC students, parent name from EFC parents
