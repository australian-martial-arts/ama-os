  const hdr = function (v) { const H = {}; v[0].forEach(function (h, i) { H[String(h).trim()] = i; }); return H; };
  const ymd = function (x) { if (x instanceof Date) return x; const m = String(x || '').match(/^(\d{4})-(\d{2})-(\d{2})/); return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null; };
  // Enrolments: group and package chosen when they joined (newest row wins)
  const en = ss.getSheetByName(HUBDASH.enrolTab).getDataRange().getValues(), EH = hdr(en), enr = {};
  for (let i = 1; i < en.length; i++) { const r = en[i], k = stuKey_(r[EH['Student name']]); if (!k) continue;
    enr[k] = { prog: String(r[EH['Program']] || '').trim(), pkg: String(r[EH['Package']] || '').trim(), dt: String(r[EH['Days and times']] || '').replace(/\s+/g, ' ').trim().slice(0, 90) }; }
  // Grading EFC: belt (by member id)
  const belt = {}, lastGraded = {}; try { const g = ss.getSheetByName('Grading EFC').getDataRange().getValues(), H = hdr(g);
    for (let i = 1; i < g.length; i++) { belt[String(g[i][H['Member ID']])] = String(g[i][H['Belt']] || '').replace(/ Belt$/, '').trim(); if (H['Promoted'] !== undefined) { const pd = ymd(g[i][H['Promoted']]); if (pd) lastGraded[String(g[i][H['Member ID']])] = Utilities.formatDate(pd, tz, 'd MMM yyyy'); } } } catch (e) {} /* 10 Nov 2026 (Mark): last graded date */
  // EFC students: every enrolled student, EFC groups and the classes they actually attend (last 6 weeks)
  const st = ss.getSheetByName('EFC students').getDataRange().getValues(), S = hdr(st), by = {};
  let pulled = '';
  for (let i = 1; i < st.length; i++) {
    const r = st[i]; const name = (String(r[S['First name']] || '').trim() + ' ' + String(r[S['Last name']] || '').trim()).trim(); const k = stuKey_(name); if (!k) continue;
    const n6 = Number(r[S['Classes last 6 weeks']]) || 0; if (by[k] && by[k]._n6 > n6) continue;
    if (!pulled && r[S['Pulled at']]) pulled = String(r[S['Pulled at']]).split(',')[0];
    let age = r[S['Age']] === '' ? null : Number(r[S['Age']]); if (isNaN(age)) age = null;
    const groups = String(r[S['EFC groups']] || '').split(',').map(function (x) { return x.trim(); }).filter(function (x) { return x && !/birthday|part(y|ies)|staff|test|^holds?$|manual payment|old leads|ndis|lead/i.test(x); });
    const e = enr[k] || {}; const usual = String(r[S['Usual classes']] || '');
    const grp = groups.length ? groups.join(', ') : (/^(mini dragons|little dragons|dragons|ninjas|teens|adults)/i.test(e.prog) ? e.prog.split('/')[0].trim() : stuBand_(age, ''));
    const sty = stuStyle_(e.prog + ' ' + groups.join(' ') + ' ' + usual, e.pkg, '');
    const la = ymd(r[S['Last attended']]), eo = ymd(r[S['Enrolled on']]);
    const mid = String(r[S['Member ID']] || '').trim();
    by[k] = { n: name, a: age, g: grp, s: sty, b: belt[mid] || '', lg: lastGraded[mid] || '', p: e.pkg || '', w: r[S['Sessions per week']] === '' ? '' : Number(r[S['Sessions per week']]),
      c: r[S['Classes last month']] === '' ? '' : Number(r[S['Classes last month']]), sc: String(r[S['School']] || ''),
      e: eo ? Utilities.formatDate(eo, tz, 'MMM yyyy') : '', la: la ? Utilities.formatDate(la, tz, 'EEE d MMM') : '',
      u: usual, d: String(r[S['Usual days']] || ''), t: usual ? '' : (e.dt || ''), _n6: n6 };
  }
