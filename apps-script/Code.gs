  let mob = String(b.mobile || '').replace(/\D/g, ''); if (/^61\d{9}$/.test(mob)) mob = '0' + mob.slice(2); if (/^4\d{8}$/.test(mob)) mob = '0' + mob;
  if (!parent || !/^04\d{8}$/.test(mob)) return { ok: false, error: 'Please enter your name and mobile.' };
  const kids = Math.max(1, Math.min(PARTY.pkg.max, +b.kids || PARTY.pkg.kids));
