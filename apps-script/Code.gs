/** Cache prefix c5_ so older cached entries (without tags) fall out. */
function ghlContact_(contactId) {
  if (!contactId) return null;
  const cache = CacheService.getScriptCache();
  const hit = cache.get('c5_' + contactId);
  if (hit) return JSON.parse(hit);

  try {
    const data = ghlFetch_('/contacts/' + contactId, {});
    const c = data.contact || data;
    const slim = {
      name: [c.firstName, c.lastName].filter(Boolean).join(' ') || c.name || 'Unknown',
      phone: c.phone || '',
      email: c.email || '',
      tags: (c.tags || []).map(function (t) { return String(t).trim().toLowerCase(); }), cf: cfPick_(c)
    };
    cache.put('c5_' + contactId, JSON.stringify(slim), 900);
    return slim;
  } catch (err) {
    Logger.log('Contact lookup failed for ' + contactId + ': ' + err.message);
    return null;
  }
}

function ghlContactIdByPhone_(e164) {
  const props = PropertiesService.getScriptProperties();
  const key = 'staff_' + e164;
  const cached = props.getProperty(key);
  if (cached) { if (ghlContact_(cached)) return cached; props.deleteProperty(key); Logger.log('Stale staff contact id cleared for ' + e164) };

  const data = ghlFetch_('/contacts/', { locationId: CONFIG.locationId, query: e164 });
  const match = (data.contacts || []).filter(function (c) {
    return normalisePhone_(c.phone) === e164;
  })[0];

  if (!match) return null;
  props.setProperty(key, match.id);
  return match.id;
}

function sendSms_(e164, body) {
  if (!CONFIG.sendSms) {
    Logger.log('[DRY RUN] -> ' + e164 + '\n' + body);
    return true;
  }

  if (String(body || '').length > 1500) body = smsTrim_(body); // 21 Nov 2026: GHL rejects texts over 1600 characters
  const contactId = ghlContactIdByPhone_(e164);
  if (!contactId) {
    Logger.log('NO CONTACT for ' + e164 + ' - create a contact in GHL with this mobile. Not sent.');
    return false;
  }
  if (smsLimited_()) return smsEmailFallback_(contactId, body);

  const res = UF_.fetch(CONFIG.ghlBase + '/conversations/messages', {
    method: 'post',
    contentType: 'application/json',
    muteHttpExceptions: true,
    headers: {
      'Authorization': 'Bearer ' + getToken_(),
      'Version': CONFIG.ghlVersion
    },
    payload: JSON.stringify({ type: 'SMS', contactId: contactId, message: body })
  });

  const ok = res.getResponseCode() >= 200 && res.getResponseCode() < 300;
  if (!ok) {
    Logger.log('SMS failed for ' + e164 + ': ' + res.getContentText().slice(0, 300));
    if (smsIsDailyLimit_(res.getContentText())) { smsLimitHit_(res.getContentText()); return smsEmailFallback_(contactId, body); }
    return false;
  }
  // GHL accepts a text and fails it a second later when the daily SMS limit is reached: check, and email instead.
  try {
    const mid = (JSON.parse(res.getContentText()) || {}).messageId;
    if (mid) {
      Utilities.sleep(2000);
      const d = ghlFetch_('/conversations/messages/' + mid, {}), mm = d.message || d;
      if (String(mm.status) === 'failed') {
        Logger.log('SMS failed after sending for ' + e164 + ': ' + mm.error);
        if (smsIsDailyLimit_(mm.error)) smsLimitHit_(mm.error);
        return smsEmailFallback_(contactId, body);
      }
    }
  } catch (e) { Logger.log('sms status check: ' + e); }
  return ok;
}

// ---------- SMS limit: email instead (Mark, 26 Oct 2026) ----------
// 21 Nov 2026: only GHL's daily sending limit counts. A 'character limit' error (text too long) is not it: it wrongly switched texts to email for 12 hours.
function smsIsDailyLimit_(err) { const t = String(err || ''); return /limit/i.test(t) && !/character|1600|too long|length/i.test(t); }
function smsTrim_(body) { const t = String(body || ''); if (t.length <= 1500) return t; let cut = t.lastIndexOf('\n', 1440); if (cut < 1000) cut = 1440; return t.slice(0, cut).replace(/\s+$/, '') + '\n(More in the hub.)'; }
function smsLimited_() { return Number(PropertiesService.getScriptProperties().getProperty('sms_limit_until') || 0) > Date.now(); }
function smsLimitHit_(err) {
  const props = PropertiesService.getScriptProperties();
  if (smsLimited_()) return;
  const m = String(err || '').match(/after (\d{4}-\d{2}-\d{2}) (\d{1,2}):(\d{2})/);
  let until = Date.now() + 12 * 3600000;
  if (m) { const d = tcParseYmd_(m[1]); if (d) { d.setHours(Number(m[2]), Number(m[3]), 0, 0); until = d.getTime(); } }
  props.setProperty('sms_limit_until', String(until));
  Logger.log('GHL SMS limit reached - texts go by email until ' + new Date(until));
  try {
    const mk = HOLD.approvers.filter(function (a) { return a.name === 'Mark'; })[0];
    const cid = mk && ghlContactIdByPhone_(mk.mobile);
    if (cid) smsEmailFallback_(cid, 'AMA: GHL has reached its daily SMS limit, so texts cannot be sent until ' + Utilities.formatDate(new Date(until), CONFIG.timezone, 'EEE d MMM h:mm a') + '. Until then the hub emails staff the same messages instead. Ask GHL support to raise the daily limit if this keeps happening.');
  } catch (e) { Logger.log('limit notice: ' + e); }
}
// Staff who want hub emails at a different address than their GHL contact (Mark, 26 Oct 2026). Mobile -> email.
const STAFF_EMAIL_TO = { '+61432917313': 'mark.loughran@australianmartialarts.com.au' };
function smsEmailFallback_(contactId, body) {
  try {
    Object.keys(STAFF_EMAIL_TO).forEach(function (ph) {
      if (ghlContactIdByPhone_(ph) !== contactId) return;
      const want = STAFF_EMAIL_TO[ph].toLowerCase(), d = ghlFetch_('/contacts/', { locationId: CONFIG.locationId, query: want });
      const hit = (d.contacts || []).filter(function (x) { return String(x.email || '').toLowerCase() === want; })[0];
      if (hit) contactId = hit.id;
    });
  } catch (e) { Logger.log('staff email override: ' + e); }
  const c = ghlContact_(contactId) || {};
  if (!c.email) { Logger.log('SMS limit: no email for ' + (c.name || contactId) + ' - not sent'); return false; }
  // Replying to an email cannot approve anything, so point approvers to the hub instead.
  body = String(body || '').replace(/Reply YES to approve,? (or )?NO to decline\.?/i, 'Approve or decline it in the hub (Holds to action): https://train.australianmartialarts.com.au/admin#holdlist');
  const first = String(body || '').split('\n')[0].replace(/^AMA:?\s*/, '');
  const html = String(body || '').split('\n').map(function (l) { return l.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/(https?:\/\/\S+)/g, '<a href="$1">$1</a>'); }).join('<br>') + '<br><br><i>Sent by email because GHL has reached its daily text limit.</i>';
  const res = UF_.fetch(CONFIG.ghlBase + '/conversations/messages', { method: 'post', contentType: 'application/json', muteHttpExceptions: true,
    headers: { 'Authorization': 'Bearer ' + getToken_(), 'Version': CONFIG.ghlVersion },
    payload: JSON.stringify({ type: 'Email', contactId: contactId, emailTo: c.email, subject: 'AMA: ' + first.slice(0, 70), html: html, message: body }) });
  const ok = res.getResponseCode() >= 200 && res.getResponseCode() < 300;
  Logger.log('SMS limit: emailed ' + (c.name || contactId) + ' ' + (ok ? 'OK' : 'FAILED ' + res.getContentText().slice(0, 200)));
  return ok;
}

// ---------------------------------------------------------------- HELPERS

function normalisePhone_(raw) {
  if (!raw) return '';
  const d = String(raw).replace(/[^\d]/g, '');
  if (d.indexOf('61') === 0 && d.length === 11) return '+' + d;
  if (d.length === 10 && d.indexOf('0') === 0) return '+61' + d.slice(1);
  if (d.length === 9) return '+61' + d;
  return d ? '+' + d : '';
}

function dayCode_(date) {
  return ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][
    Number(Utilities.formatDate(date, CONFIG.timezone, 'u')) % 7
  ];
}

function fmtTime_(date) {
  return Utilities.formatDate(date, CONFIG.timezone, 'h:mma').replace(':00', '').toLowerCase();
}

function endOfDay_(date) {
  return new Date(Utilities.formatDate(date, CONFIG.timezone, 'yyyy/MM/dd') + ' 23:59:59');
}

function dateAt_(date, hhmm) {
  return new Date(Utilities.formatDate(date, CONFIG.timezone, 'yyyy/MM/dd') + ' ' + hhmm + ':00');
}

function toMinutes_(v) {
  if (v === null || v === undefined) return null;
  const s = String(v).trim();
  if (!s) return null;
  const m = /^(\d{1,2}):(\d{2})\s*(am|pm)?$/i.exec(s);
  if (!m) return null;
  let h = Number(m[1]);
  const min = Number(m[2]);
  const ap = (m[3] || '').toLowerCase();
  if (ap === 'pm' && h < 12) h += 12;
  if (ap === 'am' && h === 12) h = 0;
  return h * 60 + min;
}

function nowMinutes_(date) {
  return Number(Utilities.formatDate(date, CONFIG.timezone, 'H')) * 60 +
         Number(Utilities.formatDate(date, CONFIG.timezone, 'm'));
}

function whenWord_(hhmm) {
  return toMinutes_(hhmm) < 12 * 60 ? 'today' : 'tonight';
}

function className_(name) {
  if (!name) return 'Trial';
  const parts = String(name).split('|').map(function (p) { return p.trim(); });
  if (parts.length >= 3) return parts.slice(2).join(' ');
  if (parts.length === 2) return parts[1];
  return 'Trial';
}

/**
 * Promo footer based on each trial contact's GHL tags.
 * No matching tag -> empty string, message unchanged.
 * If only SOME of the listed trials carry the promo, their names are shown,
 * so staff never assume it applies to everyone on the list.
 */
function promoFooter_(events) {
  const byPromo = {};

  events.forEach(function (e) {
    const c = ghlContact_(e.contactId);
    if (!c || !c.tags || !c.tags.length) return;
    c.tags.forEach(function (tag) {
      if (!CONFIG.promos[tag]) return;
      if (!byPromo[tag]) byPromo[tag] = [];
      if (byPromo[tag].indexOf(c.name) === -1) byPromo[tag].push(c.name);
    });
  });

  const keys = Object.keys(byPromo);
  if (!keys.length) return '';

  return keys.map(function (tag) {
    const names = byPromo[tag];
    const who = (names.length === events.length) ? '' : ' (' + names.join(', ') + ')';
    return '\nPromo' + who + ': ' + CONFIG.promos[tag] + '.';
  }).join('');
}

/** The full SMS body for one location / slot. */
function buildBody_(loc, slot, events) {
  const lines = events.map(function (e) {
    const c = ghlContact_(e.contactId);
    return lineFor_(e, c);
  });

  return loc + ' trials ' + whenWord_(slot) + ' (' + events.length + '):\n' +
         lines.join('\n') + promoFooter_(events);
}

// ---------------------------------------------------------------- ROSTER

function rosterRows_(date) {
  const day = dayCode_(date);
  const grid = SpreadsheetApp.openById(CONFIG.rosterSheetId)
    .getSheets()[0].getDataRange().getDisplayValues();

  const header = grid.shift().map(function (h) { return String(h).trim().toLowerCase(); });
  // Extra roster rows kept in the enrolment sheet ('Roster extra' tab), for staff the script cannot add to the main roster.
  try {
    const xs = SpreadsheetApp.openById(HOLD.sheetId).getSheetByName('Roster extra');
    if (xs && xs.getLastRow() > 1) {
      const xg = xs.getDataRange().getDisplayValues(), xh = xg.shift().map(function (h) { return String(h).trim().toLowerCase(); });
      xg.forEach(function (r) { grid.push(header.map(function (h) { const k = xh.indexOf(h); return k > -1 ? r[k] : ''; })); });
    }
  } catch (e) { Logger.log('Roster extra: ' + e); }
  const col = {
    name:     header.indexOf('name'),
    mobile:   header.indexOf('mobile'),
    location: header.indexOf('location'),
    days:     header.indexOf('days'),
    time:     header.indexOf('time'),
    active:   header.indexOf('active')
  };

  const out = [];
  grid.forEach(function (r) {
    const active = String(r[col.active]).trim().toUpperCase();
    if (active === 'FALSE' || active === 'NO') return;

    const days = String(r[col.days] || '').split(',').map(function (d) { return d.trim(); });
    if (days.indexOf(day) === -1) return;

    const phone = normalisePhone_(r[col.mobile]);
    if (!phone) return;

    out.push({
      name: String(r[col.name]).trim(),
      phone: phone,
      loc: String(r[col.location]).trim(),
      time: col.time === -1 ? null : toMinutes_(r[col.time])
    });
  });

  return out;
}

function recipientsFor_(rows, loc, slot, isMain) {
  const want = toMinutes_(slot);
  const out = [];

  rows.forEach(function (r) {
    let ok;
    if (r.loc.toUpperCase() === 'ALL') ok = true;
    else if (r.loc !== loc) ok = false;
    else if (r.time === null) ok = isMain;
    else ok = (r.time === want);

    if (ok && !out.some(function (x) { return x.phone === r.phone; })) out.push(r);
  });

  return out;
}

// ---------------------------------------------------------------- DISPATCHER

function sendDue() {
  const now = new Date();
  const day = dayCode_(now);
  const mins = nowMinutes_(now);

  const due = [];
  Object.keys(CONFIG.locations).forEach(function (loc) {
    const times = timesFor_(loc, day);
    let best = null, bestGap = 1e9, idx = -1;

    times.forEach(function (t, i) {
      const gap = Math.abs(toMinutes_(t) - mins);
      if (gap < bestGap) { bestGap = gap; best = t; idx = i; }
    });

    if (best === null || bestGap > 45) return;
    due.push({
      loc: loc, slot: best,
      next: (idx + 1 < times.length) ? times[idx + 1] : null,
      isMain: (idx === times.length - 1)
    });
  });

  if (!due.length) {
    Logger.log('Nothing scheduled near ' +
               Utilities.formatDate(now, CONFIG.timezone, 'H:mm') + ' on ' + day + '.');
    return;
  }

  Logger.log('Due now: ' + due.map(function (d) { return d.loc + '@' + d.slot; }).join(', '));
  runSends_(now, due, false);
}

function runSends_(now, due, dryRun) {
  const rows = rosterRows_(now);
  const groups = ghlGroups_();
  let sent = 0, skipped = 0;

  due.forEach(function (d) {
    const start = dateAt_(now, d.slot);
    const end = d.next ? dateAt_(now, d.next) : endOfDay_(now);

    // Only trials from this send's time until the next send (GHL can return the whole day). Mark, 24 Oct 2026:
    // the morning text lists morning trials only, the afternoon text afternoon trials only.
    const from = start;
    const events = eventsForLocation_(d.loc, groups, start, end, true).filter(function (e) {
      const t = new Date(e.startTime); return t >= from && t < end;
    }).sort(function (a, b) {
      return new Date(a.startTime) - new Date(b.startTime);
    });

    if (!events.length) {
      Logger.log(d.loc + ' @' + d.slot + ': no trials in window - nobody texted.');
      return;
    }

    const people = recipientsFor_(rows, d.loc, d.slot, d.isMain);
    if (!people.length) {
      Logger.log(d.loc + ' @' + d.slot + ': ' + events.length +
                 ' trial(s) but NOBODY rostered - nothing sent.');
      return;
    }

    const body = buildBody_(d.loc, d.slot, events);
    Logger.log(d.loc + ' @' + d.slot + ' -> ' +
               people.map(function (p) { return p.name; }).join(', ') + '\n' + body);

    people.forEach(function (p) {
      if (dryRun) sent++;
      else if (sendSms_(p.phone, body)) sent++;
      else skipped++;
    });
  });

  Logger.log('Run complete - ' + sent + (dryRun ? ' would be sent' : ' sent') +
             ', ' + skipped + ' failed/skipped.');
}

// ---------------------------------------------------------------- CALENDAR SYNC

function syncCalendars() {
  const map = JSON.parse(PropertiesService.getScriptProperties().getProperty('CALENDAR_MAP') || '{}');
  if (!Object.keys(map).length) throw new Error('Run setup() first.');

  const groups = ghlGroups_();
  const start = new Date();
  const end = new Date(start.getTime() + CONFIG.syncDaysAhead * 864e5);

  Object.keys(CONFIG.locations).forEach(function (loc) {
    const cal = CalendarApp.getCalendarById(map[loc]);
    if (!cal) { Logger.log('Calendar missing for ' + loc); return; }

    const wanted = {};
    eventsForLocation_(loc, groups, start, end).forEach(function (e) { wanted[e.id] = e; });

    cal.getEvents(start, end).forEach(function (ev) {
      const m = /\[ghl:([^\]]+)\]/.exec(ev.getDescription() || '');
      if (!m) return;
      if (!wanted[m[1]]) {
        ev.deleteEvent();
        Logger.log('Removed cancelled booking from ' + loc);
      } else {
        wanted[m[1]]._existing = ev;
      }
    });

    Object.keys(wanted).forEach(function (id) {
      const e = wanted[id];
      const c = ghlContact_(e.contactId);
      const title = (c ? c.name : 'Trial booking') + ' - ' + classOf_(e);
      const promo = promoFooter_([e]).replace(/^\n/, '');
      const desc = [
        'Trial booking from GoHighLevel.',
        c && c.phone ? 'Phone: ' + c.phone : '',
        c && c.email ? 'Email: ' + c.email : '',
        promo,
        '',
        '[ghl:' + id + ']'
      ].filter(Boolean).join('\n');

      if (e._existing) {
        if (e._existing.getTitle() !== title) e._existing.setTitle(title);
        if (e._existing.getDescription() !== desc) e._existing.setDescription(desc);
      } else {
        cal.createEvent(title, new Date(e.startTime), new Date(e.endTime), { description: desc });
        Logger.log('Added ' + title + ' to ' + loc);
      }
    });
  });

  Logger.log('Calendar sync complete.');
}

