/* ===== STUDENT DETAILS ON CARDS (6 Nov 2026) =====
   One line per student wherever the hub shows them: age, class group, style, belt, membership, classes last month.
   Sources: 'Grading EFC' (the EFC pull of every active student) and 'Enrolments' (the group and package chosen when they joined).
   Group comes from the enrolment when we have it, otherwise from the age bands below. */
const STU = {
  bands: [[0, 3, 'Mini Dragons'], [4, 5, 'Little Dragons'], [6, 8, 'Dragons'], [9, 12, 'Ninjas'], [13, 17, 'Teens'], [18, 120, 'Adults']]
};
function stuKey_(s) { return String(s || '').toLowerCase().replace(/[^a-z' -]/g, ' ').replace(/\s+/g, ' ').trim(); }
function stuBand_(age, programme) {
  if (/little dragon/i.test(programme)) return age && age <= 3 ? 'Mini Dragons' : 'Little Dragons';
  if (!age && age !== 0) return '';
  for (let i = 0; i < STU.bands.length; i++) if (age >= STU.bands[i][0] && age <= STU.bands[i][1]) return STU.bands[i][2];
  return '';
}
function stuStyle_(prog, pkg, programme) {
  const t = String(prog || '') + ' ' + String(pkg || '');
  const out = [];
  if (/bjj|jiu/i.test(t)) out.push('BJJ');
  if (/kickbox/i.test(t)) out.push('Kickboxing');
  if (/trick/i.test(t)) out.push('Tricking');
  if (/recovery|neuro/i.test(t)) out.push('Recovery Martial Arts');
  if (/kung ?fu|tigers/i.test(t)) out.push('Kung Fu');
  if (!out.length || /taekwondo|tkd/i.test(t)) out.unshift(/little dragon/i.test(programme) ? 'Little Dragons program' : 'Taekwondo');
  if (/bbc|black belt club/i.test(t)) out.push('Black Belt Club');
  return out.join(' + ');
}
function stuInfo_(who) {
