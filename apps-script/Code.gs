  const until = Utilities.formatDate(new Date(now.getTime() + 31 * 864e5), tz, 'yyyy-MM-dd');
  const nice = function (ymd) { const p = String(ymd).split('-'); return Utilities.formatDate(new Date(+p[0], +p[1] - 1, +p[2], 12), tz, 'EEE d MMM'); };
