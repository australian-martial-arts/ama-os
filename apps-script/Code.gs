// ---- Year to date: starts and stops from 1 Jan to today, this year against every past year (Targets tab, EFC numbers) ----
function ytdByYear_(who) {
  if (typeof mgmtCanSee_ === 'function' && !mgmtCanSee_(who)) return { ok: false, error: 'Management only.' };
  const sh = SpreadsheetApp.openById(HOLD.sheetId).getSheetByName(TARGETS.tab); if (!sh) return { ok: false, error: 'No Targets tab.' };
  const v = sh.getDataRange().getValues(), tz = CONFIG.timezone, now = new Date();
  const mi = Number(Utilities.formatDate(now, tz, 'M')) - 1, day = Number(Utilities.formatDate(now, tz, 'd')), dim = new Date(now.getFullYear(), mi + 1, 0).getDate(), frac = day / dim;
  const out = {};
  for (let i = 0; i < v.length - 13; i++) {
    const m = String(v[i][0]).trim().match(/^(.+?)\s*-\s*(start|stop)$/i); if (!m) continue;
    const school = m[1].trim(), kind = m[2].toLowerCase(), h = v[i + 1].map(function (x) { return String(x).trim(); });
    h.forEach(function (x, c) {
      if (!/^20\d\d$/.test(x)) return; const y = Number(x); let sum = 0, any = false;
      for (let r = 0; r <= mi; r++) { const val = v[i + 2 + r][c]; if (val === '' || val === null || isNaN(Number(val))) continue; any = true; sum += r < mi ? Number(val) : Number(val) * frac; }
      if (!any) return;
      ((out[school] = out[school] || {})[kind] = out[school][kind] || {})[y] = Math.round(sum);
    });
  }
  return { ok: true, month: mi, day: day, daysInMonth: dim, label: '1 Jan to ' + Utilities.formatDate(now, tz, 'd MMM'), schools: out };
}

/* ===== 2 Nov 2026 (Mark): contact log, live "on it now" tags, calls tally and the win-back list =====
   Bianca and Mady share one call list. Every card shows who last contacted the family and when, and who is on it right now.
   The calls tally counts calls logged in the hub only (work landline calls are separate until the landline moves into GHL). */
const CLOG = {
  tab: 'Contact log', headers: ['At', 'Key', 'Family', 'By', 'Type', 'Note'], claimMins: 15, hereMins: 3,
  callTypes: ['Called - spoke to them', 'Called - left a voicemail', 'Called - no answer'],
