function hubTrialBookRaw_(who, b) {
  const s = function (x, n) { return String(x || '').trim().slice(0, n || 200); };
  const first = s(b.first, 60), last = s(b.last, 60), email = s(b.email, 120).toLowerCase();
  const phone = normalisePhone_(b.phone);
  if (!first) return { ok: false, error: 'Add the parent\'s first name.' };
  if (!phone) return { ok: false, error: 'Add a valid mobile number.' };
  // Students: each has a name, date of birth, class and time. Older hub pages send kid1/kid2 + one class instead.
  let studs = Array.isArray(b.students) && b.students.length ? b.students.slice(0, 4) : [{ name: b.kid1, calendarId: b.calendarId, slot: b.slot }].concat(b.kid2 ? [{ name: b.kid2, calendarId: b.calendarId, slot: b.slot }] : []);
  studs = studs.map(function (x) { return { name: s(x.name, 80), dob: s(x.dob, 10), calendarId: String(x.calendarId || ''), slot: String(x.slot || ''),
    more: (Array.isArray(x.more) ? x.more.slice(0, 11) : []).map(function (m) { return { calendarId: String((m && m.calendarId) || ''), slot: String((m && m.slot) || '') }; }) }; });
  const cals = tbCalendars_();
  for (let i = 0; i < studs.length; i++) {
    const x = studs[i];
    if (!x.name) return { ok: false, error: 'Add student ' + (i + 1) + '\'s name (the parent\'s name if the adult is training).' };
    x.cal = cals.filter(function (c) { return c.ids.indexOf(x.calendarId) > -1; })[0];
    if (!x.cal) return { ok: false, error: 'Choose a class for ' + x.name + '.' };
    x.start = new Date(x.slot);
    if (isNaN(x.start) || x.start < new Date()) return { ok: false, error: 'Choose a time for ' + x.name + '.' };
  }
  // Every student gets their own booking, so each one shows and counts as a trial.
  const groups = [], byKey = {};
  studs.forEach(function (x, i) { const k = x.calendarId + '|' + x.start.getTime() + '|' + i; if (!byKey[k]) { byKey[k] = { cal: x.cal, calId: x.calendarId, start: x.start, kids: [] }; groups.push(byKey[k]); } byKey[k].kids.push(x.name); });
  // 2 Nov 2026 (Mark): book a block of classes (paid trial or special program, e.g. School readiness): same class and time each week.
  const weeks = Math.max(1, Math.min(10, parseInt(b.weeks, 10) || 1)), blockLbl = s(b.blockLabel, 40) || 'Block';
  if (weeks > 1) {
    groups.slice().forEach(function (g) {
      g.of = 1; g.weeks = weeks;
      for (let k = 1; k < weeks; k++) { const d = new Date(g.start.getTime()); d.setDate(d.getDate() + 7 * k); groups.push({ cal: g.cal, calId: g.calId, start: d, kids: g.kids, of: k + 1, weeks: weeks, extra: true }); }
    });
  }
  // 2 Nov 2026 (Mark): trial programs (2-class offer, School readiness 6 classes, 1-month trial). Staff pick every class; each one is booked separately.
  const prog = s(b.program, 50) || 'Trial program', progOf = parseInt(b.programOf, 10) || 0, progBad = [];
  studs.forEach(function (x) {
    if (!x.more || !x.more.length) return;
    const n = x.more.length + 1; // numbered by the classes actually booked, so the last one booked is the one that triggers the recommendation
    const g0 = groups.filter(function (g) { return g.kids.length === 1 && g.kids[0] === x.name && g.start.getTime() === x.start.getTime(); })[0];
    if (g0) { g0.of = 1; g0.weeks = n; g0.lbl = prog; }
    x.more.forEach(function (m, k) {
      const cal = cals.filter(function (c) { return c.ids.indexOf(m.calendarId) > -1; })[0], st = new Date(m.slot);
      if (!cal || isNaN(st) || st < new Date()) { progBad.push(x.name + ' class ' + (k + 2)); return; }
      groups.push({ cal: cal, calId: m.calendarId, start: st, kids: [x.name], of: k + 2, weeks: n, lbl: prog, extra: true });
    });
  });
