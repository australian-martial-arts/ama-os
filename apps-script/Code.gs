function holdCareDaily() { holdCareRun_(true).forEach(function (l) { Logger.log(l); }); try { refDaily(); } catch (e) { Logger.log('refDaily: ' + e); } try { chaseDaily(); } catch (e) { Logger.log('chaseDaily: ' + e); } }
function listTriggers() { const c = {}; ScriptApp.getProjectTriggers().forEach(function (t) { c[t.getHandlerFunction()] = (c[t.getHandlerFunction()] || 0) + 1; }); Logger.log(JSON.stringify(c)); }
