      if (!txt || !mob) return;
      if (dry || !PARTY.familyTextsOn) { log.push(who + ': would send #' + k + (PARTY.familyTextsOn ? '' : ' (family texts off)')); return; }
      try { if (sendSms_(mob, txt)) { sent[k] = Date.now(); mark.push('#' + k); } } catch (e) { Logger.log('party text ' + k + ' ' + p.Id + ': ' + e); }
    };
    if (p.Stage !== 'Lost') {
      fam('1', p.Stage === 'New enquiry' && recent(p.Created));
      fam('3', p.Stage === 'Held (24h)' && recent(p.Created));
      fam('4', p.Stage === 'Held (24h)' && p['Hold until'] && new Date(p['Hold until']) - now < 4 * 3600e3 && new Date(p['Hold until']) > now && p.Deposit !== 'Paid' && daytime);
      fam('5', p.Deposit === 'Paid' && at > -1 && recent(p.Updated) && d !== null && d >= 0);
      fam('7', at > -1 && d !== null && d <= 21 && d >= 15 && daytime);
      fam('8', at > -1 && d !== null && d <= 7 && d >= 3 && daytime && p.Balance !== 'Paid');
      fam('9', at > -1 && d !== null && d <= 2 && d >= 1 && daytime);
      fam('10', at > -1 && d !== null && d <= -1 && d >= -3 && daytime);
      fam('11', at > -1 && d !== null && d <= -2 && d >= -6 && daytime && !!sent['10']);
