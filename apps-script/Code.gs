/* ===== CAMP PAYMENT: Square (9 Nov 2026) =====
   Each booking gets its own Square checkout link for the exact total (Square Online Checkout API, quick pay).
   The Square order id is saved in "Payment ref". campCheckPaid_ (every 10 minutes, and whenever the camp page or hub
   camp page loads) marks a booking "paid" once Square shows the order paid. Needs Script property SQUARE_TOKEN
   (a Square production access token, added by Mark in Project Settings). Square emails the parent the receipt. */
const SQ = { base: 'https://connect.squareup.com/v2', version: '2025-10-16' };
function sq_(path, payload) {
  const t = PropertiesService.getScriptProperties().getProperty('SQUARE_TOKEN');
  if (!t) throw new Error('SQUARE_TOKEN is not set');
  const o = { headers: { Authorization: 'Bearer ' + t, 'Square-Version': SQ.version, Accept: 'application/json' }, muteHttpExceptions: true };
  if (payload !== undefined) { o.method = 'post'; o.contentType = 'application/json'; o.payload = JSON.stringify(payload); }
  const r = UF_.fetch(SQ.base + path, o), j = JSON.parse(r.getContentText() || '{}');
  if (r.getResponseCode() >= 300) throw new Error('Square ' + r.getResponseCode() + ': ' + JSON.stringify(j.errors || j).slice(0, 300));
  return j;
}
/* management (money access): paste a Square access token from the hub camp page. It is checked with Square, stored in
   Script Properties as SQUARE_TOKEN and never sent back to the browser. The editor's property list is full, so it is set here. */
function campSquareSet_(who, b) {
  if (!mgmtCanSee_(who) || mgmtNoMoney_(who)) return { ok: false, error: 'Only management with money access can connect Square.' };
  const t = String((b && b.sqtoken) || '').trim(); // not 'token': that field is the hub sign-in
  if (!/^EAAA[\w-]{20,}$/.test(t)) return { ok: false, error: 'That does not look like a Square production access token (it starts with EAAA).' };
  const r = UF_.fetch(SQ.base + '/locations', { headers: { Authorization: 'Bearer ' + t, 'Square-Version': SQ.version }, muteHttpExceptions: true });
  if (r.getResponseCode() !== 200) return { ok: false, error: 'Square did not accept that token (' + r.getResponseCode() + '). Copy the Production access token again.' };
  const locs = (JSON.parse(r.getContentText()).locations || []).filter(function (l) { return l.status === 'ACTIVE'; });
  const P = PropertiesService.getScriptProperties(); P.setProperty('SQUARE_TOKEN', t); P.deleteProperty('SQUARE_LOCATION');
  const loc = sqLocation_(), name = (locs.filter(function (l) { return l.id === loc; })[0] || {}).name || '';
  return { ok: true, location: name, locations: locs.map(function (l) { return l.name; }) };
}
function sqReady_() { return !!PropertiesService.getScriptProperties().getProperty('SQUARE_TOKEN'); }
function sqLocation_() {
  const P = PropertiesService.getScriptProperties(), have = P.getProperty('SQUARE_LOCATION'); if (have) return have;
  const locs = (sq_('/locations').locations || []).filter(function (l) { return l.status === 'ACTIVE'; });
  const pick = locs.filter(function (l) { return /marrickville/i.test(l.name); })[0] || locs[0];
