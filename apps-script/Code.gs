// ---------- Hold extensions (agreed with Mark 26 Oct 2026) ----------
// Staff open the family's current hold in Holds to action and tap "Extend this hold" (only before the hold ends).
// Medical: up to 6 weeks in total (first hold plus extensions) goes through on the certificate.
// Over 6 weeks, an extension of an approved exception, or a medical hold that was already an exception: Mark or Sarah approve (YES/NO text).
// Once approved the family signs a short extension agreement. Staff then change the restart date in EFC.
// The extension is its own row on the Holds tab ("Extends" = the hold it continues; the first hold gets "Extended by").
// While HOLDEXT.live is false, extension emails to families only go to the test address.
const HOLDEXT = { live: true, medicalCapWeeks: 6 }; // wording approved by Mark 26 Oct 2026

function holdExtFirst_(f) {
  let cur = f, guard = 0;
  while (cur && String(cur.v[cur.C['Extends']] || '') && guard++ < 10) { const p = holdFind_(cur.v[cur.C['Extends']]); if (!p) break; cur = p; }
  return cur;
}

function holdExtend_(b, who) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    holdSheet_();
    const f = holdFind_(b.id);
    if (!f) return { ok: false, error: 'Hold not found.' };
    const v = f.v, C = f.C, st = String(v[C['Status']] || ''), tz = CONFIG.timezone, DAY = 86400000;
    if (!/^approved|^auto/i.test(st) || /declin/i.test(st)) return { ok: false, error: 'Only an approved hold can be extended.' };
    if (v[C['Resumed at']]) return { ok: false, error: 'This hold has finished and billing has restarted. Log a new hold request instead.' };
    if (String(v[C['Extended by']] || '')) return { ok: false, error: 'This hold already has an extension (' + v[C['Extended by']] + '). Extend that one instead.' };
    const end = holdAsDate_(v[C['Freeze ends']]), today = hubStartOfDay_(new Date());
    if (!end) return { ok: false, error: 'This hold has no end date.' };
    const end0 = hubStartOfDay_(end);
    const fmt = function (d) { return Utilities.formatDate(d, tz, 'EEE d MMM'); }, ymd = function (d) { return Utilities.formatDate(d, tz, 'yyyy-MM-dd'); };
    if (end0 < today) return { ok: false, error: 'This hold ended on ' + fmt(end0) + '. Extensions must be asked for before the hold ends, so log a new hold request instead.' };
    const wks = Number(b.weeks);
    if (!(wks >= 1 && wks <= 26)) return { ok: false, error: 'Choose how many more weeks.' };
    const words = holdTidy_(b.words);
    if (words.length < 5) return { ok: false, error: 'Add what the family told you.' };
    const newEnd = new Date(end0.getTime() + Math.round(wks * 7) * DAY);
    const medical = String(v[C['Reason']]) === 'medical';
    const first = holdExtFirst_(f), fs = holdAsDate_(first.v[first.C['Freeze starts']]);
    const total = fs ? Math.round((newEnd - hubStartOfDay_(fs)) / DAY / 7 * 10) / 10 : wks;
    let meets = false, why = '';
    if (!medical) why = 'extension of an approved exception (' + ({ travel: 'going away', other: 'other reason' }[String(v[C['Reason']])] || String(v[C['Reason']] || 'not medical')) + ')';
    else if (String(first.v[first.C['Meets terms']]) === 'no' || String(v[C['Meets terms']]) === 'no') why = 'extension of a medical hold that was already approved as an exception';
    else if (total > HOLDEXT.medicalCapWeeks) why = 'medical hold would be ' + total + ' weeks in total, over the ' + HOLDEXT.medicalCapWeeks + '-week limit';
    else meets = true;
    const id = holdNewId_(), now = new Date(), origId = String(v[C['Request ID']]);
    const row = HOLD.headers.map(function () { return ''; });
    const set = function (k, x) { const i = HOLD.headers.indexOf(k); if (i > -1) row[i] = x; };
    ['Account holder', 'Mobile', 'Email', 'Students', 'Trains at', 'Reason', 'Detail', 'Weekly rate'].forEach(function (k) { set(k, v[C[k]]); });
    set('Request ID', id); set('Logged at', now); set('Status', meets ? 'approved - agreement not sent' : 'awaiting approval');
    set('In their words', words); set('Staff notes', holdTidy_(b.staffNotes)); set('Certificate', medical ? (b.certificate === 'received' ? 'received' : 'tofollow') : '');
    set('Freeze starts', ymd(end0)); set('Freeze ends', ymd(newEnd)); set('Weeks', wks); set('Next payment', ymd(end0));
    set('Notice days', Math.round((end0 - today) / DAY)); set('Meets terms', meets ? 'yes' : 'no'); set('Exception reason', why);
    set('Taken by', who.name);
    set('Prior freezes', 'Extension of ' + origId + ' (' + fmt(holdAsDate_(v[C['Freeze starts']]) || end0) + ' to ' + fmt(end0) + '). ' + total + ' weeks in total.');
    if (meets) { set('Approved by', 'Terms v2026.2'); set('Approved at', now); }
    set('Extends', origId);
    f.sh.appendRow(row);
    f.sh.getRange(f.row, C['Extended by'] + 1).setValue(id);
    SpreadsheetApp.flush();
    CacheService.getScriptCache().remove(HUBDASH.cacheKey);
    if (meets) {
      const nf = holdFind_(id), sent = nf ? holdSendSignLink_(nf.row) : 'not found';
      return { ok: true, id: id, approval: 'not needed', agreement: sent, total: total, newEnd: fmt(newEnd) };
    }
    holdSmsApprovers_('AMA hold extension ' + id + '\n' + v[C['Account holder']] + (v[C['Students']] ? ' (' + v[C['Students']] + ')' : '') + ' - ' + (v[C['Trains at']] || '') + '\n' +
      'Extends ' + origId + ' by ' + wks + ' week' + (wks === 1 ? '' : 's') + ': back ' + fmt(newEnd) + ' instead of ' + fmt(end0) + ' (' + total + ' weeks in total)\n' +
      'Outside terms: ' + why + '\n' + (medical ? 'Updated certificate: ' + (b.certificate === 'received' ? 'received' : 'to follow') + '\n' : '') +
      '"' + (words.length > 90 ? words.slice(0, 90) + '...' : words) + '"\nTaken by ' + who.name + '\nReply YES ' + id + ' to approve, NO ' + id + ' to decline.');
    return { ok: true, id: id, approval: 'requested', total: total, newEnd: fmt(newEnd) };
  } finally {
    lock.releaseLock();
  }
}

// Declined extension: the first hold goes back to normal (it ends on its own date and gets its welcome-back text).
