function hubSheet_() {
  const sh = SpreadsheetApp.openById(HUB.sheetId).getSheetByName(HUB.tab);
  if (!sh) throw new Error('No Hub staff tab - run setupHubStaff first');
  return sh;
}
function hubCols_() { const C = {}; HUB.headers.forEach(function (h, i) { C[h] = i; }); return C; }
function hubNewPin_() { return String(Math.floor(100000 + Math.random() * 900000)); }
function hubActive_(v) { return v === true || String(v).toUpperCase() === 'TRUE'; }

function hubKey_() {
  const props = PropertiesService.getScriptProperties();
  let k = props.getProperty('HUB_KEY');
  if (!k) { k = Utilities.getUuid() + Utilities.getUuid(); props.setProperty('HUB_KEY', k); }
  return k;
}
function hubSign_(s) { return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(s, hubKey_())); }
function hubHash_(pin, mobile9) { return hubSign_('pin|' + pin + '|' + mobile9); }

function hubLogin_(b) {
  const want = holdLast9_(b.mobile);
  const pin = String(b.pin || '').replace(/\D/g, '');
  if (want.length !== 9 || pin.length < 4) return { ok: false, error: 'Enter your mobile and PIN.' };
  const sh = hubSheet_(), last = sh.getLastRow(), C = hubCols_();
  if (last < 2) return { ok: false, error: 'Mobile or PIN not right.' };
  const vals = sh.getRange(2, 1, last - 1, HUB.headers.length).getValues();
  for (let i = 0; i < vals.length; i++) {
    const r = vals[i], row = i + 2;
    if (holdLast9_(r[C['Mobile']]) !== want) continue;
    if (!hubActive_(r[C['Active']])) return { ok: false, error: 'Access is switched off for this mobile. Ask Mark.' };
    const until = r[C['Locked until']];
    if (until && new Date(until) > new Date()) return { ok: false, error: 'Too many tries. Wait 15 minutes and try again.' };
    const fresh = String(r[C['New PIN']] || '').replace(/\D/g, '');
    const hash = String(r[C['PIN hash']] || '');
    let good;
    if (fresh) {
      good = (pin === fresh);
      if (good) sh.getRange(row, C['New PIN'] + 1, 1, 2).setValues([['', hubHash_(pin, want)]]);
    } else {
      good = !!hash && hubHash_(pin, want) === hash;
    }
    if (!good) {
      const tries = Number(r[C['Failed tries']] || 0) + 1;
      if (tries >= HUB.maxTries) sh.getRange(row, C['Failed tries'] + 1, 1, 2).setValues([[0, new Date(Date.now() + HUB.lockMinutes * 60000)]]);
      else sh.getRange(row, C['Failed tries'] + 1).setValue(tries);
      return { ok: false, error: 'Mobile or PIN not right.' };
    }
    sh.getRange(row, C['Failed tries'] + 1, 1, 3).setValues([[0, '', new Date()]]);
    const name = String(r[C['Name']]).trim(), role = String(r[C['Role']] || 'staff').trim();
    return { ok: true, token: hubToken_(name, role, want), name: name, role: role, hours: HUB.sessionHours };
  }
  return { ok: false, error: 'Mobile or PIN not right.' };
}

function hubToken_(name, role, mobile9) {
  const body = Utilities.base64EncodeWebSafe(JSON.stringify({ n: name, r: role, m: mobile9, e: Date.now() + HUB.sessionHours * 3600000 }));
  return body + '.' + hubSign_(body);
}

// Returns {name, role} for a valid, unexpired token whose person is still Active; otherwise null.
/* 5 Nov 2026: remember a signed-in login for 10 minutes so each hub screen doesn't re-open the staff sheet */
function hubCheck_(token) {
  const sig = String(token || '').split('.')[1] || ''; if (!sig) return null;
  const C = CacheService.getScriptCache(), key = 'hck_' + (C.get('hck_gen') || '0') + '_' + sig.replace(/[^A-Za-z0-9_-]/g, '').slice(0, 120);
  const hit = C.get(key); if (hit) { try { const w = JSON.parse(hit); if (w && w.name && (!w.e || w.e > Date.now())) return { name: w.name, role: w.role }; } catch (e) { } }
  const who = hubCheckRaw_(token);
  if (who) { let exp = 0; try { exp = JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(String(token).split('.')[0])).getDataAsString()).e || 0; } catch (e) { } C.put(key, JSON.stringify({ name: who.name, role: who.role, e: exp }), 600); }
  return who;
}
function hubCheckRaw_(token) {
  const parts = String(token || '').split('.');
  if (parts.length !== 2 || hubSign_(parts[0]) !== parts[1]) return null;
  let p;
  try { p = JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(parts[0])).getDataAsString()); } catch (e) { return null; }
  if (!p || !p.e || p.e < Date.now()) return null;
  const sh = hubSheet_(), last = sh.getLastRow(), C = hubCols_();
  if (last < 2) return null;
  const vals = sh.getRange(2, 1, last - 1, HUB.headers.length).getValues();
  for (let i = 0; i < vals.length; i++) {
    if (holdLast9_(vals[i][C['Mobile']]) === p.m && hubActive_(vals[i][C['Active']])) return { name: p.n, role: String(vals[i][C['Role']] || p.r || 'staff').trim() };
  }
  return null;
}

