    label = Utilities.formatDate(a, tz, 'd MMM') + ' to ' + Utilities.formatDate(new Date(mon.getTime() - DAY), tz, 'd MMM');
  } else {
    const n = [7, 30, 90].indexOf(Number(b.period)) > -1 ? Number(b.period) : 7;
    z = new Date(today.getTime() + DAY); a = new Date(z.getTime() - n * DAY); label = 'Last ' + n + ' days';
  }
  const noMoney = mgmtNoMoney_(who);
  const hide = /contact id|event id|\bid$|token|url|link|hash|pdf|signature|json|pin|row/i;
  const money = /rate|\$|fee|price|amount|payment|paid|revenue|cost|balance|uniform/i;
  const ss = SpreadsheetApp.openById(HOLD.sheetId);
  const fmt = function (v) { return v instanceof Date ? Utilities.formatDate(v, tz, 'EEE d MMM yyyy') : String(v === null || v === undefined ? '' : v); };
  const read = function (tab, dateCol, nameCols, skipFn) {
    const sh = ss.getSheetByName(tab); if (!sh || sh.getLastRow() < 2) return { cols: [], rows: [] };
    const v = sh.getDataRange().getValues(), h = v[0].map(String);
    const di = h.indexOf(dateCol); if (di < 0) return { cols: [], rows: [] };
    const keep = h.map(function (c, i) { return i; }).filter(function (i) { return h[i] && !hide.test(h[i]) && !(noMoney && money.test(h[i])); });
    const ni = nameCols.map(function (c) { return h.indexOf(c); }).filter(function (i) { return i > -1; });
    const skip = skipFn ? skipFn(v, h) : null;
    const rows = v.slice(1).filter(function (r) {
      const d = hubDay_(r[di]); if (!d || d < a || d >= z) return false; if (skip && skip(r)) return false;
      return !ni.some(function (i) { return hubIsTest_(r[i]); });
    }).sort(function (x, y) { return hubDay_(y[di]) - hubDay_(x[di]); }).slice(0, 400)
      .map(function (r) { return keep.map(function (i) { return fmt(r[i]); }); });
    return { cols: keep.map(function (i) { return h[i]; }), rows: rows };
  };
  const out = { ok: true, label: label,
    enrolled: mgmtEnrolMerge_(read(HUBDASH.enrolTab, 'Enrolled date', ['Student name', 'Parent name', 'Account holder'])),
    holds: read(HOLD.tab, 'Logged at', ['Account holder'], mgmtHoldSkip_),
    cancellations: read(HUBDASH.cancelTab, 'Logged at', ['Account holder'], mgmtCxSkip_) };
  if (a < HIST.hubFrom) {
    try {
      const sh = ss.getSheetByName(HIST.tab), v = sh.getDataRange().getValues(), h = v[0].map(String);
      const pick = ['Week starting', 'School', 'Name', 'Class', 'Package', 'Source or reason', 'Category', 'Staff', 'Tenure (months)', 'Hold weeks', 'Resume date', 'Comment'];
      const idx = pick.map(function (c) { return h.indexOf(c); });
      const old = function (type) {
        return v.slice(1).filter(function (r) { const d = r[1] instanceof Date ? r[1] : null; if (!d || r[2] !== type || d >= HIST.hubFrom) return false; const e = histWkEnd_(d); return e >= a && e < z; })
          .sort(function (x, y) { return y[1] - x[1]; }).slice(0, 400)
          .map(function (r) { return idx.map(function (i) { return i > -1 ? fmt(r[i]) : ''; }); });
      };
      out.oldHolds = { cols: pick, rows: old('Hold') };
      out.oldStops = { cols: pick, rows: old('Stop') };
      out.oldStarts = { cols: pick, rows: old('Start') };
    } catch (e) { }
  }
