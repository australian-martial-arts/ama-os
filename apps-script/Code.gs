      permissions: { calendarsEnabled: true }
    });

    if (r.code < 200 || r.code >= 300) {
      Logger.log('FAIL ' + r.code + '  ' + first + ' ' + primary + '  ' + r.body.slice(0, 160));
      return;
    }
    const nu = JSON.parse(r.body);
    const fix = ghlPut_('/users/' + nu.id, { permissions: minimalPerms_(nu.permissions) });
    Logger.log('OK  ' + first + ' ' + primary + '   perms->' + fix.code + '   ' + email);
