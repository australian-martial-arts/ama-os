    if (rec === 'Later') { const t = new Date(r[C['Trial date']]); if (isNaN(t)) return; if (!later[cid] || t > later[cid].t) later[cid] = { t: t, r: r }; }
  });
  let enrolled = {}; try { enrolled = tcEnrolled_(); } catch (e) { }
  const today = hubStartOfDay_(new Date());
  Object.keys(later).forEach(function (cid) {
    if (sent[cid] || enrolled[cid]) return;
    const x = later[cid], r = x.r, by = String(r[C['Reported by']] || '');
    if (me !== 'mark' && by.split(' ')[0].toLowerCase() !== me) return;
    /* due about two weeks after the class it was held at (around class 4 of 6) */
    const due = new Date(hubStartOfDay_(x.t).getTime() + 14 * 864e5);
    if (due > new Date(today.getTime() + 7 * 864e5)) return;
    const d = Math.floor((today - due) / 864e5);
