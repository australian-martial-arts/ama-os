    if (!P.getProperty(key)) {
      P.setProperty(key, String(new Date()));
      const have = {}; pvData_().avail.forEach(function (a) { if (a.month === next) have[a.inst] = 1; });
      insts.forEach(function (I) { if (day === 5 && have[I.name]) return; try { sendSms_(pvMobile_(I.mobile), day === 1 ? pvTextAsk_(I, next) : pvTextAskReminder_(I, next)); } catch (e) { Logger.log('pv ask ' + e); } });
