// 26 Oct 2026: the Enrolments tab gets a row from the joining form AND a second, mostly blank row when EFC confirms the
// enrolment (workflow 0). Count each student once: same mobile + same first name = same student. Keep the joining-form row.
function mgmtEnrolDedupe_(en) {
  const seen = {}, keep = [];
  en.slice().sort(function (a, b) { return (b.full - a.full) || (a.d - b.d); }).forEach(function (e) {
    const k = e.m9 && e.nm ? e.m9 + '|' + e.nm : '';
    if (k && seen[k]) return;
    if (k) seen[k] = 1;
    keep.push(e);
  });
  en.length = 0;
  Array.prototype.push.apply(en, keep);
}
// Same for the names list: the EFC row's reference goes onto the joining-form row; EFC-only students stay, with a note.
function mgmtEnrolMerge_(t) {
  const c = function (n) { return t.cols.indexOf(n); }, P = c('Package'), M = c('Mobile'), S = c('Student name'), E = c('EFC reference');
  if (P < 0 || M < 0 || S < 0) return t;
  const key = function (r) { const m = String(r[M]).replace(/\D/g, '').slice(-9), n = String(r[S]).trim().toLowerCase().split(/\s+/)[0]; return m && n ? m + '|' + n : ''; };
  const has = function (r) { return String(r[P]).trim() !== ''; }, rep = {};
  t.rows.forEach(function (r) { const k = key(r); if (has(r) && k && !rep[k]) rep[k] = r; });
  t.rows.forEach(function (r) { const k = key(r), f = k && rep[k]; if (!has(r) && f && E > -1 && !String(f[E]).trim()) f[E] = r[E]; });
  const rows = t.rows.filter(function (r) { const k = key(r); return has(r) ? (!k || rep[k] === r) : !(k && rep[k]); })
    .map(function (r) { return r.concat([has(r) ? '' : 'Set up in EFC; no joining form on file']); });
  return { cols: t.cols.concat(['Note']), rows: rows };
}


