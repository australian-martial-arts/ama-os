      Object.keys(grp).forEach(function (k) { const g = grp[k]; out.events.push({ k: 'promos', t: (g.promo || 'Promotion') + ' session', w: (g.d === today ? 'Today' : 'Tomorrow') + ' · ' + g.time + ' · ' + g.school + ' · ' + g.n + ' booked', d: g.d + ' ' + (g.t ? Utilities.formatDate(new Date(g.t), tz, 'HH:mm') : '') }); });
      (pr.promos || []).forEach(function (p) { if (String(p.status) === 'Live' && (!p.end || p.end >= today)) out.events.push({ k: 'promos', t: 'Offer running: ' + p.name, w: (p.start ? 'Since ' + nice(p.start) : '') + (p.end ? ' until ' + nice(p.end) : ''), d: '', end: p.end || '' }); });
