    if (!c.email && EXEC_EMAILS[p.k]) { try { const d = ghlFetch_('/contacts/search/duplicate', { locationId: CONFIG.locationId, email: EXEC_EMAILS[p.k] }); if (d && d.contact && d.contact.id) { cid = d.contact.id; c = d.contact; c.email = c.email || EXEC_EMAILS[p.k]; } else if (cid && !b.dry) { ghlSend_('put', '/contacts/' + cid, { email: EXEC_EMAILS[p.k] }); c.email = EXEC_EMAILS[p.k]; } else if (cid) { c.email = EXEC_EMAILS[p.k]; } } catch (e) { } }
