function absParseLogDate_(s) {
  const m = /^(\d{1,2}) ([A-Z][a-z]{2})/.exec(String(s || '').trim());
  if (!m) return null;
  const mon = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'].indexOf(m[2]);
  if (mon < 0) return null;
  const now = new Date();
  let d = new Date(now.getFullYear(), mon, Number(m[1]));
  if (d - now > 40 * 86400000) d = new Date(now.getFullYear() - 1, mon, Number(m[1]));
  return d;
}
function absReplies_(items) {
  const SENT = /System: (Day 9|Day 30|No-answer|Booking confirmation) text sent/;
  const props = PropertiesService.getScriptProperties(), cache = CacheService.getScriptCache();
  const want = items.filter(function (x) { return x.e164 && SENT.test(x.log || ''); });
  if (!want.length) return;
  // 30 Oct: read all saved contact ids and cached replies in one go (was one call per family), and remember
  // numbers that are not in GHL for 6 hours instead of searching for them on every load.
  const allP = props.getProperties();
  const noC = cache.getAll(want.map(function (x) { return 'absnoc_' + x.e164; }));
  const needId = want.filter(function (x) { x.cid = allP['abscid_' + x.e164] || ''; return !x.cid && !noC['absnoc_' + x.e164]; });
  if (needId.length) {
    const res = leadFetchAll_(needId.map(function (x) { return '/contacts/?locationId=' + CONFIG.locationId + '&query=' + encodeURIComponent(x.e164); }));
    needId.forEach(function (x, i) {
      const c = (((res[i] || {}).contacts) || []).filter(function (k) { return normalisePhone_(k.phone) === x.e164; })[0];
      if (c) { x.cid = c.id; props.setProperty('abscid_' + x.e164, c.id); } else cache.put('absnoc_' + x.e164, '1', 21600);
    });
  }
  /* 27 Nov 2026: one call for the 100 most recently active conversations replaces most per-family look-ups (was about 1,000
     outside calls an hour). A family whose conversation is not in that list has had nothing new, so its saved copy (2 hours) still holds. */
  const absH = function (c) { const raw = c.lastMessageDate, ms = raw ? (isNaN(Number(raw)) ? new Date(raw).getTime() : Number(raw)) : 0;
    return { conv: c.id || '', dir: c.lastMessageDirection || '', t: String(c.lastMessageBody || '').replace(/\s+/g, ' ').replace(/\s*(On (Mon|Tue|Wed|Thu|Fri|Sat|Sun)\b.*|-+\s*Original Message.*|From: .*)$/i, '').trim().slice(0, 300), ms: ms || 0 }; };
  const recent = {};
  try { const rr = leadFetchAll_(['/conversations/search?locationId=' + CONFIG.locationId + '&sortBy=last_message_date&sort=desc&limit=100'])[0]; ((rr && rr.conversations) || []).forEach(function (c) { if (c.contactId && !recent[c.contactId]) recent[c.contactId] = c; }); } catch (e) { }
  const needMsg = [], fresh = {};
  const hits = cache.getAll(want.filter(function (x) { return x.cid; }).map(function (x) { return 'absr2_' + x.cid; }));
  want.forEach(function (x) { if (!x.cid) return; if (recent[x.cid]) { x._c = absH(recent[x.cid]); fresh['absr2_' + x.cid] = JSON.stringify(x._c); return; } const hit = hits['absr2_' + x.cid]; if (hit) x._c = JSON.parse(hit); else needMsg.push(x); });
  if (needMsg.length) {
    const res = leadFetchAll_(needMsg.map(function (x) { return '/conversations/search?locationId=' + CONFIG.locationId + '&contactId=' + x.cid; }));
    needMsg.forEach(function (x, i) { x._c = absH((((res[i] || {}).conversations) || [])[0] || {}); fresh['absr2_' + x.cid] = JSON.stringify(x._c); });
  }
  try { if (Object.keys(fresh).length) cache.putAll(fresh, 7200); } catch (e) { }
  /* 10 Nov 2026 (Tate/Mark): a reply to a GRADING text is not an absentee reply. The grading app handles it (pauses the grading
     sequence, puts it on the grading call list), so it must not show on the absentee card or move the family's absentee stage.
     A reply counts as a grading reply when the last text we sent before it was a grading text, or the reply itself is about grading. */
  const GRADE = /\bgrad(e|es|ed|ing)\b|\bbelt\b|invitation to grade|book (their|your) spot/i;
  const gcache = CacheService.getScriptCache(), cand = want.filter(function (x) { const h = x._c; return h && h.dir === 'inbound' && h.t && h.ms; });
  const gkeys = cand.map(function (x) { return 'absrg2_' + (x._c.conv || x.e164) + '_' + x._c.ms; }), ghit = gkeys.length ? gcache.getAll(gkeys) : {};
  const gneed = cand.filter(function (x, i) { x._gk = gkeys[i]; if (ghit[x._gk] != null) { x._g = ghit[x._gk] === '1'; return false; } if (GRADE.test(x._c.t)) { x._g = true; gcache.put(x._gk, '1', 21600); return false; } return !!x._c.conv; });
  if (gneed.length) {
    let gres = []; try { gres = leadFetchAll_(gneed.map(function (x) { return '/conversations/' + x._c.conv + '/messages?limit=15'; })); } catch (e) { Logger.log('absReplies_ grading check: ' + e); }
    gneed.forEach(function (x, i) {
      const box = (gres[i] || {}).messages, list = (box && box.messages) || (Array.isArray(box) ? box : []);
      let prev = null;
      list.forEach(function (m) { const t = new Date(m.dateAdded || m.dateUpdated || 0).getTime(); if (String(m.direction) === 'outbound' && !/EMAIL/i.test(String(m.messageType || m.type || '')) && t && t < x._c.ms && (!prev || t > prev.t)) prev = { t: t, body: String(m.body || '') }; /* texts only: a newsletter email that mentions belts is not a grading text */ });
      x._g = !!(prev && GRADE.test(prev.body)); gcache.put(x._gk, x._g ? '1' : '0', 21600);
    });
  }
  want.forEach(function (x) {
    const h = x._c, isGrade = !!x._g; delete x._c; delete x.cid; delete x._g; delete x._gk;
    if (!h || h.dir !== 'inbound' || !h.t || !h.ms) return;
    if (isGrade) return; // a grading reply: leave it to the grading app
    let sent = null, staff = null;
    String(x.log || '').split(' | ').forEach(function (p) {
      if (SENT.test(p)) sent = absParseLogDate_(p) || sent;
      else if (!/System:/.test(p)) staff = absParseLogDate_(p) || staff;
    });
    const at = new Date(h.ms), atDay = hubStartOfDay_(at);
    if (!sent || atDay < sent) return;
    x.replied = { t: h.t, at: Utilities.formatDate(at, CONFIG.timezone, 'EEE d MMM h:mma') };
    if (staff && staff >= atDay) return; // an outcome has been logged since the reply
    x.replyOpen = true; // replied and nobody has actioned it yet
    // 16 Nov 2026: note the reply once on the Absentees tab (for the retention report and the family's history)
    if (!String(x.log || '').split(' | ').some(function (p) { const d = absParseLogDate_(p); return /System: Reply received/.test(p) && d && d >= atDay; })) { try { absLogRows_(x.rows, 'Reply received'); x.log = (x.log || '') + ' | ' + Utilities.formatDate(new Date(), CONFIG.timezone, 'd MMM') + ' System: Reply received'; } catch (e) { Logger.log('abs reply log: ' + e); } }
    if (x.group === 'later' || x.group === 'auto') { x.group = 'office'; x.note = 'Replied to our text: read it, then pick an outcome'; }
  });
}



// ===== Email catcher (27 Oct 2026, approved by Mark) =====
// Every 5 minutes: reads NEW emails in the info@ inbox (read only, nothing in Gmail is changed) and posts each one
// into the sender's GHL conversation, creating the contact if they are new. Skips our own system emails,
// newsletters and automatic notifications. Contacts assigned to the Gmail-synced user are skipped (GHL brings those in itself).
const MAILIN = {
  on: true,
  query: 'in:inbox newer_than:2d -from:me -category:promotions -category:social -category:forums',
  skip: /(no-?reply|do-?not-?reply|mailer-daemon|postmaster|notifications?@|notify@|alerts?@|bounce|@lc\.train-ama\.com|@email\.usercontent\.site|@australianmartialarts\.com\.au|@efcaquila|@zapier|@google\.com|@gohighlevel|@leadconnectorhq|@msgsndr|@stripe|@paypal|@xero|@facebookmail|@linkedin)/i
};
function mailInParseFrom_(s) {
  const m = /^\s*"?([^"<]*?)"?\s*<([^>]+)>/.exec(String(s || ''));
  if (m) return { name: m[1].trim(), email: m[2].trim().toLowerCase() };
  return { name: '', email: String(s || '').trim().toLowerCase() };
}
function mailInContact_(from) {
  const d = ghlFetch_('/contacts/', { locationId: CONFIG.locationId, query: from.email });
  const c = (d.contacts || []).filter(function (k) { return String(k.email || '').toLowerCase() === from.email; })[0];
  if (c) return { id: c.id, owner: c.assignedTo || '', isNew: false };
  const p = from.name.replace(/[^A-Za-z' -]/g, ' ').trim().split(/\s+/);
  const r = ghlPost_('/contacts/upsert', { locationId: CONFIG.locationId, firstName: p[0] || '', lastName: p.slice(1).join(' '), email: from.email, source: 'Email to info@', tags: ['email enquiry'] });
  const j = JSON.parse(r.body || '{}'), id = (j.contact && j.contact.id) || j.id || '';
  return id ? { id: id, owner: '', isNew: true } : null;
}
function mailInConversation_(cid) {
  const s = ghlFetch_('/conversations/search', { locationId: CONFIG.locationId, contactId: cid });
  const c = (s.conversations || [])[0];
  if (c) return c.id;
  const r = ghlPost_('/conversations/', { locationId: CONFIG.locationId, contactId: cid });
  const j = JSON.parse(r.body || '{}');
  return (j.conversation && j.conversation.id) || j.id || '';
}
function mailInTick() {
  if (!MAILIN.on) return;
  const props = PropertiesService.getScriptProperties();
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return;
  try {
    const since = Number(props.getProperty('mailin_last') || 0) || (Date.now() - 10 * 60000);
    const skipOwner = props.getProperty('mailin_skip_owner') || '';
    let newest = since, posted = 0, skipped = 0;
    const done = JSON.parse(props.getProperty('mailin_done') || '[]');
    GmailApp.search(MAILIN.query, 0, 40).forEach(function (th) {
      th.getMessages().forEach(function (m) {
        const at = m.getDate().getTime();
        if (at <= since) return;
        if (at > newest) newest = at;
        const mid = m.getId();
        if (done.indexOf(mid) > -1) return;
        done.push(mid);
        const from = mailInParseFrom_(m.getFrom());
        if (!from.email || MAILIN.skip.test(from.email)) { skipped++; return; }
        let bulk = '';
        try { bulk = (m.getHeader('List-Unsubscribe') || '') + (m.getHeader('Precedence') || '') + (m.getHeader('Auto-Submitted') || ''); } catch (e) {}
        if (/bulk|list|junk|auto-|mailto:|https?:/i.test(bulk)) { skipped++; return; }
        try {
          const c = mailInContact_(from);
          if (!c) { Logger.log('mailIn: no contact for ' + from.email); return; }
          if (!c.isNew && skipOwner && c.owner === skipOwner) { skipped++; return; }
          const conv = mailInConversation_(c.id);
          if (!conv) { Logger.log('mailIn: no conversation for ' + from.email); return; }
          const r = ghlPost_('/conversations/messages/inbound', {
            type: 'Email', conversationId: conv, contactId: c.id, attachments: mailInAttach_(m, conv, c.id),
            subject: m.getSubject() || '(no subject)', html: (m.getBody() || m.getPlainBody()) + mailInAttachNote_(m),
            emailFrom: m.getFrom(), emailTo: 'info@australianmartialarts.com.au', altId: 'gmail-' + mid,
            date: new Date(at).toISOString()
          });
          if (r.code >= 300) Logger.log('mailIn post ' + r.code + ': ' + String(r.body).slice(0, 300));
          else posted++;
        } catch (e) { Logger.log('mailIn ' + from.email + ': ' + e); }
      });
    });
    props.setProperty('mailin_last', String(newest));
    props.setProperty('mailin_done', JSON.stringify(done.slice(-300)));
    if (posted || skipped) Logger.log('mailIn: posted ' + posted + ', skipped ' + skipped);
  } finally { lock.releaseLock(); }
}
// Run once from the editor (Mark clicks Allow): checks the inbox account, then turns on the 5-minute check.
function setupMailIn() {
  Logger.log('Reading inbox of: ' + Session.getEffectiveUser().getEmail());
  Logger.log('Inbox threads visible: ' + GmailApp.search('in:inbox newer_than:1d', 0, 5).length);
  try {
    const us = (ghlFetch_('/users/', { locationId: CONFIG.locationId }).users || []);
    us.forEach(function (u) { Logger.log('GHL user: ' + (u.name || (u.firstName + ' ' + u.lastName))); });
    const me = us.filter(function (u) { return /mark/i.test(u.firstName || u.name || '') && /loughran/i.test(u.lastName || u.name || ''); })[0];
    if (me) { PropertiesService.getScriptProperties().setProperty('mailin_skip_owner', me.id); Logger.log('Gmail-synced user: Mark Loughran'); }
  } catch (e) { Logger.log('users: ' + e); }
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'mailInTick') ScriptApp.deleteTrigger(t); });
  PropertiesService.getScriptProperties().setProperty('mailin_last', String(Date.now() - 10 * 60000));
  ScriptApp.newTrigger('mailInTick').timeBased().everyMinutes(5).create();
  Logger.log('Email catcher on: every 5 minutes, starting from emails in the last 10 minutes.');
}



// ===== Staff quiet hours (29 Oct 2026, Mark) =====
// Staff on the shift roster (Enquiry alerts tab) only get Hub texts during their shift (15 minutes either side).
// Texts outside their hours wait in a queue and go out when their next shift starts. Anyone not on the roster
// (e.g. Mark, Sarah) still gets texts straight away.
function staffShiftRow_(name) {
  const first = String(name || '').toLowerCase().split(' ')[0];
  const v = alertTab_().getDataRange().getValues();
  return v.slice(1).filter(function (x) { return String(x[0] || '').trim().toLowerCase().split(' ')[0] === first; })[0] || null;
}
function staffSpansOn_(row, d) {
  const day = Number(Utilities.formatDate(d, CONFIG.timezone, 'u')) - 1;
  return alertParseHours_(row[1 + day]);
}
function staffOnNow_(name) {
  const row = staffShiftRow_(name);
  if (!row) return true;
  const hasAny = [0, 1, 2, 3, 4, 5, 6].some(function (k) { return String(row[1 + k] || '').trim(); });
  if (!hasAny) return true;
  const now = new Date(), mins = Number(Utilities.formatDate(now, CONFIG.timezone, 'H')) * 60 + Number(Utilities.formatDate(now, CONFIG.timezone, 'm'));
  return staffSpansOn_(row, now).some(function (s) { return mins >= s[0] - 15 && mins <= s[1] + 15; });
}
function staffQueue_(name, text) {
  const p = PropertiesService.getScriptProperties(), q = JSON.parse(p.getProperty('staff_q') || '[]');
  q.push({ n: name, t: text, at: Date.now() });
  p.setProperty('staff_q', JSON.stringify(q.slice(-100)));
  Logger.log('staffQueue_: ' + name + ' is off shift, text held until their next shift');
}
// Runs every 10 minutes (from mydayWarm): sends held texts to anyone now on shift.
function staffQueueFlush() {
  const p = PropertiesService.getScriptProperties(), q = JSON.parse(p.getProperty('staff_q') || '[]');
  if (!q.length) return;
  const keep = [], cache = {};
  q.forEach(function (x) {
    const on = x.n in cache ? cache[x.n] : (cache[x.n] = staffOnNow_(x.n));
    if (!on && Date.now() - x.at < 8 * 86400000) { keep.push(x); return; }
    const m = hubStaffMobile_(x.n);
    if (m) { try { sendSms_(m, x.t); } catch (e) { Logger.log('staffQueueFlush: ' + e); } }
  });
  p.setProperty('staff_q', JSON.stringify(keep));
}




