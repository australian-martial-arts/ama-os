function cxCloseRequests_(b, id, who) {
  const norm = function (s) { return String(s || '').toLowerCase().replace(/[^a-z ]/g, ' ').replace(/\s+/g, ' ').trim(); };
  const names = String(b.students || '').split(/[,&\n]| and /i).map(norm).filter(function (s) { return s.split(' ').length >= 2; });
  const holder = norm((b.first || '') + ' ' + (b.last || '')), m9 = String(b.mobile || '').replace(/\D/g, '').slice(-9);
  const sh = reqSheet_(), H = REQ.headers, col = function (h) { return H.indexOf(h); };
