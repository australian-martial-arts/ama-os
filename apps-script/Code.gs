}
/* hub stage -> GHL stage (the pipeline's current stages; see PARTY_GHL_MAP once Mark approves new stages) */
const PARTY_GHL_MAP = { 'New enquiry': /new lead/i, 'Contacted': /sms follow up 1|phone call 1/i, 'Held (24h)': /tentativ/i, 'Confirmed': /^party booked$/i, 'Planning': /^party booked$/i,
  'Locked (7 days)': /^party booked$/i, 'Ready': /^party booked$/i, 'Completed': /^party booked$/i, 'Follow-up': /^party booked$/i, 'Closed': /^party booked$/i, 'Lost': /dnd|stop/i };
