/* ---------- monthly scorecard ---------- */
function partyScore_(rows) {
  const now = new Date(), ym = Utilities.formatDate(now, CONFIG.timezone, 'yyyy-MM'), last = Utilities.formatDate(new Date(now.getFullYear(), now.getMonth() - 1, 15), CONFIG.timezone, 'yyyy-MM');
  const calc = function (m) {
    const inM = rows.filter(function (p) { return partyCell_(p.Date).slice(0, 7) === m && partyLive_(p); });
    const done = inM.filter(function (p) { return ['Completed', 'Follow-up', 'Closed'].indexOf(p.Stage) > -1; });
    const slots = partySessions_(m + '-01', 31).filter(function (s) { return s.date.slice(0, 7) === m; }).reduce(function (n, s) { return n + s.cfg.max; }, 0);
    const rev = inM.reduce(function (s, p) { return s + (+p.Total || 0); }, 0);
    const enq = rows.filter(function (p) { return p.Created instanceof Date && Utilities.formatDate(p.Created, CONFIG.timezone, 'yyyy-MM') === m; }).length;
    return { month: m, enquiries: enq, booked: inM.length, delivered: done.length, slots: slots, utilisation: slots ? Math.round(inM.length / slots * 100) : 0, revenue: rev, avg: inM.length ? Math.round(rev / inM.length) : 0, kids: inM.reduce(function (s, p) { return s + (+p.Kids || 0); }, 0) };
  };
  return [calc(ym), calc(last)];
}

