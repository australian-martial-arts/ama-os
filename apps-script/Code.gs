function timesFor_(loc, day) {
  const o = CONFIG.overrides[loc];
  const list = (o && o[day]) ? o[day] : (CONFIG.defaultTimes[day] || []);
  return list.slice().sort();
}

// ---------------------------------------------------------------- SETUP

function getToken_() {
  const t = PropertiesService.getScriptProperties().getProperty('GHL_TOKEN');
  if (!t) throw new Error('No GHL_TOKEN in Script Properties. Add it in Project Settings.');
  return t;
}

function setup() {
  const props = PropertiesService.getScriptProperties();
  const map = {};

  Object.keys(CONFIG.locations).forEach(function (loc) {
    const calName = CONFIG.locations[loc].calendar;
    let cal = CalendarApp.getCalendarsByName(calName)[0];
    if (!cal) {
      cal = CalendarApp.createCalendar(calName, {
        summary: 'Trial bookings from GoHighLevel. Managed automatically.',
        timeZone: CONFIG.timezone
      });
      Logger.log('Created calendar: ' + calName);
    } else {
      Logger.log('Reusing calendar: ' + calName);
    }
    map[loc] = cal.getId();
  });

  props.setProperty('CALENDAR_MAP', JSON.stringify(map));

  const names = ghlGroups_().map(function (g) { return g.name; });
  const missing = [];
  Object.keys(CONFIG.locations).forEach(function (loc) {
    CONFIG.locations[loc].groups.forEach(function (gn) {
      if (names.indexOf(gn) === -1) missing.push(gn);
    });
  });
  if (missing.length) Logger.log('WARNING - groups not found in GHL: ' + missing.join(', '));
  else Logger.log('All configured groups matched.');
}

function installTriggers() {
  ScriptApp.getProjectTriggers().forEach(function (t) { ScriptApp.deleteTrigger(t); });

  const WD = {
    Mon: ScriptApp.WeekDay.MONDAY,    Tue: ScriptApp.WeekDay.TUESDAY,
    Wed: ScriptApp.WeekDay.WEDNESDAY, Thu: ScriptApp.WeekDay.THURSDAY,
    Fri: ScriptApp.WeekDay.FRIDAY,    Sat: ScriptApp.WeekDay.SATURDAY,
    Sun: ScriptApp.WeekDay.SUNDAY
  };

  const slots = {};
  Object.keys(CONFIG.locations).forEach(function (loc) {
    DAYS.forEach(function (day) {
      timesFor_(loc, day).forEach(function (t) { slots[day + ' ' + t] = true; });
    });
  });
  Object.keys(slots).sort().forEach(function (key) {
    const day = key.split(' ')[0];
    const hhmm = key.split(' ')[1];
    ScriptApp.newTrigger('sendDue').timeBased()
      .onWeekDay(WD[day])
      .atHour(Number(hhmm.split(':')[0]))
      .nearMinute(Number(hhmm.split(':')[1]))
      .create();
    Logger.log('Trigger: ' + day + ' ' + hhmm);
  });

  ScriptApp.newTrigger('syncCalendars').timeBased().everyHours(1).create();
  Logger.log('Plus syncCalendars hourly. Total ' +
             ScriptApp.getProjectTriggers().length + ' triggers.');
}

// ---------------------------------------------------------------- GHL API

function ghlFetch_(path, params) {
  const qs = Object.keys(params || {})
    .map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]); })
    .join('&');

  const res = UF_.fetch(CONFIG.ghlBase + path + (qs ? '?' + qs : ''), {
    method: 'get',
    muteHttpExceptions: true,
    headers: {
      'Authorization': 'Bearer ' + getToken_(),
      'Version': CONFIG.ghlVersion,
      'Accept': 'application/json'
    }
  });

  const code = res.getResponseCode();
  if (code < 200 || code >= 300) {
    throw new Error('GHL ' + code + ' on ' + path + ' - ' + res.getContentText().slice(0, 500));
  }
  return JSON.parse(res.getContentText());
}

function ghlGroups_() {
  const data = ghlFetch_('/calendars/groups', { locationId: CONFIG.locationId });
  return data.groups || data.data || [];
}

var _calNames = null;
function calendarName_(calendarId) {
  if (!_calNames) {
    _calNames = {};
    try {
      const data = ghlFetch_('/calendars/', { locationId: CONFIG.locationId });
      (data.calendars || data.data || []).forEach(function (c) { _calNames[c.id] = c.name; });
    } catch (err) {
      Logger.log('Could not load calendar names: ' + err.message);
    }
  }
  return _calNames[calendarId] || '';
}

function classOf_(e) { return className_(calendarName_(e.calendarId)); }

function ghlEvents_(groupId, start, end) {
  const data = ghlFetch_('/calendars/events', { locationId: CONFIG.locationId, groupId: groupId, startTime: start.getTime(), endTime: end.getTime() });
  /* 16 Nov 2026 (Mark): a family who books the same class more than once in the booking widget shows once (earliest booking kept),
     so no duplicate trial cards or duplicate texts. */
  const seen = {};
  return (data.events || data.data || []).filter(function (e) {
    const st = String(e.appointmentStatus || '').toLowerCase();
    return !(st === 'cancelled' || st === 'canceled' || st === 'noshow' || st === 'no-show');
  }).sort(function (a, b) { return String(a.dateAdded || '').localeCompare(String(b.dateAdded || '')); }).filter(function (e) {
    if (!e.contactId) return true;
    const key = e.contactId + '|' + e.calendarId + '|' + e.startTime;
    if (seen[key]) return false; seen[key] = 1; return true;
  });
}

