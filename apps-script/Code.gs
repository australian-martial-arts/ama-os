    v.forEach(function (r, i) {
      if (r[2] === 'Cancellation form') lk.getRange(i + 2, 4, 1, 2).setValues([['https://train.australianmartialarts.com.au/admin#cancel', 'Wants to stop? Try to keep them first, then log the 30 days notice.']]);
