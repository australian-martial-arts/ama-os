  const missing = REF.extra.filter(function (h) { return head.indexOf(h) < 0; });
  if (missing.length) { sh.getRange(1, head.length + 1, 1, missing.length).setValues([missing]).setFontWeight('bold'); head = head.concat(missing); }
  const C = {}; head.forEach(function (h, i) { C[h] = i; });
  ['Enrolled date', 'Location', 'Student who joined', 'Member who referred', 'Action', 'Action date', 'Reward chosen', 'Notes', 'Contact ID', 'Status'].forEach(function (h) {
