// 23 Nov 2026 (Mark): said "forgot to clock on" but clocked on more than 15 min after the start. Start is not backdated; the manager on duty, Hakan and Mark are told.
function dpaLateAlert_(name, school, o, t, r, mgr, send) {
  const mins = Math.round((t.StartTime - r.StartTime) / 60);
  const txt = name + ' said they forgot to clock on for the ' + o.when + ' shift at AMA ' + school + ', but only clocked on at ' + dpaT_(t.StartTime) + ' (' + mins + ' min after the start). Their start time was not changed.';
  if (!send || !GEOCHK.send) { Logger.log('late alert (preview): ' + txt); return; }
  const me = String(name || '').toLowerCase().split(' ')[0], to = [];
  if (mgr && mgr !== me) to.push(mgr); GEOCHK.cc.forEach(function (p) { if (to.indexOf(p) < 0 && p !== me) to.push(p); });
  to.forEach(function (p) { try { const m = payPersonMobile_(p); if (m) sendSms_(m, txt); } catch (e) { Logger.log('late alert ' + p + ': ' + e); } });
}
function geoTick_() {
  if (!GEOCHK.on) return [];
  const tz = payTz_(), now = new Date(), hr = Number(Utilities.formatDate(now, tz, 'H'));
  if (hr < GEOCHK.from || hr >= GEOCHK.until) return [];
  const today = Utilities.formatDate(now, tz, 'yyyy-MM-dd'), dow = Number(Utilities.formatDate(now, tz, 'u'));
  const P = PropertiesService.getScriptProperties(); let seen = {}; try { seen = JSON.parse(P.getProperty(GEOCHK.prop) || '{}'); } catch (e) { }
  if (seen.day !== today) seen = { day: today, k: {} };
  const ts = (deputyQuery_('Timesheet', { s1: { field: 'Date', type: 'ge', data: today }, s2: { field: 'Date', type: 'le', data: today } }) || []).filter(function (t) { return !t.Discarded && !t.IsLeave; });
  if (!ts.length) return [];
  const meta = payMeta_(), U = {}, N = {}; meta.units.forEach(function (u) { U[u.id] = u; }); meta.people.forEach(function (p) { N[p.id] = p.name; });
  const by = {}; ts.forEach(function (t) { by[t.Id] = t; });
  const geos = deputy_('/resource/Geo/QUERY', { search: { s1: { field: 'RecId', type: 'in', data: ts.map(function (t) { return t.Id; }) } }, max: 500 }) || [];
  const out = [];
  geos.forEach(function (g) {
    if (g.Orm && g.Orm !== 'DeputecTimesheet') return;
    if (g.Action !== 'TimesheetStart' && g.Action !== 'TimesheetEnd') return;
    const t = by[g.RecId]; if (!t) return;
    const key = g.RecId + (g.Action === 'TimesheetStart' ? 'S' : 'E'); if (seen.k[key]) return;
    const school = (U[t.OperationalUnit] || {}).school || '', c = GEOCHK.schools[school]; if (!c) return;
    const name = N[t.Employee] || ('Staff ' + t.Employee), first = payFirst_(name);
    seen.k[key] = 1;
    if (/^mark\b/i.test(name)) return;
    const km = geoKm_(c, [Number(g.Latitude), Number(g.Longitude)]), acc = Number(g.Accuracy || 0);
    const poor = acc > GEOCHK.poorAcc, away = (km * 1000 - Math.min(acc, 150)) > GEOCHK.maxM;
    if (!poor && !away) return;
    const what = g.Action === 'TimesheetStart' ? 'clocked on' : 'clocked off';
    const at = dpaT_(g.Action === 'TimesheetStart' ? t.StartTime : (t.EndTime || Math.floor(now.getTime() / 1000)));
    const kmTxt = km < 10 ? km.toFixed(1) : String(Math.round(km));
    const txt = away
      ? 'Deputy location check: ' + name + ' ' + what + ' for AMA ' + school + ' at ' + at + ' about ' + kmTxt + ' km from the school. Please check with ' + first + '.'
      : 'Deputy location check: ' + name + ' ' + what + ' for AMA ' + school + ' at ' + at + ' but their phone could not confirm where they were (GPS out by about ' + (acc / 1000).toFixed(1) + ' km). Please check with ' + first + '.';
    const mgr = (EOS.mgr[school] || {})[dow] || '', me = first.toLowerCase();
    const to = []; if (mgr && mgr !== me) to.push(mgr); GEOCHK.cc.forEach(function (p) { if (to.indexOf(p) < 0 && p !== me) to.push(p); });
    out.push(txt + ' -> ' + to.join(', '));
    try { payLog_({ name: 'Hub' }, away ? (what === 'clocked on' ? 'Clocked on away from school' : 'Clocked off away from school') : 'Location not confirmed', name, school, Utilities.formatDate(new Date(t.StartTime * 1000), tz, 'EEE d MMM h:mma'), away ? kmTxt + ' km from ' + school : 'GPS out by ' + Math.round(acc) + ' m', '', t.Roster || '', GEOCHK.send ? 'Needs checking' : 'Preview'); } catch (e) { Logger.log('geo log ' + e); }
    if (GEOCHK.send) to.forEach(function (p) { try { const m = payPersonMobile_(p); if (m) sendSms_(m, txt); } catch (e) { Logger.log('geo sms ' + p + ': ' + e); } });
  });
  // 23 Nov 2026 (Mark): clocked on with no rostered shift: same-day alert (manager on duty, Hakan, Mark)
  ts.forEach(function (t) {
    if (t.Roster || seen.k['U' + t.Id]) return;
    if (Math.floor(now.getTime() / 1000) - t.StartTime < 10 * 60) return;
    seen.k['U' + t.Id] = 1;
    const school = (U[t.OperationalUnit] || {}).school || 'AMA', name = N[t.Employee] || ('Staff ' + t.Employee), first = payFirst_(name), me = first.toLowerCase();
    if (/^mark\b/i.test(name)) return;
    const txt = 'Deputy check: ' + name + ' clocked on for AMA ' + school + ' at ' + dpaT_(t.StartTime) + ' without a rostered shift. Please check with ' + first + '.';
    const mgr = (EOS.mgr[school] || {})[dow] || '', to = []; if (mgr && mgr !== me) to.push(mgr); GEOCHK.cc.forEach(function (p) { if (to.indexOf(p) < 0 && p !== me) to.push(p); });
    out.push(txt + ' -> ' + to.join(', '));
    try { payLog_({ name: 'Hub' }, 'Unrostered clock-on', name, school, Utilities.formatDate(new Date(t.StartTime * 1000), tz, 'EEE d MMM h:mma'), 'Clocked on with no rostered shift', '', '', GEOCHK.send ? 'Needs checking' : 'Preview'); } catch (e) { Logger.log('unrostered log ' + e); }
    if (GEOCHK.send) to.forEach(function (p) { try { const m = payPersonMobile_(p); if (m) sendSms_(m, txt); } catch (e) { Logger.log('unrostered sms ' + p + ': ' + e); } });
  });
  P.setProperty(GEOCHK.prop, JSON.stringify(seen));
  return out;
}

// 23 Nov 2026 (Mark): pay only the rostered time. Once a shift is finished, the Deputy timesheet is trimmed to the roster:
// clock on early = paid from the rostered start, stay back = paid to the rostered finish. Extra time added in the hub extends the roster,
// so it is still paid. Only timesheets not yet approved or exported are touched; every trim is noted on the timesheet and the log.
var TRIM = { on: true, days: 2, skip: ['mark', 'sarah', 'hakan', 'ridvan', 'busra', 'laurie'] };
function trimTick_(dry) {
  if (!TRIM.on && !dry) return [];
  const tz = payTz_(), now = new Date(), nowS = Math.floor(now.getTime() / 1000);
  const from = Utilities.formatDate(new Date(now.getTime() - (TRIM.days - 1) * 864e5), tz, 'yyyy-MM-dd'), to = Utilities.formatDate(now, tz, 'yyyy-MM-dd');
  const all = (deputyQuery_('Timesheet', { s1: { field: 'Date', type: 'ge', data: from }, s2: { field: 'Date', type: 'le', data: to } }) || []).filter(function (t) { return !t.IsInProgress && !t.Discarded && !t.IsLeave && t.EndTime; });
  const ts = all.filter(function (t) { return !t.TimeApproved && !t.Exported; }), appr = all.filter(function (t) { return t.TimeApproved; });
  if (!all.length) return [];
  const ro = (deputyQuery_('Roster', { s1: { field: 'Date', type: 'ge', data: from }, s2: { field: 'Date', type: 'le', data: to } }) || []).filter(function (r) { return r.Employee; }), R = {}, M = {};
  ro.forEach(function (r) { R[r.Id] = r; if (r.MatchedByTimesheet) M[r.MatchedByTimesheet] = r; });
  const rosterFor = function (t) { return M[t.Id] || (t.Roster && R[t.Roster]) || ro.filter(function (r) { return r.Employee === t.Employee && r.StartTime < t.EndTime && r.EndTime > t.StartTime; })[0] || null; };
  const meta = payMeta_(), U = {}, N = {}; meta.units.forEach(function (u) { U[u.id] = u; }); meta.people.forEach(function (p) { N[p.id] = p.name; });
  const out = [];
  ts.forEach(function (t) {
    const r = rosterFor(t); if (!r || !r.StartTime || !r.EndTime) return;
    const name = N[t.Employee] || ('Staff ' + t.Employee); if (TRIM.skip.indexOf(name.toLowerCase().split(' ')[0]) > -1) return;
    const ns = Math.max(t.StartTime, r.StartTime), ne = Math.min(t.EndTime, r.EndTime);
    if (ns === t.StartTime && ne === t.EndTime) return;
    if (ne <= ns) { out.push('SKIP ' + name + ' no overlap with roster'); return; }
    const brk = Math.max(0, Math.round(((t.EndTime - t.StartTime) / 3600 - (+t.TotalTime || 0)) * 60));
    const cut = Math.round(((ns - t.StartTime) + (t.EndTime - ne)) / 60), school = (U[t.OperationalUnit] || {}).school || '';
    const note = 'Paid to the roster: clocked ' + dpaT_(t.StartTime) + '-' + dpaT_(t.EndTime) + ', paid ' + dpaT_(ns) + '-' + dpaT_(ne) + ' (' + cut + ' min outside the rostered shift is not paid unless extra time is added in the hub).';
    out.push(name + ' ' + school + ': ' + note);
    if (dry) return;
    try {
      deputy_('/supervise/timesheet/update', { intTimesheetId: t.Id, intStartTimestamp: ns, intEndTimestamp: ne, intMealbreakMinute: brk, intOpunitId: t.OperationalUnit, strComment: note });
      payLog_({ name: 'Hub' }, 'Paid to roster', name, school, payFmt_(r.StartTime) + ' to ' + payFmt_(r.EndTime, 'h:mma'), note, '', r.Id, 'Fixed');
    } catch (e) { payLog_({ name: 'Hub' }, 'Paid to roster', name, school, payFmt_(r.StartTime), 'Could not trim: ' + String(e).slice(0, 120), '', r.Id, 'Needs checking'); }
  });
  // 23 Nov 2026 (Mark): an APPROVED timesheet that runs past the roster is not changed, but it is flagged once (log + 8pm summary + Monday check).
  const P = PropertiesService.getScriptProperties(); let seen = {}; try { seen = JSON.parse(P.getProperty('TRIM_APPR_SEEN') || '{}'); } catch (e) { }
  appr.forEach(function (t) {
    if (seen[t.Id]) return;
    const r = rosterFor(t); if (!r || !r.StartTime || !r.EndTime) return;
    const name = N[t.Employee] || ('Staff ' + t.Employee); if (TRIM.skip.indexOf(name.toLowerCase().split(' ')[0]) > -1) return;
    const extra = Math.round(((Math.max(0, r.StartTime - t.StartTime)) + Math.max(0, t.EndTime - r.EndTime)) / 60);
    if (extra < 5) return;
    seen[t.Id] = 1;
    const school = (U[t.OperationalUnit] || {}).school || '';
    out.push('APPROVED PAST ROSTER ' + name + ' ' + extra + ' min');
    if (!dry) payLog_({ name: 'Hub' }, 'Approved past roster', name, school, payFmt_(r.StartTime) + ' to ' + payFmt_(r.EndTime, 'h:mma'), 'Approved for ' + dpaT_(t.StartTime) + '-' + dpaT_(t.EndTime) + ', ' + extra + ' min outside the rostered shift with no extra time added', '', r.Id, 'Needs checking');
  });
  if (!dry) { const keys = Object.keys(seen); if (keys.length > 400) keys.slice(0, keys.length - 400).forEach(function (k) { delete seen[k]; }); P.setProperty('TRIM_APPR_SEEN', JSON.stringify(seen)); }
  return out;
}

// 23 Nov 2026 (Mark): safety net. Once a day (after 2am) a full copy of this whole Apps Script project
// is saved to Drive folder 'AMA Hub code backups'. Copies are inert: no triggers, no deployment, no Script Properties.
