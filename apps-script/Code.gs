    f.done = Math.max(f.done, absStageIdx_(String(v[C['Stage done']] || '').trim()));
    const first = String(v[C['First name']] || '').trim(), lastN = String(v[C['Last name']] || '').trim();
    // 25 Nov 2026 (Mark): EFC age decides who is an adult. A child is never treated as their own parent; use the EFC parent name instead.
    const kid = absKid_(String(v[C['EFC member ID']] || '').trim(), first + ' ' + lastN);
    const isSelf0 = parent && parent.replace(/\s+/g, '').toLowerCase() === (first + lastN).replace(/\s+/g, '').toLowerCase();
    const isSelf = isSelf0 && !(kid.age && kid.age < 18);
    if (!isSelf && (isSelf0 || !f.parent) && kid.parent) f.parent = kid.parent; else if (isSelf0 && !isSelf) f.parent = '';
