function sendOneOff_(loc, slot, phone, label) {
  const now = new Date();
  const times = timesFor_(loc, dayCode_(now));
  const idx = times.indexOf(slot);
  const next = (idx >= 0 && idx + 1 < times.length) ? times[idx + 1] : null;

  const start = dateAt_(now, slot);
  const end = next ? dateAt_(now, next) : endOfDay_(now);

  const events = eventsForLocation_(loc, ghlGroups_(), start, end).sort(function (a, b) {
    return new Date(a.startTime) - new Date(b.startTime);
  });

  if (!events.length) {
    Logger.log('No trials for ' + loc + ' @' + slot + ' today - nothing to send.');
    return;
  }

  const body = buildBody_(loc, slot, events);
  Logger.log('Catch-up to ' + label + ':\n' + body);
  Logger.log(sendSms_(normalisePhone_(phone), body) ? 'Sent.' : 'FAILED - see above.');
}

