// ============================================================ WALK-IN RECOMMENDATIONS (23 Oct 2026)
// /staff-recommend posts each recommendation here when staff press "Agree & send".
// Logged on the Recommendations tab. If the family had no trial booked at that school today, it is also added
// to the Trial follow-up tab as a walk-in (attended, recommendation sent), so it shows on the hub's Trials list,
// is never asked about in the after-trial check, and lands on Follow up until they enrol.
const RECLOG = {
  tab: 'Recommendations',
  headers: ['Logged at', 'Date', 'Location', 'Parent first', 'Parent last', 'Mobile', 'Email', 'Students', 'Staff member', 'Logged by', 'Contact ID', 'Trial booked today', 'Walk-in ID', 'Ref', 'Snapshot', 'Correction']
};
function recLog_(b, who) {
  /* 13 Nov 2026 (Mark): only Mark, Sarah and Busra can change the first payment, and nothing outside the approved lists goes through.
     A send that breaks this is not logged and its joining link is switched off (the join page sees it as replaced). */
  try {
    const bad = recApprovalProblem_(b, who);
    if (bad) {
      const r0 = /^[a-z0-9]{6,16}$/.test(String(b.ref || '')) ? String(b.ref) : '';
      if (r0) PropertiesService.getScriptProperties().setProperty('recbad_' + r0, '1');
      try { actRow_(who.name, 'Recommendation', 'Recommendation blocked', '', bad.slice(0, 80)); } catch (e) { }
      return { ok: false, error: bad + ' The joining link from this send will not work. Ask Mark, Sarah or Busra.' };
    }
  } catch (e) { Logger.log('recApprovalProblem_: ' + e); }
  const ss = SpreadsheetApp.openById(HOLD.sheetId);
  let sh = ss.getSheetByName(RECLOG.tab);
  if (!sh) {
    sh = ss.insertSheet(RECLOG.tab);
    sh.getRange(1, 1, 1, RECLOG.headers.length).setValues([RECLOG.headers]).setFontWeight('bold').setBackground('#0d1511').setFontColor('#ffd200');
    sh.setFrozenRows(1);
    sh.getRange('F:F').setNumberFormat('@');
  }
  const now = new Date(), loc = String(b.loc || ''), mobile = normalisePhone_(String(b.mobile || ''));
  const day = hubStartOfDay_(now), end = new Date(day.getTime() + 86400000);
  let cid = '';
  try { cid = ghlContactIdByPhone_(mobile) || ''; } catch (e) {}
  let booked = '';
  if (cid && CONFIG.locations[loc]) {
    try {
      const ev = eventsForLocation_(loc, ghlGroups_(), day, end).filter(function (x) {
        const t = new Date(x.startTime); return t >= day && t < end && x.contactId === cid;
      })[0];
      if (ev) booked = ev.id;
    } catch (e) { Logger.log('recLog_ events: ' + e); }
  }
  let wid = '';
  if (!booked && !b.fix) { // 10 Nov 2026: a corrected recommendation is not a new walk-in
    wid = 'W' + Utilities.formatDate(now, CONFIG.timezone, 'yyMMddHHmmss');
    const ts = tcSheet_(), C = tcCols_(), r = TRIALCHECK.headers.map(function () { return ''; });
    r[C['Event ID']] = wid; r[C['Trial date']] = tcYmd_(now);
    r[C['Trial time']] = Utilities.formatDate(now, CONFIG.timezone, 'h:mm a').toLowerCase(); r[C['Location']] = loc;
    r[C['Child']] = String(b.students || ''); r[C['Class']] = 'Walk-in';
    r[C['Parent']] = (String(b.first || '') + ' ' + String(b.last || '')).trim(); r[C['Mobile']] = mobile; r[C['Contact ID']] = cid;
    r[C['Attended']] = 'Attended'; r[C['Recommendation sent']] = 'Yes';
    r[C['Notes']] = 'Walk-in, no trial booked. Recommendation sent by ' + (b.staff || who.name) + '.';
    r[C['Reported by']] = who.name; r[C['Reported at']] = now;
    ts.appendRow(r);
  }
  // 3 Nov 2026: a second send to the same mobile on the same day is a resend, not a new win.
  try { const lr = sh.getLastRow(); if (lr > 1) { const ymdNow = tcYmd_(now); b._resend = sh.getRange(2, 1, lr - 1, 6).getValues().some(function (r) { return String(r[1]) === ymdNow && normalisePhone_(String(r[5] || '')) === mobile; }); } } catch (e) { }
  try { if (String(sh.getRange(1, 14).getValue()) !== 'Ref') sh.getRange(1, 14, 1, 3).setValues([['Ref', 'Snapshot', 'Correction']]).setFontWeight('bold'); } catch (e) { }
  const ref = /^[a-z0-9]{6,16}$/.test(String(b.ref || '')) ? String(b.ref) : '';
  let snapTxt = ''; try { snapTxt = b.snap ? JSON.stringify(b.snap).slice(0, 45000) : ''; } catch (e) { }
  sh.appendRow([now, tcYmd_(now), loc, b.first || '', b.last || '', mobile, b.email || '', b.students || '', b.staff || '', who.name, cid, booked ? 'yes' : 'no', wid, ref, snapTxt, b.fix ? 'yes' : '']);
  /* 10 Nov 2026 (Mark): the newest recommendation's link is the only one that works */
  try { recRefSave_(ref, mobile); } catch (e) { Logger.log('recRefSave_: ' + e); }
  try { if (b.referrals && b.referrals.length) recReferralLog_(b, who, mobile); } catch (e) { Logger.log('referrals: ' + e); }
  let changedText = ''; try { if (cid) changedText = recChangedNotify_(cid, mobile, b.first || '', loc); } catch (e) { Logger.log('recChangedNotify_: ' + e); }
  if (b.fix && cid) { try { ghlPost_('/contacts/' + cid + '/notes', { body: 'Recommendation changed by ' + (b.staff || who.name) + (b.summary ? ': ' + String(b.summary).slice(0, 600) : '') + '. The earlier joining link no longer works.\n\n(' + who.name + ', AMA hub)' }); } catch (e) { } }
  try { actRow_(who.name, 'Recommendation', b.fix ? 'Recommendation changed' : 'Recommendation sent', cid, String(b.summary || b.students || '').slice(0, 80)); } catch (e) { }
  let later = '';
  if (b.startLater) { try { later = laterLog_(b, who, cid, mobile, loc); } catch (e) { Logger.log('later start: ' + e); } }
  CacheService.getScriptCache().remove(HUBDASH.cacheKey);
  return { ok: true, walkin: !!wid, later: later };
}







