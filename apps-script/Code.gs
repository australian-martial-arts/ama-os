const AMASSO = { base: 'https://app.train-ama.com/sso/#token=', paths: ['/', '/grading/', '/grading/coloured-belts/', '/grading/coloured-belts/ready', '/grading/coloured-belts/grading-days', '/Black-belt-prep-system/'] };
function amaSso_(who, b) {
