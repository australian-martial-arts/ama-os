/* ===== 3 Nov 2026 (Mark): weekly payroll from Deputy for Busra (Monday report). Read-only against Deputy. ===== */
const PAYROLL = { graceMins: 5, to: 'accounts@australianmartialarts.com.au' };
function payWeek_(mon) {
  const tz = CONFIG.timezone;
  const d0 = new Date(mon + 'T00:00:00'), sun = Utilities.formatDate(new Date(d0.getTime() + 6 * 86400000 + 3600000), tz, 'yyyy-MM-dd');
  const range = { s1: { field: 'Date', type: 'ge', data: mon }, s2: { field: 'Date', type: 'le', data: sun } };
  const emps = {}; deputy_('/resource/Employee').forEach(function (e) { emps[e.Id] = e; });
  const cos = {}; deputy_('/resource/Company').forEach(function (c) { cos[c.Id] = String(c.CompanyName).replace(/^Australian Martial Arts Academy\s*/, '') || c.CompanyName; });
  const units = {}; deputy_('/resource/OperationalUnit').forEach(function (u) { units[u.Id] = { name: u.OperationalUnitName, school: cos[u.Company] || '' }; });
  const ts = deputyQuery_('Timesheet', range).filter(function (t) { return !t.Discarded; });
  const ro = deputyQuery_('Roster', range);
  let prs = [], rules = {};
  if (ts.length) {
    try { prs = deputyQuery_('TimesheetPayReturn', { s1: { field: 'Timesheet', type: 'in', data: ts.map(function (t) { return t.Id; }) } }); } catch (e) { Logger.log('PayReturn: ' + e.message); }
    const rids = prs.map(function (p) { return p.PayRule; }).filter(function (x, i, a) { return x && a.indexOf(x) === i; });
    if (rids.length) try { deputyQuery_('PayRules', { s1: { field: 'Id', type: 'in', data: rids } }).forEach(function (r) { rules[r.Id] = r; }); } catch (e) { Logger.log('PayRules: ' + e.message); }
  }
  const T = function (u) { return u ? Utilities.formatDate(new Date(u * 1000), tz, 'EEE d MMM, h:mma').replace('AM', 'am').replace('PM', 'pm') : ''; };
  const name = function (id) { return emps[id] ? emps[id].DisplayName : ('Employee ' + id); };
  const tsById = {}; ts.forEach(function (t) { tsById[t.Id] = t; });
  const people = {}, fix = [], note = [];
  const P = function (id) { return people[id] = people[id] || { name: name(id), shifts: 0, hrs: 0, apprHrs: 0, unHrs: 0, cost: 0, lines: {}, schools: {} }; };
  ts.forEach(function (t) {
    const p = P(t.Employee), u = units[t.OperationalUnit] || {}, h = +t.TotalTime || 0;
    const it = { who: p.name, when: T(t.StartTime), school: u.school || '', hrs: h };
    p.shifts++; p.hrs += h; p.cost += +t.Cost || 0; if (u.school) p.schools[u.school] = 1;
    if (t.IsInProgress) fix.push(Object.assign({ type: 'open' }, it));
    else if (!t.TimeApproved) { p.unHrs += h; fix.push(Object.assign({ type: 'unapproved' }, it)); }
    else { p.apprHrs += h; if (h > 0 && !(+t.Cost)) fix.push(Object.assign({ type: 'norate' }, it)); }
    if (h > 10) fix.push(Object.assign({ type: 'long' }, it));
    if (!t.Roster) note.push(Object.assign({ type: 'noroster' }, it));
  });
  prs.forEach(function (r) {
    const t = tsById[r.Timesheet]; if (!t) return;
    const p = P(t.Employee), rule = rules[r.PayRule] || {}, k = rule.PayTitle || ('Pay rule ' + r.PayRule);
    const l = p.lines[k] = p.lines[k] || { hrs: 0, cost: 0, rate: rule.HourlyRate };
    l.hrs += +r.Value || 0; l.cost += +r.Cost || 0;
  });
  const now = Date.now() / 1000;
  ro.forEach(function (r) {
    if (!r.Employee || r.StartTime > now) return;
    const u = units[r.OperationalUnit] || {}, it = { who: name(r.Employee), when: T(r.StartTime), school: u.school || '', hrs: +r.TotalTime || 0 };
    const t = r.MatchedByTimesheet ? tsById[r.MatchedByTimesheet] : null;
    if (!t) { fix.push(Object.assign({ type: 'nots' }, it)); return; }
    const late = Math.round((t.StartTime - r.StartTime) / 60);
    if (late > PAYROLL.graceMins) note.push(Object.assign({ type: 'late', mins: late }, it));
  });
  const list = Object.keys(people).map(function (k) { return people[k]; }).sort(function (a, b) { return a.name.localeCompare(b.name); });
  list.forEach(function (p) {
    const wk = Object.keys(p.lines).filter(function (k) { return /weekday/i.test(k); }).map(function (k) { return p.lines[k].rate; })[0];
    Object.keys(p.lines).forEach(function (k) { if (/sat|sun/i.test(k) && wk != null && p.lines[k].rate === wk) note.push({ type: 'flat', who: p.name, rule: k, rate: wk }); });
  });
  const sum = function (f) { return list.reduce(function (s, p) { return s + f(p); }, 0); };
  return { mon: mon, sun: sun, pulled: Utilities.formatDate(new Date(), tz, 'EEE d MMM yyyy, h:mma'), people: list, fix: fix, note: note,
    totalHrs: sum(function (p) { return p.hrs; }), apprHrs: sum(function (p) { return p.apprHrs; }), unHrs: sum(function (p) { return p.unHrs; }), totalCost: sum(function (p) { return p.cost; }),
    tsCount: ts.length, roCount: ro.length, draft: fix.length > 0 };
}

function payReportHtml_(r, fmtDay) {
