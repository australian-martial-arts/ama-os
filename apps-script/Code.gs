function auditOverlaps() {
  const LAURIE = 'T6hEdCOGKg644GS3EgDg';
  const props = PropertiesService.getScriptProperties();
  const plan = JSON.parse(props.getProperty('ASSIGN_PLAN'));
  const fixed = JSON.parse(props.getProperty('RESTORE_DONE') || '{}');
  const DAYIDX = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };

  const start = new Date().getTime();
  let ok = 0, failed = 0, skipped = 0;

  for (let i = 0; i < plan.length; i++) {
    if (new Date().getTime() - start > 280000) { Logger.log('*** time limit - run again ***'); break; }
    const p = plan[i];
    if (p.user.indexOf('no slots') > -1) { skipped++; continue; }
    if (fixed[p.id]) continue;

    let detail;
    try { const d = ghlFetch_('/calendars/' + p.id, {}); detail = d.calendar || d; }
    catch (e) { Logger.log('GET failed ' + p.name); failed++; continue; }

    const tm = (detail.teamMembers && detail.teamMembers[0]) || {};
    tm.userId = LAURIE;
    tm.priority = 0.5; tm.selected = true; tm.isPrimary = true;

    const oh = [];
    Object.keys(p.days).forEach(function (dayName) {
      p.days[dayName].forEach(function (iv) {
        oh.push({ daysOfTheWeek: [DAYIDX[dayName]], hours: [{
          openHour: Math.floor(iv[0] / 60), openMinute: iv[0] % 60,
          closeHour: Math.floor(iv[1] / 60), closeMinute: iv[1] % 60
        }]});
      });
    });

    const r = ghlPut_('/calendars/' + p.id, { teamMembers: [tm], openHours: oh });
    if (r.code >= 200 && r.code < 300) {
      ok++; fixed[p.id] = 1;
      Logger.log('restored  ' + p.name.replace('Book a Trial | ', ''));
    } else {
      failed++;
      Logger.log('FAIL ' + r.code + '  ' + p.name);
    }
  }

  props.setProperty('RESTORE_DONE', JSON.stringify(fixed));
  Logger.log('');
  Logger.log('restored ' + ok + ' | failed ' + failed + ' | done ' + Object.keys(fixed).length);
}

