  Logger.log((live ? 'DONE' : 'DRY RUN') + ': families ' + Object.keys(fam).length + ' | name already right ' + ok + ' | ' + (live ? 'fixed ' : 'would fix ') + fixed + ' | ' + (live ? 'created ' : 'would create ') + created + ' | adult students (left alone) ' + adult + ' | different name, left alone ' + other + (skipped ? ' | NOT REACHED (run again) ' + skipped : ''));
  Logger.log('Examples: ' + ex.join(' | '));
  if (oth.length) Logger.log('Left alone (GHL has another name): ' + oth.join(' | '));
}
