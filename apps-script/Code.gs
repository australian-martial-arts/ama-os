// Free times for one class over the next TBOOK.days days.
function hubTrialSlots_(b) {
  const cal = tbCalendars_().filter(function (c) { return c.ids.indexOf(b.calendarId) > -1; })[0];
  if (!cal) return { ok: false, error: 'Choose a class.' };
  const now = new Date(), end = new Date(now.getTime() + TBOOK.days * 86400000), tz = CONFIG.timezone, byDay = {};
  cal.ids.forEach(function (id) {
    /* 3 Nov 2026: GHL free-slots only accepts up to 31 days per request, so ask in 28-day pieces (TBOOK.days is 42) */
    let data = {};
    for (let from = now.getTime(); from < end.getTime(); from += 28 * 86400000) {
      const to = Math.min(end.getTime(), from + 28 * 86400000);
      try { const part = ghlFetch_('/calendars/' + id + '/free-slots', { startDate: from, endDate: to, timezone: tz }); Object.keys(part || {}).forEach(function (k) { if (/^\d{4}-\d{2}-\d{2}$/.test(k)) { const s = (data[k] && data[k].slots) || []; data[k] = { slots: s.concat((part[k] && part[k].slots) || []).filter(function (x, i, arr) { return arr.indexOf(x) === i; }) }; } }); } catch (e) { Logger.log('slots ' + id + ': ' + e); }
    }
    Object.keys(data).filter(function (k) { return /^\d{4}-\d{2}-\d{2}$/.test(k); }).forEach(function (k) {
      ((data[k] && data[k].slots) || []).forEach(function (s) { if (new Date(s) > now) (byDay[k] = byDay[k] || []).push({ iso: s, cal: id, t: Utilities.formatDate(new Date(s), tz, 'h:mm a').toLowerCase() }); });
    });
  });
  const days = Object.keys(byDay).sort().map(function (k) { return { ymd: k, label: Utilities.formatDate(tcParseYmd_(k), tz, 'EEE d MMM'), slots: byDay[k].sort(function (a, b) { return new Date(a.iso) - new Date(b.iso); }) }; });
  return { ok: true, days: days };
}

