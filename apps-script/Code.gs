function targetsAddSchool_(school, start, stop) {
  const sh = targetsSheet_(), M = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const have = sh.getLastRow() ? sh.getRange(1, 1, sh.getLastRow(), 1).getValues().map(function (r) { return String(r[0]); }) : [];
  if (have.indexOf(school + ' - Start') > -1) { Logger.log(school + ' already on the Targets tab - not changed'); return; }
  const head = ['Month', 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026, 'Avg', 'Best', 'Target'];
  let row0 = sh.getLastRow() ? sh.getLastRow() + 3 : 1;
  [['Start', start], ['Stop', stop]].forEach(function (b) {
    sh.getRange(row0, 1).setValue(school + ' - ' + b[0]).setFontWeight('bold').setFontColor('#1B7A3D');
    sh.getRange(row0 + 1, 1, 1, head.length).setValues([head]).setFontWeight('bold');
    sh.getRange(row0 + 2, 1, 12, head.length).setValues(b[1].map(function (r, i) { return [M[i]].concat(r); }));
    const f = [];
    for (let c = 2; c <= head.length; c++) { const L = String.fromCharCode(64 + c); f.push('=SUM(' + L + (row0 + 2) + ':' + L + (row0 + 13) + ')'); }
    sh.getRange(row0 + 14, 1).setValue('Total');
    sh.getRange(row0 + 14, 2, 1, f.length).setFormulas([f]);
    sh.getRange(row0 + 14, 1, 1, head.length).setFontWeight('bold');
