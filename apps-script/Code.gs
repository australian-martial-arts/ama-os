/* 25 Nov 2026 (Mark): who is booked into a class (tomorrow or later today) for the Today & coming up strip. Names and belts only. */
function upClass_(who, b) {
  const tz = CONFIG.timezone, today = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
  const s = efcSchoolOf_(String(b.school || '')), ymd = String(b.date || ''), sid = String(b.id || '');
  if (!s || !/^\d{4}-\d{2}-\d{2}$/.test(ymd) || !sid) return { ok: false, error: 'Choose a class.' };
  if (ymd < today) return { ok: false, error: 'That day has passed.' };
  const base = liveAtt_(who, {}); if (!base || !base.ok) return { ok: false, error: 'Not allowed.' };
  const UC = CacheService.getScriptCache(), uck = 'upcls_' + s + '_' + ymd + '_' + sid;
  try { const hit = UC.get(uck); if (hit) return JSON.parse(hit); } catch (e) {}
  const loc = efcLoc_(s), L = '/version/1/locations/' + loc, DAY = 864e5, base0 = new Date(ymd + 'T12:00:00');
  const past = [1, 2, 3, 4].map(function (w) { return Utilities.formatDate(new Date(base0.getTime() - w * 7 * DAY), tz, 'yyyy-MM-dd'); });
  const res = efcFetchMany_(s, [L + '/calendar/sessions/' + ymd + '/bookings'].concat(past.map(function (d) { return L + '/calendar/sessions/' + d + '/bookings'; })));
  const nm = function (m) { return [m && m.firstName, m && m.lastName].filter(Boolean).join(' ').trim(); };
  const belt = function (x) { return String((x.grade || {}).name || '').replace(/ Belt$/i, ''); };
  const list = (Array.isArray(res[0]) ? res[0] : []).filter(function (x) { return x.status !== 'cancelled' && String((x.bookable || {}).id) === sid; })
    .map(function (x) { return { name: nm(x.member), belt: belt(x) }; }).sort(function (p, q) { return p.name.localeCompare(q.name); });
  // Regulars: came to the same class (name + start time) on at least 2 of the last 4 same weekdays.
  const want = String(b.name || '').trim().toLowerCase() + '|' + String(b.start || '').slice(0, 5), seen = {}, got = {};
  list.forEach(function (x) { got[x.name] = 1; });
  res.slice(1).forEach(function (L2) { (Array.isArray(L2) ? L2 : []).forEach(function (x) {
    const bk = x.bookable || {}, here = x.status !== 'cancelled' && (x.attended || (x.checkIn && x.checkIn.status === 'present'));
    if (!here) return; if (String(bk.name || '').trim().toLowerCase() + '|' + String(x.startTime || bk.startTime || '').slice(0, 5) !== want) return;
    const id = (x.member || {}).id; if (!id) return; seen[id] = seen[id] || { name: nm(x.member), belt: belt(x), n: 0 }; seen[id].n++; }); });
  const usual = Object.keys(seen).map(function (k) { return seen[k]; }).filter(function (m) { return m.n >= 2 && !got[m.name]; })
    .sort(function (p, q) { return q.n - p.n || p.name.localeCompare(q.name); }).slice(0, 40);
  const outc = { ok: true, list: list, usual: usual };
  try { UC.put(uck, JSON.stringify(outc), 1800); } catch (e) {}
  return outc;
}

