// Rows from the History tab for the dashboard: [{school, d, type, cat, tenure, weeks, staff, source, pkg}]
function histRead_() {
  const sh = SpreadsheetApp.openById(HOLD.sheetId).getSheetByName(HIST.tab);
  if (!sh || sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, HIST.headers.length).getValues().map(function (r) {
    return { school: String(r[0]), d: r[1] instanceof Date ? r[1] : null, type: String(r[2]), cat: String(r[7] || ''),
      tenure: r[9] === '' ? null : Number(r[9]), weeks: r[10] === '' ? 0 : Number(r[10]) || 0, staff: staffAlias_(r[8]),
      source: String(r[6] || ''), pkg: String(r[5] || ''), resume: r[11] instanceof Date ? r[11] : null };
  }).filter(function (x) { return x.d; });
}

// Hub records in the same shape as History rows.
function histFromHub_(en, cx, ho, recStaff) {
  const out = [];
  en.forEach(function (e) {
    out.push({ school: e.loc, d: e.d, type: 'Start', cat: '', tenure: null, weeks: 0,
      staff: staffAlias_(e.rec !== 'Not recorded' ? e.rec : (recStaff[e.cid] || '')), source: e.heard, pkg: e.pkg });
  });
  cx.forEach(function (c) {
    if (c.saved || c.withdrawn) return;
    for (let i = 0; i < (c.n || 1); i++) out.push({ school: c.loc, d: c.d, type: 'Stop', cat: histCatStop_(c.reason), tenure: c.mos, weeks: 0, staff: c.by, source: c.reason, pkg: '' });
  });
  ho.forEach(function (h) {
    if (h.saved || h.declined) return;
    out.push({ school: h.loc, d: h.d, type: 'Hold', cat: histCatHold_(h.reason), tenure: null, weeks: h.wg || h.wk || 0, staff: '', source: h.reason, pkg: '' });
  });
  return out;
}

// One year of rows from both sources. Stops and holds: old sheet before HIST.hubFrom, hub from then on.
// Starts: for each school and week, whichever source recorded more (the hub took over starts gradually).
function histMerge_(H, hub) {
  const mon = function (d) { const x = new Date(d.getFullYear(), d.getMonth(), d.getDate()); x.setDate(x.getDate() - ((x.getDay() + 6) % 7)); return x.getTime(); };
  const key = function (x) { return String(x.school).toLowerCase() + '|' + mon(x.d); };
  const hs = {}, hb = {};
  H.forEach(function (x) { if (x.type === 'Start') hs[key(x)] = (hs[key(x)] || 0) + 1; });
  hub.forEach(function (x) { if (x.type === 'Start') hb[key(x)] = (hb[key(x)] || 0) + 1; });
  const keep = H.filter(function (x) { return x.type === 'Start' ? (hs[key(x)] || 0) >= (hb[key(x)] || 0) : x.d < HIST.hubFrom; });
  const add = hub.filter(function (x) { return x.type === 'Start' ? (hb[key(x)] || 0) > (hs[key(x)] || 0) : x.d >= HIST.hubFrom; });
  return keep.concat(add);
}

// Summary for the dashboard: per school (and All schools) monthly counts, year-to-date totals and breakdowns.
function mgmtHistBuild_(H, avgRate, year) {
  const schools = ['All schools'].concat(HUBDASH.locations), out = {}, monthly = {};
  schools.forEach(function (sc) {
    const rows = H.filter(function (x) { return x.d.getFullYear() === year && (sc === 'All schools' || x.school.toLowerCase() === sc.toLowerCase()); });
    if (!rows.length) return;
    const months = [];
    for (let m = 0; m < 12; m++) {
      const r = rows.filter(function (x) { return x.d.getMonth() === m; });
      const holds = r.filter(function (x) { return x.type === 'Hold' && !/package change/i.test(x.cat); });
      months.push({ starts: r.filter(function (x) { return x.type === 'Start'; }).length, stops: r.filter(function (x) { return x.type === 'Stop'; }).length,
        holds: holds.length, holdWeeks: holds.reduce(function (a, x) { return a + x.weeks; }, 0) });
    }
    monthly[sc] = months;
    const tally = function (list, f) { const m = {}; list.forEach(function (x) { const k = f(x) || 'Not given'; m[k] = (m[k] || 0) + 1; });
      return Object.keys(m).map(function (k) { return { k: k, n: m[k] }; }).sort(function (a, b) { return b.n - a.n; }); };
    const stops = rows.filter(function (x) { return x.type === 'Stop'; });
    const holds = rows.filter(function (x) { return x.type === 'Hold' && !/package change/i.test(x.cat); });
    const starts = rows.filter(function (x) { return x.type === 'Start'; });
    const tb = function (t) { return t === null || isNaN(t) ? 'Not recorded' : t < 3 ? 'Under 3 months' : t < 12 ? '3 to 12 months' : t < 36 ? '1 to 3 years' : '3 years or more'; };
    const holdWeeks = holds.reduce(function (a, x) { return a + x.weeks; }, 0);
    out[sc] = { months: months.map(function (x, i) { x.m = i; return x; }),
      ytd: { starts: starts.length, stops: stops.length, holds: holds.length, holdWeeks: holdWeeks, holdCost: Math.round(holdWeeks * avgRate),
        avgHoldWeeks: holds.filter(function (x) { return x.weeks; }).length ? Math.round(10 * holdWeeks / holds.filter(function (x) { return x.weeks; }).length) / 10 : null },
      stopReasons: tally(stops, function (x) { return x.cat; }), holdReasons: tally(holds, function (x) { return x.cat; }),
      tenure: ['Under 3 months', '3 to 12 months', '1 to 3 years', '3 years or more', 'Not recorded'].map(function (k) { return { k: k, n: stops.filter(function (x) { return tb(x.tenure) === k; }).length }; }),
      startStaff: tally(starts, function (x) { return x.staff; }).slice(0, 10), stopStaff: tally(stops, function (x) { return x.staff; }).slice(0, 10) };
  });
  return { bySchool: out, monthly: monthly, imported: PropertiesService.getScriptProperties().getProperty('hist_imported') || '',
    hubFrom: Utilities.formatDate(HIST.hubFrom, CONFIG.timezone, 'd MMM') };
}

