// ---------------------------------------------------------------- GRADING NUMBERS: writing the sheet
/* 13 Nov 2026 (Mark): the hub keeps the "Grading Numbers – all schools" sheet up to date by itself, from Tate's Toolkit.
   Every hour: the "Live – this round" tab (expected, booked, invited, % of target per grading).
   Once a day: one line per grading on the "Booking log" tab (so the next round can be compared with this one).
   After a grading day, once the Toolkit sends results: the graded numbers go into Gradings, Black Belts,
   Little Dragons, Not graded and the other style tabs (the row for that school and month is updated, never duplicated).
   Nothing is typed in by hand. Run gnSyncInstall() once to start the hourly run. */
function gnSyncInstall() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'gnSync') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('gnSync').timeBased().everyHours(1).create();
  gnSync();
}
function gnSync() {
  const lock = LockService.getScriptLock(); if (!lock.tryLock(20000)) return;
  try {
    const ss = SpreadsheetApp.openById(GNUMS.sheetId), tz = CONFIG.timezone, now = new Date();
    const o = gnumsBuild_();
    try { CacheService.getScriptCache().put(GNUMS.cacheKey, JSON.stringify(o), 600); } catch (e) { }
    const T = gmoneyFetch_();
    const res = T.ok ? gnWriteResults_(ss, T.data, now) : { notes: ['Toolkit not reachable: ' + T.error] };
    gnWriteLive_(ss, o, res, now);
    gnLogDay_(ss, o, now);
    PropertiesService.getScriptProperties().setProperty('gn_last_sync', Utilities.formatDate(now, tz, 'yyyy-MM-dd HH:mm'));
  } finally { lock.releaseLock(); }
}
