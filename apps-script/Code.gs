    after = cs[cs.length - 1].sort ? cs[cs.length - 1].sort[0] : cs[cs.length - 1].lastMessageDate;
    if (stop) break;
  }
  Logger.log('Conversations since Sun noon: ' + n);
  Logger.log('Outbound SMS (last message) by hour: ' + JSON.stringify(hours));
  Object.keys(tally).sort(function (a, b) { return tally[b] - tally[a]; }).slice(0, 25).forEach(function (k) { Logger.log(tally[k] + ' x ' + k); });
}

