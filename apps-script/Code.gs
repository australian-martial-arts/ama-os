function hubEnrolDedupeRows_(t) {
  const iM = t.head.indexOf('Mobile'), iN = t.head.indexOf('Student name'), iP = t.head.indexOf('Package');
  if (iM < 0 || iN < 0) return t.rows;
  const key = function (r) { const m = String(r[iM] || '').replace(/\D/g, '').slice(-9), n = String(r[iN] || '').trim().toLowerCase().split(/\s+/)[0]; return m.length === 9 && n ? m + '|' + n : ''; };
  const best = {};
  t.rows.forEach(function (r, i) { const k = key(r); if (!k) return; const full = iP > -1 && String(r[iP] || '').trim() ? 1 : 0; if (!best[k] || full > best[k].full) best[k] = { i: i, full: full }; });
  return t.rows.filter(function (r, i) { const k = key(r); return !k || best[k].i === i; });
}

