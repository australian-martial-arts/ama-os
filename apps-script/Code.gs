    const d = hubDashboard_(who), s = hubStartOfDay_(new Date()).getTime(), e = s + 86400000;
    const o = JSON.parse(JSON.stringify(d));
    o.trials = (d.trials || []).filter(function (t) { return locs.indexOf(t.loc) > -1 && t.t >= s && t.t < e && !t.walkin; });
    o.locations = locs; o.instructor = true;
    return o;
  }
  if (body.kind === 'check' || body.kind === 'checksave') {
    if (!locs.length) return { ok: false, error: 'You are not on the trial roster today.' };
    if (locs.indexOf(String(body.loc || '')) < 0) { if (body.kind === 'check') return { ok: true, loc: String(body.loc || ''), trials: [] }; /* 16 Nov 2026: a school they are not rostered at shows nothing (it used to repeat their own school's trials once per school) */ body.loc = locs[0]; }
  }
  if (body.kind === 'links') return { ok: true, links: [] };
  return null;
}
