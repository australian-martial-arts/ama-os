    sess.forEach(function (s) { const k = s.date + '|' + s.school + '|' + s.period; keep.push([empId, me.name, s.date, s.school, s.period, !!want[k], new Date()]); });
    sh.clearContents(); sh.getRange(1, 1, keep.length, keep[0].length).setValues(keep);
