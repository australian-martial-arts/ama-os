// Hub: log a cancellation (or a save).
function cxSubmitRaw_(b, who) {
  const inPerson = b.emailIn === 'inperson' && !b.saved;
  if (inPerson && !cxCanInPerson_(who)) return { ok: false, error: 'Only head instructors can take notice in person. Ask them to email instead.' };
  if (!b.saved && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(String(b.email || '').trim())) return { ok: false, error: 'Add the parent\'s email so they can sign the cancellation.' };
  const sh = cxSheet_(), C = cxCols_(), id = cxNewId_(), now = new Date();
  const r = CANCEL.headers.map(function () { return ''; });
  const set = function (k, v) { r[C[k]] = v === undefined || v === null ? '' : v; };
  const holder = ((b.first || '') + ' ' + (b.last || '')).trim();
  set('Request ID', id); set('Logged at', now); set('Account holder', holder);
  set('Mobile', normalisePhone_(b.mobile)); set('Email', b.email); set('Students', b.students);
  set('Student count', cxCountKids_(b.students)); set('Trains at', b.location); set('Reason', b.reasonText || b.reason);
  set('In their words', holdTidy_(b.words)); set('Offered', b.offered); set('Complaint', b.complaint ? 'yes' : '');
  set('Joined', b.joined); set('Months a member', b.months); set('Uniform balance', b.uniform); set('Taken by', who.name);
  set('Notes', holdTidy_(b.notes));

  let status, smsApprovers = false;
  const wanted = tcParseYmd_(b.wanted);
  if (b.saved) {
    status = 'saved - ' + (b.offered || 'stayed');
  } else if (b.emailIn !== 'yes' && !inPerson) {
    status = 'waiting for signature';
    set('Wanted last class', wanted); if (wanted && b.pushBack) set('Short notice', 'asked');
  } else {
    const recv = inPerson ? hubStartOfDay_(now) : (tcParseYmd_(b.emailDate) || hubStartOfDay_(now));
    set('Notice given', inPerson ? 'In person to ' + who.name : 'Email');
    const ends = new Date(hubStartOfDay_(recv).getTime() + CANCEL.noticeDays * 86400000);
    const short = !!(wanted && wanted < ends);
    set('Notice email received', recv); set('Notice ends', ends); set('Wanted last class', wanted);
    set('Short notice', short ? 'yes' : 'no');
    if (short && b.pushBack) {
      if (cxSelfApprover_(who.name)) {
        status = 'approved early stop'; set('Last class', wanted); set('Notice ends', wanted);
        r[C['Approved by']] = who.name + ' (co-coordinator)'; r[C['Approved by'] + 1] = now;
        try { holdSmsApprovers_('FYI ' + who.name + ' approved an early stop: ' + holder + ' (' + (b.location || '-') + '). Last class ' + Utilities.formatDate(wanted, CONFIG.timezone, 'EEE d MMM') + ' instead of ' + Utilities.formatDate(ends, CONFIG.timezone, 'EEE d MMM') + '. Reason: ' + (b.reasonText || b.reason || '-') + '. No reply needed.'); } catch (e) { Logger.log('self approve fyi ' + e); }
      } else {
        status = 'awaiting approval'; set('Last class', ends); smsApprovers = true;
      }
    } else {
      status = 'notice running'; set('Last class', ends);
    }
  }
  set('Status', status);
  sh.appendRow(r);
  CacheService.getScriptCache().remove(HUBDASH.cacheKey);

  if (smsApprovers) {
    holdSmsApprovers_('AMA cancellation needs a yes/no: ' + id + ' ' + holder + ' (' + (b.location || '?') + ', ' + (b.students || '') + '). ' +
      'Wants last class ' + Utilities.formatDate(wanted, CONFIG.timezone, 'EEE d MMM') + ' but 30 days notice runs to ' +
      Utilities.formatDate(r[C['Notice ends']], CONFIG.timezone, 'EEE d MMM') + '. Reason: ' + (b.reasonText || b.reason) +
      (b.offered ? '. Offered: ' + b.offered + ' - declined' : '') + '. Taken by ' + who.name +
      '. Reply YES ' + id + ' to let them stop early, NO ' + id + ' to hold to 30 days.');
  }
  let emailed = '';
  if (!b.saved) emailed = cxSendSignLink_(sh.getLastRow(), r); // parent signs online (CANCELLATION SIGNING)
  if (b.complaint && !b.saved) {
    try { sendSms_(cxComplaintsTo_(), 'AMA complaint with a cancellation: ' + id + ' ' + holder + ' (' + (b.location || '?') + '). ' + String(b.words || '').slice(0, 300) + ' - taken by ' + who.name); } catch (e) { Logger.log('complaint sms: ' + e); }
  }
  return { ok: true, id: id, status: status, emailed: emailed, noticeEnds: r[C['Notice ends']] ? cxDateText_(r[C['Notice ends']]) : '' };
}

// YES/NO from Mark or Sarah on a short-notice cancellation.
function cxDecide_(row, v, yes, who) {
  const sh = cxSheet_(), C = cxCols_();
  const id = String(v[C['Request ID']]), holder = String(v[C['Account holder']]), staff = String(v[C['Taken by']] || 'the staff member');
  const wanted = v[C['Wanted last class']], ends = v[C['Notice ends']];
  sh.getRange(row, C['Status'] + 1).setValue(yes ? 'approved early stop' : 'notice running');
  sh.getRange(row, C['Last class'] + 1).setValue(yes && wanted ? wanted : ends);
  if (yes && wanted) sh.getRange(row, C['Notice ends'] + 1).setValue(wanted); // early stop: payments stop then too (Mark, 24 Oct)
  sh.getRange(row, C['Approved by'] + 1, 1, 2).setValues([[who.name + (yes ? '' : ' (held to 30 days)'), new Date()]]);
  CacheService.getScriptCache().remove(HUBDASH.cacheKey);
  const lastTxt = yes && wanted ? Utilities.formatDate(new Date(wanted), CONFIG.timezone, 'EEE d MMM') : Utilities.formatDate(new Date(ends), CONFIG.timezone, 'EEE d MMM');
  holdSmsOthers_(who, who.name + (yes ? ' approved the early stop for ' : ' held to 30 days: ') + id + ' - ' + holder + '. Nothing needed from you.');
  if (yes && wanted && CANCEL.emailEarlyStop) { try { const f2 = cxFind_(id); cxGhlEmail_(v[C['Mobile']], v[C['Email']], 'Updated cancellation dates \u2013 AMA reference ' + id, cxEarlyStopText_(cxDetails_(f2))); } catch (e) { Logger.log('early stop email: ' + e); } }
  sendSms_(who.mobile, id + (yes ? ' approved. Last class and last payment ' : ' held to 30 days. Last class and last payment ') + lastTxt + '. ' + (staffTell_(staff, 'AMA: ' + who.name + (yes ? ' approved the early stop for ' : ' said no to stopping early for ') + holder + ' (' + id + '). Last class and last payment: ' + lastTxt + '. Please let ' + holder.split(' ')[0] + ' know.', who.mobile) ? staff + ' has been texted to tell ' + holder.split(' ')[0] + '.' : (staff === who.name ? 'Please let ' + holder.split(' ')[0] + ' know.' : staff + ' needs to tell ' + holder.split(' ')[0] + '.')));
  return { ok: true, id: id, decision: yes ? 'approved' : 'held', by: who.name };
}

// All YES/NO replies come through here: cancellations first, then freezes.
function hubReply_(b) {
  const from = b.from || b.phone || '', text = String(b.body || b.message || '').trim();
  const who = holdApproverByPhone_(from);
  if (who && /^\s*cover\b/i.test(text)) return coverHandle_(who, text);
  if (who && /^\s*(fast\s*-?\s*track|ft)\b/i.test(text)) return cxFastTrackText_(who, text); // 5 Nov 2026
  const m = text.match(/^\s*(yes|y|no|n)\b\s*(.*)$/i);
  if (!who || !m) return holdHandleReply_(b);
  const yes = /^y/i.test(m[1]), hint = String(m[2] || '').trim();
  const sh = cxSheet_(), C = cxCols_(), last = sh.getLastRow();
  const cx = [];
  if (last > 1) sh.getRange(2, 1, last - 1, CANCEL.headers.length).getValues().forEach(function (v, i) { if (v[C['Status']] === 'awaiting approval') cx.push({ row: i + 2, v: v }); });
  if (!cx.length) return holdHandleReply_(b);
  if (/\bH\d{4}\b/i.test(hint)) return holdHandleReply_(b);
  if (hint) {
    const h = hint.toLowerCase();
    const pick = cx.filter(function (p) { return (String(p.v[C['Request ID']]) + ' ' + p.v[C['Account holder']] + ' ' + p.v[C['Students']]).toLowerCase().indexOf(h) > -1; })[0];
    return pick ? cxDecide_(pick.row, pick.v, yes, who) : holdHandleReply_(b);
  }
  const hs = holdSheet_(), hl = hs.getLastRow();
  const holdsWaiting = hl > 1 ? hs.getRange(2, holdCol_('Status'), hl - 1, 1).getValues().filter(function (r) { return r[0] === 'awaiting approval'; }).length : 0;
  if (cx.length === 1 && !holdsWaiting) return cxDecide_(cx[0].row, cx[0].v, yes, who);
  const list = cx.map(function (p) { return p.v[C['Request ID']] + ' ' + p.v[C['Account holder']]; }).join(', ');
  sendSms_(who.mobile, (cx.length + holdsWaiting) + ' waiting. Reply ' + m[1].toUpperCase() + ' and the ID. Cancellations: ' + list + (holdsWaiting ? '. Plus ' + holdsWaiting + ' freeze(s) - reply with the H number.' : ''));
  return { ok: true, matched: 0, ambiguous: cx.length + holdsWaiting };
}

