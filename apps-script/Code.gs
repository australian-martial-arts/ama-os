/* ===== 17 Nov 2026 (Mark): REQUEST A HUB CHANGE. Any staff member: the "Request a change" button on every hub page.
   Requests go to the 'Hub change requests' tab and Mark gets a text. Mark approves / says not now / marks done in
   Team > Hub change requests. Approved ones are built one at a time, so nobody's changes overwrite anyone else's. ===== */
const HUBREQ = { tab: 'Hub change requests', approver: 'mark', cols: ['Id', 'Date', 'From', 'Where in the hub', 'Request', 'How soon', 'Status', 'Mark\'s note', 'Updated'] };
function hubReqSheet_() {
  const ss = SpreadsheetApp.openById(HOLD.sheetId); let sh = ss.getSheetByName(HUBREQ.tab);
  if (!sh) { sh = ss.insertSheet(HUBREQ.tab); sh.appendRow(HUBREQ.cols); sh.setFrozenRows(1); sh.getRange(1, 1, 1, HUBREQ.cols.length).setFontWeight('bold'); sh.setColumnWidth(5, 420); }
  return sh;
}
function hubReq_(who, b) {
  const act = String(b.act || 'list'), me = String((who && who.name) || '').trim(), key = me.split(/\s+/)[0].toLowerCase(), boss = key === HUBREQ.approver;
  const tz = CONFIG.timezone, sh = hubReqSheet_();
  if (act === 'add') {
    const text = String(b.text || '').trim().slice(0, 1500); if (text.length < 5) return { ok: false, error: 'Say what you would like changed.' };
    const where = String(b.where || '').slice(0, 80), soon = ['Nice to have', 'Soon', 'Urgent'].indexOf(String(b.soon)) > -1 ? String(b.soon) : 'Nice to have';
    const id = 'R' + Utilities.formatDate(new Date(), tz, 'yyMMddHHmmss');
    sh.appendRow([id, new Date(), me, where, text, soon, 'New', '', new Date()]);
    if (!boss) { try { sendSms_(payPersonMobile_('mark'), 'Hub change request from ' + payFirst_(key) + ' (' + soon.toLowerCase() + '): ' + text.slice(0, 220) + (text.length > 220 ? '...' : '') + ' Approve it in the hub: Team > Hub change requests.'); } catch (e) { } }
    return { ok: true, id: id };
  }
  if (act === 'set') {
    if (!boss) return { ok: false, error: 'Only Mark can change the status.' };
    const st = ['New', 'Approved', 'Not now', 'Done'].indexOf(String(b.status)) > -1 ? String(b.status) : 'New';
    const v = sh.getLastRow() > 1 ? sh.getRange(2, 1, sh.getLastRow() - 1, 1).getValues() : [];
    for (let i = 0; i < v.length; i++) if (String(v[i][0]) === String(b.id)) { sh.getRange(i + 2, 7, 1, 3).setValues([[st, String(b.note || '').slice(0, 300), new Date()]]); return { ok: true }; }
    return { ok: false, error: 'Not found.' };
  }
  const rows = sh.getLastRow() > 1 ? sh.getRange(2, 1, sh.getLastRow() - 1, 9).getValues() : [];
  return { ok: true, boss: boss, me: me, list: rows.reverse().map(function (r) { return { id: String(r[0]), at: r[1] instanceof Date ? Utilities.formatDate(r[1], tz, 'EEE d MMM h:mma') : String(r[1]), from: String(r[2]), where: String(r[3]), text: String(r[4]), soon: String(r[5]), status: String(r[6]), note: String(r[7]) }; }) };
}

