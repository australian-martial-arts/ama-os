  const P = PropertiesService.getScriptProperties(), key = myworkTickKey_(who), today = Utilities.formatDate(new Date(), CONFIG.timezone, 'yyyy-MM-dd'), cut = Utilities.formatDate(new Date(Date.now() - 7 * 864e5), CONFIG.timezone, 'yyyy-MM-dd');
