// ============================================================ ONE TRIAL-TEXT ALARM (24 Oct 2026)
// Replaces the one-trigger-per-send-time setup (11 triggers) with one 15-minute check. Each send time is sent once,
// within 15 minutes after it is due (never more than 60 minutes late), and remembered so it cannot go twice.
function sdDue_(now, markSent) {
  const day = dayCode_(now), mins = nowMinutes_(now), props = PropertiesService.getScriptProperties();
  const ymd = Utilities.formatDate(now, CONFIG.timezone, 'yyyy-MM-dd'), due = [];
  Object.keys(CONFIG.locations).forEach(function (loc) {
    const times = timesFor_(loc, day);
    times.forEach(function (t, i) {
      const tm = toMinutes_(t), key = 'sd_' + ymd + '_' + loc + '_' + t;
      if (tm > mins || mins - tm > 60 || props.getProperty(key)) return;
      if (markSent) props.setProperty(key, '1');
      due.push({ loc: loc, slot: t, next: i + 1 < times.length ? times[i + 1] : null, isMain: i === times.length - 1, first: i === 0 });
    });
  });
  if (markSent) props.getKeys().forEach(function (k) { if (/^sd_/.test(k) && k.indexOf('sd_' + ymd + '_') !== 0) props.deleteProperty(k); });
  return due;
}
function sendDueTick() {
  const lock = LockService.getScriptLock(); if (!lock.tryLock(20000)) return;
  try { const now = new Date(), due = sdDue_(now, true); if (due.length) { Logger.log('Due now: ' + due.map(function (d) { return d.loc + '@' + d.slot; }).join(', ')); runSends_(now, due, false); } try { trialMsgTick_(); } catch (e) { Logger.log('trialMsgTick_: ' + e); } try { stage3Tick_(); } catch (e) { Logger.log('stage3Tick_: ' + e); } try { stage4Tick_(); } catch (e) { Logger.log('stage4Tick_: ' + e); } try { stage6Tick_(); } catch (e) { Logger.log('stage6Tick_: ' + e); }
    try { pvTick_(); } catch (e) { Logger.log('pvTick_: ' + e); }
    try { execTick_(); } catch (e) { Logger.log('execTick_: ' + e); }
    try { payTick_(); } catch (e) { Logger.log('payTick_: ' + e); }
    try { winbackTick_(); } catch (e) { Logger.log('winbackTick_: ' + e); }
      try { efcBillTick_(); } catch (e) { Logger.log('efcBillTick_: ' + e); } }
  finally { lock.releaseLock(); }
}
// Lists every send time per day (should match the old triggers), and dry-runs Monday's sends (nothing is texted).
function previewTrialTextSchedule() {
  const slots = {};
