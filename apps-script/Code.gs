  if (last > 1) R.sh.getRange(2, 1, last - 1, R.width).getValues().forEach(function (v) {
    seen[String(v[R.C['Contact ID']]).trim() + '|' + String(v[R.C['Student who joined']]).trim().toLowerCase()] = 1;
  });
  const add = [];
  enr.rows.forEach(function (r) {
