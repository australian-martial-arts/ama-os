/* ===== 4 Nov 2026 (Mady): personal to-do list at the top of My Day. One list per staff member, only they see it. ===== */
function todoKey_(who) { return 'todo_' + String((who && who.name) || '').toLowerCase().replace(/[^a-z0-9]+/g, '_').slice(0, 40); }
function todoRead_(who) { try { return JSON.parse(PropertiesService.getScriptProperties().getProperty(todoKey_(who)) || '[]'); } catch (e) { return []; } }
function todo_(who, b) {
  if (!who || !who.name) return { ok: false, error: 'Sign in again.' };
  /* no script lock here: the 5-minute Deputy tick holds it and would make ticking a to-do fail. One list per person, so clashes are not a concern. */
  {
    const P = PropertiesService.getScriptProperties(), key = todoKey_(who), now = Date.now();
    let list = todoRead_(who);
    const act = String(b.act || 'list');
    if (act === 'add') {
      const text = String(b.text || '').replace(/\s+/g, ' ').trim().slice(0, 200);
      if (!text) return { ok: false, error: 'Type the to-do first.' };
      list.push({ id: Utilities.getUuid().slice(0, 8), text: text, at: now, done: 0 });
    } else if (act === 'done' || act === 'undo') {
      list.forEach(function (t) { if (t.id === b.id) t.done = act === 'done' ? now : 0; });
    } else if (act === 'del') {
      list = list.filter(function (t) { return t.id !== b.id; });
    }
    /* ticked items drop off after 2 days; keep the list a sensible size */
    list = list.filter(function (t) { return !t.done || now - t.done < 2 * 864e5; }).slice(-60);
    if (act !== 'list') P.setProperty(key, JSON.stringify(list));
    return { ok: true, items: list };
  }
}

/* ===== 4 Nov 2026 (Mark): "missed your trial" text from the Absent, rebook cards. Wording approved by Mark 4 Nov 3:24pm. ===== */
function tcAbsentText_(who, b) {
  const have = tcRowsById_()[String(b.id || '')];
  if (!have) return { ok: false, error: 'Not found. Refresh and try again.' };
  const C = tcCols_(), r = have.v;
  if (r[C['Attended']] !== 'Absent') return { ok: false, error: 'This trial is not marked absent.' };
  const notes = String(r[C['Notes']] || '');
  if (/Absent text sent/.test(notes) && !b.again) return { ok: false, error: 'Already sent: ' + (notes.match(/Absent text sent[^|]*/) || [''])[0].trim() };
  let mob = String(r[C['Mobile']] || '').replace(/[^\d+]/g, '');
  if (/^0\d{9}$/.test(mob)) mob = '+61' + mob.slice(1); else if (/^61\d{9}$/.test(mob)) mob = '+' + mob; else if (/^4\d{8}$/.test(mob)) mob = '+61' + mob;
  if (!/^\+61\d{9}$/.test(mob)) return { ok: false, error: 'No mobile on this trial.' };
  const first = String(r[C['Parent']] || '').trim().split(/\s+/)[0];
  const kids = call24Kids_(r[C['Child']]) || String(r[C['Child']] || '').trim() || 'your child';
  const td = tcParseYmd_(String(r[C['Trial date']])) || hubDay_(r[C['Trial date']]);
  const when = td ? Utilities.formatDate(td, CONFIG.timezone, 'EEE d MMM') : String(r[C['Trial date']]);
  const self = trialIsSelf_(first, kids, r[C['Class']]); // 13 Nov 2026: adult trials say "we missed you at your trial class"
  const txt = 'Hi ' + (first ? first.charAt(0).toUpperCase() + first.slice(1) : 'there') + ', we missed ' + (self ? 'you at your' : kids + ' at their') + ' trial class at AMA ' + r[C['Location']] + ' on ' + when +
    '. No problem at all. Would you like to book another time? Just reply to this message and we\'ll find a class that suits.';
  if (b.preview) return { ok: true, preview: txt, to: mob };
  const ok = sendSms_(mob, txt);
  if (!ok) return { ok: false, error: 'The text did not send (no GHL contact for this mobile?).' };
  const stamp = 'Absent text sent ' + Utilities.formatDate(new Date(), CONFIG.timezone, 'd MMM h:mma') + ' by ' + ((who && who.name) || 'hub');
  tcSheet_().getRange(have.row, C['Notes'] + 1).setValue((notes ? notes + ' | ' : '') + stamp);
  const cid = r[C['Contact ID']];
  if (cid) { try { ghlPost_('/contacts/' + cid + '/notes', { body: stamp + ': ' + txt }); } catch (e) { } }
  actRow_((who && who.name) || '', 'Trial follow-up', 'Absent text sent', r[C['Child']], r[C['Location']] + ' ' + when);
  return { ok: true, note: stamp };
}

/* ===== 4 Nov 2026 (Mark): text 30 minutes before each rostered shift (instructors + front desk; same skip list as the clock-on reminder). Wording approved by Mark 4 Nov 3:24pm. ===== */
const PRESHIFT = { on: true, mins: 30 };
function payPreTick_() {
  if (!PRESHIFT.on || !CLOCKREM.on) return;
  const tz = payTz_(), now = new Date(), nowS = Math.floor(now.getTime() / 1000), hr = Number(Utilities.formatDate(now, tz, 'H'));
  if (hr < CLOCKREM.from || hr >= CLOCKREM.until) return;
  const today = Utilities.formatDate(now, tz, 'yyyy-MM-dd'), P = PropertiesService.getScriptProperties();
  let sent = {}; try { sent = JSON.parse(P.getProperty('pre_sent') || '{}'); } catch (e) { }
  if (sent.day !== today) sent = { day: today, s: {} };
  const range = { s1: { field: 'Date', type: 'ge', data: today }, s2: { field: 'Date', type: 'le', data: today } };
  /* shifts starting 24-30 minutes from now (the tick runs every 5 minutes, so each shift is caught once) */
  const ro = deputyQuery_('Roster', range).filter(function (r) { const d = r.StartTime - nowS; return r.Employee && r.Published && d <= PRESHIFT.mins * 60 && d > (PRESHIFT.mins - 6) * 60 && !sent.s[r.Id]; });
  if (!ro.length) { P.setProperty('pre_sent', JSON.stringify(sent)); return; }
  const meta = payMeta_(), U = {}, N = {}; meta.units.forEach(function (u) { U[u.id] = u; }); meta.people.forEach(function (p) { N[p.id] = p.name; });
  ro.forEach(function (r) {
    const name = N[r.Employee] || '', first = String(name).toLowerCase().split(/\s+/)[0];
    if (!name || CLOCKREM.skip.indexOf(first) > -1) { sent.s[r.Id] = 'skip'; return; }
    const mob = payMobile_(r.Employee);
    if (!mob) { sent.s[r.Id] = 'nomob'; return; }
    const school = (U[r.OperationalUnit] || {}).school || '';
    const when = payFmt_(r.StartTime, 'h:mma').replace(':00', '').toLowerCase();
    const txt = 'Hi ' + payFirst_(name) + ', reminder: your ' + when + ' shift at AMA' + (school ? ' ' + school : '') + ' starts in ' + PRESHIFT.mins + ' minutes. Please clock on in the Deputy app when you arrive.'; // 23 Nov 2026 (Mark): app only, web clock-in is off
    try { sendSms_(mob, txt); sent.s[r.Id] = 1; payLog_({ name: 'Hub' }, 'Pre-shift reminder', name, school, payFmt_(r.StartTime), 'Text sent', '', r.Id, 'Sent'); }
    catch (e) { Logger.log('pre sms ' + name + ': ' + e); }
  });
  P.setProperty('pre_sent', JSON.stringify(sent));
}
/* read-only: who would get a pre-shift text today (sends nothing) */
function payPrePreview() {
  const tz = payTz_(), today = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
  const meta = payMeta_(), U = {}, N = {}; meta.units.forEach(function (u) { U[u.id] = u; }); meta.people.forEach(function (p) { N[p.id] = p.name; });
  deputyQuery_('Roster', { s1: { field: 'Date', type: 'ge', data: today }, s2: { field: 'Date', type: 'le', data: today } }).filter(function (r) { return r.Employee && r.Published; }).forEach(function (r) {
    const name = N[r.Employee] || '?', skip = CLOCKREM.skip.indexOf(String(name).toLowerCase().split(/\s+/)[0]) > -1;
