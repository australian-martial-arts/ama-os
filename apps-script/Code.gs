// ============================================================ MONTH PICKER AND MONTHLY SNAPSHOTS (25 Oct 2026)
// Every finished month is saved once to the 'Monthly snapshots' tab (never overwritten), so any past month
// can be shown later, even after it falls outside the live data window.
const MSNAP = { tab: 'Monthly snapshots', headers: ['Month', 'Label', 'Saved at', 'New students', 'Students cancelled', 'Net', 'New $/wk', 'Lost $/wk',
  'Enquiries', 'Trial families', 'Attended', 'Enrolled from trials', 'Holds', 'Saves', 'Data'] };

function mgmtSnapSheet_() {
  const ss = SpreadsheetApp.openById(HOLD.sheetId); let sh = ss.getSheetByName(MSNAP.tab);
  if (!sh) { sh = ss.insertSheet(MSNAP.tab); sh.getRange(1, 1, 1, MSNAP.headers.length).setValues([MSNAP.headers]).setFontWeight('bold'); sh.setFrozenRows(1); }
  return sh;
}

function mgmtSnapRows_() {
  const sh = mgmtSnapSheet_(), n = sh.getLastRow(); if (n < 2) return {};
  const o = {};
  sh.getRange(2, 1, n - 1, MSNAP.headers.length).getValues().forEach(function (r) {
    const k = r[0] instanceof Date ? Utilities.formatDate(r[0], CONFIG.timezone, 'yyyy-MM') : String(r[0]).trim();
    if (/^\d{4}-\d{2}$/.test(k)) o[k] = { label: String(r[1]), json: String(r[14] || '') };
  });
  return o;
}

function mgmtKeepMonths_(out) {
  const ms = out._months || {}; delete out._months;
  const cache = CacheService.getScriptCache();
  Object.keys(ms).forEach(function (k) { try { cache.put('mgmt_m_' + k, JSON.stringify(ms[k]), 21600); } catch (e) { Logger.log('month cache ' + k + ': ' + e); } });
  try {
    const have = mgmtSnapRows_(), sh = mgmtSnapSheet_(), add = [];
    Object.keys(ms).forEach(function (k) {
      const x = ms[k]; if (!x.full || have[k]) return;
      const p = x.p, js = JSON.stringify(x);
      add.push(["'" + k, p.label, new Date(), p.enrolStudents, p.cancelStudents, p.net, p.newWeekly, p.lostWeekly, p.enquiries,
        p.trialFamilies, p.attended, p.trialEnrolled, p.holds, p.saves, js.length < 49000 ? js : '']);
      have[k] = { label: p.label };
    });
    if (add.length) sh.getRange(sh.getLastRow() + 1, 1, add.length, MSNAP.headers.length).setValues(add);
    const list = out.monthList || [], seen = {};
    list.forEach(function (m) { seen[m.k] = 1; });
    Object.keys(have).forEach(function (k) { if (!seen[k]) list.push({ k: k, label: mgmtLabel_(have[k].label, k) + ' (saved)' }); });
    list.sort(function (a, b) { return a.k < b.k ? 1 : -1; });
    out.monthList = list;
  } catch (err) { (out.notes = out.notes || []).push('Monthly snapshots could not be saved: ' + err); }
}

function mgmtMonth_(k) {
  if (!/^\d{4}-\d{2}$/.test(k)) return { ok: false, error: 'Pick a month.' };
  const cache = CacheService.getScriptCache();
  const hit = cache.get('mgmt_m_' + k); if (hit) return { ok: true, month: k, data: JSON.parse(hit) };
  const snap = mgmtSnapRows_()[k];
  if (snap && snap.json) { try { const d = JSON.parse(snap.json); try { cache.put('mgmt_m_' + k, snap.json, 21600); } catch (e) { } return { ok: true, month: k, data: d, saved: true }; } catch (e) { } }
  const out = mgmtBuild_(false), d = (out._months || {})[k];
  mgmtKeepMonths_(out);
  try { cache.put(MGMT.cacheKey, JSON.stringify(out), MGMT.cacheSecs); } catch (e) { }
  return d ? { ok: true, month: k, data: d } : { ok: false, error: 'There is no data for that month yet.' };
}


