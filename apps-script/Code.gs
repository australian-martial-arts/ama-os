// Hub: what we know about this family from the Enrolments tab.
function cxLookup_(b) {
  const want = holdLast9_(b.mobile);
  if (want.length !== 9) return { ok: true, found: false };
  const ss = SpreadsheetApp.openById(HOLD.sheetId), enr = hubRows_(ss, HUBDASH.enrolTab);
  const cM = enr.head.indexOf('Mobile'), cD = enr.head.indexOf('Enrolled date'), cS = enr.head.indexOf('Student name');
  const cL = enr.head.indexOf('Location'), cP = enr.head.indexOf('Promotion'), cK = enr.head.indexOf('Package');
  const rows = enr.rows.filter(function (r) { return holdLast9_(r[cM]) === want; });
  if (!rows.length) return { ok: true, found: false };
  let joined = null;
  rows.forEach(function (r) { const d = hubDay_(r[cD]); if (d && (!joined || d < joined)) joined = d; });
  const months = joined ? Math.floor((hubStartOfDay_(new Date()) - hubStartOfDay_(joined)) / (86400000 * 30.44)) : null;
  const uniq = function (a) { return a.filter(function (x, i) { return x && a.indexOf(x) === i; }); };
  return {
    ok: true, found: true,
    joined: joined ? Utilities.formatDate(joined, CONFIG.timezone, 'yyyy-MM-dd') : '', joinedText: cxDateText_(joined), months: months,
    under12: months !== null && months < 12,
    students: uniq(rows.map(function (r) { return String(r[cS] || '').trim(); })).join(', '),
    location: String(rows[0][cL] || ''),
    promos: uniq(rows.map(function (r) { return String(r[cP] || '').trim(); }).filter(function (p) { return p && p !== 'None'; })).join(', '),
    packages: uniq(rows.map(function (r) { return String(r[cK] || '').trim(); })).join(', ')
  };
}

