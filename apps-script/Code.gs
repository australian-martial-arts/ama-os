/* ===== 6 Nov 2026 (Mark): "late" counts only the days each person works (their weekly roster), for everyone.
   Something that landed on a day off shows as due this shift, and only turns late once a shift ends without it done.
   My work order: Close the sale first, then new enrolments, then absentees; cancellations and holds at the bottom. ===== */
function myWorkDays_(who) {
  const first = String((who && who.name) || '').trim().toLowerCase().split(' ')[0]; if (!first) return null;
  const C = CacheService.getScriptCache(), key = 'wdays_' + first, hit = C.get(key);
  if (hit) return hit === 'none' ? null : JSON.parse(hit);
  const days = {}, base = hubStartOfDay_(new Date());
  for (let k = 0; k < 7; k++) {
    const d = new Date(base.getTime() + k * 86400000);
    try { if (rosterRows_(d).some(function (r) { return String(r.name || '').trim().toLowerCase().split(' ')[0] === first; })) days[d.getDay()] = 1; } catch (e) { }
  }
  const out = Object.keys(days).length ? days : null;
  try { C.put(key, out ? JSON.stringify(out) : 'none', 3600); } catch (e) { }
  return out;
}
/* working days from 'from' (inclusive) up to today (not counted) */
function workDaysSince_(wd, daysAgo) {
  const d = Math.max(0, Math.round(daysAgo || 0)); if (!wd) return d;
  const today = hubStartOfDay_(new Date()).getTime(); let n = 0;
  for (let k = d; k >= 1; k--) { if (wd[new Date(today - k * 86400000).getDay()]) n++; }
  return n;
}
function chaseList_(who) {
  const r = chaseListRaw_(who);
  try {
    const wd = myWorkDays_(who);
    if (wd && r && Array.isArray(r.items)) r.items.forEach(function (it) { if (it.late > 0) it.late = workDaysSince_(wd, it.late); });
  } catch (e) { Logger.log('chase workdays ' + e); }
  return r;
}
function myWorkRank_(it) {
  const a = String(it.area || ''), s = String(it.stage || '');
  if (/^(cancel|hold)/i.test(s) || /^(cancellations|holds)$/i.test(a)) return 9;
  if (/close the sale|joining|join/i.test(s)) return 0;
  if (/new member|enrol|membership change/i.test(s)) return 1;
  if (/absent/i.test(s)) return 2;
  if (/trial|booking|confirm/i.test(s)) return 3;
  if (a === 'Sales') return 4;
  if (a === 'Members' || a === 'Front desk') return 5;
  return 6;
}
function mywork_(who, b) {
  const r = myworkRaw_(who, b);
  try {
    if (!r || !r.ok || !Array.isArray(r.groups)) return r;
    const wd = myWorkDays_(who), all = [];
    const TK = myworkTicks_(who), tkCut = Utilities.formatDate(new Date(Date.now() - 2 * 864e5), CONFIG.timezone, 'yyyy-MM-dd');
    r.groups.forEach(function (g) { (g.items || []).forEach(function (it) { const tk = TK[it.stage + '|' + it.who]; if (tk && tk >= tkCut) return; all.push(it); }); }); // 17 Nov 2026: ticked items stay off for 3 days, on every device
    const late = [], today = [], bottom = [];
    all.forEach(function (it) {
      const d = it.days || 0, nd = workDaysSince_(wd, d);
      it.days = nd;
      it.due = wd ? (nd >= 2 ? nd + ' shifts waiting' : nd === 1 ? 'Since your last shift' : (d ? 'Due this shift' : 'Today')) : (nd >= 2 ? nd + ' days waiting' : nd === 1 ? 'Since yesterday' : 'Today');
      const rank = myWorkRank_(it); it.rank = rank;
      (rank === 9 ? bottom : nd >= 2 ? late : today).push(it);
    });
    const srt = function (x, y) { return (x.rank - y.rank) || ((y.days || 0) - (x.days || 0)); };
    r.groups = [{ label: 'Overdue', items: late.sort(srt) }, { label: 'Today', items: today.sort(srt) }, { label: 'Cancellations and holds', items: bottom.sort(srt) }]
      .map(function (g) { g.count = g.items.length; return g; }).filter(function (g) { return g.count; });
  } catch (e) { Logger.log('mywork order ' + e); }
  return r;
}


/* ===== 6 Nov 2026 (Mark): record a hold that was already set up in EFC (before the hub), dates only.
   Nothing is sent to the family. The family then shows as on hold: out of absentee follow-up, on the hold check-in list. ===== */
function holdRecord_(who, b) {
  if (!who || hubIsInstr_(who)) return { ok: false, error: 'Not available on the instructor view.' };
  b = b || {};
  const end = absDate_(b.end); if (!end) return { ok: false, error: 'Pick the date they come back.' };
  if (hubStartOfDay_(end) < hubStartOfDay_(new Date())) return { ok: false, error: 'That date has passed. Pick the date they come back.' };
  const start = absDate_(b.start) || hubStartOfDay_(new Date());
  let mobile = String(b.mobile || ''), holder = String(b.holder || '').trim(), students = String(b.students || '').trim(), loc = String(b.loc || '').trim(), email = String(b.email || '').trim();
  const rows = String(b.rows || '').split(',').map(Number).filter(function (n) { return n > 1; });
  if (rows.length) {
    const R = absSheet_(), C = R.C, H = Object.keys(C), col = function (re) { const k = H.filter(function (h) { return re.test(h); })[0]; return k === undefined ? -1 : C[k]; };
    const cF = col(/^first/i), cL = col(/^last name|^surname|^last$/i), cM = col(/^mobile/i), cE = col(/^email/i), cS = col(/^school/i), cN = col(/^notes/i);
    const names = [];
    rows.forEach(function (r) {
      if (r > R.sh.getLastRow()) return;
      const v = R.sh.getRange(r, 1, 1, R.sh.getLastColumn()).getValues()[0];
      if (cF > -1) names.push((String(v[cF] || '') + ' ' + (cL > -1 ? String(v[cL] || '') : '')).trim());
      if (!mobile && cM > -1) mobile = String(v[cM] || '');
      if (!email && cE > -1) email = String(v[cE] || '');
      if (!loc && cS > -1) loc = String(v[cS] || '');
      if (!holder && cN > -1) holder = absParent_(v[cN]) || '';
    });
    if (!students) students = names.filter(Boolean).join(', ');
  }
  const m9 = holdLast9_(mobile); if (m9.length !== 9) return { ok: false, error: 'No mobile number for this family, so the hold cannot be matched. Add it in EFC first.' };
  const sh = holdSheet_(), C2 = {}; HOLD.headers.forEach(function (h, i) { C2[h] = i; });
  const now = new Date(), row = HOLD.headers.map(function () { return ''; });
  row[C2['Request ID']] = 'HOLD-OLD-' + Utilities.formatDate(now, CONFIG.timezone, 'yyMMddHHmmss');
  row[C2['Logged at']] = now; row[C2['Status']] = 'Active (set up before the hub)';
  row[C2['Account holder']] = holder || 'Family'; row[C2['Mobile']] = '0' + m9; row[C2['Email']] = email;
  row[C2['Students']] = students; row[C2['Trains at']] = loc; row[C2['Reason']] = 'Hold set up before the hub';
  row[C2['Freeze starts']] = start; row[C2['Freeze ends']] = end; row[C2['Taken by']] = who.name;
  row[C2['EFC actioned at']] = now; row[C2['EFC actioned by']] = 'Already in EFC';
  row[C2['Notes']] = 'Recorded in the hub by ' + who.name + ' on ' + Utilities.formatDate(now, CONFIG.timezone, 'd MMM') + '. Set up the old way, no agreement on file.' + (b.note ? ' ' + String(b.note).slice(0, 200) : '');
  sh.appendRow(row);
  try { actRow_(who.name, 'Holds', 'Recorded existing hold', students || ('0' + m9), 'until ' + Utilities.formatDate(end, CONFIG.timezone, 'd MMM yyyy')); } catch (e) { }
  try { listBump_('abs'); } catch (e) { }
  return { ok: true, text: (students || 'Family') + ' on hold until ' + Utilities.formatDate(end, CONFIG.timezone, 'EEE d MMM yyyy') + '.' };
}

