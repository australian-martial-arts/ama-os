  return sh;
}
function tcCols_() { const C = {}; TRIALCHECK.headers.forEach(function (h, i) { C[h] = i; }); return C; }
function tcYmd_(d) { return Utilities.formatDate(d, CONFIG.timezone, 'yyyy-MM-dd'); }
function tcParseYmd_(s) { const m = String(s || '').match(/^(\d{4})-(\d{2})-(\d{2})$/); return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null; }

// All trials at one location on one day, with the child/parent details staff need.
function tcTrials_(loc, day, withPromo) {
  if (!CONFIG.locations[loc]) return [];
  const start = hubStartOfDay_(day), end = new Date(start.getTime() + 86400000);
  // GHL can return the next morning's bookings too, so keep only ones that start on this day.
  return eventsForLocation_(loc, ghlGroups_(), start, end, withPromo).filter(function (e) { const t = new Date(e.startTime); return t >= start && t < end; }).map(function (e) {
    const c = ghlContact_(e.contactId) || {}, cf = c.cf || {};
    const st = new Date(e.startTime);
    return {
      id: e.id, contactId: e.contactId || '', loc: loc, t: st.getTime(),
      date: tcYmd_(st), time: Utilities.formatDate(st, CONFIG.timezone, 'h:mm a').toLowerCase(),
      end: e.endTime ? new Date(e.endTime).getTime() : st.getTime() + 45 * 60000,
      child: (tbTitleKids_(e).length ? tbTitleKids_(e) : [cf.student_1, cf.student_2].filter(Boolean)).join(' & ') || '',
      parent: c.name || '', mobile: c.phone || '', cls: classOf_(e), prog: tcProg_(e),
      num: tcTrialLabel_(e.contactId, tcYmd_(st))
    };
  }).sort(function (a, b) { return a.t - b.t; });
}

