/* money report (management, not noMoney): revenue (paid / booked / refunded) against running costs, per day and total.
   Staff cost = instructors needed (1 per 8 kids, min 1 on any day with bookings) x hours x hourly rate. */
function campMoney_(days, rows) {
  const C = CAMP.costs; let paid = 0, booked = 0, refunded = 0;
  rows.forEach(function (r) { const st = String(r.Status || ''), t = Number(r.Total) || 0; if (/^TEST/i.test(st)) return;
    if (/^refunded/i.test(st)) refunded += t; else if (/^paid/i.test(st)) paid += t; if (!/cancel|refund/i.test(st)) booked += t; });
  const perDay = days.map(function (d) {
    const kids = d.kids.filter(function (k) { return !/^TEST/i.test(String(k.status)) && !/cancel|refund/i.test(String(k.status)); }).length, staff = kids ? Math.max(1, Math.ceil(kids / CAMP.ratio)) : 0;
    const rev = d.kids.reduce(function (s, k) { const r = rows.filter(function (x) { return x._row === k.row; })[0]; return s + (r && !/^TEST/i.test(String(r.Status)) ? (Number(r['Price per day']) || 0) : 0); }, 0);
    const cost = staff * C.staffHours * C.staffHourly + kids * C.perChildDay + (kids ? C.perDayFixed : 0) + rev * C.squarePct / 100;
    return { date: d.date, label: d.label, kids: kids, staff: staff, revenue: Math.round(rev), cost: Math.round(cost), profit: Math.round(rev - cost) };
  });
  const cost = perDay.reduce(function (s, d) { return s + d.cost; }, 0), rev = perDay.reduce(function (s, d) { return s + d.revenue; }, 0);
  return { paid: Math.round(paid), booked: Math.round(booked), refunded: Math.round(refunded), revenue: rev, cost: cost, profit: rev - cost, costs: C, perDay: perDay };
}

/* ===== CAMP roster approvals (Mark, 9 Nov): management approves who works each day; approved days are locked for the staff member ===== */
function campRosterSheet_() { return stockSheetOf_('Camp roster', ['Emp ID', 'Name', 'Day', 'Approved by', 'At']); }
function campRosterRows_() { const v = campRosterSheet_().getDataRange().getValues(); return v.slice(1).filter(function (r) { return r[0] !== ''; }); }
function campApprovedFor_(empId) { const o = {}; campRosterRows_().forEach(function (r) { if (+r[0] === +empId) o[campCell_(r[2])] = 1; }); return o; }
function campRosterAdmin_(who) { return CAMP.rosterAdmins.indexOf(String((who && who.name) || '').toLowerCase().split(' ')[0]) > -1; }
function campApprove_(who, b, quiet) {
  if (!campRosterAdmin_(who)) return { ok: false, error: 'Only ' + CAMP.rosterAdmins.map(function (x) { return x[0].toUpperCase() + x.slice(1); }).join(' and ') + ' can change the camp roster.' };
  const emp = +b.emp, day = String(b.day || ''), on = !!b.on, valid = {}; campDays_().forEach(function (d) { valid[d.date] = 1; });
  if (!emp || !valid[day]) return { ok: false, error: 'Pick a staff member and a camp day.' };
  const me = partyStaff_().filter(function (s) { return s.id === emp; })[0]; if (!me) return { ok: false, error: 'Staff member not found.' };
  const lock = LockService.getScriptLock(); lock.waitLock(15000);
  try {
