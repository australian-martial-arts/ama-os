/* ~~~~~ 23 Nov 2026 (Mark): SHOP SALES (POS). Staff tap items and sizes in Shop and stock > Sell, the hub makes a Stripe
   Checkout for the total (prices include GST), the parent scans the QR code and pays on Stripe's page, and the hub records
   the sale on the family (family page timeline + GHL note) and takes the items off stock. Uses AMA's Stripe account through
   its own restricted key (Script property STRIPE_SHOP_KEY, added by Mark; Checkout Sessions only). The key is never logged
   or returned. Card details never touch the hub. ~~~~~ */
const SHOP = { tab: 'Shop sales', key: 'STRIPE_SHOP_KEY', currency: 'aud', expireMins: 30,
  locs: ['Marrickville', 'Sydenham', 'Concord', 'Auburn', 'Sylvania'],
  done: 'https://australianmartialarts.com.au/',
  headers: ['Sale ID', 'Created', 'Staff', 'Location', 'Family', 'Family key', 'Mobile', 'Items', 'Lines', 'Total', 'GST', 'Status', 'Session ID', 'Paid at', 'Payment', 'Stock updated', 'GHL note'] };
function shopSheet_() { const sh = stockSheetOf_(SHOP.tab, SHOP.headers); return sh; }
function shopRows_() {
  const sh = shopSheet_(), last = sh.getLastRow(); if (last < 2) return [];
  return sh.getRange(2, 1, last - 1, SHOP.headers.length).getValues().map(function (r, i) { const o = { row: i + 2 }; SHOP.headers.forEach(function (h, j) { o[h] = r[j]; }); return o; });
}
function shopCol_(h) { return SHOP.headers.indexOf(h) + 1; }
function shopMoney_(n) { return '$' + (Number(n) || 0).toFixed(2); }
function shopForm_(o, pre, out) {
  out = out || [];
  Object.keys(o).forEach(function (k) {
    const key = pre ? pre + '[' + k + ']' : k, v = o[k];
    if (v === undefined || v === null) return;
    if (typeof v === 'object') shopForm_(v, key, out); else out.push(encodeURIComponent(key) + '=' + encodeURIComponent(String(v)));
  });
  return out;
}
function shopStripe_(method, path, params) {
  const key = PropertiesService.getScriptProperties().getProperty(SHOP.key) || '';
  if (!key) return { ok: false, error: 'The Stripe key for the shop is not set up yet (Script property STRIPE_SHOP_KEY).' };
  const opt = { method: method, headers: { Authorization: 'Bearer ' + key }, muteHttpExceptions: true };
  if (params) { opt.contentType = 'application/x-www-form-urlencoded'; opt.payload = shopForm_(params).join('&'); }
  try {
    const r = UF_.fetch('https://api.stripe.com/v1' + path, opt), code = r.getResponseCode();
    let j = {}; try { j = JSON.parse(r.getContentText()); } catch (e) { }
    if (code >= 200 && code < 300) return { ok: true, body: j };
    return { ok: false, error: 'Stripe: ' + String((j.error && j.error.message) || ('error ' + code)).slice(0, 200) };
  } catch (e) { return { ok: false, error: 'Stripe could not be reached.' }; }
}
function shopOut_(r) {
  let lines = []; try { lines = JSON.parse(r.Lines || '[]'); } catch (e) { }
  const t = r.Created ? new Date(r.Created).getTime() : 0;
  return { id: String(r['Sale ID']), t: t, staff: String(r.Staff || ''), loc: String(r.Location || ''), family: String(r.Family || ''), mobile: String(r.Mobile || ''),
    items: String(r.Items || ''), lines: lines, total: Number(r.Total) || 0, gst: Number(r.GST) || 0, status: String(r.Status || ''), paidAt: r['Paid at'] ? new Date(r['Paid at']).getTime() : 0 };
}
/* b: { loc, family: { key, title, mobile }, lines: [{ sku, n }] } */
function shopCheckout_(who, b) {
  if (!stockCanEdit_(who)) return { ok: false, error: 'Not available on the instructor view.' };
  b = b || {};
  const loc = SHOP.locs.indexOf(b.loc) > -1 ? b.loc : ''; if (!loc) return { ok: false, error: 'Pick the school.' };
  const fam = b.family || {}, famName = String(fam.title || '').trim().slice(0, 120), mob = String(fam.mobile || '').replace(/[^\d+]/g, '').slice(0, 16);
  if (!famName) return { ok: false, error: 'Pick the family first (or type their name).' };
  const map = {}; stockRows_().forEach(function (r) { if (String(r.Active).toLowerCase() !== 'no') map[String(r.SKU)] = r; });
  const lines = [];
  (Array.isArray(b.lines) ? b.lines : []).slice(0, 30).forEach(function (l) {
    const r = map[String(l && l.sku || '')], n = Math.round(Number(l && l.n));
    if (!r || !isFinite(n) || n < 1 || n > 20) return;
    const price = Math.round((Number(r.Price) || 0) * 100) / 100; if (price <= 0) return;
    lines.push({ sku: String(r.SKU), item: String(r.Item), opt: String(r.Option || ''), n: n, price: price });
  });
  if (!lines.length) return { ok: false, error: 'Add at least one item with a price.' };
  const total = Math.round(lines.reduce(function (a, l) { return a + l.price * l.n; }, 0) * 100) / 100, gst = Math.round(total / 11 * 100) / 100;
  const tz = CONFIG.timezone, now = new Date(), id = 'S' + Utilities.formatDate(now, tz, 'yyMMdd') + '-' + Utilities.getUuid().slice(0, 4).toUpperCase();
  const desc = lines.map(function (l) { return l.item + (l.opt ? ' (' + l.opt + ')' : '') + ' x' + l.n; }).join(', ');
  const li = {}; lines.forEach(function (l, i) { li[i] = { quantity: l.n, price_data: { currency: SHOP.currency, unit_amount: Math.round(l.price * 100), product_data: { name: l.item + (l.opt ? ' - ' + l.opt : ''), description: 'Price includes GST' } } }; });
  const s = shopStripe_('post', '/checkout/sessions', {
    mode: 'payment', line_items: li, success_url: SHOP.done, cancel_url: SHOP.done,
    expires_at: Math.floor(now.getTime() / 1000) + SHOP.expireMins * 60 + 60,
    client_reference_id: id, submit_type: 'pay',
    metadata: { sale: id, family: famName.slice(0, 100), school: loc, staff: String(who && who.name || '').slice(0, 60), gst: gst.toFixed(2) },
    payment_intent_data: { description: 'AMA shop ' + id + ' - ' + loc + ' - ' + famName.slice(0, 60) + ' (incl. GST ' + shopMoney_(gst) + ')', metadata: { sale: id } }
  });
  if (!s.ok) return s;
  const sh = shopSheet_();
  sh.appendRow([id, now, String(who && who.name || ''), loc, famName, String(fam.key || '').slice(0, 300), mob ? "'" + mob : '', desc, JSON.stringify(lines), total, gst, 'Pending', String(s.body.id || ''), '', '', '', '']);
  try { actRow_(who.name, 'Shop', 'Started a sale', id, famName + ' ' + shopMoney_(total)); } catch (e) { }
  return { ok: true, id: id, url: String(s.body.url || ''), total: total, gst: gst, items: desc };
}
function shopFinish_(row, sess) {
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const sh = shopSheet_(), st = String(sh.getRange(row, shopCol_('Status')).getValue());
    if (st !== 'Pending') return st;
    const v = sh.getRange(row, 1, 1, SHOP.headers.length).getValues()[0], o = {}; SHOP.headers.forEach(function (h, j) { o[h] = v[j]; });
    const pi = sess && sess.payment_intent ? String(sess.payment_intent) : '';
    sh.getRange(row, shopCol_('Status')).setValue('Paid'); sh.getRange(row, shopCol_('Paid at')).setValue(new Date()); sh.getRange(row, shopCol_('Payment')).setValue(pi);
    let lines = []; try { lines = JSON.parse(o.Lines || '[]'); } catch (e) { }
    let stockMsg = 'Not tracked at ' + o.Location;
    if (STOCK.locs.indexOf(String(o.Location)) > -1) {
      try {
        const ss = stockSheet_(), map = {}, log = [], now = new Date(), col = function (h) { return STOCK.headers.indexOf(h) + 1; };
        stockRows_().forEach(function (r) { map[r.SKU] = r; });
        lines.forEach(function (l) { const r = map[l.sku]; if (!r) return; const cur = Number(r[o.Location]) || 0; ss.getRange(r.row, col(o.Location)).setValue(cur - l.n); r[o.Location] = cur - l.n; log.push([now, String(o.Staff || 'Shop'), r.SKU, r.Item, r.Option, o.Location, -l.n, 'Sold', 'Shop sale ' + o['Sale ID'], cur - l.n]); });
        if (log.length) { const ls = stockLogSheet_(); ls.getRange(ls.getLastRow() + 1, 1, log.length, STOCK.logHeaders.length).setValues(log); }
