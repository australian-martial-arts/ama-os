    try { ghlPost_('/contacts/' + cid + '/notes', { body: 'Wants to start on ' + when + ' (recommended by ' + by + '). They fill in the joining form now to lock in the class and price. Manual billing: set the first EFC payment for ' + when + '.' }); } catch (e) { Logger.log('later note: ' + e); }
  }
  const txt = 'AMA later start: ' + fam + (kids ? ' (' + kids + ')' : '') + ', ' + loc + ', wants to start on ' + when + '. When their joining form comes in, set them up in EFC with the first payment on ' + when + ' (Manual billing). Recommended by ' + by + '.';
