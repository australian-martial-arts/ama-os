        Date: date, School: school, Start: start, End: end, Kids: kids, Upgrades: ups.map(function (u) { return u.id; }).join(','), Total: total, Deposit: 'Not paid', Balance: 'Not paid',
        'Hold until': until, Checklist: '{}', Notes: clean(b.notes, 600), Source: clean(b.source, 40) || 'Party page', Updated: new Date(), 'Updated by': 'Family', Extras: JSON.stringify({ dates: clean(b.dates, 120), interests: clean(b.interests, 200), medical: clean(b.medical, 300), member: clean(b.member, 10), trial: clean(b.trial, 10) }) })[h];
