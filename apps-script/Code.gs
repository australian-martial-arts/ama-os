  const ym = function (d) { return Utilities.formatDate(d, tz, 'yyyy-MM'); };
  const mode = String(b.mode || 'recent'), q = String(b.q || '').toLowerCase().trim(), qd = q.replace(/\D/g, '').replace(/^0/, '').replace(/^61/, '');
  const months = {};
  rows.forEach(function (r) { const d = D(r['Logged at']); if (d) months[ym(d)] = (months[ym(d)] || 0) + 1; });
  const cut = Date.now() - 30 * 86400000;
  const list = rows.filter(function (r) {
    const d = D(r['Logged at']);
    if (mode === 'search') {
      if (!q) return false;
      const hay = [r['Request ID'], r['Account holder'], r['Students'], r['Email'], r['Parent email'], r['Trains at']].join(' ').toLowerCase();
      const mob = String(r['Mobile'] || '').replace(/\D/g, '');
