/* 1 Nov 2026 (Mark): How to use the hub - help content, generated from the Team Training Guide and the Management Dashboard guide. Regenerate when the guides change. */
var HELP_DOCS = [{"d":"hub","h2":"New from 5 November","t":"New from 5 November","html":"<p>Reload the hub page once to get the latest version. The hub has a new layout: everything that needs doing lands in <b>My work<\/b>, every decision lands in <b>Approvals<\/b>, and every family has one page. The old tiles are still under <b>All sections<\/b> at the bottom of the home page while everyone gets used to it.<\/p>"},{"d":"hub","h2":"New from 5 November","t":"The new home page","html":"<p>From the top:<\/p><ul><li><b>Top bar<\/b>: My work, Members, Events, Team and Business. Tap Members, Events, Team or Business for a menu of everything inside. Then the search box (find any family by name or mobile), Help, and <b>Approvals<\/b> with the number waiting on you.<\/li><li><b>Today's trials<\/b>: every trial today at every school, with the buttons to mark them. See the next section.<\/li><li><b>My work<\/b>: what you need to do today, from every area.<\/li><li><b>Right-hand column<\/b>: Open Deputy to clock on, Log into EFC, Log into GHL, what is waiting on someone else, and On today (trials booked, staff on shift, anyone not clocked on yet, parties this weekend).<\/li><li><b>Members<\/b>: one row of stages from trial to leaving: Trials, Close the sale, New members, Absent, Requests to log, On hold, Cancelling, Referrals. Tap one to work it.<\/li><li><b>Events, Team, Business<\/b>: gradings, parties, private lessons, Book a trial, My Day, Clock on, roster and pay, employment packs, and the Management dashboard.<\/li><li>At the bottom: <b>Trials on other days<\/b> (last 7 days and coming up) and <b>All sections<\/b> (the old tiles).<\/li><\/ul><p>The numbers for the last 7 days and the By school table have moved to the Management dashboard.<\/p>"},{"d":"hub","h2":"New from 5 November","t":"Today's trials","html":"<p>The yellow box at the top of the home page. Tap a school to see only that school. Each trial moves through: Coming up, On now, Did they come?, Send the recommendation, Done.<\/p><ol><li>When they arrive, tap <b>Arrived<\/b> (or <b>No-show<\/b>, then <b>Send absent text<\/b> or <b>Rebooked<\/b>).<\/li><li>After the class, tap <b>Send recommendation<\/b>. It opens the staff recommendation tool with the family already filled in. If your browser blocks it, the button changes to <b>Open the recommendation tool<\/b>: tap it again.<\/li><li>Then tap <b>Recommendation sent<\/b> (or <b>Not yet<\/b>).<\/li><\/ol><p><b>School readiness<\/b> (3 weeks, 6 classes): you can also tap <b>Recommend later<\/b>. It goes in your My work around class 4 so it is sent before the program ends. Every other trial gets the recommendation straight away.<\/p><p>Tap a child's name to open the family page. Tap <b>Upcoming trials<\/b> to see the next few days.<\/p><p>Online bookings can take up to 5 minutes to appear. Anything you do in the hub shows straight away.<\/p>"},{"d":"hub","h2":"New from 5 November","t":"My work","html":"<p>Everything assigned to you, from every area, in one list: <b>Overdue<\/b> first, then <b>Today<\/b>. Each card says what it is, who, why, and has one button: Call, Reply, Confirm, Chase, Check, Send, Decide or Open.<\/p><ul><li>You only see the work for your areas (for example Sales, Front desk, Holds, Cancellations).<\/li><li>Queues show as one card each, for example <b>Close the sale calls: 10 families<\/b>. Tap the button to go straight there.<\/li><li>Tap the <b>tick<\/b> to hide a card for today once it is done.<\/li><li><b>School readiness: send recommendation<\/b> appears here when you tapped Recommend later.<\/li><\/ul>"},{"d":"hub","h2":"New from 5 November","t":"Approvals","html":"<p>Mark, Sarah and Busra: every decision waiting on you is in one list. Tap <b>Approvals<\/b> in the top bar. It shows early stops on cancellations, holds, leave, shifts that still need cover, and training access requests.<\/p><p>Approving here does exactly the same as replying Y to the text. Leave and cover open the roster tools so you can pick someone.<\/p>"},{"d":"hub","h2":"New from 5 November","t":"The family page","html":"<p>Tap a family's name (Today's trials, follow-up, close the sale and new member cards), or search by name or mobile in the top bar.<\/p><ul><li>At the top: <b>where they are<\/b> and the <b>next step<\/b>, for example \"Trialled. Next: send the recommendation.\"<\/li><li>Buttons for that stage: Send recommendation, Rebook trial, Book a trial, Open Close the sale, plus Call, Text, Open in GHL, Start cancellation form and Hold request form.<\/li><li><b>Add a note<\/b>: saves to the family in GHL, signed with your name, so everyone sees it.<\/li><li>Below: their children, recent texts and emails, and everything that has happened with the family, newest first.<\/li><\/ul><p>Tap <b>Search another family<\/b> to look up someone else.<\/p>"},{"d":"hub","h2":"New from 5 November","t":"Instructors: the simple view","html":"<p>Instructors see a simple home page: your shift today, the schools you are on trials at, <b>Today's trials<\/b> for your schools, and buttons for After-trial check, New members in your class, Absent videos, Book a trial and Clock on in Deputy.<\/p><p>Front desk and admin keep the full hub.<\/p>"},{"d":"hub","h2":"New from 5 November","t":"Grow your skills","html":"<p>On the home page (right-hand column, or your instructor card) you can ask for free access to the <b>Instructor Academy<\/b> or the <b>Sales Lab<\/b>. Tap <b>Request access<\/b>. Mark sets you up and the card changes to <b>You have access<\/b>.<\/p>"},{"d":"hub","h2":"New from 5 November","t":"Absentee calls: the top 25","html":"<p><b>Call today<\/b> now shows the 25 families most likely to come back first. Tap <b>Show the other ...<\/b> to see the rest.<\/p><ul><li>Order: call-backs due today, return classes to check, then calls, shortest absence first, fewer unanswered tries first, and bigger families first.<\/li><li>Families who replied to a text are only under <b>Replied<\/b>. Read the reply and pick an outcome. They are not in the call list.<\/li><li>A call drops off by itself once the family reaches the next step: a missed day 12 call drops off at the day 15 video, a missed day 18 call at day 21, a missed head instructor call at the day 30 text.<\/li><li>A new text reply can take a few minutes to appear under Replied.<\/li><\/ul>"},{"d":"hub","h2":"New from 5 November","t":"Cancellations and holds: what changed","html":"<ul><li>Both pages start with <b>stage tiles<\/b>. Cancellations: New requests, Form sent, Waiting for approval, Form returned, Completed. Holds: New requests, Waiting for approval, Paperwork, Action in EFC, On hold now. Tap one to see that stage.<\/li><li>Request cards show the four main buttons. The rest are under <b>More options<\/b>.<\/li><li><b>Form back, done in EFC<\/b>: use it when the family filled in the form outside the hub and EFC is already done.<\/li><li><b>Fast-track (no form)<\/b>, Mark and Sarah only: for a family who will not fill in more forms. Mark and Sarah can also text <b>FT<\/b> and the family name to the hub number.<\/li><li>The cancellation form has a <b>last payment date<\/b> and a <b>last class<\/b> date, so a family can stop paying on one date and keep training to a later one.<\/li><\/ul>"},{"d":"hub","h2":"New from 1 November","t":"New from 1 November","html":"<p>Reload the hub page once to get the latest version.<\/p>"},{"d":"hub","h2":"New from 1 November","t":"Holds and Cancels: every request in one place","html":"<p>The old <b>HOLDS TO ACTION<\/b> and <b>CANCELLATIONS TO ACTION<\/b> tiles are now called <b>HOLDS<\/b> and <b>CANCELS<\/b>. Each one follows a request from the moment it arrives until it's finished.<\/p><p><b>The count bar.<\/b> At the top of each page is a row of buttons, one per stage, with how many are in it (for example <i>Received, not logged yet: 8<\/i>). Gold outline = something to do. Tap a button to jump straight to that stage.<\/p><p><b>Stages fold away.<\/b> Each stage is closed until you tap its heading. It stays open while you work through it.<\/p><p><b>1. Received, not logged yet.<\/b> Hold and cancel requests that came in by email, EFC message, phone or in person but haven't been put through the hub yet. Each card shows who, which school, how they asked and how many days it has been waiting (red edge = over a day). On each card:<\/p><ul><li><b>Open the hold form<\/b> / <b>Start the cancellation form<\/b>: log it properly. Then tap <b>Logged in the hub<\/b>.<\/li><li><b>Already agreed by email<\/b>: only when Mark or Sarah already sorted it by email. Type what was agreed (dates, last class, last payment) and save.<\/li><li><b>Saved: staying<\/b> (Cancels only): the family decided to stay.<\/li><li><b>Not a request<\/b>: it wasn't actually a hold or cancel.<\/li><\/ul><p><b>Got a request by phone or at the desk?<\/b> Tap <b>Add a request received by phone or in person<\/b>, fill in the name, mobile, students, school and what they asked for, and tap <b>Add to Received<\/b>. Then action it the same way.<\/p><p><b>2. Logged, in progress.<\/b> Everything below this works as before (approval, signing, medical certificate, EFC, on hold, restarting).<\/p><p><b>Emails are caught for you.<\/b> Every 15 minutes the hub reads the info@ inbox and adds anything that looks like a hold, cancellation, billing question or new enquiry to <b>Received<\/b>. It only reads; it never replies or marks emails as read. You still reply to the family yourself.<\/p>"},{"d":"hub","h2":"New from 1 November","t":"Who does cancels","html":"<p>Busra handles cancellations on her days. On days she isn't in, they go to Mady, then Bianca. My Day shows them to the right person automatically. A cancellation request gets a phone call first, to see if a hold, a different class or a lighter week would help, before anything is confirmed.<\/p><p><b>Busra is co-coordinator of cancellations<\/b> with Sarah. When Busra processes a cancellation and the family wants to stop before their 30 days' notice is up, the early stop is approved straight away: it doesn't wait for Mark or Sarah. Mark and Sarah get an FYI text so they know. Early stops on cancellations taken by anyone else still go to Mark and Sarah to approve.<\/p>"},{"d":"hub","h2":"New from 1 November","t":"My Day: your plan for the day","html":"<p><b>Next call<\/b> is at the top: the single most valuable call to make right now, with what to say and the goal of the call. Tap <b>Skip<\/b> to move to the next one.<\/p><p><b>When you can't call yet.<\/b> No calls before 9am Monday to Saturday or 9:30am Sunday. Until then (and during busy class times) My Day shows <b>desk tasks<\/b> instead: grading prep, EFC fixes, trial reports, close-the-sale prep, absentee texts, holds paperwork, front desk tidy, uniform orders, checking EFC attendance log-ins live, and social media stories while classes are on.<\/p><p><b>Who sees what.<\/b> Bianca's list leads with sales and gradings. Mady's leads with holds. Busra's leads with cancels. Speed to lead (new enquiries and tomorrow's trials) is always first for everyone. Sunday has a smaller call target because the desk is busy.<\/p><p><b>Reply by email<\/b> on a card opens the right email so you can answer it straight away.<\/p>"},{"d":"hub","h2":"New from 1 November","t":"After-trial check: resend to an instructor","html":"<p>Under <b>Reports not in yet<\/b>, tap <b>Resend<\/b> next to a trial to text the after-trial check to the instructor again (for example Dilek or Tate) if yesterday's wasn't filled in. You see the text first.<\/p>"},{"d":"hub","h2":"New from 1 November","t":"New recommendation from a follow-up card","html":"<p>Next to <b>Rebook trial<\/b> there's now a <b>New recommendation<\/b> button. It opens the enrolment recommendation for that family straight from the card.<\/p>"},{"d":"hub","h2":"New from 1 November","t":"Gradings: now open to Bianca, Mady, Busra and Ridvan","html":"<p>As well as Mark, Sarah and Hakan.<\/p><p><b>Overdue: missed a grading.<\/b> A new filter in Gradings. It lists students who have had enough classes for their next belt for 3 months or more without grading, so they've missed at least one grading. Each card says roughly when they became ready. These families are a priority to invite. Never tell a family how many classes their child needs.<\/p>"},{"d":"hub","h2":"New from 1 November","t":"Not sure where something is?","html":"<p>Use <b>How to use the hub<\/b> at the top of the hub home page. Type a question (for example <i>medical certificate<\/i> or <i>cancel<\/i>) and it takes you straight to the answer.<\/p>"},{"d":"hub","h2":"New from 31 October","t":"Messages families now get automatically","html":"<p>The hub now sends these, so you don't need to. If a family replies, the reply lands in GHL Conversations as usual.<\/p><table class=\"hp-t\"><tr><th>When<\/th><th>What the family gets<\/th><\/tr><tr><td>Trial booked<\/td><td>A text and a \"You're booked in\" email with the address, parking and what to bring. The calendar no longer sends its own confirmation.<\/td><\/tr><tr><td>2 hours before the trial<\/td><td>A reminder text (only for bookings made more than a day ahead).<\/td><\/tr><tr><td>Day before, 5pm<\/td><td>A reminder text, only if nobody reached them on the 24-hour call.<\/td><\/tr><tr><td>Trial cancelled<\/td><td>A text with the booking link to pick a new time.<\/td><\/tr><tr><td>Day after an attended trial<\/td><td>A thank-you text at 9am (if they haven't joined yet).<\/td><\/tr><tr><td>Day 7 and 14 after the trial<\/td><td>An email with their joining link, then a text.<\/td><\/tr><tr><td>Enrolled<\/td><td>A welcome text and a welcome email from their school, with class times.<\/td><\/tr><tr><td>Day 2 and day 14 after starting<\/td><td>Emails about the uniform and belt, then how gradings and the monthly theme work.<\/td><\/tr><\/table>"},{"d":"hub","h2":"New from 31 October","t":"Trials tomorrow: confirm by phone (My Day)","html":"<p>Call every family with a trial tomorrow. Confirm the time, answer questions, and offer to book a friend, brother or sister too: if they join as well, both get $50 off sign up. Tap <b>Confirmed<\/b>, <b>Rescheduled<\/b>, <b>No answer<\/b> or <b>Change class or time<\/b>. Families you couldn't reach get the 5pm reminder text instead; \"No answer\" ones stay on the list so you can try again.<\/p>"},{"d":"hub","h2":"New from 31 October","t":"Gradings (Mark, Sarah and Hakan)","html":"<p>The <b>GRADINGS<\/b> tile lists every colour belt (white to red three) for each school's grading, plus Little Dragons turning 6 who will grade into Dragons. For each student you see their belt, classes since their last belt against the minimum, classes in the last month, and whether they'll reach the minimum by grading day at their current pace.<\/p><ol><li>Pick the school at the top.<\/li><li>Work through each student. The dashed button is the hub's suggestion: tap it to confirm, or tap another option (<b>Invite<\/b>, <b>Get ready<\/b>, <b>Not this time<\/b>, <b>Check belt<\/b>, or for Little Dragons <b>Grade into Dragons: Yellow belt / Orange belt<\/b>).<\/li><li>Tick <b>Needs technique help<\/b> and write what to work on, so instructors can help them in class or at the Colour Belt Prep Session.<\/li><li><b>Check belt in EFC<\/b> means the student has been on white belt for over 6 months, so their belt is probably recorded wrong in EFC. Fix it in EFC.<\/li><\/ol><p><b>Sending.<\/b> Tap <b>Send texts for (school)<\/b>. You see how many texts and four real examples first; nothing goes until you tap <b>Send N texts now<\/b>. Only students with a saved decision are sent, one text per family, between 9am and 7pm. The text asks the family to reply YES to confirm their intention to grade; the official invitation and payment still come from EFC.<\/p><p><b>Replies<\/b> show on each card. A YES marks the student <b>Intends to grade<\/b>: use that filter for the EFC invitations. <b>Sent, no reply yet<\/b> shows who to follow up.<\/p><p><b>To fix in EFC.<\/b> Tap <b>Fix in EFC<\/b> on a card when the EFC record is wrong (Has cancelled, On hold, Wrong belt, Parent name or mobile, Other). Students marked cancelled or on hold are never texted, and nor is anyone with a hold or cancellation logged in the hub. The <b>To fix in EFC<\/b> tab lists every student across all schools that needs fixing, including white belts for over 6 months and children whose EFC contact has their own name. Fix the record in EFC, then tap <b>Fixed in EFC<\/b>.<\/p>"},{"d":"hub","h2":"New this week (27 to 30 Oct)","t":"New this week (27 to 30 Oct)","html":"<p>Reload the hub page once to get the latest version. Then:<\/p><ul><li><b>My Day<\/b> is your to-do list for the shift. See the My Day section below.<\/li><li><b>Absentee follow up<\/b> is live for every school. Families who text back show first, with their reply on the card. See the Absentee follow up section below.<\/li><li><b>Reply by text<\/b> from an absentee card, and a <b>Text sign-in reminder<\/b> button for members who trained but didn't check in.<\/li><li><b>Undo<\/b> after you save a choice on a new enquiry, and a <b>Remove: blank or junk enquiry<\/b> option for \"No name\" cards.<\/li><li><b>Double booking check<\/b>: the hub warns you if a family already has a trial booked.<\/li><li><b>They called back: trial confirmed<\/b> on any trial in the hub.<\/li><li>Holds use the name in <b>Taken by<\/b>, not whoever is signed in, and finished holds fold away.<\/li><li>Saving an action no longer blanks the page. The card folds away and the list refreshes quietly.<\/li><li>Hub texts to rostered staff only arrive during your shift.<\/li><li>Emails to info@, including attachments like medical certificates, now show on the family's GHL profile.<\/li><\/ul>"},{"d":"hub","h2":"Start here","t":"Start here","html":"<p>From Monday 26 October, every trial report, follow-up, hold and cancellation goes through the Admin Hub. The old weekly stats sheet is no longer used. This guide shows each role what to do and what happens after each step. Each role only needs to read the sections listed for it below.<\/p><table class=\"hp-t\"><tr><th>Your role<\/th><th>Read these sections<\/th><\/tr><tr><td>Front desk and admin (Bianca, Mady, Busra)<\/td><td>Start here, The hub at a glance, Front desk, Holds, Cancellations, Texts and emails<\/td><\/tr><tr><td>Instructors and head instructors<\/td><td>Start here, The hub at a glance, Instructors, plus Holds and Cancellations if a parent raises it with you<\/td><\/tr><tr><td>Cancellation Coordinator (Sarah)<\/td><td>Cancellations, Cancellation Coordinator<\/td><\/tr><tr><td>Approvers (Mark and Sarah)<\/td><td>Approvers, Holds, Cancellations<\/td><\/tr><tr><td>Management (Mark, Sarah, Hakan)<\/td><td>The separate Management Dashboard guide<\/td><\/tr><\/table>"},{"d":"hub","h2":"Start here","t":"Signing in","html":"<ol><li>Open <b>train.australianmartialarts.com.au/admin<\/b> on your phone or the front desk computer.<\/li><li>Type your mobile and your PIN, then tap <b>Sign in<\/b>. Mark gives you a PIN the first time.<\/li><li>You stay signed in on that device for 12 hours. To sign out, tap <b>Sign out<\/b> in the bottom-right corner.<\/li><\/ol><p><b>Forgot your PIN?<\/b> Tap <b>Forgot PIN?<\/b>, enter your mobile and tap <b>Text me a new PIN<\/b>. A new PIN is texted to you.<\/p><p><b>Locked out?<\/b> Five wrong PINs locks your mobile for 15 minutes. Wait, then try again, or ask Mark.<\/p><p>The same sign-in covers the hold form (/membership-freeze) and Trial Why (/trial-why). Your name is filled in automatically on everything you log, so the record always shows who did it.<\/p><blockquote>Staff use only. Never send a hub link to a member. Families only ever get their own signing link by email.<\/blockquote>"},{"d":"hub","h2":"The hub at a glance","t":"The hub at a glance","html":"<p>From the top:<\/p><ul><li><b>Top bar<\/b>: My work, Members, Events, Team and Business. Tap Members, Events, Team or Business for a menu of everything inside. Then the search box (find any family by name or mobile), Help, and <b>Approvals<\/b> with the number waiting on you.<\/li><li><b>Today's trials<\/b>: every trial today at every school, with the buttons to mark them. See the next section.<\/li><li><b>My work<\/b>: what you need to do today, from every area.<\/li><li><b>Right-hand column<\/b>: Open Deputy to clock on, Log into EFC, Log into GHL, what is waiting on someone else, and On today (trials booked, staff on shift, anyone not clocked on yet, parties this weekend).<\/li><li><b>Members<\/b>: one row of stages from trial to leaving: Trials, Close the sale, New members, Absent, Requests to log, On hold, Cancelling, Referrals. Tap one to work it.<\/li><li><b>Events, Team, Business<\/b>: gradings, parties, private lessons, Book a trial, My Day, Clock on, roster and pay, employment packs, and the Management dashboard.<\/li><li>At the bottom: <b>Trials on other days<\/b> (last 7 days and coming up) and <b>All sections<\/b> (the old tiles).<\/li><\/ul><p>The numbers for the last 7 days and the By school table have moved to the Management dashboard.<\/p>"},{"d":"hub","h2":"How it all fits together (end to end)","t":"How it all fits together (end to end)","html":"<p>This is a family's whole journey with us, start to finish, and where each step happens. Updated 25 October.<\/p><ol><li><b>Enquiry.<\/b> A family books a trial online or sends an enquiry. GHL sends them an automatic welcome. If no one replies within 60 minutes, whoever is on shift gets a text. Families still waiting for a reply show under <b>Follow up today → Reply to new enquiries<\/b>.<\/li><li><b>Before the trial.<\/b> Rostered staff get a morning text listing the day's trials. Instructors read each family's <b>Trial why<\/b>.<\/li><li><b>End of the trial.<\/b> The instructor sends a recommendation from the <b>Staff recommendation tool<\/b>, and says whether a current member referred them.<\/li><li><b>After-trial check.<\/b> About 30 minutes after the last trial, rostered staff get a text to fill in the check: who attended, who didn't, and who got a recommendation.<\/li><li><b>Joining link.<\/b> As soon as the recommendation is sent, GHL texts and emails the family a short, personal joining link. When they open it, the page fills in their membership, prices, name, contact details and any dates of birth we already have. Reminder texts follow 2 hours later and the next day.<\/li><li><b>Close the sale.<\/b> Families who haven't joined come up in <b>Close the sale<\/b> for calls on day 2, 4, 7 and 14.<\/li><li><b>Joining form, then payment.<\/b> When they submit the joining form, GHL sends the EFC payment setup link. If it can't, the card shows <b>Manual billing needed<\/b>: the office sets up billing in EFC, then taps <b>Payment set up in EFC<\/b> on the hub.<\/li><li><b>Enrolled.<\/b> Once the payment is confirmed, GHL moves them to Enrolled, sends the welcome text and email, and adds them to the Enrolments sheet.<\/li><li><b>Referral thank-you.<\/b> If a member referred them, the referral appears in <b>Referrals<\/b>. Tate thanks the member and organises the reward, and an instructor presents it in class.<\/li><li><b>Holds and cancellations.<\/b> Later on, any pause or stop is logged on the hub with the Freeze form or the Cancellation form. The hub handles approvals, signing, EFC reminders and every text and email to the family.<\/li><li><b>Management dashboard.<\/b> Everything above feeds the management dashboard for Mark, Sarah, Hakan and Ridvan. It rebuilds every 30 minutes.<\/li><\/ol><p>If a parent says their joining link didn't work, tap <b>Resend joining link<\/b> on their Close the sale card. It sends the same short link again.<\/p>"},{"d":"hub","h2":"My Day","t":"My Day","html":"<p>Open <b>My Day<\/b> from the home page at the start of every shift. It says hello, shows your hours today and your targets, then lists everything waiting, in the order to do it. Work from the top down.<\/p><p>Each row shows how many are waiting and the first few names. Tap a row to open the page where you make the call and record what happened. When you finish an item it drops off the list. Tap <b>Refresh<\/b> at the top of the list to update the counts.<\/p><table class=\"hp-t\"><tr><th>Row<\/th><th>What to do<\/th><\/tr><tr><td>New enquiries waiting for a reply<\/td><td>Reply within 15 minutes, from GHL or your phone<\/td><\/tr><tr><td>Online bookings to confirm (next 2 days)<\/td><td>Tap a name to confirm the trial and do the fact finding<\/td><\/tr><tr><td>Absentee replies to action<\/td><td>Families who texted back. Read the reply and pick an outcome. Most need no call<\/td><\/tr><tr><td>After-trial follow-up calls<\/td><td>Families who trialled and haven't joined yet<\/td><\/tr><tr><td>Close the sale calls<\/td><td>Recommendation sent, not joined. Goal: payment set up today<\/td><\/tr><tr><td>New member calls<\/td><td>First 90 days check-ins<\/td><\/tr><tr><td>Absentee calls<\/td><td>Members who've stopped coming and haven't replied<\/td><\/tr><tr><td>Referral thank-you calls<\/td><td>Thank the member who referred a family<\/td><\/tr><tr><td>Holds to action<\/td><td>Holds that need something done in EFC. Finished holds don't show here<\/td><\/tr><tr><td>Cancellations to action in EFC<\/td><td>Cancellations to process<\/td><\/tr><\/table><p>If you're not on the roster today, My Day still shows everything waiting.<\/p>"},{"d":"hub","h2":"Front desk and admin (Bianca, Mady, Busra)","t":"Front desk and admin (Bianca, Mady, Busra)","html":"<p>While you're on shift, your job in the hub is to reply to every new enquiry within the hour, follow up every trial, and log every hold and cancellation conversation.<\/p>"},{"d":"hub","h2":"Front desk and admin (Bianca, Mady, Busra)","t":"Start of every shift","html":"<ol><li>Sign in and open <b>FOLLOW UP TODAY<\/b>.<\/li><li>Work down <b>Reply to new enquiries<\/b>. Oldest is at the top.<\/li><li>Check <b>Reports not in yet<\/b> and chase anyone who hasn't done their after-trial check.<\/li><li>Work through <b>Attended, not enrolled yet<\/b> and <b>Absent, rebook<\/b>.<\/li><li>Open <b>HOLDS TO ACTION<\/b> and clear anything you can.<\/li><\/ol>"},{"d":"hub","h2":"Front desk and admin (Bianca, Mady, Busra)","t":"Replying to new enquiries","html":"<p>This list shows every enquiry from the last 7 days that hasn't had a text, email or call from a person. The automatic welcome SMS and email don't count.<\/p><p><b>Picked the wrong option?<\/b> After you tap <b>Save<\/b>, an <b>Undo<\/b> button appears next to \"Saved\". Tap it and the card goes back on the list. It stays until you refresh the page.<\/p><p><b>\"No name\" cards<\/b> are blank or junk enquiries. Choose <b>Remove: blank or junk enquiry<\/b> and tap <b>Save<\/b>. Enquiries deleted in GHL drop off by themselves.<\/p><ul><li>Reply from GHL (tap <b>Open in GHL<\/b>). The enquiry drops off the list within 30 minutes on its own.<\/li><li>If you called or texted from your own phone, tap <b>I replied from my own phone<\/b>. It drops off straight away and still counts towards our reply time.<\/li><\/ul><p><b>Replying in GHL, step by step<\/b><\/p><ol><li>On the enquiry card, tap <b>Open in GHL<\/b>. Their contact record opens.<\/li><li>Open the <b>Conversations<\/b> panel on the contact (or go to <b>Conversations<\/b> in the left menu and search their name).<\/li><li>Choose <b>SMS<\/b> or <b>Email<\/b> at the bottom, type your message, and tap <b>Send<\/b>.<\/li><li>If you call instead, use the phone icon in GHL so the call is logged. A call from your own phone doesn't show, so tap <b>I replied from my own phone<\/b> on the hub afterwards.<\/li><li>If they're ready to book, book the trial in the school's trial calendar in GHL. It then appears on the hub's Trials list and in the after-trial check.<\/li><\/ol><p><b>What happens if nobody replies:<\/b> after 60 minutes, whoever is on shift gets a text. 60 minutes after that, Mark gets a text. No alerts go out between 9pm and 7am.<\/p><p>Alerts follow these hours, which Mark keeps on the Enquiry alerts tab:<\/p><table class=\"hp-t\"><tr><th><\/th><th>Mon<\/th><th>Tue<\/th><th>Wed<\/th><th>Thu<\/th><th>Fri<\/th><th>Sun<\/th><\/tr><tr><td>Bianca<\/td><td>1pm-8pm<\/td><td>11am-8pm<\/td><td>-<\/td><td>-<\/td><td>9:30am-8pm<\/td><td>7:45am-12:45pm<\/td><\/tr><tr><td>Mady<\/td><td>11am-7pm<\/td><td>1pm-7pm<\/td><td>1pm-7pm<\/td><td>9am-7pm<\/td><td>1pm-7pm<\/td><td>-<\/td><\/tr><tr><td>Busra<\/td><td>-<\/td><td>10am-1pm<\/td><td>10am-1pm<\/td><td>-<\/td><td>-<\/td><td>-<\/td><\/tr><\/table>"},{"d":"hub","h2":"Front desk and admin (Bianca, Mady, Busra)","t":"Following up after trials","html":"<p><b>Attended, not enrolled yet<\/b> and <b>Absent, rebook<\/b> list each family with the instructor's notes and whether a recommendation was sent.<\/p><ol><li>Call or text the family.<\/li><li>Choose an <b>Outcome<\/b>: Enrolled, Booked another trial, Call again, No answer - left message, or Not interested.<\/li><li>Add a short note and tap <b>Save<\/b>.<\/li><\/ol><p><b>What happens next:<\/b><\/p><ul><li><b>Call again<\/b> and <b>No answer<\/b> put the family back on your list in 2 days.<\/li><li>Families drop off the list by themselves once they enrol. The joining form tells the hub.<\/li><\/ul>"},{"d":"hub","h2":"Front desk and admin (Bianca, Mady, Busra)","t":"When a parent wants to pause or stop","html":"<ul><li><b>Injured, sick or going away<\/b> → use the <b>Membership freeze<\/b> form. See the Holds section.<\/li><li><b>Wants to stop<\/b> → use the <b>Cancellation form<\/b>. Always try the offer first. See the Cancellations section.<\/li><\/ul><p>Never just tell a parent \"email us\". Log the conversation in the hub. That's how they get their signing link and how we keep the record.<\/p>"},{"d":"hub","h2":"Front desk and admin (Bianca, Mady, Busra)","t":"Holds to action","html":"<p>You put holds on in EFC and restart billing when they end. The Holds section has the full steps.<\/p>"},{"d":"hub","h2":"Instructors and head instructors","t":"Instructors and head instructors","html":"<p>If you run trials, you have three jobs in the hub. Log why the family is coming, send the recommendation at the end of the trial, and report every trial before you go home.<\/p><p>Most instructors now see the <b>simple view<\/b> of the hub: your shift, Today's trials for your schools, and your buttons. Tap <b>Send recommendation<\/b> on the trial card at the end of the class.<\/p>"},{"d":"hub","h2":"Instructors and head instructors","t":"Before the trial: Trial why","html":"<p>When you set up or confirm a trial, open <b>Trial why<\/b> (SALES section). Log why the family is coming, in their words. Whoever runs the trial and makes the recommendation reads this.<\/p><ol><li><b>Parent first name.<\/b><\/li><li><b>Parent email<\/b> (optional).<\/li><li><b>Parent mobile.<\/b> Copy it from their GHL contact so it saves against the right family.<\/li><li><b>What brought them in?<\/b> For example confidence, fitness, focus, self defence.<\/li><li><b>In their words.<\/b> What they actually said, for example \"she is a bit shy at school and we want to build her confidence\".<\/li><li>Tap <b>Save to their record<\/b>. It saves to their GHL contact.<\/li><\/ol>"},{"d":"hub","h2":"Instructors and head instructors","t":"End of the trial: Staff recommendation tool","html":"<p>Open the <b>Staff recommendation tool<\/b> (SALES section). Build the membership recommendation and send the family the joining link.<\/p><p>It has three screens: <b>1 Details<\/b>, <b>2 The numbers<\/b>, <b>3 Sent<\/b>.<\/p><p><b>Screen 1: Details<\/b><\/p><ol><li><b>Family:<\/b> parent first name, last name, mobile and email.<\/li><li><b>Fact finding:<\/b><\/li><li>primary goal, and a secondary goal (optional)<\/li><li><b>Why<\/b> (in their words, what isn't working right now)<\/li><li><b>Why now<\/b> (what made them come in this week)<\/li><li>how important solving it is, out of 10<\/li><li>the timeframe they want results in<\/li><li>the outcome they want in 3 to 6 months (optional)<\/li><li>the decision maker<\/li><li>their commitment level<\/li><li><b>Recommendation:<\/b><\/li><li>school<\/li><li>how many are joining<\/li><li>any promotion running<\/li><li>for each student: name, date of birth and membership (1 Per Week, Kickstarter, Gold or Unlimited)<\/li><li><b>Existing family<\/b> and <b>Referral:<\/b> whether anyone in the family already trains, and whether a current member referred them, with names.<\/li><li><b>Recommended by:<\/b> choose <b>your own name<\/b>. This is how the joins are credited to you.<\/li><li><b>Notes for the office<\/b> (optional). Then tap <b>See the numbers<\/b>.<\/li><\/ol><p><b>Screen 2: The numbers.<\/b> Go through the weekly investment and what's due today with the family. Tap <b>Change<\/b> to adjust, or <b>Agree &amp; send<\/b>.<\/p><p><b>Screen 3: Sent.<\/b> The family is sent their recommendation and joining link. Tap <b>New recommendation<\/b> for the next family.<\/p><p><b>What happens next:<\/b><\/p><ul><li>The trial shows as <b>Rec sent<\/b> on the hub.<\/li><li>Your name is recorded as the person who recommended.<\/li><li>When the family joins, the enrolment is credited to you on the management dashboard.<\/li><\/ul>"},{"d":"hub","h2":"Instructors and head instructors","t":"End of your shift: After-trial check","html":"<p>About 30 minutes after the last trial of the day, the rostered staff at that school get a text with a link. The text never goes out after 9pm. You can also open <b>AFTER-TRIAL CHECK<\/b> from the home page whenever you like.<\/p><ol><li>Choose the school and the day, then tap <b>Show trials<\/b>.<\/li><li>For each trial, tap <b>Attended<\/b> or <b>Absent<\/b>.<\/li><li>Answer <b>Recommendation sent?<\/b> with <b>Yes<\/b> or <b>No<\/b>.<\/li><li>Write notes for Bianca and Mady: what the family said and what happens next.<\/li><li>Tap <b>Save<\/b> on each card.<\/li><\/ol><p>Trials already marked Enrolled or Rec sent are listed as \"already known\". You don't need to report those.<\/p><p><b>What happens next:<\/b><\/p><ul><li><b>Attended<\/b> families who haven't joined go to Bianca and Mady's <b>Attended, not enrolled yet<\/b> list, with your notes.<\/li><li><b>Absent<\/b> families go to their <b>Absent, rebook<\/b> list.<\/li><li>Any trial you don't report shows on <b>Reports not in yet<\/b>, and Bianca and Mady will chase you.<\/li><\/ul><p><b>Covering another school?<\/b> Mark or Sarah can add you to that school's text for the day. If the text has already gone out, open AFTER-TRIAL CHECK yourself and pick the school.<\/p><p><b>Send-offs.<\/b> On a student's last class day, the staff rostered at that school get a text: \"Max's last class at Marrickville is today.\" Give them a send-off in front of the class, for example a handshake, a round of applause, and a reminder they're always welcome back. Families remember how it ended.<\/p>"},{"d":"hub","h2":"Instructors and head instructors","t":"If a parent raises a pause or cancellation with you","html":"<p>Use the same forms as the front desk (see Holds and Cancellations). Only Mark, Sarah, Hakan and Busra can accept cancellation notice in person. Anyone else logs it as \"Not yet\", and the parent signs online.<\/p>"},{"d":"hub","h2":"Instructors and head instructors","t":"Double bookings and call-backs","html":"<p><b>Already booked?<\/b> If you book a trial for a family that already has one coming up, the hub stops and shows you the existing booking. Nothing new is booked. To change it, use <b>Change class or time<\/b> on that booking. Use <b>Book anyway<\/b> only for a different child or an extra class.<\/p><p><b>Don't cancel a trial in GHL to tidy up.<\/b> Cancelling sends the family an automatic cancellation email and text. If you find a double booking, ask Mark or Sarah first.<\/p><p><b>They called back to confirm:<\/b> tap the trial in the hub, then <b>They called back: trial confirmed<\/b>. Add a short note and tap <b>Save<\/b>. It adds a note to their GHL contact.<\/p>"},{"d":"hub","h2":"Holds (membership freezes)","t":"Holds (membership freezes)","html":"<p>Under the terms, a family can pause payments for up to 6 weeks for an injury or illness, with a medical certificate. Anything else is either a save or needs Mark or Sarah to approve it. Every hold that goes ahead is signed online by the family.<\/p><p><b>Taken by<\/b> is the person the hold is recorded under, even if someone else is signed in on the front desk computer. Type your own name. Approval and decline texts go to that person. When Mark or Sarah declines a hold, you're told too, and Sarah calls the family.<\/p><p><b>Medical certificates:<\/b> when a family emails one to info@, it's attached to the email on their GHL profile. Check it there, then tap <b>Certificate received<\/b> on the hold.<\/p>"},{"d":"hub","h2":"Holds (membership freezes)","t":"Step by step","html":"<ol><li><b>Open the form.<\/b> Go to RETENTION, then <b>Membership freeze<\/b>. The family's details must match their GHL contact: name, mobile, students and school. <b>Email is required<\/b>, because that's where the agreement goes.<\/li><li><b>Choose the reason.<\/b><\/li><li><b>Sick or injured:<\/b> enter the condition and whether the medical certificate is received or still to come.<\/li><li><b>Going away:<\/b> offer make-up classes first. Holiday weeks are already allowed for in their fees. If make-ups solve it, the form logs a <b>save<\/b> (no hold, no EFC change, nothing for the family to sign).<\/li><li><b>Something else:<\/b> write it down in their words.<\/li><li><b>Enter the dates:<\/b> the hold start, the end date (when billing restarts) and the next payment date. The form checks this against the terms.<\/li><li><b>Send it.<\/b> One of three things happens:<\/li><\/ol><table class=\"hp-t\"><tr><th>The form says<\/th><th>What happens next<\/th><th>What you tell the family<\/th><\/tr><tr><td>Within the terms (medical, 6 weeks or less)<\/td><td>Approved automatically. The family is emailed a link to check and sign the hold.<\/td><td>\"You'll get an email from us now to check the dates and sign. Please look in junk too.\"<\/td><\/tr><tr><td>Outside the terms (e.g. travel, longer than 6 weeks)<\/td><td>Mark and Sarah get a text to approve it. It waits under <b>Waiting on Mark or Sarah<\/b>.<\/td><td>\"I've passed this to Mark and Sarah. We'll let you know shortly.\"<\/td><\/tr><tr><td>Going away, sorted with make-ups<\/td><td>Logged as a save. Nothing else happens.<\/td><td>Book their make-up classes.<\/td><\/tr><\/table>"},{"d":"hub","h2":"Holds (membership freezes)","t":"The freeze form, screen by screen","html":"<p><b>01 Who<\/b><\/p><ul><li>Account holder first name, last name and mobile. Copy the mobile from their GHL contact; this is how the hold is saved against them.<\/li><li><b>Email.<\/b> Required, because the agreement is emailed here to sign.<\/li><li><b>Students on this freeze.<\/b> Separate names with commas, and list only the children stopping. A family can freeze one child and keep another training.<\/li><li><b>Trains at.<\/b> Pick the school.<\/li><li><b>Taken by.<\/b> Your name fills in automatically.<\/li><li><b>Previous freezes.<\/b> Choose First one, Had one before, Two or more before, or Not sure. Previous freezes are allowed (6 weeks is per incident); this just shows the pattern.<\/li><\/ul><p>Tap <b>Continue<\/b>.<\/p><p><b>02 Why.<\/b> Choose one reason:<\/p><ul><li><b>Sick or injured:<\/b> choose <b>Medical certificate<\/b>. Pick \"We have it\" or \"They are sending it\". Either is fine, but if it's still coming, the hold isn't put on in EFC until it arrives. Then type the injury or illness.<\/li><li><b>Going away:<\/b> read the script on screen. They already don't pay for up to four holiday weeks a year, so offer make-up classes. Then answer <b>How did that land?<\/b>:<\/li><li><b>Happy with make-up classes:<\/b> that's the end. It's logged as a save.<\/li><li><b>They still want the payments paused:<\/b> it goes to Mark and Sarah.<\/li><li><b>Something else:<\/b> type the reason (cost, work hours, lost interest). This always goes to Mark and Sarah. Check first whether this is really a conversation about what isn't working.<\/li><\/ul><p>For every reason, fill in <b>In their words<\/b> (Mark or Sarah read this if it needs approving) and <b>What did you offer instead?<\/b> A child in a cast can still come and watch. Tap <b>Continue<\/b>.<\/p><p><b>03 Dates<\/b><\/p><ul><li><b>Freeze starts.<\/b><\/li><li><b>Freeze ends.<\/b> Billing restarts on this date and the membership is not extended.<\/li><li><b>Next payment date.<\/b> Take this from EFC; it warns you if a payment is already on its way.<\/li><\/ul><p>Tap <b>Continue<\/b>.<\/p><p><b>04 Confirm.<\/b> Read the summary and the terms back to the family, then tap <b>Send to them to sign<\/b> (or <b>Log this freeze<\/b>). The screen then tells you exactly what happens next.<\/p>"},{"d":"hub","h2":"Holds (membership freezes)","t":"After you send it","html":"<ul><li><b>If Mark or Sarah approves:<\/b> you get a text. The family is emailed the signing link automatically. Let them know to look out for it.<\/li><li><b>If they decline:<\/b> you get a text. Call the family and explain. The hold comes off the list.<\/li><li><b>When the family signs:<\/b> they get a signed PDF copy by email, the office gets a copy, and you get a text. The PDF is saved and linked on the hold card.<\/li><\/ul><p><b>Texts to the family during the hold<\/b>. At 10am the AMA number texts the account holder:<\/p><ul><li>on the day the hold starts<\/li><li>halfway through, for holds of 4 weeks or more<\/li><li>5 days before the hold ends, to welcome them back<\/li><\/ul><p>Replies come into <b>GHL Conversations<\/b>. If a family replies that they need longer, call them. Log a new hold for the extra weeks so it is approved and signed like any other.<\/p>"},{"d":"hub","h2":"Holds (membership freezes)","t":"Holds to action: what you do in EFC","html":"<p>Each hold moves through these groups on <b>HOLDS TO ACTION<\/b>:<\/p><table class=\"hp-t\"><tr><th>Group<\/th><th>What it means<\/th><th>Your button<\/th><\/tr><tr><td>Waiting on Mark or Sarah<\/td><td>Outside the terms, not decided yet<\/td><td>None. Wait for their reply.<\/td><\/tr><tr><td>Waiting for the family to sign<\/td><td>Approved, signing link emailed<\/td><td><b>Resend signing link<\/b> if they can't find it. <b>Done in EFC anyway<\/b> only if Mark says so.<\/td><\/tr><tr><td>Waiting for the medical certificate<\/td><td>Certificate still to come<\/td><td><b>Certificate received<\/b> once you have it<\/td><\/tr><tr><td>Put on hold in EFC<\/td><td>Ready to set up<\/td><td>In EFC, pause payments from the start date and set them to restart on the end date. Then tap <b>Done in EFC<\/b>.<\/td><\/tr><tr><td>On hold now<\/td><td>Hold is running<\/td><td>Nothing yet<\/td><\/tr><tr><td>Hold ending: restart billing in EFC<\/td><td>Ends within 3 days<\/td><td>Check billing has restarted in EFC, then tap <b>Restarted in EFC<\/b>. The hold leaves the list.<\/td><\/tr><\/table><p><b>Putting a hold on in EFC<\/b><\/p><ol><li>In EFC, check the school name at the top left is right. Switch location if it isn't.<\/li><li>Search the member at the top, open them and go to the <b>Subscriptions<\/b> tab.<\/li><li>On their active subscription, tap <b>⋮<\/b>, then <b>Suspend invoices<\/b>.<\/li><li><b>Cancel invoices from:<\/b> the hold start date. <b>Cancel invoices until:<\/b> the day before the hold ends, because billing restarts on the end date.<\/li><li>Leave <b>Append suspended invoices to the end of the subscription<\/b> unticked. The terms say the membership is not extended.<\/li><li><b>Cancellation type:<\/b> Injury / Medical for medical holds, otherwise the closest type. In <b>Reason<\/b>, write the H number, for example H2970.<\/li><li>Tap <b>Suspend<\/b>. Check the <b>Invoices<\/b> tab: there should be no open invoices inside the hold dates.<\/li><li>Go back to the hub and tap <b>Done in EFC<\/b>.<\/li><\/ol><p><b>When the hold ends.<\/b> Open <b>Invoices<\/b> and check that the first invoice on or after the end date is there and open. Then tap <b>Restarted in EFC<\/b>. If the dates were wrong, <b>Restore invoices<\/b> on the same ⋮ menu brings suspended invoices back.<\/p><p>Tap a button only after you've done the step in EFC. Your name and the time are recorded.<\/p><blockquote>If the screen ever says the agreement could not be emailed, check the email address on the hold and tell Mark.<\/blockquote>"},{"d":"hub","h2":"Holds (membership freezes)","t":"Extending a hold","html":"<p>Use this when a family on hold needs more time, for example the doctor says another three weeks off, or a family on an approved exception is still away. They can ask by phone, by email, or by replying to one of the hold check-in texts.<\/p><ol><li>Open <b>HOLDS TO ACTION<\/b> and find their current hold.<\/li><li>Tap <b>Extend this hold<\/b>. The button only shows before the hold's end date. After that, log a new hold instead.<\/li><li>Choose how many more weeks. The new return date shows underneath.<\/li><li>For a medical hold, choose whether the updated certificate is <b>Received<\/b> or <b>To follow<\/b>.<\/li><li>Type what the family told you and tap <b>Send extension<\/b>.<\/li><\/ol><p><b>What happens next<\/b><\/p><ul><li><b>Medical, 6 weeks or less in total<\/b> (the first hold plus the extension): it goes through on the certificate, and the family is emailed the extension agreement to sign.<\/li><li><b>Medical over 6 weeks, or any extension of a non-medical hold:<\/b> Mark and Sarah get a YES/NO text. You get a text when they decide.<\/li><li>Once the family signs, the extension appears under <b>Put on hold in EFC<\/b>, tagged <b>Extension of H…<\/b>. In EFC, change the date billing restarts to the new end date, then tap <b>Done in EFC<\/b>.<\/li><li>The halfway and welcome-back texts move to the new end date automatically. If the extension is declined, the original hold carries on as before.<\/li><\/ul>"},{"d":"hub","h2":"Cancellations","t":"Cancellations","html":"<p>A cancellation needs 30 days' written notice, and payments continue until the notice ends. Every cancellation conversation is logged in the hub, even when the family stays. Every cancellation that goes ahead is signed online by the parent.<\/p>"},{"d":"hub","h2":"Cancellations","t":"Step by step (Cancellation form)","html":"<p>Open it from RETENTION, then <b>Cancellation form<\/b>. It has four steps.<\/p><ol><li><b>Who.<\/b> Enter the person who pays (first name, last name, mobile, email), the students who are stopping, and their school. Copy the mobile from their GHL contact so it matches. When you tap <b>Continue<\/b>, the hub looks up their membership: join date, package and whether they're under 12 months.<\/li><li><b>Why.<\/b> Pick the closest reason. Each reason shows a gold <b>Say this<\/b> script with an offer:<\/li><\/ol><table class=\"hp-t\"><tr><th>Reason<\/th><th>Offer to make first<\/th><\/tr><tr><td>Moved or too far<\/td><td>Switch to another of our five schools<\/td><\/tr><tr><td>Class times don't work<\/td><td>Change days or times<\/td><\/tr><tr><td>Cost<\/td><td>Drop to a smaller package<\/td><\/tr><tr><td>Injury or illness<\/td><td>Medical freeze. Use the freeze form instead.<\/td><\/tr><tr><td>Going away<\/td><td>Make-up classes. Holiday weeks are already allowed for.<\/td><\/tr><tr><td>Lost interest<\/td><td>A free 10-minute chat with their instructor<\/td><\/tr><tr><td>Unhappy with something<\/td><td>No offer. It goes to Sarah as a complaint.<\/td><\/tr><tr><td>Something else<\/td><td>Listen, write it in their words, and try any of the options above<\/td><\/tr><\/table><p>Type <b>In their words<\/b>, because the parent sees this when they sign. Choose what you offered. Then choose <b>They're staying<\/b> or <b>Still want to cancel<\/b>.<\/p><ol><li><b>Notice.<\/b> Answer <b>Have they emailed info@?<\/b><\/li><li><b>Yes:<\/b> enter the date the email arrived. The 30 days run from then.<\/li><li><b>Not yet:<\/b> the 30 days start on the day they sign the online link.<\/li><li><b>In person to a head instructor:<\/b> only Mark, Sarah, Hakan or Busra can accept this. Notice starts today.<\/li><\/ol><p>Then:<\/p><ul><li>If they want to stop before the 30 days are up, read the script. If they push back, choose <b>Want to stop earlier - ask Mark/Sarah<\/b>.<\/li><li>If they're under 12 months, choose the uniform balance option.<\/li><li><b>Check and log.<\/b> Read the summary back to them. Tap <b>Log the cancellation<\/b> (or <b>Log the save<\/b>).<\/li><\/ul>"},{"d":"hub","h2":"Cancellations","t":"What happens after you log it","html":"<table class=\"hp-t\"><tr><th>Outcome<\/th><th>What happens automatically<\/th><\/tr><tr><td>They stayed (a save)<\/td><td>Logged as a save. Nothing goes to EFC. If they changed school, days or package, update EFC as normal.<\/td><\/tr><tr><td>Cancellation going ahead<\/td><td>The parent is emailed a link to check the details and sign. It goes on Sarah's Cancellations to action list.<\/td><\/tr><tr><td>Wants to stop early<\/td><td>Mark and Sarah get a text. Until one of them says yes, the full 30 days stand.<\/td><\/tr><tr><td>Complaint<\/td><td>Sarah gets a text straight away with their words.<\/td><\/tr><\/table><p><b>When the parent signs:<\/b><\/p><ul><li>They get a signed PDF copy by email, and the office gets a copy.<\/li><li>Sarah gets a text.<\/li><li>If they hadn't emailed, the 30 days start from the day they signed.<\/li><\/ul><p><b>If Mark or Sarah approves an early stop:<\/b><\/p><ul><li>The last class and the last payment both move to the date the family asked for.<\/li><li>The parent gets a formal email with the new dates.<\/li><li>You get a text.<\/li><\/ul><p>Tell the parent: \"You'll get an email from us now to check the details and sign. Payments continue until the end of your notice, and you're welcome to keep training until then.\"<\/p>"},{"d":"hub","h2":"Cancellations","t":"After the cancellation: what happens automatically","html":"<p>The hub keeps looking after the family through the notice period and after they leave. Your job is to watch for replies in <b>GHL Conversations<\/b> and act on them.<\/p><table class=\"hp-t\"><tr><th>When<\/th><th>Who gets it<\/th><th>What it says<\/th><th>What staff do<\/th><\/tr><tr><td>As soon as it's logged, if they joined less than 3 months ago<\/td><td>Mark and Sarah<\/td><td>Early leaver: call them in the next 48 hours<\/td><td>Mark or Sarah calls the family<\/td><\/tr><tr><td>About 10 days into the notice (signed or notice received)<\/td><td>The family<\/td><td>Max is welcome in class until the last class, plus one offer that fits their reason (another school, other class times, a smaller package, a medical freeze, a chat with the instructor, or make-up classes). Not sent for complaints or \"Something else\".<\/td><td>If they reply yes, sort the change, then tap <b>They're staying<\/b> on Cancellations to action<\/td><\/tr><tr><td>2 days before the last class<\/td><td>The family<\/td><td>We'd love to give Max a proper send-off<\/td><td>Nothing<\/td><\/tr><tr><td>On the day of the last class<\/td><td>Staff rostered at that school<\/td><td>Max's last class is today, please give them a send-off<\/td><td>Give them a send-off in front of the class<\/td><\/tr><tr><td>The day after the last class<\/td><td>The family<\/td><td>Rate their time 1 to 5, and one thing we could have done better<\/td><td>Replies are saved automatically. A 1 or 2 is texted to Sarah.<\/td><\/tr><tr><td>60 and 180 days after the last class<\/td><td>The family<\/td><td>Invitation back, with a line for their reason and a free first class back. Not sent for complaints or families who have rejoined.<\/td><td>If they reply, book the class and treat it as a trial<\/td><\/tr><\/table><p>Texts to families go out between 10am and 6pm, and each family gets each one only once.<\/p>"},{"d":"hub","h2":"Approvers (Mark and Sarah)","t":"Approvers (Mark and Sarah)","html":"<p>You approve everything by replying to a text from the AMA number. Replies only count when they come from your own mobile.<\/p>"},{"d":"hub","h2":"Approvers (Mark and Sarah)","t":"Approving holds and early stops","html":"<p>You get a text for two things:<\/p><ul><li>a <b>hold outside the terms<\/b>, with an ID like <b>H2970<\/b><\/li><li>an <b>early stop<\/b> on a cancellation, with an ID like <b>C8899<\/b><\/li><\/ul><p>Each text gives the family, the dates, the reason, what was offered and who took it.<\/p><table class=\"hp-t\"><tr><th>Reply<\/th><th>What happens<\/th><\/tr><tr><td><b>YES H2970<\/b><\/td><td>The hold is approved. The family is emailed the signing link. The staff member and the other approver get a text.<\/td><\/tr><tr><td><b>NO H2970<\/b><\/td><td>The hold is declined. The staff member gets a text to call the family.<\/td><\/tr><tr><td><b>YES C8899<\/b><\/td><td>The early stop is approved. The last class and the last payment move to the date they asked for. The parent gets a formal email with the new dates. The staff member gets a text.<\/td><\/tr><tr><td><b>NO C8899<\/b><\/td><td>The full 30 days stand. The staff member gets a text.<\/td><\/tr><\/table><p><b>Always include the ID.<\/b> A plain YES only works when exactly one item is waiting. If more than one is waiting, the hub texts back the list and asks you to reply with the ID.<\/p><p>You don't need to tell the staff member yourself. The hub texts them. If you logged it yourself, you won't get a duplicate text.<\/p>"},{"d":"hub","h2":"Approvers (Mark and Sarah)","t":"Early leaver calls","html":"<p>When a family cancels within 3 months of joining, you both get a text with the C number, their reason, their words and their mobile. One of you calls them within 48 hours. Agree between you who takes it. These are usually problems with the first few months that a call can still fix. If they stay, tap <b>They're staying<\/b> on Cancellations to action.<\/p>"},{"d":"hub","h2":"Approvers (Mark and Sarah)","t":"Covering a school (after-trial check text)","html":"<p>The after-trial check text goes to whoever is rostered at that school. When someone covers, text the AMA number:<\/p><table class=\"hp-t\"><tr><th>Text<\/th><th>Result<\/th><\/tr><tr><td>COVER Bianca Marrickville<\/td><td>Bianca also gets today's Marrickville text<\/td><\/tr><tr><td>COVER Bianca Marrickville Sat<\/td><td>The same for Saturday. You can also use \"tomorrow\", a day name or a date like 31/10.<\/td><\/tr><tr><td>COVER LIST<\/td><td>Shows every cover that's set<\/td><\/tr><tr><td>COVER CANCEL Marrickville Sat<\/td><td>Removes it, so only the normal roster gets the text<\/td><\/tr><tr><td>COVER HELP<\/td><td>Texts back these instructions<\/td><\/tr><\/table><ul><li>The school can be shortened to its first few letters (for example \"marr\").<\/li><li>The person must be on the Hub staff list.<\/li><li>Cover <b>adds<\/b> the person. Whoever is rostered still gets the text too.<\/li><li>If today's text has already gone, the reply says so. The person can open AFTER-TRIAL CHECK on the hub instead.<\/li><\/ul>"},{"d":"hub","h2":"Approvers (Mark and Sarah)","t":"Changing a last payment","html":"<p>On <b>CANCELLATIONS TO ACTION<\/b>, only Mark and Sarah see <b>Change last payment<\/b>. Use it when you've agreed a different final payment date with a family.<\/p>"},{"d":"hub","h2":"Cancellation Coordinator (Sarah)","t":"Cancellation Coordinator (Sarah)","html":"<p>Your list is <b>CANCELLATIONS TO ACTION<\/b>. Every cancellation stays on it until it has been set up in EFC. You get a text when a parent signs and when a complaint is logged.<\/p>"},{"d":"hub","h2":"Cancellation Coordinator (Sarah)","t":"The groups on your list","html":"<table class=\"hp-t\"><tr><th>Group<\/th><th>What it means<\/th><th>What you do<\/th><\/tr><tr><td>Waiting on Mark or Sarah<\/td><td>They asked to stop early<\/td><td>Reply YES or NO to the text with the C number<\/td><\/tr><tr><td>Waiting for the parent to sign<\/td><td>The link has been emailed but not signed yet<\/td><td>Chase the family. Tap <b>Resend signing link<\/b> if needed. If their notice email comes in instead, tap <b>Email received<\/b> and pick the date.<\/td><\/tr><tr><td>Notice running: action in EFC<\/td><td>Signed, or notice received<\/td><td>In EFC, set the cancellation to the last class date and add any uniform balance to the final payment. Then tap <b>Done in EFC<\/b>.<\/td><\/tr><tr><td>Early stop approved: action in EFC<\/td><td>Approved to stop early<\/td><td>The same EFC step, using the approved dates<\/td><\/tr><\/table><p><b>Actioning a cancellation in EFC<\/b><\/p><ol><li>In EFC, check the school at the top left. Search the member and open their <b>Subscriptions<\/b> tab.<\/li><li>On the active subscription, tap <b>⋮<\/b>, then <b>Cancel subscription<\/b>.<\/li><li><b>Cancellation date:<\/b> the day after the <b>Last payment<\/b> date on the hub card. Invoices on or after this date are cancelled, so the last payment still goes out. Never leave it blank, because blank cancels immediately.<\/li><li>Tick <b>Also cancel enrolment<\/b> so they come off their classes when the subscription ends.<\/li><li>Tap <b>Cancel subscription<\/b>.<\/li><li><b>Uniform balance:<\/b> if the card says it applies, go to <b>Invoices<\/b>, tap <b>Create Invoice<\/b> for the balance, and date it for the last payment.<\/li><li>Back on the hub, tap <b>Done in EFC<\/b>.<\/li><\/ol><p>For an approved early stop, use the new last payment date shown on the card.<\/p><p>Each card shows:<\/p><ul><li>the family, the students and the school<\/li><li>the reason, their words, and who logged it<\/li><li>the last payment date and the last class date<\/li><li>the uniform balance<\/li><li>whether it's signed, with a link to the signed PDF<\/li><li>a red <b>Complaint<\/b> tag if it applies<\/li><\/ul>"},{"d":"hub","h2":"Cancellation Coordinator (Sarah)","t":"Other buttons","html":"<ul><li><b>They're staying:<\/b> the family changed their mind. The cancellation is withdrawn, the record keeps who withdrew it and when, and it leaves your list.<\/li><li><b>Change last payment:<\/b> move the final payment date when you've agreed it with the family. Only Mark and Sarah see this.<\/li><\/ul>"},{"d":"hub","h2":"Cancellation Coordinator (Sarah)","t":"Complaints","html":"<p>When a cancellation is logged with <b>Unhappy with something<\/b>, you get a text straight away with the family's words. Call them before the notice runs out.<\/p><p><b>Closing a complaint<\/b><\/p><ol><li>Call the family.<\/li><li>On the complaint card, type in the box what happened and how it was resolved.<\/li><li>Tap <b>Save outcome<\/b>. Your name and the date are added.<\/li><\/ol><p>A complaint stays on your list until you close it, even after you tap Done in EFC. Those cards move to <b>Done in EFC: complaint still to close<\/b>. The dashboard counts how many complaints were closed.<\/p><p><b>Low exit-survey scores.<\/b> If a family rates their time 1 or 2 out of 5, you get a text with what they said. A call is worth it, because these families talk to other parents.<\/p>"},{"d":"hub","h2":"Close the sale (Bianca and Mady)","t":"Close the sale (Bianca and Mady)","html":"<p>This is for families who were sent a recommendation but haven't joined yet. Open the <b>CLOSE THE SALE<\/b> tile on the hub home page. The list comes live from the GHL pipeline \"Enrolment 2026\": everyone sitting at <b>Recommendation sent<\/b>.<\/p><p><b>What GHL already does on its own.<\/b> The moment the recommendation is sent, GHL texts and emails the family a short, personal joining link. The page fills in everything we already know about them. Two hours later GHL sends a reminder text, and the next day another. If the family replies at any point, GHL stops these automatic messages. After that, nothing more happens automatically, which is why this list exists.<\/p><p><b>Your calls.<\/b> Each family comes up for a call on day 2, 4, 7 and 14 after their recommendation. The list shows who is due today at the top, then who is coming up.<\/p>"},{"d":"hub","h2":"Close the sale (Bianca and Mady)","t":"Step by step","html":"<ol><li>Open <b>CLOSE THE SALE<\/b>. Start at the top of <b>Call today<\/b>: newest families first, because they are the most likely to join.<\/li><li>Each card shows the family, school, the package and weekly price, who recommended them, how many calls so far and any notes. Tap the mobile number to call.<\/li><li>If they tell you why they haven't joined, choose the reason in <b>Why haven't they joined?<\/b>. A <b>Say this<\/b> box appears with a suggested reply. Use it in your own words.<\/li><li>Type what they said in <b>What they said<\/b>. If they ask you to call back on a certain day, pick it in the date box.<\/li><li>Tap one button:<\/li><li><b>Spoke to them<\/b>: saves the reason, the note and the call-back date (or the next call on the schedule).<\/li><li><b>No answer<\/b>: counts the call and moves them to their next call day. Leave a short voicemail.<\/li><li><b>Joining now<\/b>: they're doing the form while you're on the phone. They come back up tomorrow in case it didn't go through.<\/li><li><b>Already joined<\/b>: they've signed up. Closes the card.<\/li><li><b>Not going ahead<\/b>: you must choose a reason first. Closes the card.<\/li><li>When a family completes the joining form, GHL moves them on and they drop off the list by themselves. The hub records that they joined.<\/li><\/ol><p><b>Catch-up cards.<\/b> Families recommended before 25 October whose call days have already passed are marked <b>Catch-up<\/b>. Give each one good call, then record an outcome.<\/p><p><b>Final planned call.<\/b> After the day-14 call the card says <b>Final planned call: record an outcome<\/b>. If you still can't decide, it comes back every two weeks.<\/p>"},{"d":"hub","h2":"Close the sale (Bianca and Mady)","t":"Joining form done, payment not set up","html":"<p>These families have signed the joining form but their EFC billing isn't running yet. They're the closest to joining, so call them first. GHL puts them in one of three places:<\/p><ul><li><b>Joining form completed<\/b>: GHL texted and emailed them the EFC payment link, with a reminder 3 hours later. Call and help them finish it.<\/li><li><b>Manual billing needed<\/b>: their EFC link couldn't be sent automatically. The office sets up billing in EFC directly.<\/li><li><b>Pending Enrolment<\/b>: waiting on the payment setup in EFC.<\/li><\/ul><p>Each card works like the ones above. Choose a reason if they give one, type what they said, then tap <b>Spoke to them<\/b>, <b>No answer<\/b> or <b>Not going ahead<\/b>. After a call the card comes back in two days, or on the call-back date you pick.<\/p><p><b>When the payment is set up.<\/b> If the family finished it themselves through the EFC link, you don't need to do anything. EFC tells GHL, GHL moves them to Enrolled and sends their welcome text and email, and the card disappears. For <b>Manual billing needed<\/b> and <b>Pending Enrolment<\/b>, the office sets up the billing in EFC first. Then tap <b>Payment set up in EFC: enrol them<\/b> on the card, and tap again to confirm. This does exactly what the office's \"EFC payment confirmed\" link does: it moves them to Enrolled in GHL, sends the welcome text and email, and adds them to the Enrolments sheet. Only tap it once the billing is actually running in EFC.<\/p><p><b>Cards marked \"They are on the Enrolments sheet\".<\/b> These families are already enrolled; only their GHL card is behind. Tap <b>Move to Enrolled in GHL<\/b> to fix it. Nothing is sent to the family.<\/p><p><b>Not going ahead<\/b> closes the card and moves the family to Contact list / NRN in GHL, so the pipeline stays clean.<\/p><p><b>Resend joining link.<\/b> Tap it to text the family their own joining link again. It's the same link GHL sent the first time. The text reads: \"Hi [first name], it's Australian Martial Arts. Here's your joining form again - about 2 minutes to complete: [link] Once that is done we will text you the payment setup link. Any questions, just reply here.\"<\/p><p>Every call is saved on the <b>Sales chase<\/b> tab of the enrolment sheet. The management dashboard shows how many families were called, how many joined and the reasons people give for not joining.<\/p>"},{"d":"hub","h2":"Referrals (Tate)","t":"Referrals (Tate)","html":"<p>When a family joins because a current member sent them, we thank that member with a call and a reward, and the reward is presented in class. The <b>REFERRALS<\/b> tile on the home page runs all of this. It replaces the Referral calls tab, the Saturday referral emails and the separate Referrals Log sheet.<\/p><p><b>Where referrals come from.<\/b> On the Staff recommendation tool, staff answer \"Was this student referred by a current AMA member?\" and name the member. When the family joins, the referral appears on the hub automatically. If one was missed, use <b>Add a referral<\/b> at the bottom of the page.<\/p>"},{"d":"hub","h2":"Referrals (Tate)","t":"Step by step","html":"<table class=\"hp-t\"><tr><th>Group on the page<\/th><th>What you do<\/th><th>What happens<\/th><\/tr><tr><td>To thank: call the member who referred<\/td><td>Call the member and thank them. Offer a $50 VISA gift card, a free Parents Night Out ticket or $50 off their next payment (they can also say no reward). Choose the reward they picked and tap <b>Thanked<\/b>. If there's no answer, leave a voicemail and tap <b>No answer<\/b>. The member then gets a thank-you text asking which reward they'd like. If they're not actually a member, tap <b>Not a member<\/b>.<\/td><td>Thanked moves the referral to Get the reward ready. No answer brings it back in 2 days.<\/td><\/tr><tr><td>Check who referred<\/td><td>The form says something like \"Sibling\" or a first name only. Check the joining form or GHL to find the actual member, then call them, or tap Not a member.<\/td><td>Same as above<\/td><\/tr><tr><td>Get the reward ready<\/td><td><b>Put a referral card and the<\/b> reward in an envelope marked with the member's name, the new student and the school. Leave it at that school's reception. Choose the instructor who will present it and tap <b>Envelope at reception<\/b>.<\/td><td>The instructor gets a text asking them to present it at the member's next class.<\/td><\/tr><tr><td>Instructor to present the reward<\/td><td>The instructor presents it during mat chat (video it if you can) and promotes the referral program. Then tap <b>Presented<\/b>.<\/td><td>The referral is complete and counts on the dashboard.<\/td><\/tr><\/table><p>If no mobile is shown, find it in EFC or GHL and tap <b>Save mobile<\/b>. The hub also tries to find it in GHL each morning.<\/p><p><b>Texts.<\/b> Each morning at 10am, Tate gets a text listing new members to thank. If a member still hasn't been thanked 7 days after the family joined, Mark gets a text.<\/p><p><b>Rewards and presenting (updated 25 Oct).<\/b> The member can choose a $50 VISA gift card, a Parents Night Out ticket, <b>$50 off their payments<\/b> or no reward. For $50 off, the office takes it off their next payment in EFC, and the instructor presents the referral card. When the reward is ready, pick the instructor plus the <b>date and time<\/b> of the class where it'll be presented. The instructor's text includes that time, and the card shows <b>Overdue<\/b> if the time passes without <b>Presented<\/b> being tapped. If the reward was already given to them some other way, tap <b>Already handed out<\/b>.<\/p><p><b>Follow up today: routing families.<\/b> Under Reply to new enquiries, choose what happened: I replied from my own phone, Already a member, Booked a trial, or Not interested / wrong number. Then tap Save. Families who have booked a trial or been sent a recommendation are left off this list automatically. Under Attended, the outcome list now includes <b>Already a member<\/b> and <b>Recommendation sent<\/b>. A family is closed automatically once GHL shows a recommendation was sent (they move to Close the sale) or that they've enrolled. A yellow note warns you when the child's name or mobile is already on the Enrolments sheet.<\/p>"},{"d":"hub","h2":"Absentee follow up","t":"Absentee follow up","html":"<p>EFC tells the hub every day who has stopped coming. Open <b>ABSENTEE FOLLOW UP<\/b> from the home page, or tap <b>Absentee replies to action<\/b> or <b>Absentee calls<\/b> in My Day. There's one card per family. The goal of every contact is a booked return class. Anyone who trains again drops off the list by themselves.<\/p><p><b>Call today<\/b> shows the 25 families most likely to come back first. Families who replied to a text are only under Replied, not in the call list.<\/p>"},{"d":"hub","h2":"Absentee follow up","t":"The stages","html":"<table class=\"hp-t\"><tr><th>Day absent<\/th><th>What happens<\/th><th>Who<\/th><\/tr><tr><td>Day 9<\/td><td>Automatic text to the family<\/td><td>The hub<\/td><\/tr><tr><td>Day 12<\/td><td>First call<\/td><td>Office<\/td><\/tr><tr><td>Day 15<\/td><td>Short video from their instructor<\/td><td>Instructor<\/td><\/tr><tr><td>Day 18<\/td><td>Second call<\/td><td>Office<\/td><\/tr><tr><td>Day 21<\/td><td>Call from the head instructor<\/td><td>Head instructor<\/td><\/tr><tr><td>Day 30<\/td><td>Automatic text<\/td><td>The hub<\/td><\/tr><tr><td>Day 35<\/td><td>Last try, then close<\/td><td>Office<\/td><\/tr><\/table><p>The tabs across the top show how many families are at each stage. <b>Call today<\/b> holds everything that needs a call today, including families who replied.<\/p>"},{"d":"hub","h2":"Absentee follow up","t":"When a family has replied","html":"<p>Their reply shows on the card in a box, with the date. Read it first.<\/p><ol><li>If you need to answer them, type in the <b>Reply by text<\/b> box under their message and tap <b>Send text<\/b>. It goes from the AMA number through GHL and shows in GHL Conversations.<\/li><li>Then pick the outcome that fits, and the card closes:<\/li><li><b>Replied - no follow up required<\/b> when they've told you why and when they're back.<\/li><li><b>Return class booked<\/b> when they've given you a class (pick the date and the reason first).<\/li><li><b>Not absent: EFC record wrong<\/b> when they say their child was at class.<\/li><li><b>Wants a hold<\/b> or <b>Wants to cancel<\/b> to send it to the right process.<\/li><\/ol>"},{"d":"hub","h2":"Absentee follow up","t":"Making a call","html":"<ol><li>Call the number on the card.<\/li><li>Choose <b>Why did they stop coming?<\/b> and, if you offered one, the <b>Save option<\/b>. Type what they said.<\/li><li>Tap the outcome:<\/li><\/ol><table class=\"hp-t\"><tr><th>Button<\/th><th>What it does<\/th><\/tr><tr><td>Return class booked<\/td><td>Pick the date. The family gets a booking confirmation text straight away<\/td><\/tr><tr><td>No answer<\/td><td>Records the attempt. The family gets a short \"just checking in again\" text<\/td><\/tr><tr><td>Call back on date<\/td><td>Pick the date. The card comes back on that day<\/td><\/tr><tr><td>Wants a hold / Wants to cancel<\/td><td>Sends them to the hold or cancellation process<\/td><\/tr><tr><td>Not absent: EFC record wrong<\/td><td>Closes the card and adds it to the EFC clean-up list<\/td><\/tr><tr><td>Something else<\/td><td>Write what happened first<\/td><\/tr><\/table>"},{"d":"hub","h2":"Absentee follow up","t":"They trained but didn't check in","html":"<p>If a family says their child was at class, check EFC. Then tap <b>Text sign-in reminder<\/b> on the card. They get a friendly reminder to check in when they arrive for each class. Then tap <b>Back in class<\/b> (or <b>Not absent: EFC record wrong<\/b>) with a note, for example \"came Mon 26 Oct, did not check in\".<\/p>"},{"d":"hub","h2":"Absentee follow up","t":"Other things on the card","html":"<ul><li><b>Member's own number<\/b> means the member is their own contact in EFC (an adult, or a teen with their own phone). Otherwise you'll see the parent's name.<\/li><li>After you save, the card folds away and the list refreshes quietly in the background. If a <b>Next:<\/b> tip appears, read it before it disappears.<\/li><\/ul>"},{"d":"hub","h2":"Every automatic text and email","t":"Every automatic text and email","html":"<p>The hub sends all texts and emails through GHL from the AMA number and address, so replies land in GHL Conversations.<\/p>"},{"d":"hub","h2":"Every automatic text and email","t":"Texts to staff","html":"<p><b>Only during your shift.<\/b> If you're on the roster, hub texts only reach you during your rostered hours (15 minutes either side). Anything that comes in while you're off waits and arrives when your next shift starts. Staff not on the roster, like Mark and Sarah, get texts straight away.<\/p><table class=\"hp-t\"><tr><th>Text<\/th><th>When<\/th><th>Who gets it<\/th><th>What to do<\/th><\/tr><tr><td>After-trial check<\/td><td>About 30 minutes after the day's last trial, never after 9pm<\/td><td>Rostered staff at that school, plus anyone covering<\/td><td>Fill in the check on the hub<\/td><\/tr><tr><td>New enquiry with no reply<\/td><td>60 minutes after the enquiry, between 7am and 9pm<\/td><td>Whoever is on shift (Bianca, Mady, Busra)<\/td><td>Call or text the family now<\/td><\/tr><tr><td>Enquiry still not replied to<\/td><td>60 minutes after the staff text<\/td><td>Mark<\/td><td>Mark follows up<\/td><\/tr><tr><td>Hold to approve<\/td><td>When a hold outside the terms is logged<\/td><td>Mark and Sarah<\/td><td>Reply YES or NO with the H number<\/td><\/tr><tr><td>Hold approved or declined<\/td><td>When Mark or Sarah replies<\/td><td>The staff member who logged it<\/td><td>Approved: tell the family to look out for the email. Declined: call them.<\/td><\/tr><tr><td>Hold signed<\/td><td>When the family signs<\/td><td>The staff member who logged it<\/td><td>Put it on hold in EFC<\/td><\/tr><tr><td>Early stop to approve<\/td><td>When a family wants to stop before their 30 days<\/td><td>Mark and Sarah<\/td><td>Reply YES or NO with the C number<\/td><\/tr><tr><td>Early stop decided<\/td><td>When Mark or Sarah replies<\/td><td>The staff member who logged it<\/td><td>Tell the family if needed. They also get an email.<\/td><\/tr><tr><td>Cancellation signed<\/td><td>When the parent signs<\/td><td>Sarah<\/td><td>Action it in EFC<\/td><\/tr><tr><td>Complaint<\/td><td>When it's logged<\/td><td>Sarah<\/td><td>Call the family, then save the outcome<\/td><\/tr><tr><td>Early leaver<\/td><td>When a family cancels within 3 months of joining<\/td><td>Mark and Sarah<\/td><td>Call within 48 hours<\/td><\/tr><tr><td>Send-off<\/td><td>On a student's last class day<\/td><td>Rostered staff at that school<\/td><td>Give them a send-off in class<\/td><\/tr><tr><td>Low exit-survey score<\/td><td>When a family rates 1 or 2 out of 5<\/td><td>Sarah<\/td><td>Call the family<\/td><\/tr><tr><td>Cover confirmations<\/td><td>When Mark or Sarah text COVER<\/td><td>The sender<\/td><td>Nothing<\/td><\/tr><tr><td>New PIN<\/td><td>When someone taps Forgot PIN?<\/td><td>That staff member<\/td><td>Sign in with the new PIN<\/td><\/tr><tr><td>Weekly summary<\/td><td>Monday, 8am<\/td><td>Mark, Sarah, Hakan<\/td><td>Read it<\/td><\/tr><tr><td>Update student numbers<\/td><td>1st of each month, 9am<\/td><td>Mark<\/td><td>Update the Student counts tab from EFC<\/td><\/tr><\/table><p>Two older systems also run every day:<\/p><ul><li><b>Today's trials text.<\/b> Each rostered staff member gets a text listing that day's upcoming trials at their school.<\/li><li><b>Trial calendars.<\/b> Every GHL trial booking is copied to the school's Google Calendar (for example \"AMA Marrickville - Trials\"), so the trial shows on the calendar staff check.<\/li><\/ul><p>Referral texts:<\/p><ul><li>At 10am each day, Tate gets a text listing new members to thank.<\/li><li>When a reward is ready, the chosen instructor gets a text asking them to present it.<\/li><li>If a member hasn't been thanked within 7 days, Mark gets a text.<\/li><\/ul><p>Close the sale text: at 10am Monday to Saturday, if any families are due a call, whoever owns those calls and is rostered that day gets a text saying how many, with the first few names and a link to the list.<\/p>"},{"d":"hub","h2":"Every automatic text and email","t":"Emails and texts to families","html":"<table class=\"hp-t\"><tr><th>Message<\/th><th>When<\/th><th>Contains<\/th><\/tr><tr><td>Welcome SMS and email (GHL)<\/td><td>Instantly on a new enquiry<\/td><td>Set up in GHL. Doesn't count as a reply from a person.<\/td><\/tr><tr><td>Email: Please confirm your AMA cancellation<\/td><td>As soon as a cancellation is logged<\/td><td>Signing link and notice dates<\/td><\/tr><tr><td>Email: Your signed AMA cancellation<\/td><td>When they sign<\/td><td>Signed PDF, dates and uniform balance. The office is copied in.<\/td><\/tr><tr><td>Email: Updated cancellation dates<\/td><td>When an early stop is approved<\/td><td>The new last class and final payment<\/td><\/tr><tr><td>Text: notice check-in<\/td><td>About 10 days into the notice<\/td><td>Welcome until the last class, plus an offer that fits their reason<\/td><\/tr><tr><td>Text: send-off<\/td><td>2 days before the last class<\/td><td>We'd love to give them a send-off<\/td><\/tr><tr><td>Text: exit survey<\/td><td>The day after the last class<\/td><td>Rate 1 to 5, and one thing to do better<\/td><\/tr><tr><td>Text: win-back<\/td><td>60 and 180 days after the last class<\/td><td>Invitation back, with a free first class<\/td><\/tr><tr><td>Email: Please sign your AMA membership hold<\/td><td>When a hold is approved, automatically or by Mark or Sarah<\/td><td>Personal line, signing link, hold dates, medical certificate reminder<\/td><\/tr><tr><td>Email: Your signed AMA membership hold<\/td><td>When they sign<\/td><td>Signed PDF and dates. The office is copied in.<\/td><\/tr><tr><td>Text: hold starts<\/td><td>10am on the day the hold starts<\/td><td>Thinking of them, and their spot is saved<\/td><\/tr><tr><td>Text: hold check-in<\/td><td>Halfway through holds of 4 weeks or more<\/td><td>How are they going? Reply if they need longer.<\/td><\/tr><tr><td>Text: welcome back<\/td><td>5 days before the hold ends<\/td><td>Due back on the end date, and payments restart then<\/td><\/tr><\/table><p>New enquiries also get the instant welcome SMS and email set up in GHL. These don't count as a reply from a person.<\/p><p><b>Joining and referral messages to families<\/b><\/p><ul><li><b>Joining link text and email (GHL):<\/b> sent when the recommendation goes out. It contains their short, personal joining link.<\/li><li><b>Joining link reminders (GHL):<\/b> 2 hours later and the next day, unless they reply.<\/li><li><b>EFC payment link text and email (GHL):<\/b> sent when the joining form is submitted, with a reminder.<\/li><li><b>Welcome text and email (hub):<\/b> now sent by the hub, not GHL (since 31 October), once the payment is confirmed, either by EFC or by <b>Payment set up in EFC<\/b> on the hub.<\/li><li><b>Referral thank-you after a voicemail (hub):<\/b> sent when Tate taps No answer. It thanks the member and asks which reward they'd like.<\/li><li><b>Referral reward booked (hub):<\/b> sent when the reward is ready. It tells the member which class and time the reward will be presented at.<\/li><li><b>Referral $50 off (hub):<\/b> sent when the member chooses $50 off. It tells them it comes off their next payment and they don't need to do anything.<\/li><\/ul><p>Each referral text goes to a member only once.<\/p><p><b>Other automatic messages to families<\/b> (exact wording for all of these is in the next section):<\/p><ul><li><b>Trial booked to trial day (hub):<\/b> booking text and email, 5pm reminder if nobody reached them, 2-hour reminder, a text if the trial is moved or cancelled, and a rebook text the same day if they were absent.<\/li><li><b>After the trial (hub):<\/b> thank-you text the next morning, day 7 email with the joining link, day 14 \"keep your place open?\" text.<\/li><li><b>First weeks as a member (hub):<\/b> welcome text and email, then day 2, day 14 and day 35 emails.<\/li><li><b>New members, first 90 days (hub):<\/b> texts on day 7, day 30 (with a Google review link) and day 90.<\/li><li><b>Gradings (hub):<\/b> a text per family when they're sent from the Gradings section.<\/li><li><b>Enquiry and enrolment (GHL):<\/b> welcome email and text on a new enquiry, not-booked texts and emails on days 1, 3, 7 and 14, the joining-link messages and the payment-link messages.<\/li><li><b>Built but not switched on:<\/b> private lesson texts, and the anniversary and rate notice emails.<\/li><\/ul>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Exact wording of every text and email","html":"<p>This is word for word what the hub sends. Words in [square brackets] are filled in for each family or staff member. \"[Student]\" means the child's first name, or names, for example \"Ava and Leo\". Texts come from the AMA number. Family emails come from AMA through GHL, and replies land in <b>GHL Conversations<\/b>.<\/p><p>The new enquiry, not-booked, joining-link and payment-link messages are sent by GHL itself. Their wording is set in the GHL workflows and is copied word for word under Messages GHL sends, near the end of this section.<\/p>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Holds","html":"<p><b>1. Approval needed (text to Mark and Sarah)<\/b> when a hold is outside the terms:<\/p><blockquote>AMA freeze [H1234] [Parent name] ([Student]) - [School] [4] weeks, [6 Dec] to [3 Jan] Outside terms: [reason it is outside the terms] \"[what the family said]\" Taken by [staff name] Reply YES to approve, NO to decline.<\/blockquote><p>After Mark or Sarah replies, the staff member who logged it gets one of these texts:<\/p><blockquote>AMA: [Sarah] approved the freeze for [Parent name] ([H1234]), [Mon 7 Dec] to [Mon 4 Jan]. The hold agreement has been emailed to [Parent first name] to sign - please let them know to look out for it. It is on Holds to action in the hub.<\/blockquote><blockquote>AMA: [Sarah] did not approve the freeze for [Parent name] ([H1234]). Please call [Parent first name] to let them know.<\/blockquote><p><b>2. Signing email to the family<\/b> (as soon as the hold is approved, or straight away when it is within the terms)<\/p><p>Subject: <i>Please sign your AMA membership hold (H1234)<\/i><\/p><blockquote>Dear [Parent first name],<br>Thank you for speaking with [staff name] about pausing [Student]'s membership at AMA [School].<br>We are sorry to hear that [Student] can't train for a while, and we wish them a smooth recovery. Their place in class will be kept for them. <i>(If the hold is not medical, this line reads: \"We look forward to welcoming [Student] back on [end date].\")<\/i><br>Please open the link below to check the details and sign the hold agreement. It takes about a minute.<br>[signing link]<br>Hold starts: [date] Hold ends and billing restarts: [date]<br>Please send us the medical certificate before the hold starts. <i>(only when the certificate is still to come)<\/i> Once you have signed, we will email you a copy for your records.<br>If any of these details are incorrect, please reply to this email or call us on 02 9569 1943.<br>Kind regards, Australian Martial Arts Academy<\/blockquote><p><b>3. Signed copy (email to the family, info@ copied)<\/b><\/p><p>Subject: <i>Your signed AMA membership hold (H1234)<\/i><\/p><blockquote>Dear [Parent first name],<br>Thank you for signing. This email confirms the hold on [Student]'s membership at AMA [School].<br>Hold starts: [date] Hold ends and billing restarts: [date]<br>Your signed copy is attached.<br>If any of these details are incorrect, please reply to this email or call us on 02 9569 1943.<br>Kind regards, Australian Martial Arts Academy<\/blockquote><p>At the same time, the staff member who logged it gets this text:<\/p><blockquote>AMA: [Parent name] signed the hold agreement ([H1234]), [start] to [end]. It is on Holds to action in the hub to put on in EFC.<\/blockquote><p><b>4. Care texts to the family<\/b> (sent at 10am)<\/p><p>On the day the hold starts, for a medical hold:<\/p><blockquote>Hi [Parent first name], it's the team at AMA [School]. We're thinking of [Student] and hope the recovery goes smoothly. Their spot is saved and we'll check in before they're back. Please let us know if there's anything we can do.<\/blockquote><p>On the day the hold starts, for any other hold:<\/p><blockquote>Hi [Parent first name], it's the team at AMA [School]. [Student]'s hold starts today. Their spot is saved and we look forward to having them back on [Mon 4 Jan]. Please let us know if there's anything we can do.<\/blockquote><p>Halfway through, only for holds of 4 weeks or more:<\/p><blockquote>Hi [Parent first name], just checking in from AMA [School]. How is [Student] going? We're looking forward to having them back on [Mon 4 Jan]. If they need a little longer, just reply here and we'll sort it.<\/blockquote><p>Five days before the hold ends:<\/p><blockquote>Hi [Parent first name], [Student] is due back at AMA [School] from [Mon 4 Jan], and the class can't wait to see them. Payments restart from that date, as agreed. If they need more time, please reply here before then.<\/blockquote>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Hold extensions","html":"<p><b>1. Approval needed (text to Mark and Sarah)<\/b> when the extension is outside the terms. That means a medical hold going over 6 weeks in total, or any extension of an approved exception:<\/p><blockquote>AMA hold extension [H5678] [Parent name] ([Student]) - [School] Extends [H1234] by [3] weeks: back [Mon 25 Jan] instead of [Mon 4 Jan] ([9] weeks in total) Outside terms: [reason] Updated certificate: [received / to follow] <i>(medical only)<\/i> \"[what the family said]\" Taken by [staff name] Reply YES [H5678] to approve, NO [H5678] to decline.<\/blockquote><p><b>2. Signing email to the family<\/b><\/p><p>Subject: <i>Please sign your AMA membership hold extension (H5678)<\/i><\/p><blockquote>Dear [Parent first name],<br>Thank you for letting [staff name] know that [Student] needs more time away from training at AMA [School].<br>We hope the recovery is going well. Their place in class will be kept for them. <i>(If the hold is not medical, this line reads: \"We look forward to welcoming them back on [new end date].\")<\/i><br>Please open the link below to check the new dates and sign the hold extension. It takes about a minute.<br>[signing link]<br>Extension starts: [date] Hold ends and billing restarts: [new date]<br>Please send us the updated medical certificate as soon as you can. <i>(only when it is still to come)<\/i> Once you have signed, we will email you a copy for your records.<br>If any of these details are incorrect, please reply to this email or call us on 02 9569 1943.<br>Kind regards, Australian Martial Arts Academy<\/blockquote><p><b>3. Signed copy<\/b><\/p><p>Subject: <i>Your signed AMA membership hold extension (H5678)<\/i><\/p><blockquote>Dear [Parent first name],<br>Thank you for signing. This email confirms the extension of the hold on [Student]'s membership at AMA [School].<br>Extension starts: [date] Hold ends and billing restarts: [new date]<br>Your signed copy is attached.<br>If any of these details are incorrect, please reply to this email or call us on 02 9569 1943.<br>Kind regards, Australian Martial Arts Academy<\/blockquote><p>The halfway and welcome-back texts above move to the new end date automatically.<\/p>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Cancellations","html":"<p><b>1. Signing email to the family<\/b> (as soon as the cancellation is logged)<\/p><p>Subject: <i>Please confirm your AMA cancellation<\/i><\/p><blockquote>Hi [Parent first name],<br>Thanks for talking with [staff name] about [Student] finishing up at AMA [School].<br>Please open the link below to check the details, agree to the dates and sign. It takes about a minute.<br>[signing link]<br>Your 30 days' notice starts on the day you sign, and payments continue until 30 days after that. <i>(If they had already emailed their notice: \"Your 30 days' notice started on [date], so payments continue until [date].\")<\/i><br>Once you have signed, we will email you a copy for your records.<br>If anything isn't right, just reply to this email or call us on 02 9569 1943.<br>Thank you for training with us, Australian Martial Arts Academy<\/blockquote><p><b>2. Signed copy (email to the family, info@ copied)<\/b><\/p><p>Subject: <i>Your signed AMA cancellation ([ref])<\/i><\/p><blockquote>Hi [Parent first name],<br>Thank you for signing. This email confirms your cancellation notice for [Student] at AMA [School].<br>Notice started: [date] Payments continue until: [date] Last class: [date]<br>[Uniform line: \"The balance of any discounted or free uniform or equipment will be added to your final payment.\" / \"We will check whether a uniform or equipment balance applies and let you know before your final payment.\" / \"No uniform or equipment balance applies.\"]<br>Your signed copy is attached.<br>If anything isn't right, reply to this email or call us on 02 9569 1943.<br>Thank you for training with us, Australian Martial Arts Academy<\/blockquote><p><b>3. Early stop approved (email to the family)<\/b><\/p><p>Subject: <i>Updated cancellation dates – AMA reference [ref]<\/i><\/p><blockquote>Dear [Parent first name],<br>Further to your cancellation notice, we have approved your request for [Student] to finish at AMA [School] before the end of the 30-day notice period.<br>Your updated dates are: • Last class: [date] • Final payment: [date]<br>These dates replace those in your earlier confirmation. [Uniform line]<br>If any of these details are incorrect, please reply to this email or call us on 02 9569 1943.<br>Kind regards, Australian Martial Arts Academy<\/blockquote><p><b>4. Texts to Mark and Sarah<\/b><\/p><p>Early stop request:<\/p><blockquote>AMA cancellation needs a yes/no: [ref] [Parent name] ([School], [Student]). Wants last class [Fri 6 Nov] but 30 days notice runs to [Wed 25 Nov]. Reason: [reason]. Offered: [offer] - declined. Taken by [staff name]. Reply YES [ref] to let them stop early, NO [ref] to hold to 30 days.<\/blockquote><p>Early leaver (a family cancelling within their first few months):<\/p><blockquote>AMA early leaver: [ref] [Parent name] ([School], [Student]) is cancelling after [3] months. Reason: [reason]. \"[what they said]\" Please call them in the next 48 hours: [mobile]. Taken by [staff name].<\/blockquote><p>Complaint with a cancellation (to the person set up to receive complaints):<\/p><blockquote>AMA complaint with a cancellation: [ref] [Parent name] ([School]). [what they said] - taken by [staff name]<\/blockquote><p>Low exit-survey score (1 or 2):<\/p><blockquote>AMA exit survey: [Parent name] ([School], [ref]) rated their time [2]/5: \"[their feedback]\" Worth a call.<\/blockquote><p><b>5. Texts to staff<\/b><\/p><p>To Sarah and Busra once the family signs:<\/p><blockquote>AMA cancellation to action in EFC: [Parent name] ([Student]), [School]. Signed today. Last payment [date]. [Uniform line] Details and signed PDF: https://train.australianmartialarts.com.au/admin#cxlist<\/blockquote><p>To the staff member, after Mark or Sarah decides on an early stop:<\/p><blockquote>AMA: [Sarah] approved the early stop for [Parent name] ([ref]). Last class and last payment: [date]. Please let [Parent first name] know.<\/blockquote><p>To the rostered staff at that school on the student's last day:<\/p><blockquote>AMA: [Student]'s last class at [School] is today ([Parent name], [ref]). If you see them, please give them a send-off in front of the class.<\/blockquote><p><b>6. Care texts to the family<\/b><\/p><p>Check-in while they are still in their notice period. The offer depends on the reason:<\/p><blockquote>Hi [Parent first name], just a note from AMA [School]. [Student] is welcome in class until [Fri 27 Nov]. [Offer] No pressure at all, just reply here if that would help.<\/blockquote><table class=\"hp-t\"><tr><th>Reason<\/th><th>Offer line<\/th><\/tr><tr><td>Moved / too far<\/td><td>If one of our other schools would be closer, [Student] can switch over and keep their progress.<\/td><\/tr><tr><td>Class times<\/td><td>If a different class day or time would make it easier, we'd be happy to find one that fits.<\/td><\/tr><tr><td>Cost<\/td><td>If a lighter schedule would help, we can drop to fewer classes a week so it costs less and [Student] keeps their progress.<\/td><\/tr><tr><td>Injury or illness<\/td><td>If it's about recovering, we can pause with a medical freeze instead, so there's no need to cancel.<\/td><\/tr><tr><td>Lost interest<\/td><td>If you like, we can book a free 10-minute chat with their instructor before class. A quick one-on-one often makes a real difference.<\/td><\/tr><tr><td>Going away<\/td><td>If it's time away, we can make up the classes when [Student] is back instead.<\/td><\/tr><\/table><p>Shortly before the last class:<\/p><blockquote>Hi [Parent first name], [Student]'s last class at AMA [School] is on [Fri 27 Nov]. We'd love to give them a proper send-off, so we hope to see them there.<\/blockquote><p>After the last class (exit survey):<\/p><blockquote>Hi [Parent first name], thank you for being part of AMA [School]. How would you rate [Student]'s time with us, from 1 to 5? And is there one thing we could have done better? Just reply here.<\/blockquote><p>Win-back, 60 days after they leave:<\/p><blockquote>Hi [Parent first name], it's AMA [School]. [Reason line] [Student]'s first class back is on us, so just reply here and we'll book it in.<\/blockquote><p>Win-back, 180 days after they leave:<\/p><blockquote>Hi [Parent first name], it's been a while since we've seen [Student] at AMA [School]. [Reason line] Their first class back is on us, so just reply here and we will book it in.<\/blockquote><table class=\"hp-t\"><tr><th>Reason<\/th><th>Win-back reason line<\/th><\/tr><tr><td>Moved / too far<\/td><td>If one of our five schools is close to you now, [Student] would be very welcome back.<\/td><\/tr><tr><td>Class times<\/td><td>Our timetable changes through the year, so there may now be a class time that fits.<\/td><\/tr><tr><td>Cost<\/td><td>We have memberships from one class a week, so it can fit the budget.<\/td><\/tr><tr><td>Injury or illness<\/td><td>We hope [Student] is fully recovered.<\/td><\/tr><tr><td>Lost interest<\/td><td>Kids often come back keen after a break, and we would love to see [Student] on the mat again.<\/td><\/tr><tr><td>Going away<\/td><td>We hope you had a great time away.<\/td><\/tr><tr><td>Anything else<\/td><td>We would love to see [Student] back on the mat.<\/td><\/tr><\/table><p>Families with a complaint, or who said they were unhappy, never get win-back texts.<\/p>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Trials and enquiries (texts to staff)","html":"<p>Trial list, to the rostered staff for that session (morning trials in the morning text, afternoon trials in the afternoon text):<\/p><blockquote>[School] trials [today / tonight] ([2]): [4:00pm] [Ava] - [Little Dragons] Parent: [Sam Smith] | Why: [what the family said] Promo: [promotion details] <i>(only when a family has a promo tag)<\/i><\/blockquote><p>After-trial check reminder, about 30 minutes after the last trial:<\/p><blockquote>AMA [School]: thanks for running today's trials. Please fill in the after-trial check for the [3] trials (attended or absent, plus any notes). Takes 2 minutes: [hub link]<\/blockquote><p>New enquiry with no reply from a person after 60 minutes, to whoever is on shift (not between 9pm and 7am):<\/p><blockquote>AMA: new enquiry with no reply from a person yet: [Name] ([Facebook]), waiting [1 hr 5 min]. [mobile]. Please call or text now, from GHL if you can. List: [hub link]<\/blockquote><p>When there are several, the text lists them: \"AMA: [3] new enquiries have no reply from a person yet: [names and times]. Please call or text them now, from GHL if you can.\"<\/p><p>Still no reply an hour later (to Mark):<\/p><blockquote>AMA: still no reply from a person to [Name] (enquired [9:40 am]). [Bianca] got a text about it an hour ago. List: [hub link]<\/blockquote>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Close the sale","html":"<p>Morning text to whoever owns the calls and is rostered that day (Monday to Saturday, only when there are calls due):<\/p><blockquote>AMA close the sale: [4] families to call today ([family names]), plus [2] older catch-up calls. Also [1] waiting on payment setup. Record each call on the hub: https://train.australianmartialarts.com.au/admin#close<\/blockquote><p><b>Resend joining link<\/b> (text to the family, when staff tap the button):<\/p><blockquote>Hi [Parent first name], it's Australian Martial Arts. Here's your joining form again - about 2 minutes to complete: [their joining link] Once that is done we will text you the payment setup link. Any questions, just reply here.<\/blockquote>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Referrals","html":"<p>To Tate each morning, when there are members to thank:<\/p><blockquote>AMA referrals: [2] members to thank for referring a new family: [Member] ([new student], [School]); … Please call this week and offer a $50 VISA gift card or a free Parents Night Out ticket. List: https://train.australianmartialarts.com.au/admin#referrals<\/blockquote><p>To the managers on the follow-up list if a member still has not been thanked after a set number of days:<\/p><blockquote>AMA referrals: [2] members have not been thanked [x]+ days after the family joined: [list]. Tate has the list.<\/blockquote><p>To the member, after a voicemail:<\/p><blockquote>Hi [Member first name], it's Australian Martial Arts. Thank you so much for referring [new student] to us! We have a special thank-you gift for you. Could you please reply and let us know which you'd prefer: a $50 VISA gift card, a free Parents Night Out ticket, or $50 off your next payment? Thank you for helping us build a great community.<\/blockquote><p>To the member, when the reward is booked:<\/p><blockquote>Hi [Member first name], thank you so much for referring [new student] to Australian Martial Arts! Your thank-you ([reward]) will be presented at your class on [Sat 31 Oct, 10:00AM]. See you on the mat!<\/blockquote><p>To the member, when they chose $50 off:<\/p><blockquote>Hi [Member first name], thank you so much for referring [new student] to Australian Martial Arts! As a thank-you, we've taken $50 off your next payment, so there's nothing you need to do. Thank you for helping us build a great community.<\/blockquote><p>To the presenting instructor:<\/p><blockquote>AMA referral reward: [Member] referred [new student] to AMA [School]. Their thank-you ([reward]) is in an envelope at [School] reception with a referral card. Please present it at their class on [Sat 31 Oct 10:00AM] during mat chat, and video it if you can. Then tap Presented on the hub: https://train.australianmartialarts.com.au/admin#referrals<\/blockquote>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Management and staff","html":"<p>Monday summary, 8am, to Mark, Sarah, Hakan and Ridvan:<\/p><blockquote>AMA last week ([19 Oct to 25 Oct]): [15] new students (+$[652]/wk), [18] cancelled, [11] new holds, net [-3]. [24] enquiries, [28] trial families, [24] attended, [7] joined so far ([29.2]%). Most new students: [Marrickville] ([7]). [October] so far: [x] starts (target [78]), [x] stops (target under [44]). Dashboard: https://train.australianmartialarts.com.au/admin#mgmt<\/blockquote><p>1st of the month, 9am (student numbers reminder):<\/p><blockquote>AMA reminder: please update student numbers from EFC. On the Student counts tab, type each school's current number and today's date: [sheet link]<\/blockquote><p>New staff login:<\/p><blockquote>Hi [Name], your AMA staff hub login is ready.<br>Open: https://train.australianmartialarts.com.au/admin Mobile: [mobile] PIN: [PIN]<br>Works on your phone. Please keep your PIN to yourself. Any trouble, ask Mark.<\/blockquote><p>Forgot PIN:<\/p><blockquote>AMA Admin Hub: your new PIN is [PIN]. Sign in at https://train.australianmartialarts.com.au/admin with your mobile and this PIN. If you didn't ask for this, tell Mark.<\/blockquote><p>Marketing request (email to Laurie):<\/p><p>Subject: <i>Marketing request: [Poster] for [School] – needed by [date]<\/i><\/p><blockquote>Hi Laurie,<br>[Staff name] has sent a marketing request from the Admin Hub.<br>What's needed: [item] School: [School] Size or format: [size] Wording to include: [wording] Needed by: [date] Notes and reference links: [notes]<br>If you have any questions, contact [Staff name] on [mobile].<br>Thanks, AMA Admin Hub<\/blockquote>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Absentee follow up","html":"<p>The hub fills in the names. Replies come back to the card in the hub and to GHL Conversations.<\/p><p>Day 9 (automatic):<\/p><blockquote>Hi {parent}, we've missed {student} at {school} this week! Everything okay? What day suits you best to get them back on the mats? Just reply and we'll be ready.<\/blockquote><p>No answer (when you tap No answer):<\/p><blockquote>Hi {parent}, just checking in again. We'd love to have {student} back, even just for one class this week. Let me know what works best.<\/blockquote><p>Return class booked (when you tap Return class booked):<\/p><blockquote>Awesome, we've got {student} booked for {day}. We'll be ready for them. Looking forward to seeing them back on the mats!<\/blockquote><p>Day 30 (automatic):<\/p><blockquote>Hi {parent}, we haven't seen {student} in a little while and would love to have them back, even just for a casual class. Want me to lock something in for you?<\/blockquote><p>Sign-in reminder (member's own number):<\/p><blockquote>Hi {first}, great to see you back at training. Just a reminder to check in when you arrive for each class so your attendance is recorded. If you have any trouble checking in, please let us know. AMA<\/blockquote><p>Sign-in reminder (parent):<\/p><blockquote>Hi {parent}, great to see {child} back at training. Just a reminder for {child} to check in when arriving for each class so their attendance is recorded. If you have any trouble checking in, please let us know. AMA<\/blockquote><p>Day 15 instructor video (the script on the card, for the instructor to record and send):<\/p><blockquote>Hey {parent}, it's {instructor} from AMA {school}. I noticed we haven't seen {student} for a couple of weeks and wanted to check in. They've been doing really well and I don't want them losing momentum. We'd love to see them back this week. Can we book something in?<\/blockquote>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Trial booked to trial day (texts and email to the family)","html":"<p>These go automatically from the hub. GHL's own calendar confirmations and reminders are switched off on every trial calendar, so families only get these.<\/p><p><b>Booking text<\/b> (as soon as the trial is booked):<\/p><blockquote>Hi [Parent first name], [Ava is / you're] booked for a free trial at AMA [School] on [Saturday 7 November] at [10:00am]. We'll email what to bring. Invite a friend and you'll both get $50 off sign up! Any questions, just reply.<\/blockquote><p><b>Booking email<\/b> (at the same time). Subject: <i>You're booked: [Ava's trial / your trial] on [Saturday]<\/i><\/p><blockquote>YOU'RE BOOKED IN. See you [Saturday].<br>Hi [Parent first name],<br>We're looking forward to meeting [Ava / you] on [Saturday 7 November at 10:00am] at AMA [School], [address].<br>BEFORE YOU COME<br>- Arrive 10 minutes early so we can say hello and show you around.<br>- Comfortable clothes (shorts or trackpants and a t-shirt). Training is barefoot.<br>- A water bottle, and hair tied back.<br>- [Parking note for that school]<br>In the class the instructor will make sure [Ava] feels welcome, learns a few real techniques and has fun. You're welcome to watch.<br>After class the instructor will tell you how [Ava] went and which class would suit them best. No pressure to decide on the day.<br>BRING A FRIEND. If they join too, you'll both get $50 off sign up. Just reply with their name and we'll book them into the same class.<br>Need to change the time? Just reply to this email or call [AMA phone].<br>The AMA team, Australian Martial Arts Academy<\/blockquote><p><b>Day before, 5pm<\/b> (only if nobody reached them on the \"Trials tomorrow: confirm by phone\" call):<\/p><blockquote>Hi [Parent first name], see you tomorrow at [10:00am] for [Ava's / your] trial at AMA [School], [address]. Comfortable clothes and water is all [they need / you need].<\/blockquote><p><b>2 hours before<\/b> (only for bookings made more than a day ahead):<\/p><blockquote>Hi [Parent first name], looking forward to meeting [Ava / you] at [10:00am] today. Please arrive 10 minutes early so we can say hello. AMA [School]<\/blockquote><p><b>Trial moved to another class<\/b> (when staff move the booking in the hub):<\/p><blockquote>Hi [Parent first name], quick update: [Ava]'s free trial at AMA [School] is now in our [class] on [Tue 3 Nov] at [4:30pm]. See you then! Any questions, just reply here.<\/blockquote><p><b>Trial cancelled<\/b> (when a trial is cancelled in GHL):<\/p><blockquote>Hi [Parent first name], your booking at AMA [School] has been cancelled. Whenever you're ready, book a new time here: [booking link]<\/blockquote><p><b>Marked absent<\/b> (the same day, when the after-trial check marks them absent):<\/p><blockquote>Hi [Parent first name], sorry we missed [Ava / you] today. No problem at all. Would you like another time? Book here: [booking link] AMA [School]<\/blockquote>"},{"d":"hub","h2":"Exact wording of every text and email","t":"After the trial (texts and email to the family)","html":"<p>These stop as soon as the family joins.<\/p><p><b>Day after the trial, 9am:<\/b><\/p><blockquote>Hi [Parent first name], it was great having [Ava / you] on the mat yesterday! Any questions about classes or memberships, just reply here. AMA [School]<\/blockquote><p><b>Day 7 email.<\/b> Subject: <i>[Ava's / Your] place at AMA [School]<\/i><\/p><blockquote>YOUR RECOMMENDATION. [Ava's / Your] place is still here.<br>Hi [Parent first name],<br>Thanks again for bringing [Ava / yourself] to try a class. [Instructor] recommended [package] as the best fit.<br>If you'd like to go ahead, it takes about 2 minutes: [JOIN NOW button, their joining link]<br>If something's holding you back (days, times or cost), reply and tell us. There's often an option that works.<br>Or call us on [AMA phone].<br>The AMA team, Australian Martial Arts Academy<\/blockquote><p><b>Day 14 text:<\/b><\/p><blockquote>Hi [Parent first name], should we keep [Ava's / your] place open? Reply YES and we'll call you, or NO and we'll close it off. AMA [School]<\/blockquote>"},{"d":"hub","h2":"Exact wording of every text and email","t":"First weeks as a member (texts and emails to the family)","html":"<p>The welcome goes once the family is enrolled (9am to 7pm). The other emails count from the start date and go from 10am. Families on hold or cancelling are skipped. Emails are signed by Sarah, Head Instructor (Marrickville), Phu (Sydenham and Sylvania), Gericho (Concord and Auburn).<\/p><p><b>Welcome text:<\/b><\/p><blockquote>Welcome to AMA, [Parent first name]! [Ava is / You're] all enrolled. Check your email for everything you need for the first class. See you on the mats! AMA [School]<\/blockquote><p><b>Welcome email.<\/b> Subject: <i>Welcome to the AMA family<\/i><\/p><blockquote>Hi [Parent first name],<br>Welcome to Australian Martial Arts! [Ava is / You're] officially enrolled. Your joining form is signed and your payment is set up, so there's nothing else you need to do.<br>Your membership: [package]<br>BEFORE THE NEXT CLASS<br>- Uniform: you'll have received it when you enrolled. If not, collect it at your next class.<br>- Arrive 10 minutes early and check in each class. Attendance is how we track [Ava's / your] progress to the next belt.<br>- Bring a water bottle. Training is barefoot.<br>- [Parking note for that school]<br>Payments come out weekly in advance. Your weekly rate goes up by 3% every 52 weeks from your start date. This happens automatically.<br>[SEE CLASS TIMES button]<br>Questions? Reply to this email or call [AMA phone]. We're really glad to have you with us.<\/blockquote><p><b>Day 2 email.<\/b> Subject: <i>[Ava's / Your] uniform and belt<\/i><\/p><blockquote>Hi [Parent first name],<br>A few things that make the first weeks easier:<br>- Wash the uniform cold and hang it to dry so it doesn't shrink. Put [Ava's / your] name inside the jacket.<br>- Never wash the belt.<br>Coming regularly is what moves [Ava / you] towards the next belt. [Ava's membership includes two classes a week], so pick the same days each week and make them part of the routine.<br>Any questions, just reply.<\/blockquote><p><b>Day 14 email.<\/b> Subject: <i>Two weeks in: the AMA way<\/i><\/p><blockquote>Hi [Parent first name],<br>Two weeks in! Here's what [Ava is / you're] learning beyond the techniques.<br>Each month has a theme. This month it's [theme], and you'll hear the instructors talk about it in class.<br>How progress works: [one of the three lines below]<br>[WATCH THE WHITE BELT VIDEO button, colour belt families only]<br>Any questions, just reply.<\/blockquote><p>The progress line depends on the program:<\/p><ul><li>Little Dragons: \"Little Dragons earn a stripe for each class and move up a belt once they've collected enough stripes.\"<\/li><li>Colour belts: \"Students are invited to grade for their next belt once they've done 12 classes at white belt and their instructor says they're ready. The instructors prepare them with everything they need.\"<\/li><li>Other programs: \"Students are invited to grade for their next rank once they've done the minimum number of classes and their instructor says they're ready. The instructors prepare them with everything they need.\"<\/li><\/ul><p><b>Day 35 email.<\/b> Subject: <i>How to help [Ava / your child] at home<\/i><\/p><blockquote>Hi [Parent first name],<br>Five weeks in, and the habits are forming. Three things parents tell us make the biggest difference:<br>1. Ask about the theme, not the kicks. \"What did your instructor say about [theme] today?\" gets a better answer than \"How was class?\"<br>2. Celebrate effort, not just belts. Turning up and trying hard is what gets [Ava] to the next belt.<br>3. Keep the routine. Same day each week. Busy weeks are when the habit matters most.<br>Want to talk about [Ava's] progress? Reply and we'll set up a chat with their instructor.<\/blockquote>"},{"d":"hub","h2":"Exact wording of every text and email","t":"New members: first 90 days (texts to the family)","html":"<p>Alongside the calls on the New members list, three texts go automatically:<\/p><p>Day 7:<\/p><blockquote>Hi {parent}, {student} has finished their first week at AMA {school}! How are they finding it? Any questions at all, just reply here.<\/blockquote><p>Day 30 (with that school's Google review link):<\/p><blockquote>Hi {parent}, {student} is one month in at AMA {school}! We'd love to hear how it's going. If you're happy, a quick Google review would mean a lot: {link}<\/blockquote><p>Day 90:<\/p><blockquote>Hi {parent}, {student} has completed their first 90 days at AMA {school}! That's a big milestone. Thanks for being part of the AMA family. See you on the mats!<\/blockquote><p>The calls and chats in between: first class welcome (instructor), day 3 first class call, day 10 second class check, day 14 goals and grading call, day 21 goal-setting chat (instructor), day 42 six-week call, day 60 progress chat (instructor).<\/p>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Gradings (texts to the family)","html":"<p>Sent from the Gradings section when someone taps <b>Send texts<\/b>, one per family, 9am to 7pm. The text never says how many classes a student needs. If the student is an adult on their own number, it says \"you\" instead.<\/p><p>Invited (ready to grade):<\/p><blockquote>Hi [Parent first name], [Ava] is preparing for their [Yellow belt] grading [on Saturday 5 December]. Please reply YES to confirm their intention to grade, and the official invitation will follow. AMA [School]<\/blockquote><p>Getting ready (aiming for this grading):<\/p><blockquote>Hi [Parent first name], our goal is to have [Ava] ready for their [Yellow belt] grading [on Saturday 5 December]. Regular classes over the next few weeks are the key. Please reply YES to confirm it as their goal. AMA [School]<\/blockquote>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Private lessons (not switched on yet)","html":"<p>These are built but switched off until the rates and rules are agreed at the executive meeting.<\/p><p>To each instructor on the 1st of the month, 10am:<\/p><blockquote>Hi [Phu], it's AMA. What is your availability for 1:1 private lessons in [December]? Please add your times (Marrickville or Sydenham) here: [hub link] . Families can be booked into any time you add.<\/blockquote><p>Reminder on the 5th, if they haven't added times:<\/p><blockquote>Hi [Phu], a reminder from AMA: we don't have your private lesson availability for [December] yet. Add your times here: [hub link] . If you are not taking privates that month, just reply NONE.<\/blockquote><p>To the instructor, when a lesson is booked:<\/p><blockquote>AMA private lesson booked: [Ava] ([Sam Smith]), [Tue 8 Dec 4:30pm], AMA [School], [standard] [45] min. $[100] cash from the family; $10 goes in the AMA till. Mark it Paid in the hub afterwards.<\/blockquote><p>To the family, when a lesson is booked:<\/p><blockquote>Hi [Sam], [Ava]'s private lesson with [Phu] is booked for [Tue 8 Dec 4:30pm] at AMA [School] ([45] minutes). The lesson is $[100], paid in cash to [Phu] on the day. Need to change it? Call us on [AMA phone].<\/blockquote><p>Day before, 5pm, to the family:<\/p><blockquote>Hi [Sam], a reminder that [Ava]'s private lesson with [Phu] is tomorrow, [Tue 8 Dec 4:30pm] at AMA [School]. Please bring $[100] in cash. See you then.<\/blockquote><p>Day before, 5pm, to the instructor:<\/p><blockquote>AMA privates tomorrow: [4:30pm Ava (45 min, Marrickville, $100)]. $10 per lesson goes in the till.<\/blockquote>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Anniversary and rate notice emails (built, not switched on)","html":"<p>Built for each family's enrolment anniversary. They stay off until Mark switches them on. Families on hold, cancelling, or with a hold or cancellation still to fix in EFC are skipped. Brothers and sisters with the same anniversary share one email.<\/p><p>One month before the anniversary. Subject: <i>Your AMA membership: a note about next month<\/i><\/p><blockquote>Hi [Parent first name],<br>[Ava is / You're] nearly [one year] into [their / your] training at AMA [School], and we wanted to give you a heads-up about your yearly membership update.<br>As set out in your membership terms, your weekly rate increases by 3% every 52 weeks. Your new rate starts from [Monday 7 December]. Nothing changes in how or when you pay, and your classes stay exactly the same.<br>If you have any questions, just reply to this email or call us on [AMA phone].<br>Thank you for being part of AMA.<\/blockquote><p>On the anniversary. Subject: <i>Happy [one]-year anniversary, [Ava]!<\/i><\/p><blockquote>Hi [Parent first name],<br>[One year ago], [Ava / you] stepped onto the mat at AMA [School] for the first time. [They're now Blue belt, and that's the result of a year of showing up and working hard.]<br>We're proud of the progress [Ava has / you've] made, and we're looking forward to the year ahead: new belts, new skills and more confidence on and off the mat.<br>[Thank you for trusting us with Ava's training. / Thank you for training with us.]<\/blockquote>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Other texts to staff","html":"<p>After-trial check still missing (when it's resent to an instructor):<\/p><blockquote>AMA [School]: the after-trial check for [Monday 2 November] ([3] trials) is still missing. Please fill it in today so we can follow up these families. Takes 2 minutes: [hub link]<\/blockquote><p>When Busra approves an early stop herself (to Mark and Sarah):<\/p><blockquote>FYI Busra approved an early stop: [Parent name] ([School]). Last class [Fri 13 Nov] instead of [Sun 29 Nov]. Reason: [reason]. No reply needed.<\/blockquote><p>Close the sale, when the only calls due are families who filled in the joining form but haven't set up payment:<\/p><blockquote>AMA close the sale: [2] families have filled in the joining form but payment is not set up. Call them today: [hub link]<\/blockquote><p><b>If GHL's daily text limit is reached<\/b>, staff texts (holds to approve, alerts) go by email instead, with the line \"Sent by email because GHL has reached its daily text limit.\"<\/p>"},{"d":"hub","h2":"Exact wording of every text and email","t":"Messages GHL sends (enquiry to enrolment)","html":"<p>These are set up in GHL workflows, not in the hub. GHL fills in the first name. Change the wording in GHL only with Mark's OK.<\/p><p><b>New enquiry (straight away): email.<\/b> Subject: <i>Your free trial class at Australian Martial Arts<\/i><\/p><blockquote>YOUR FIRST CLASS IS FREE. Confidence starts on the mat.<br>Hi [first name],<br>Thanks for getting in touch. The best way to see if AMA is right for your family is a free trial class: your child joins a real class, at their level, with an instructor looking after them.<br>[BOOK MY FREE TRIAL button] Takes under a minute · Five schools across Sydney<br>4.9★ 170 Google reviews · Teaching Sydney since 1982 · 5 schools<br>YOUR TRIAL, STEP BY STEP. 01 Arrive 10 minutes early: our front desk team will meet you, show you around and introduce your instructor. 02 Train with the class: comfortable clothes and a water bottle are all you need. No experience required. 03 Talk with your instructor: we'll answer your questions and recommend the right program for you.<br>[One Google review from a Marrickville parent]<br>Not sure which class or school? Just reply to this email or call 02 9569 1943 and we'll help you choose.<br>The AMA team<\/blockquote><p><b>New enquiry (straight away): text.<\/b><\/p><blockquote>Hi [first name], thanks for enquiring with AMA! Ready to book now? Click here to pick a free trial time: train.australianmartialarts.com.au/book<\/blockquote><p><b>Enquired but not booked.<\/b> These stop as soon as a trial is booked.<\/p><p>Day 1 text:<\/p><blockquote>Hi [first name], just checking our message came through. Trial classes run most days after school. Book a time here: train.australianmartialarts.com.au/book AMA<\/blockquote><p>Day 3 email. Subject: <i>What happens at a trial class?<\/i><\/p><blockquote>Hi [first name],<br>Parents often ask what a trial class looks like, so here's the short version:<br>- Arrive 10 minutes early. We'll meet you, show you around and introduce your child to their instructor.<br>- Wear comfortable clothes. No uniform needed. Training is barefoot; bring a water bottle.<br>- Parents can watch. Most classes have seating so you can see how it runs.<br>- After class, the instructor will tell you how your child went and which class and membership would suit them. There's no pressure to sign up on the day.<br>[BOOK MY FREE TRIAL button]<br>Any questions? Just reply to this email or call 02 9569 1943.<\/blockquote><p>Day 7 text:<\/p><blockquote>Hi [first name], would you still like to try a class at AMA? Book here: train.australianmartialarts.com.au/book or reply NO and we'll stop messaging.<\/blockquote><p>Day 14 email. Subject: <i>Why families choose AMA<\/i><\/p><blockquote>Hi [first name],<br>This February, Australian Martial Arts turns 45. For almost 45 years we've helped Sydney kids and adults build confidence, focus and fitness, with real martial arts skills taught alongside respect and self-discipline.<br>WHAT FAMILIES SAY: [three Google reviews from Marrickville and Concord parents] [Read more reviews on Google]<br>When you're ready, your first class is free. [BOOK MY FREE TRIAL button]<br>Any questions? Just reply to this email or call 02 9569 1943.<\/blockquote><p><b>Recommendation sent (straight away): text.<\/b><\/p><blockquote>Hi [first name], it's Australian Martial Arts. Here is your membership summary and joining form - about 2 minutes to complete: [their joining link] Once that is done we will text you the payment setup link. Any questions, just reply here.<\/blockquote><p><b>Recommendation sent (straight away): email.<\/b> Subject: <i>Your membership details and joining form<\/i><\/p><blockquote>Hi [first name],<br>Great to have you joining us. Here is the short joining form, along with everything we talked about.<br>Recommended: [recommended memberships]<br>[Complete your joining form]<br>It takes about two minutes. Your full membership summary and the terms are on that page.<br>As soon as you submit it we will text and email you a secure link to set up your direct debit through our billing provider, Educational Funding Company. Your enrolment is confirmed once that step is done.<br>Any questions, just reply to this email or call us on 02 9569 1943.<\/blockquote><p>Joining form reminder, 2 hours later:<\/p><blockquote>Hi [first name], just making sure the joining form link came through. It takes about 2 minutes: [their joining link] If anything is not right, just reply and we will sort it out.<\/blockquote><p>Joining form reminder, next day:<\/p><blockquote>Hi [first name], we are holding your place at Australian Martial Arts but we still need the joining form to get you started: [their joining link] Happy to do it over the phone instead - just call 02 9569 1943.<\/blockquote><p><b>Joining form signed.<\/b> The reminders above stop.<\/p><p>Email. Subject: <i>Your signed joining form - Australian Martial Arts Academy<\/i>. It thanks them, then lists their details (name, mobile, email, address, membership, students, training times, medical notes, emergency contact) and the full Membership Terms (version 2026.2) they accepted, including the 3% rise every 52 weeks, 30 days' written notice to cancel, and the 6-week medical freeze. It ends: \"If anything above is not right, just reply to this email and we will fix it.\"<\/p><p>Payment link text (straight away, when the EFC link is ready):<\/p><blockquote>Thanks [first name], joining form received. Last step is setting up your direct debit with our billing provider, Educational Funding Company: [EFC link] Your enrolment is confirmed once that is done. Any trouble, reply here or call 02 9569 1943.<\/blockquote><p>Payment link email. Subject: <i>One last step - set up your payment<\/i><\/p><blockquote>Hi [first name],<br>Thanks - we have your joining form. There is one last step.<br>[Set up your direct debit]<br>This is handled securely by our billing provider, Educational Funding Company. Your enrolment is confirmed once it is done.<br>Any questions, reply to this email or call 02 9569 1943.<\/blockquote><p>Payment reminder, 3 hours later:<\/p><blockquote>Hi [first name], you are one step from being enrolled - we just need the direct debit set up: [EFC link] Takes 2 minutes. Reply here if you get stuck.<\/blockquote><p>Payment reminder, next day:<\/p><blockquote>Hi [first name], just the direct debit left to set up and you're all enrolled: [EFC link] Any trouble, just reply here. AMA<\/blockquote><p>Payment reminder, 2 days after that:<\/p><blockquote>Hi [first name], we're holding your place at AMA. Would it be easier to set up the payment over the phone? Call 02 9569 1943, or reply here and we'll call you.<\/blockquote><p>If there is no EFC link yet, nothing goes to the family: the office gets an email to set up billing by hand.<\/p><p><b>Payment set up.<\/b> GHL sends nothing to the family any more. The welcome text and email come from the hub (see First weeks as a member).<\/p><p><b>Switched off on 1 November.<\/b> The old Gold, Kickstarter and Unlimited enrolment forms (never used, and on the older terms) and the old Sylvania landing-page and Facebook lead workflows (no leads since March, and out-of-date wording) no longer send anything. Every family now joins through the joining page, on Membership Terms version 2026.2: the weekly rate increases by 3% every 52 weeks from the start of the membership, automatically.<\/p><p><b>Referral forms.<\/b> When a member refers a friend through the referral form, the friend gets:<\/p><blockquote>Hi [first name], you've been invited to try a FREE week at Australian Martial Arts Academy Sylvania by [member]. No obligation. Book here: https://train-ama.com/sylvania-information<\/blockquote><p>(The non-Sylvania referral form says \"you've been invited to try Martial Arts at Australian Martial Arts Academy by [member]\" and links to the booking form.)<\/p><p><b>Lead texts to staff.<\/b> Facebook and Google lead forms text a staff member straight away, for example \"New lead from AMA Sylvania. [name] [phone] [email]\" or \"SFG New lead from Marrickville [name] [phone]\".<\/p>"},{"d":"hub","h2":"Troubleshooting and FAQs","t":"Troubleshooting and FAQs","html":"<table class=\"hp-t\"><tr><th>Problem<\/th><th>Fix<\/th><\/tr><tr><td>\"Mobile or PIN not right\"<\/td><td>Check the mobile is the one Mark has for you. Tap <b>Forgot PIN?<\/b> for a new one.<\/td><\/tr><tr><td>\"Too many tries\"<\/td><td>Wait 15 minutes, or ask Mark<\/td><\/tr><tr><td>\"Access is switched off for this mobile\"<\/td><td>Ask Mark<\/td><\/tr><tr><td>\"Please sign in again\"<\/td><td>Your 12 hours are up. Sign in again.<\/td><\/tr><tr><td>The family didn't get the signing email<\/td><td>Check the email on the card. Ask them to look in junk. Tap <b>Resend signing link<\/b>.<\/td><\/tr><tr><td>The family's email address was wrong<\/td><td>Ask Mark to fix it on the sheet, then resend<\/td><\/tr><tr><td>A trial is missing from the after-trial check<\/td><td>Check the school and date. Trials come from the GHL calendars, so make sure it was booked in GHL.<\/td><\/tr><tr><td>I replied but the enquiry is still on my list<\/td><td>Replies from GHL take up to 30 minutes to show. If you used your own phone, tap <b>I replied from my own phone<\/b>.<\/td><\/tr><tr><td>I logged something wrong<\/td><td>Don't log it again. Tell Mark the H or C number.<\/td><\/tr><tr><td>The numbers look out of date<\/td><td>Tap <b>Refresh<\/b> on the home page<\/td><\/tr><tr><td>A link in the SALES, MARKETING or RETENTION sections won't open<\/td><td>Tap <b>No access?<\/b> and email Mark<\/td><\/tr><\/table><p><b>Who to ask:<\/b> Mark for anything about the hub, PINs or access. Sarah for cancellations and complaints.<\/p>"},{"d":"dash","h2":"How the dashboard is laid out (from 1 November)","t":"How the dashboard is laid out (from 1 November)","html":"<p>The dashboard now opens on an <b>overview<\/b>, and everything else sits in sections you tap into.<\/p><p><b>At a glance.<\/b> The top of the page shows <b>Right now<\/b> (students, trials in the next 7 days, open enquiries, notices running) and this month's <b>Targets<\/b>. That's enough to know where the business stands in ten seconds.<\/p><p><b>Dive deeper.<\/b> Under that is a tile for each section, with its headline numbers on the tile. Tap a tile to see everything in that section. Tap <b>Back to the overview<\/b> to return. The period buttons (7, 30, 90 days, or a month) at the top still apply to every section.<\/p><table class=\"hp-t\"><tr><th>Section<\/th><th>What's inside<\/th><\/tr><tr><td><b>How to use this dashboard<\/b><\/td><td>A short guide, a link to search the hub help, and this document<\/td><\/tr><tr><td><b>Targets<\/b><\/td><td>Starts and stops against goal this month, this year so far, why students stopped<\/td><\/tr><tr><td><b>Money waiting<\/b><\/td><td>Close the sale (families and weekly fees waiting), absentees, new members in their first 90 days, holds to action, hold and cancel requests received<\/td><\/tr><tr><td><b>Growth and revenue<\/b><\/td><td>New and cancelled students, net growth, saves, weekly revenue, 12-week trend<\/td><\/tr><tr><td><b>Sales<\/b><\/td><td>Funnel, speed to lead, close the sale results, trial classes that convert<\/td><\/tr><tr><td><b>Marketing and referrals<\/b><\/td><td>Lead sources, how families heard about AMA, packages, promotions, referrals<\/td><\/tr><tr><td><b>Retention: holds and cancels<\/b><\/td><td>Holds, cancellations, churn, why students cancelled, who joined, held and cancelled<\/td><\/tr><tr><td><b>By school<\/b><\/td><td>Each school side by side for the period and for last week<\/td><\/tr><tr><td><b>Team<\/b><\/td><td>Recommendations and joins per staff member, and each person's activity in the last 7 days<\/td><\/tr><tr><td><b>Gradings<\/b><\/td><td>Ready, on track and overdue students for the next grading, by school<\/td><\/tr><tr><td><b>Data health<\/b><\/td><td>Records to fix in EFC and trial reports not filled in<\/td><\/tr><\/table><p><b>Suggested order for the Monday meeting:<\/b> Targets, Money waiting, Sales (speed to lead first), Retention, Gradings, Team, Data health.<\/p>"},{"d":"dash","h2":"How the dashboard is laid out (from 1 November)","t":"New numbers (1 November)","html":"<ul><li><b>Starts goal.<\/b> 30% above the average for that month across every previous year with data. Underneath, <b>To beat last year +10%<\/b> shows the number needed to beat last year by 10%. Tags read Goal hit, Beat last year +10%, On pace for goal, On pace to beat last year +10%, or Behind pace.<\/li><li><b>Hold and cancel requests received.<\/b> Every request that came in (email, EFC message, phone, desk), how many are still waiting to be logged (and how many over a day), how many were logged in the hub, agreed by email, or saved. Requests agreed by email aren't in the stops and holds counts until they're logged.<\/li><li><b>Overdue gradings.<\/b> Students who have had enough classes for 3 months or more without grading.<\/li><li><b>Team activity, last 7 days.<\/b> Calls, wins and admin actions per person.<\/li><li><b>Data health.<\/b> Students to fix in EFC and trial reports missing.<\/li><\/ul>"},{"d":"dash","h2":"Executive meeting (Mondays, 12pm)","t":"Executive meeting (Mondays, 12pm)","html":"<p>The <b>Executive meeting<\/b> tile opens the page for the Monday head instructor meeting. Mark, Hakan, Sarah, Busra, Phu, Ridvan (Grand Master) and Laurie can open it. Everyone sees everyone's sections. The link is train.australianmartialarts.com.au/admin#exec.<\/p><p><b>The 9am text.<\/b> At 9am every Monday each of the seven gets this text:<\/p><blockquote>Hi [name], AMA executive meeting today at 12pm. Please add your update for your section before 11:30: https://train.australianmartialarts.com.au/admin#exec<\/blockquote><p><b>How the page is laid out.<\/b><\/p><ul><li><b>Decisions made:<\/b> a box for what the meeting agreed.<\/li><li><b>1. Marketing (Laurie):<\/b> Laurie's notes, plus the week's lead channels and how new members heard about AMA.<\/li><li><b>2. Overview by school:<\/b> last Monday to Sunday for each school, including Showed and Showed to joined, with short notes on what stands out.<\/li><li><b>3, 4 and 5. Starts, Stops and Holds:<\/b> the numbers and the names behind them.<\/li><li><b>6 onwards, one numbered section per person<\/b> (Mark, Hakan, Sarah, Busra, Phu, Ridvan): a list of items, each with Item, What it is, Needs (For info, Decision needed or Discussion), and Notes and outcome (Agreed, Not agreed, Needs more info, Action, Noted). The person's open actions show underneath, and there is an optional Other notes box.<\/li><li><b>Anything else:<\/b> other business from anyone.<\/li><li><b>Actions:<\/b> every open action with its owner, due date and status (Open, In progress, Waiting, Done, Dropped). Actions carry forward to the next meeting until they are marked Done or Dropped.<\/li><li><b>Meeting summary:<\/b> at the end of the meeting, tap <b>Write the meeting summary<\/b>. It writes up the decisions, everyone's items with outcomes, the notes, the week's numbers and the actions, and keeps it with that meeting.<\/li><\/ul><p><b>Past meetings.<\/b> Pick any past Monday at the top of the page to read what was written that week and its summary. Everything is stored on the <b>Exec notes<\/b> and <b>Exec actions<\/b> tabs of the enrolment sheet.<\/p>"},{"d":"dash","h2":"Year to date","t":"Year to date","html":"<p>The <b>Year to date<\/b> tile compares starts and stops from 1 January to today with the same dates in every past year, for each school and all schools. Past years come from the EFC numbers on the Targets tab; the current month is counted pro rata to today's date. Sydenham's figures before 2020 include the old Mascot school's history.<\/p>"},{"d":"dash","h2":"Private lessons","t":"Private lessons","html":"<p>The <b>Private lessons<\/b> tile is where admin books 1:1 lessons and instructors add their availability a month ahead. Lessons run at Marrickville and Sydenham only, and need 24 hours' notice. The family pays the instructor in cash and $10 per lesson goes in the AMA till. Proposed rates (30 / 45 / 60 minutes): Head instructor $85 / $120 / $155, Senior instructor $70 / $100 / $130, Instructor $55 / $75 / $100. The texts to instructors and families are built but switched off until the rates and rules are agreed at the executive meeting. Their exact wording is in the team training guide.<\/p>"},{"d":"dash","h2":"Messages management gets, and messages waiting on a decision","t":"Messages management gets, and messages waiting on a decision","html":"<ul><li><b>Monday 8am:<\/b> the weekly summary text (see The Monday text below).<\/li><li><b>Monday 9am:<\/b> the executive meeting text (above).<\/li><li><b>7pm daily:<\/b> the staff activity report (see Staff activity report below).<\/li><li><b>When Busra approves an early stop herself:<\/b> Mark and Sarah get \"FYI Busra approved an early stop: [Parent name] ([School]). Last class [date] instead of [date]. Reason: [reason]. No reply needed.\"<\/li><li><b>Built, waiting for a decision before they go live:<\/b> private lesson texts, and the anniversary and 3% rate notice emails to families.<\/li><\/ul><p>The exact wording of every text and email families get, from the hub and from GHL, is in the team training guide under Exact wording of every text and email.<\/p>"},{"d":"dash","h2":"Opening it and reading it","t":"Opening it and reading it","html":"<p>The dashboard shows the whole business on one page: students, starts against target, the trial funnel, revenue, staff, lead sources and retention. Mark, Sarah, Hakan, Ridvan, Busra and Laurie can see it. Laurie sees the marketing view: Right now, Targets, Growth, Sales, Marketing and referrals, By school, Year to date and the Executive meeting. Money waiting, Retention, Team, Gradings and Data health are hidden from him, and dollar figures (revenue, rates, hold costs and fees) are removed before the page reaches his login.<\/p><p><b>To open it<\/b>, sign in at <b>train.australianmartialarts.com.au/admin<\/b> with your mobile and PIN. Then tap the gold <b>MANAGEMENT DASHBOARD<\/b> tile. The Monday text also has a direct link.<\/p><p><b>How fresh it is.<\/b> The numbers rebuild every 30 minutes on their own. The time of the last update is at the top. Tap <b>Refresh<\/b> to rebuild them now; this takes about 20 seconds.<\/p><p><b>Period: 7 days, 30 days, 90 days.<\/b> Most sections cover the period you pick, ending today. The default is 30 days. Small arrows compare it with the period just before. Green means better. For cancellations, lower is better.<\/p><p><b>Month picker.<\/b> Next to the 7, 30 and 90 day buttons, the <b>Month…<\/b> box shows any single calendar month: this month so far, or a finished month. The sections then cover that month, and the arrows compare it with the month before. Every finished month is also saved to the <b>Monthly snapshots<\/b> tab of the enrolment sheet, once, and never changed afterwards. That means every month is kept, and you can look back at past months and years later. Months saved this way show \"(saved)\" in the list.<\/p><p><b>School buttons.<\/b> These sit under Targets and switch the <b>Targets<\/b> and <b>This year so far<\/b> sections between all schools and one school.<\/p><p><b>Where the numbers come from<\/b><\/p><table class=\"hp-t\"><tr><th>Data<\/th><th>Source<\/th><\/tr><tr><td>New students, packages, weekly rates, who signed them up<\/td><td>The joining form (Enrolments tab)<\/td><\/tr><tr><td>Enquiries, trials, attendance, recommendations<\/td><td>GHL pipeline, trial calendars, recommendation form, after-trial check<\/td><\/tr><tr><td>Holds, cancellations, saves<\/td><td>The hub forms, from 26 October 2026<\/td><\/tr><tr><td>Holds and stops before 26 October<\/td><td>The old weekly stats sheet (no saves or notice details)<\/td><\/tr><tr><td>Monthly starts and stops for past months and targets<\/td><td>The Targets tab (EFC numbers)<\/td><\/tr><tr><td>Current student totals<\/td><td>The Student counts tab (EFC numbers Mark enters monthly), plus joins and minus cancellations since<\/td><\/tr><tr><td>Lead sources<\/td><td>GHL first-touch tracking (ad clicks, UTM links, QR codes)<\/td><\/tr><\/table><p>Test records (names starting with ZZ) are always left out.<\/p>"},{"d":"dash","h2":"Right now, and Targets","t":"Right now","html":"<table class=\"hp-t\"><tr><th>Card<\/th><th>What it shows<\/th><\/tr><tr><td><b>Students<\/b><\/td><td>Active students across all schools. This is the last EFC count, plus new joins and minus cancellations since that count.<\/td><\/tr><tr><td><b>Trials next 7 days<\/b><\/td><td>Families booked for a trial in the next week, broken down by school. Siblings on the same day count as one family. Walk-ins are not included.<\/td><\/tr><tr><td><b>Open enquiries<\/b><\/td><td>Open opportunities in the GHL Enquiries pipeline from the last 6 months<\/td><\/tr><tr><td><b>Notices running<\/b><\/td><td>Cancellations still in their notice period or waiting on a signature or approval. The caption shows how many members are on hold right now.<\/td><\/tr><\/table>"},{"d":"dash","h2":"Right now, and Targets","t":"Targets (this month)","html":"<p>Every school has a monthly goal for starts and stops on the Targets tab. Each goal is set 30% better than that month's average since 2019. Mark can change them on the tab at any time.<\/p><p><b>Sylvania<\/b> has no history yet. It opened in February 2026, so its goals are provisional. Its starts goal is its share of the all-schools goal, and its stops goal is 1 a month.<\/p><table class=\"hp-t\"><tr><th>Card<\/th><th>What it means<\/th><\/tr><tr><td><b>Starts this month<\/b><\/td><td>New students so far against the goal. The tag reads Goal hit, Minimum hit, On pace for goal, On pace for minimum, or Behind pace. The minimum is last year's same month plus 10%. Pace assumes even progress through the month.<\/td><\/tr><tr><td><b>Stops this month<\/b><\/td><td>Students cancelled this month against the goal to stay under. The minimum to stay under is last year minus 10%. Stops are counted on the day the notice is logged.<\/td><\/tr><tr><td><b>Net this month<\/b><\/td><td>Starts minus stops, with the target net underneath<\/td><\/tr><tr><td><b>Starts this year<\/b><\/td><td>Starts so far this year against the year-to-date goal, with the same months last year for comparison. It also shows starts and stops over the last 12 months and that school's yearly churn. Use the school buttons to compare churn by school.<\/td><\/tr><\/table><p>Two charts follow. They show starts and stops for each month this year against the goal, the minimum and last year.<\/p><p><b>Where past months come from:<\/b> the EFC numbers on the Targets tab. If a month is blank there, the old weekly stats sheet or the hub fills it in. The current month is counted live from the hub.<\/p>"},{"d":"dash","h2":"This year so far","t":"This year so far","html":"<p>This section covers January to today for the school you pick. Weeks before 26 October come from the old \"2026 Stats - Start, Stop, Hold\" sheet. From 26 October everything comes from the hub.<\/p><table class=\"hp-t\"><tr><th>Card<\/th><th>What it means<\/th><\/tr><tr><td><b>Starts<\/b><\/td><td>New students this year, with stops and the net beneath<\/td><\/tr><tr><td><b>Holds<\/b><\/td><td>Holds taken this year (package changes are not counted), with the total and average weeks<\/td><\/tr><tr><td><b>Cost of holds<\/b><\/td><td>Total weeks on hold × the average weekly rate per student. This is the revenue paused by holds.<\/td><\/tr><tr><td><b>Stops in first 3 months<\/b><\/td><td>How many of this year's stops left within 3 months of joining. This is the early-leaver problem.<\/td><\/tr><\/table><p>Next is a chart of starts, stops and holds for each month, then four lists:<\/p><ul><li><b>Why students stopped:<\/b> reasons grouped into categories, such as cost, moving, lost interest or time.<\/li><li><b>How long they had been with us:<\/b> under 3 months, 3 to 12 months, 1 to 3 years, or 3 years or more.<\/li><li><b>Why families asked for a hold.<\/b><\/li><li><b>New students signed up by:<\/b> each staff member's sign-ups this year.<\/li><\/ul><p>The reason categories are worked out from the words staff typed, so they are a guide rather than exact.<\/p>"},{"d":"dash","h2":"Growth, revenue and the trial funnel","t":"Growth, revenue and the trial funnel","html":"<p>These sections all follow the period you pick (7, 30 or 90 days).<\/p>"},{"d":"dash","h2":"Growth, revenue and the trial funnel","t":"Growth","html":"<table class=\"hp-t\"><tr><th>Card<\/th><th>What it means<\/th><\/tr><tr><td><b>New students<\/b><\/td><td>Students who joined in the period, one per child. The caption shows how many families that is.<\/td><\/tr><tr><td><b>Students cancelled<\/b><\/td><td>Students whose cancellation was logged in the period. Saves and families who changed their mind are not counted.<\/td><\/tr><tr><td><b>Net growth<\/b><\/td><td>New minus cancelled<\/td><\/tr><tr><td><b>Saves<\/b><\/td><td>Families who were going to cancel or pause but stayed: they took an offer, or used make-up classes instead of a hold. The <b>save rate<\/b> is saves ÷ (saves + cancellations going ahead).<\/td><\/tr><\/table>"},{"d":"dash","h2":"Growth, revenue and the trial funnel","t":"Revenue (weekly)","html":"<table class=\"hp-t\"><tr><th>Card<\/th><th>What it means<\/th><\/tr><tr><td><b>New weekly revenue<\/b><\/td><td>The total weekly fees of new students, from the joining form<\/td><\/tr><tr><td><b>Lost weekly revenue<\/b><\/td><td>An estimate of the weekly fees lost to cancellations. It uses each family's own rate where we have it, otherwise the average.<\/td><\/tr><tr><td><b>Net weekly change<\/b><\/td><td>New minus lost, plus what that comes to over a year<\/td><\/tr><tr><td><b>Average weekly rate<\/b><\/td><td>The average weekly fee per new student<\/td><\/tr><\/table>"},{"d":"dash","h2":"Growth, revenue and the trial funnel","t":"Funnel","html":"<p>The funnel follows families from enquiry to joining. A <b>trial family<\/b> is one family on one day, so siblings trialling together count once.<\/p><table class=\"hp-t\"><tr><th>Stage<\/th><th>What counts<\/th><\/tr><tr><td><b>Enquiries<\/b><\/td><td>New opportunities in the GHL Enquiries pipeline<\/td><\/tr><tr><td><b>Trial families<\/b><\/td><td>Families whose trial took place in the period. Walk-ins are included. <b>Show rate<\/b> = attended ÷ trial families.<\/td><\/tr><tr><td><b>Attended<\/b><\/td><td>Trial families not marked absent in the after-trial check or as a no-show in GHL<\/td><\/tr><tr><td><b>Rec sent<\/b><\/td><td>Attended families who got the recommendation form, were marked \"recommendation sent\", or joined. Shown as a % of attended.<\/td><\/tr><tr><td><b>Enrolled<\/b><\/td><td>Attended families who have joined since their trial. Shown as a % of attended.<\/td><\/tr><\/table><p>The line underneath shows:<\/p><ul><li><b>Enquiry to trial %<\/b> and <b>enquiry to enrolled %<\/b><\/li><li>trials booked in the period<\/li><li>walk-ins<\/li><li>recommendation forms sent<\/li><\/ul><p><b>How to read it:<\/b> a drop from Trial families to Attended is a show-rate problem, so look at confirmations and reminders. A drop from Attended to Rec sent means recommendations aren't being made. A drop from Rec sent to Enrolled is a conversion and follow-up problem.<\/p>"},{"d":"dash","h2":"Growth, revenue and the trial funnel","t":"12-week trend","html":"<p>Two charts show the last 12 weeks, one point per week:<\/p><ul><li>enquiries, trial families, new students and cancellations<\/li><li>new and lost weekly revenue<\/li><\/ul><p>Use them to see whether a change is a one-off week or a trend.<\/p>"},{"d":"dash","h2":"By school, Staff and Classes","t":"By school","html":"<p>There is one row per school for the chosen period.<\/p><table class=\"hp-t\"><tr><th>Column<\/th><th>What it means<\/th><\/tr><tr><td>Students<\/td><td>Active students now<\/td><\/tr><tr><td>Joined, Cancelled, Net<\/td><td>Students who joined and cancelled in the period, and the difference (green up, red down)<\/td><\/tr><tr><td>New $/wk<\/td><td>Weekly fees from new students<\/td><\/tr><tr><td>Trials<\/td><td>Trial families<\/td><\/tr><tr><td>Show<\/td><td>Share of trial families who attended<\/td><\/tr><tr><td>Rec sent<\/td><td>Share of attended families who got a recommendation<\/td><\/tr><tr><td>Trial to join<\/td><td>Share of attended families who have joined<\/td><\/tr><tr><td>Reported<\/td><td>Share of past trials with an after-trial check filled in. Anything under 100% means some trials weren't reported, which makes Show and Trial to join less reliable for that school.<\/td><\/tr><\/table><p>On a phone, some columns are hidden. Turn the phone sideways or use a computer to see them all.<\/p>"},{"d":"dash","h2":"By school, Staff and Classes","t":"Staff","html":"<p>There is one row per staff member who sent recommendations in the period.<\/p><table class=\"hp-t\"><tr><th>Column<\/th><th>What it means<\/th><\/tr><tr><td>Recs sent<\/td><td>Recommendation forms they sent<\/td><\/tr><tr><td>Joined from recs<\/td><td>Families they recommended who have since joined<\/td><\/tr><tr><td>Rec to join %<\/td><td>Joined from recs ÷ recs sent. This is their closing rate.<\/td><\/tr><tr><td>Enrolments credited<\/td><td>New students credited to them. This comes from \"Recommended by\" on the joining form, or, if that's blank, from whoever sent the recommendation.<\/td><\/tr><\/table>"},{"d":"dash","h2":"By school, Staff and Classes","t":"Classes","html":"<p>The 15 classes with the most trial families. Each row shows trials, attended, joined and trial to join %. Use it to see which classes convert and which don't.<\/p>"},{"d":"dash","h2":"Speed to lead, lead sources and marketing","t":"Speed to lead","html":"<p>This section measures how fast a person replies to a new enquiry. Only a text, email or call from a staff member counts. The automatic welcome SMS and email, and booking confirmations, don't count.<\/p><table class=\"hp-t\"><tr><th>Card<\/th><th>What it means<\/th><\/tr><tr><td><b>Typical first reply<\/b><\/td><td>The middle (median) time from enquiry to first personal reply<\/td><\/tr><tr><td><b>Replied within 5 min<\/b> and <b>within 1 hour<\/b><\/td><td>The share of enquiries answered that fast<\/td><\/tr><tr><td><b>No reply from a person<\/b><\/td><td>Enquiries that only got the automatic message, or nothing at all<\/td><\/tr><\/table><p>The note underneath gives the same figures for enquiry-form leads only. These are people who haven't booked a trial yet, so a fast personal reply matters most for them. Front desk staff get a text after 60 minutes with no reply, and Mark gets one an hour after that.<\/p>"},{"d":"dash","h2":"Speed to lead, lead sources and marketing","t":"Lead sources","html":"<p>Each enquiry is grouped by where the family first came from, using GHL's tracking. The groups are:<\/p><ul><li>Meta ads<\/li><li>Google ads<\/li><li>Banners and QR codes<\/li><li>Social (not paid)<\/li><li>Email or SMS<\/li><li>Google search (not paid)<\/li><li>Website or link<\/li><li>Direct<\/li><li>Unknown<\/li><\/ul><table class=\"hp-t\"><tr><th>Column<\/th><th>What it means<\/th><\/tr><tr><td>Enquiries<\/td><td>New enquiries in the period from that channel<\/td><\/tr><tr><td>Had a trial<\/td><td>How many of those families have had a trial<\/td><\/tr><tr><td>New members<\/td><td>Everyone who joined in the period, grouped by where they first came from. This includes families who enquired before the period started.<\/td><\/tr><tr><td>New $/wk<\/td><td>Their weekly fees<\/td><\/tr><tr><td>Of these enquiries, joined<\/td><td>Follows only the enquiries made in the period: how many of them have joined so far, and the %. For example, \"7 (36.8%)\" means 7 of that channel's 19 enquiries have joined. Recent enquiries haven't had time to join yet, so this reads low for the last few weeks.<\/td><\/tr><\/table><p>If UTM campaign names are used on ads or links, a campaign table appears underneath. \"No GHL contact linked\" means the enrolment couldn't be matched to a GHL contact. Older contacts are looked up gradually, so the table fills in over a few hours.<\/p><p><b>Why New members can be bigger than Enquiries.<\/b> Direct might show 5 enquiries but 12 new members. That's because most of those 12 enquired before this period, or joined without going through the Enquiries pipeline. Use New members and New $/wk to see which channels bring in members. Use the last column to see how well this period's enquiries are converting.<\/p>"},{"d":"dash","h2":"Speed to lead, lead sources and marketing","t":"Marketing","html":"<p>Four short lists for the period:<\/p><ul><li><b>How new members heard about AMA:<\/b> from the joining form.<\/li><li><b>Where enquiries came from:<\/b> the GHL source.<\/li><li><b>Packages chosen.<\/b><\/li><li><b>Promotions used.<\/b><\/li><\/ul>"},{"d":"dash","h2":"Speed to lead, lead sources and marketing","t":"Close the sale","html":"<p>Families who were sent a recommendation in the period you picked, and what Bianca and Mady did about the ones who hadn't joined.<\/p><ul><li><b>Families called<\/b>: how many had at least one call recorded.<\/li><li><b>Calls made<\/b>: every call recorded, including no answers.<\/li><li><b>Joined<\/b>: families on the list who went on to join (recorded by staff, or picked up when GHL moved them on).<\/li><li><b>Not going ahead<\/b>: families closed off with a reason.<\/li><li><b>Why they haven't joined<\/b>: the reasons staff chose, most common first. If price or class times keep coming up, that tells you what to fix.<\/li><\/ul>"},{"d":"dash","h2":"Speed to lead, lead sources and marketing","t":"Referrals","html":"<table class=\"hp-t\"><tr><th>Card<\/th><th>What it means<\/th><\/tr><tr><td><b>Joined through a referral<\/b><\/td><td>New students in the period who were referred by a current member, as a share of all new students, and how many families referred them<\/td><\/tr><tr><td><b>Members thanked<\/b><\/td><td>How many of those referring members have been called and offered a reward<\/td><\/tr><tr><td><b>Rewards presented<\/b><\/td><td>Rewards handed over at mat chat<\/td><\/tr><tr><td><b>Days to say thank you<\/b><\/td><td>Typical days from the family joining to the thank-you call. Aim for under 7.<\/td><\/tr><\/table><p><b>Top referring families<\/b> lists who has sent us the most new students in the period. These families are worth a personal thank-you from Mark or Sarah.<\/p>"},{"d":"dash","h2":"Holds, cancellations and retention","t":"Holds, cancellations and retention","html":"<p>These sections run on the hub's hold and cancellation forms, which start on 26 October 2026. Before that date, holds and stops come from the old weekly stats sheet. They count in the totals, weeks, costs and reasons, but the sheet has no saves, notice dates or approvals, so those cards fill out over the coming weeks. Summary lines typed into the sheet (like \"HOLDS - requested vs granted\") and package changes are left out.<\/p>"},{"d":"dash","h2":"Holds, cancellations and retention","t":"Holds","html":"<table class=\"hp-t\"><tr><th>Card<\/th><th>What it means<\/th><\/tr><tr><td><b>Hold requests<\/b><\/td><td>Holds logged in the period, split into approved, declined and waiting. The caption also shows how many were sorted without a hold, for example with make-up classes.<\/td><\/tr><tr><td><b>Weeks requested / granted<\/b><\/td><td>Total hold weeks asked for and given<\/td><\/tr><tr><td><b>Cost of holds<\/b><\/td><td>Weeks granted × each family's weekly rate. For holds from the old sheet, which has no rate, it uses the average weekly rate per student. This is the revenue paused.<\/td><\/tr><tr><td><b>On hold now<\/b><\/td><td>Students on hold today, and the weekly fees paused right now. For holds from the old sheet, this is an estimate: from the week the hold was logged, for the number of weeks staff wrote down (or until the resume date, where one was given).<\/td><\/tr><\/table><p>A note shows how many requests were outside the terms and how many of those were approved as an exception.<\/p>"},{"d":"dash","h2":"Holds, cancellations and retention","t":"Cancellations","html":"<table class=\"hp-t\"><tr><th>Card<\/th><th>What it means<\/th><\/tr><tr><td><b>Cancellations logged<\/b><\/td><td>Cancellation conversations logged in the hub, split into saved, changed their mind, and going ahead. Stops from the old sheet before 26 October are shown separately.<\/td><\/tr><tr><td><b>Save rate<\/b><\/td><td>Saves ÷ (saves + going ahead), with the weekly fees kept by saves<\/td><\/tr><tr><td><b>Notice periods<\/b><\/td><td>The average notice given, and the fees collected during notice<\/td><\/tr><tr><td><b>Early stops<\/b><\/td><td>How many families asked to stop before their 30 days were up, how many were approved, and the notice fees given up<\/td><\/tr><\/table><p>A note lists what's still in progress: waiting for a signature, or waiting for Mark or Sarah to approve.<\/p>"},{"d":"dash","h2":"Holds, cancellations and retention","t":"Retention","html":"<table class=\"hp-t\"><tr><th>Card<\/th><th>What it means<\/th><\/tr><tr><td><b>Churn (30 days)<\/b><\/td><td>Students cancelled in the last 30 days ÷ active students. This always uses 30 days, whichever period is picked.<\/td><\/tr><tr><td><b>Early leavers<\/b><\/td><td>Cancellations from students who joined less than 3 months ago, and the average time members stay<\/td><\/tr><tr><td><b>Complaints<\/b><\/td><td>Cancellations logged as \"Unhappy with something\". Each one goes to Sarah by text.<\/td><\/tr><tr><td><b>Short notice<\/b><\/td><td>Families who wanted to stop with less than 30 days' notice<\/td><\/tr><\/table><p><b>Churn (12 months)<\/b> sits beside the 30-day figure. It is the number of students who stopped in the last 12 months ÷ active students now. Past months use the EFC stop numbers on the Targets tab, and the current month comes from the hub. It doesn't change with the period buttons. Short notice is shown under Complaints.<\/p><p><b>Complaints<\/b> now also shows how many complaints Sarah has closed. Underneath Retention, a line gives the <b>exit survey<\/b> average (1 to 5) for families who left in the period, and how many cancelled families have since <b>rejoined<\/b>. Families are texted the survey the day after their last class. Win-back texts go out at 60 and 180 days.<\/p><p>Under these are lists of:<\/p><ul><li>why students cancelled<\/li><li>which offers saved members<\/li><li>which offers were made<\/li><li>why families asked for holds<\/li><li>open enquiries by pipeline stage<\/li><\/ul>"},{"d":"dash","h2":"Names, last week by school and how students are counted","t":"Who joined, held and cancelled","html":"<p>At the bottom of the dashboard, three buttons show the people behind the numbers for the period or month you picked: <b>Enrolled<\/b>, <b>Holds<\/b> and <b>Cancellations<\/b>, each with a count.<\/p><ul><li><b>Enrolled:<\/b> the full joining-form details for each student, including student, date of birth, package, parent, mobile, email, suburb, how they heard about AMA, who recommended them, class times, medical notes, emergency contact and their \"why\".<\/li><li><b>Holds<\/b> and <b>Cancellations:<\/b> what was logged in the hub (status, reason in the family's words, dates, who took it). For dates before 26 Oct 2026, the entries from the old weekly start / stop / hold sheet are listed underneath.<\/li><li>A student set up in EFC with no joining form on file still appears, with the note <b>Set up in EFC; no joining form on file<\/b>.<\/li><\/ul>"},{"d":"dash","h2":"Names, last week by school and how students are counted","t":"Last week by school","html":"<p>A table of last Monday to Sunday, one row per school in alphabetical order plus an <b>All schools<\/b> total: joined, cancelled, holds, net, trials, show rate, trial to join and new $ per week.<\/p>"},{"d":"dash","h2":"Names, last week by school and how students are counted","t":"Each student is counted once","html":"<p>The Enrolments tab usually has two rows for each new student: one from the joining form and one when EFC confirms the enrolment. Since 26 Oct 2026 the dashboard, the front page, the Monday text and the saved months count them once (same mobile and first name = same student). This lowered some earlier figures; for example, the week of 19 to 25 Oct is 15 new students, not 23.<\/p>"},{"d":"dash","h2":"Names, last week by school and how students are counted","t":"Old weekly sheet weeks","html":"<p>The old weekly start / stop / hold sheet records each week under its Monday. The dashboard counts that week on its Sunday, so \"last 7 days\" includes last week's sheet.<\/p>"},{"d":"dash","h2":"Names, last week by school and how students are counted","t":"Staff activity report (7pm)","html":"<p>Every action staff take in the hub is logged on the <b>Activity log<\/b> tab: who, when, what and which family. At 7pm each day Mark and Sarah get a text and an email showing what each person did, when they were in the hub, who signed in without doing anything, and what is still waiting (holds to approve or put on in EFC, signed cancellations to action, Close the sale calls due).<\/p>"},{"d":"dash","h2":"The Monday text and a weekly routine","t":"The Monday text and a weekly routine","html":"<p>Every Monday at 8am, Mark, Sarah, Hakan and Ridvan get a text summing up the previous Monday to Sunday. It covers:<\/p><ul><li>new students and the weekly fees they added<\/li><li>cancellations and new holds, and the net change<\/li><li>enquiries, trial families, how many attended, and how many have joined so far<\/li><li>the school with the most new students<\/li><li>this month's starts and stops against target<\/li><li>a link to the dashboard<\/li><\/ul><p><b>A 10-minute weekly check<\/b><\/p><ol><li><b>Targets.<\/b> Are starts on pace for goal? Are stops under? If not, check which school is behind using the school buttons.<\/li><li><b>Funnel (30 days).<\/b> Where is the biggest drop: show rate, recommendations, or joining?<\/li><li><b>By school.<\/b> Check that the Reported column is close to 100%. If it isn't, that school's trials aren't being reported.<\/li><li><b>Staff.<\/b> Look at recommendations sent and closing rate for each person.<\/li><li><b>Speed to lead.<\/b> Check the typical first reply time and how many enquiries got no reply from a person.<\/li><li><b>Retention.<\/b> Look at the save rate, early leavers and complaints.<\/li><\/ol><p><b>Questions or numbers that look wrong:<\/b> tell Mark. Most fixes are a data entry on the joining form or the Targets or Student counts tab.<\/p>"}];


// ===================== PRIVATE LESSONS (1 Nov 2026, Mark) =====================
// Instructors give their availability a month ahead; admin books 1:1 lessons into it.
// Marrickville and Sydenham only. Cash to the instructor, $10 of every lesson goes in the AMA till.
// Texts are built but OFF until Mark approves the wording: set PV.send to true (or run pvGoLive).
const PV = {
  send: false,
  schools: ['Marrickville', 'Sydenham'],
  minNoticeHours: 24,
  till: 10,
  stepMins: 15,
  types: [
    { k: 'grading', t: 'Grading prep', mins: 30 },
    { k: 'standard', t: 'Standard private', mins: 45 },
    { k: 'extended', t: 'Extended (black belt, competition, catch-up)', mins: 60 }
  ],
  levels: { head: 'Head instructor', senior: 'Senior instructor', instructor: 'Instructor' },
