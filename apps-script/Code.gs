function ghlPost_(path, body) {
  const res = UF_.fetch(CONFIG.ghlBase + path, {
    method: 'post', contentType: 'application/json', muteHttpExceptions: true,
    headers: { 'Authorization': 'Bearer ' + getToken_(), 'Version': CONFIG.ghlVersion, 'Accept': 'application/json' },
    payload: JSON.stringify(body)
  });
  return { code: res.getResponseCode(), body: res.getContentText() };
}

function ghlPut_(path, body) {
  const res = UF_.fetch(CONFIG.ghlBase + path, {
    method: 'put', contentType: 'application/json', muteHttpExceptions: true,
    headers: { 'Authorization': 'Bearer ' + getToken_(), 'Version': CONFIG.ghlVersion, 'Accept': 'application/json' },
    payload: JSON.stringify(body)
  });
  return { code: res.getResponseCode(), body: res.getContentText() };
}

function minimalPerms_(perms) {
  const out = {};
  Object.keys(perms || {}).forEach(function (k) {
    if (typeof perms[k] === 'boolean') out[k] = false;
    else out[k] = perms[k];
  });
  out.calendarsEnabled = true;
  out.assignedDataOnly = false;
  return out;
}

function slug_(s) {
  return s.toLowerCase().replace(/\([^)]*\)/g, '').replace(/[^a-z0-9]/g, '');
}

function cleanName_(s) {
  return s.replace(/\([^)]*\)/g, '').replace(/\|/g, ' ').replace(/\s+/g, ' ').trim();
}

function auditOverlaps() {
  const plan = JSON.parse(PropertiesService.getScriptProperties().getProperty('ASSIGN_PLAN'));

  const byUser = {};
  plan.forEach(function (p) {
    if (p.user.indexOf('no slots') > -1) return;
    byUser[p.user] = byUser[p.user] || [];
    byUser[p.user].push(p.name.replace('Book a Trial | ', '').replace('Open Day | ', 'OPENDAY '));
  });

  const done = {
    'info+sylvania-ld@australianmartialarts.com.au': 1,
    'info+sylvania-dragons@australianmartialarts.com.au': 1,
    'info+auburn-family@australianmartialarts.com.au': 1,
    'info+auburn-littledragons@australianmartialarts.com.au': 1,
    'info+auburn-adults@australianmartialarts.com.au': 1
  };

  const created = [];
  Object.keys(byUser).sort().forEach(function (u) {
    const loc = u.replace(/ \d+$/, '');
    const primary = cleanName_(byUser[u][0].replace(loc + ' | ', ''));
    const first = 'AMA ' + loc;
    const email = 'info+' + slug_(loc) + '-' + slug_(primary) + '@australianmartialarts.com.au';

    if (done[email]) { Logger.log('skip (exists): ' + first + ' ' + primary); return; }

    const r = ghlPost_('/users/', {
