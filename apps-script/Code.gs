  T.sh.getRange(row, T.C['Notes'] + 1).setValue(String(v[T.C['Notes']] || '') + ' | ' + line);
  T.sh.getRange(row, T.C['Updated at'] + 1).setValue(new Date());
  return { ok: true };
}
