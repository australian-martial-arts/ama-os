      status: f.status, by: f.by, log: f.log, tries: tries, reason: f.reason, e164: f.e164, email: f.email,
      light: days >= 21 ? 'red' : days >= 14 ? 'orange' : 'yellow',
      received: f.received ? Utilities.formatDate(f.received, CONFIG.timezone, 'd MMM') : '' };
  });
