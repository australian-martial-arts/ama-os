  payPutRoster_({ id: r.Id, start: r.StartTime, end: newEnd, emp: r.Employee, unit: r.OperationalUnit, brk: payBreakMins_(r), note: (String(r.Comment || '') + (r.Comment ? ' | ' : '') + tag).slice(0, 500), publish: true });
  let tsMsg = 'They have not clocked off yet, so Deputy will pay to the new finish time when they do.';
  if (r.MatchedByTimesheet) {
