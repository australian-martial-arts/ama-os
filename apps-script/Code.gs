// ============================================================ CANCELLATION CARE (24 Oct 2026)
// Runs hourly (cxCareHourly). Family texts only go out between 10am and 6pm; staff alerts between 8am and 8pm.
// 1 Early leaver: cancelling within 3 months of joining -> Mark and Sarah texted to call within 48 hours.
// 2 Notice check-in: ~10 days into the notice, one soft text with the offer that fits their reason.
// 3 Send-off: family texted 2 days before the last class; rostered staff at that school texted on the day.
// 4 Exit survey: the day after the last class, "1 to 5 and one thing we could do better". Replies are read from
//   GHL and saved (Exit rating, Exit feedback); a 1 or 2 is texted to Sarah.
// 5 Win-back: 60 and 180 days after the last class, unless they have rejoined (Enrolments tab).
// 6 Complaint outcome: logged on the Cancellations to action card (hub), shown on the dashboard.
// While CXCARE.on is false nothing goes to families or staff (previewCxCare logs what would go).
const CXCARE = { on: true, // ON 24 Oct 2026 - Mark approved the wording
  checkinDays: 10, sendoffDays: 2, winback: [60, 180], earlyMonths: 3, surveyDays: 14 };

function cxCareOffer_(reason, k) {
  const r = String(reason || '').toLowerCase();
  if (/moved|far/.test(r)) return 'If one of our other schools would be closer, ' + k + ' can switch over and keep their progress.';
  if (/time/.test(r)) return "If a different class day or time would make it easier, we'd be happy to find one that fits.";
  if (/cost|money/.test(r)) return 'If a lighter schedule would help, we can drop to fewer classes a week so it costs less and ' + k + ' keeps their progress.';
  if (/injur|ill/.test(r)) return "If it's about recovering, we can pause with a medical freeze instead, so there's no need to cancel.";
  if (/interest/.test(r)) return 'If you like, we can book a free 10-minute chat with their instructor before class. A quick one-on-one often makes a real difference.';
  if (/going away|travel|holiday/.test(r)) return "If it's time away, we can make up the classes when " + k + ' is back instead.';
  return '';
}
function cxWinbackLead_(reason, k) {
  const r = String(reason || '').toLowerCase();
  if (/moved|far/.test(r)) return 'If one of our five schools is close to you now, ' + k + ' would be very welcome back.';
  if (/time/.test(r)) return 'Our timetable changes through the year, so there may now be a class time that fits.';
  if (/cost|money/.test(r)) return 'We have memberships from one class a week, so it can fit the budget.';
  if (/injur|ill/.test(r)) return 'We hope ' + k + ' is fully recovered.';
  if (/interest/.test(r)) return 'Kids often come back keen after a break, and we would love to see ' + k + ' on the mat again.';
  if (/going away|travel|holiday/.test(r)) return 'We hope you had a great time away.';
  return 'We would love to see ' + k + ' back on the mat.';
}
function cxCareText_(kind, x) {
  const hi = 'Hi ' + (x.first || 'there') + ', ', k = x.kids.text, is = x.kids.plural ? 'are' : 'is';
  if (kind === 'checkin') return hi + 'just a note from AMA ' + x.loc + '. ' + k + ' ' + is + ' welcome in class until ' + x.lastS + '. ' + x.offer + ' No pressure at all, just reply here if that would help.';
  if (kind === 'sendoff') return hi + k + "'s last class at AMA " + x.loc + ' is on ' + x.lastS + ". We'd love to give them a proper send-off, so we hope to see them there.";
  if (kind === 'staff') return 'AMA: ' + k + "'s last class at " + x.loc + ' is today (' + x.holder + ', ' + x.id + '). If you see them, please give them a send-off in front of the class.';
  if (kind === 'survey') return hi + 'thank you for being part of AMA ' + x.loc + '. How would you rate ' + k + "'s time with us, from 1 to 5? And is there one thing we could have done better? Just reply here.";
  if (kind === 'wb60') return hi + "it's AMA " + x.loc + '. ' + cxWinbackLead_(x.reason, k) + ' ' + k + "'s first class back is on us, so just reply here and we'll book it in.";
  if (kind === 'wb180') return hi + "it's been a while since we've seen " + k + ' at AMA ' + x.loc + '. ' + cxWinbackLead_(x.reason, k) + ' Their first class back is on us, so just reply here and we will book it in.';
  if (kind === 'early') return 'AMA early leaver: ' + x.id + ' ' + x.holder + ' (' + x.loc + ', ' + x.students + ') is cancelling after ' + x.months + ' month' + (x.months === 1 ? '' : 's') + '. Reason: ' + x.reason + '. "' + String(x.words || '').slice(0, 160) + '" Please call them in the next 48 hours: ' + x.mobile + '. Taken by ' + x.by + '.';
  if (kind === 'lowrating') return 'AMA exit survey: ' + x.holder + ' (' + x.loc + ', ' + x.id + ') rated their time ' + x.rating + '/5: "' + String(x.feedback || '').slice(0, 220) + '" Worth a call.';
  return '';
}
function cxRejoinedSet_(after) {
  const ss = SpreadsheetApp.openById(HOLD.sheetId), enr = hubRows_(ss, HUBDASH.enrolTab), out = {};
  const cM = enr.head.indexOf('Mobile'), cD = enr.head.indexOf('Enrolled date');
  enr.rows.forEach(function (r) { const d = hubDay_(r[cD]), m = holdLast9_(r[cM]); if (d && m) { if (!out[m] || d > out[m]) out[m] = d; } });
  return out;
}
function cxInbound_(mobile, since) {
  const cid = ghlContactIdByPhone_(normalisePhone_(mobile));
  if (!cid) return null;
  const conv = leadFetchAll_(['/conversations/search?locationId=' + CONFIG.locationId + '&contactId=' + cid])[0];
  const ids = ((conv && conv.conversations) || []).slice(0, 2).map(function (c) { return '/conversations/' + c.id + '/messages?limit=50'; });
  let best = null;
  leadFetchAll_(ids).forEach(function (j) {
    const m = j && j.messages, list = (m && m.messages) || (Array.isArray(m) ? m : []);
    list.forEach(function (x) {
      if (x.direction !== 'inbound' || !x.body) return;
      const d = new Date(x.dateAdded);
      if (d > since && (!best || d < best.d)) best = { d: d, body: String(x.body) };
    });
  });
  return best;
}
// send=false: work out and log only. Returns lines.
function cxCareRun_(send) {
  const sh = cxSheet_(), C = cxCols_(), last = sh.getLastRow(), out = [];
  if (last < 2) return out;
  const tz = CONFIG.timezone, now = new Date(), hour = Number(Utilities.formatDate(now, tz, 'H'));
  const today = hubStartOfDay_(now), DAY = 86400000, t = Utilities.formatDate(today, tz, 'yyyy-MM-dd');
  const familyHours = hour >= 10 && hour < 18, staffHours = hour >= 8 && hour < 20;
  const go = send && CXCARE.on;
  const vals = sh.getRange(2, 1, last - 1, CANCEL.headers.length).getValues();
  let rejoined = null;
  vals.forEach(function (v, i) {
    const row = i + 2, st = String(v[C['Status']] || ''), holder = String(v[C['Account holder']] || '');
    if (!v[C['Request ID']] || /^zz/i.test(holder) || /^saved|withdrawn/i.test(st)) return;
    const sent = String(v[C['Care texts']] || ''), has = function (k) { return new RegExp('\\b' + k + '\\b').test(sent); };
    const lastD = v[C['Last class']] ? hubStartOfDay_(new Date(v[C['Last class']])) : null;
    const kids = holdKids_(v[C['Students']]);
    const x = { id: String(v[C['Request ID']]), holder: holder, first: holder.split(' ')[0], kids: kids, students: v[C['Students']], loc: v[C['Trains at']],
      reason: v[C['Reason']], words: v[C['In their words']], staffNotes: v[C['Staff notes']] || '', mobile: v[C['Mobile']] ? hubPrettyMobile_(v[C['Mobile']]) : '', by: v[C['Taken by']],
      months: v[C['Months a member']] === '' ? null : Number(v[C['Months a member']]), lastS: lastD ? Utilities.formatDate(lastD, tz, 'EEE d MMM') : '' };
    x.offer = cxCareOffer_(x.reason, kids.text);
    const mark = function (k) { const cell = sh.getRange(row, C['Care texts'] + 1); const cur = String(cell.getValue() || ''); cell.setValue((cur ? cur + '; ' : '') + k + ' ' + t); };
    const fire = function (k, to, text, who) {
      let r = 'preview';
      if (go) { try { if (Array.isArray(to)) to.forEach(function (m) { sendSms_(m, text); }); else sendSms_(to, text); r = 'sent'; mark(k); } catch (e) { r = 'failed: ' + e; } }
      out.push(x.id + ' ' + k + ' -> ' + who + ' [' + r + ']: ' + text);
    };
    const going = /notice running|approved early|awaiting|waiting/i.test(st);
    // 1 early leaver
    if (!has('early') && staffHours && x.months !== null && !isNaN(x.months) && x.months < CXCARE.earlyMonths && going)
      fire('early', HOLD.approvers.map(function (a) { return a.mobile; }), cxCareText_('early', x), 'Mark and Sarah');
    if (!lastD || !v[C['Mobile']]) return;
    const signedOrRunning = /notice running|approved early/i.test(st);
    const base = v[C['Signed at']] ? hubStartOfDay_(new Date(v[C['Signed at']])) : (v[C['Notice email received']] ? hubStartOfDay_(new Date(v[C['Notice email received']])) : hubStartOfDay_(new Date(v[C['Logged at']])));
    // 2 check-in
    if (!has('checkin') && familyHours && signedOrRunning && x.offer && !/^yes/i.test(String(v[C['Complaint']] || '')) &&
      today >= new Date(base.getTime() + CXCARE.checkinDays * DAY) && today <= new Date(lastD.getTime() - 3 * DAY))
      fire('checkin', v[C['Mobile']], cxCareText_('checkin', x), 'family');
    // 3 send-off
    if (!has('sendoff') && familyHours && signedOrRunning && today >= new Date(lastD.getTime() - CXCARE.sendoffDays * DAY) && today < lastD)
      fire('sendoff', v[C['Mobile']], cxCareText_('sendoff', x), 'family');
    if (!has('staff') && staffHours && signedOrRunning && today.getTime() === lastD.getTime() && hour >= 9) {
      const staff = tcRecipients_(lastD, String(x.loc)).map(function (p) { return p.phone; });
      if (staff.length) fire('staff', staff, cxCareText_('staff', x), 'rostered staff at ' + x.loc);
    }
    if (today <= lastD) return;
    // 4 exit survey (+ read the reply)
    if (!has('survey') && familyHours && today >= new Date(lastD.getTime() + DAY) && today < new Date(lastD.getTime() + 21 * DAY))
      fire('survey', v[C['Mobile']], cxCareText_('survey', x), 'family');
    const sv = sent.match(/survey (\d{4}-\d{2}-\d{2})/);
    if (sv && !v[C['Exit feedback']] && today <= new Date(tcParseYmd_(sv[1]).getTime() + CXCARE.surveyDays * DAY)) {
      let rep = null; try { rep = cxInbound_(v[C['Mobile']], tcParseYmd_(sv[1])); } catch (e) { out.push(x.id + ' survey read failed: ' + e); }
      if (rep) {
        const m = rep.body.match(/\b([1-5])\b/);
        x.rating = m ? Number(m[1]) : ''; x.feedback = rep.body;
        out.push(x.id + ' survey reply: ' + (x.rating || '?') + ' / ' + rep.body);
        if (send) {
          sh.getRange(row, C['Exit rating'] + 1, 1, 2).setValues([[x.rating, rep.body]]);
          if (x.rating && x.rating <= 2 && CXCARE.on) { try { sendSms_(CANCEL.complaintsTo, cxCareText_('lowrating', x)); } catch (e) { } }
        }
      }
    }
    // 5 win-back (skip complaints and anyone who has rejoined)
    if (/^yes/i.test(String(v[C['Complaint']] || '')) || /unhappy/i.test(String(x.reason))) return;
    if (v[C['Rejoined']]) return;
    rejoined = rejoined || cxRejoinedSet_();
    const rj = rejoined[holdLast9_(v[C['Mobile']])];
    if (rj && rj > lastD) { if (send) sh.getRange(row, C['Rejoined'] + 1).setValue(rj); out.push(x.id + ' rejoined ' + Utilities.formatDate(rj, tz, 'd MMM')); return; }
    CXCARE.winback.forEach(function (n) {
      const k = 'wb' + n;
      if (!has(k) && familyHours && today >= new Date(lastD.getTime() + n * DAY) && today < new Date(lastD.getTime() + (n + 14) * DAY))
        fire(k, v[C['Mobile']], cxCareText_(k, x), 'family');
    });
  });
  return out;
}
