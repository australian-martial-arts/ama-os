// Live status for a trial: from GHL tags, the Enrolments tab and the after-trial check.
const TRIALSTATUS = { recTags: ['in joining chase', 'efc link sent automatically', 'awaiting efc payment', 'online trial booking - pending enrolment'], enrolledTag: 'enrolled' };
function tcStatusCtx_() {
  let fu = {}; try { fu = tcRowsById_(); } catch (e) {}
  return { fu: fu, C: tcCols_(), enrolled: tcEnrolled_() };
}
// 2 Nov 2026 (Mark): in a trial program (2-class offer, School readiness...), only the LAST class gets the after-trial check, recommendation and follow-up.
function progMid_(e) {
  const m = /\(([^()]+) (\d+) of (\d+)\) trial$/i.exec(String((e && e.title) || '').trim());
  if (!m) return '';
  const n = Number(m[2]), N = Number(m[3]);
  return n < N ? 'Program ' + n + ' of ' + N : '';
}
function tcStatus_(ctx, e, contact, isPast) {
  const tags = (contact && contact.tags) || [];
  const row = ctx.fu[e.id], att = row ? String(row.v[ctx.C['Attended']] || '') : '';
  const recFu = row && String(row.v[ctx.C['Recommendation sent']]) === 'Yes';
  const enrolled = tags.indexOf(TRIALSTATUS.enrolledTag) > -1 || !!ctx.enrolled[e.contactId];
  const rec = recFu || TRIALSTATUS.recTags.some(function (t) { return tags.indexOf(t) > -1; });
  if (enrolled) return 'Enrolled';
  if (rec) return 'Rec sent';
  const pm = progMid_(e);
  if (pm) return pm;
  if (att === 'Absent') return 'Absent';
  if (att === 'Attended') return 'Attended';
  if (att === 'Rebooked') return 'Rebooked'; // 13 Nov 2026: was falling through to 'No update'
  return isPast ? 'No update' : '';
}


// ============================================================ CANCELLATION SIGNING (24 Oct 2026)
// After a cancellation is logged, the parent is emailed a link. They check the details on their
// own device, tick to agree, type their name and sign. The signed PDF is saved to Drive and
// emailed to the parent with info@ copied in. While CANCEL.emailParents is false, emails only
// go to the CXSIGN.testEmails addresses.
const CXSIGN = {
  page: 'https://train.australianmartialarts.com.au/membership-sign',
  folderName: 'AMA Cancellation Agreements',
  infoEmail: 'info@australianmartialarts.com.au',
  testEmails: ['mark.loughran@australianmartialarts.com.au'],
  terms: 'Payments come out in advance for your sessions. To cancel, email info@australianmartialarts.com.au giving 30 days\' written notice. If you received a discounted or free uniform or equipment and stop within the first 12 months, the balance of those items is payable on your final payment. (Membership terms v2026.2)'
};

function cxKey_(id) { return hubSign_('cxsign:' + id).slice(0, 32); }
function cxSignUrl_(id) { return CXSIGN.page + '?r=' + encodeURIComponent(id) + '&k=' + encodeURIComponent(cxKey_(id)); }
function cxFmt_(d, f) { return d ? Utilities.formatDate(new Date(d), CONFIG.timezone, f || 'EEEE d MMMM yyyy') : ''; }
function cxEsc_(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

function cxFind_(id) {
  const sh = cxSheet_(), C = cxCols_(), last = sh.getLastRow();
  if (last < 2 || !id) return null;
  const vals = sh.getRange(2, 1, last - 1, CANCEL.headers.length).getValues();
  for (let i = 0; i < vals.length; i++) {
    if (String(vals[i][C['Request ID']]) === String(id)) return { sh: sh, C: C, row: i + 2, v: vals[i] };
  }
  return null;
}

function cxUniformText_(u) {
  u = String(u || '');
  if (/^Applies/i.test(u)) return 'The balance of any discounted or free uniform or equipment will be added to your final payment.';
  if (/^Not sure/i.test(u)) return 'We will check whether a uniform or equipment balance applies and let you know before your final payment.';
  return 'No uniform or equipment balance applies.';
}

// Everything the parent sees and signs.
function cxDetails_(f) {
  const v = f.v, C = f.C, st = String(v[C['Status']] || '');
  const recv = v[C['Notice email received']], ends = v[C['Notice ends']], lastCls = v[C['Last class']];
  const pending = !recv;
  const holder = String(v[C['Account holder']] || '');
  return {
    id: String(v[C['Request ID']]),
    holder: holder,
    first: holder.split(' ')[0],
    students: String(v[C['Students']] || ''),
    location: String(v[C['Trains at']] || ''),
    reason: String(v[C['Reason']] || ''),
    words: String(v[C['In their words']] || ''),
    offered: String(v[C['Offered']] || ''),
    staff: String(v[C['Taken by']] || ''),
    pending: pending,
    noticeFrom: pending ? 'The day you sign' : cxFmt_(recv),
    noticeEnds: pending ? '30 days after the day you sign' : cxFmt_(ends),
    lastClass: pending ? '' : cxFmt_(lastCls || ends),
    uniform: cxUniformText_(v[C['Uniform balance']]),
    terms: CXSIGN.terms,
    signedAt: v[C['Signed at']] ? cxFmt_(v[C['Signed at']], 'EEEE d MMMM yyyy, h:mm a') : '',
    signedName: String(v[C['Signed name']] || ''),
    closed: /^saved|^withdrawn/i.test(st)
  };
}

function cxBadLink_() { return { ok: false, error: 'This link is not valid. Please call us on 02 9569 1943.' }; }

// Public (no staff sign-in): load the agreement for the signing page.
function cxDoc_(b) {
  const f = cxFind_(b.r);
  if (!f || String(b.k || '') !== cxKey_(f.v[f.C['Request ID']])) return cxBadLink_();
  const d = cxDetails_(f);
  if (d.closed) return { ok: false, error: 'This cancellation has been withdrawn, so there is nothing to sign.' };
  return { ok: true, doc: d };
}

// Public (no staff sign-in): the parent signs.
function cxSignRaw_(b) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const f = cxFind_(b.r);
    if (!f || String(b.k || '') !== cxKey_(f.v[f.C['Request ID']])) return cxBadLink_();
    const sh = f.sh, C = f.C, row = f.row;
    let d = cxDetails_(f);
    if (d.closed) return { ok: false, error: 'This cancellation has been withdrawn, so there is nothing to sign.' };
    if (d.signedAt) return { ok: true, already: true, doc: d };
    const name = String(b.name || '').replace(/\s+/g, ' ').trim().slice(0, 80);
    const sig = String(b.sig || '');
    if (!b.agree) return { ok: false, error: 'Please tick the box to agree.' };
    if (name.length < 3) return { ok: false, error: 'Please type your full name.' };
    if (sig.indexOf('data:image/png;base64,') !== 0 || sig.length < 1500 || sig.length > 400000) return { ok: false, error: 'Please sign in the box.' };
    const now = new Date();
    let askEarly = false;
    if (d.pending) {
      // No written notice yet: signing is the notice, so the 30 days start today.
      const recv = hubStartOfDay_(now), ends = new Date(recv.getTime() + CANCEL.noticeDays * 86400000);
      sh.getRange(row, C['Notice given'] + 1).setValue('Signed online');
      sh.getRange(row, C['Notice email received'] + 1).setValue(recv);
      sh.getRange(row, C['Notice ends'] + 1).setValue(ends);
      sh.getRange(row, C['Last class'] + 1).setValue(ends);
      askEarly = String(f.v[C['Short notice']]) === 'asked' && !!f.v[C['Wanted last class']] && new Date(f.v[C['Wanted last class']]) < ends;
      sh.getRange(row, C['Status'] + 1).setValue(askEarly ? 'awaiting approval' : 'notice running');
      try { cxApplyDates_(f.v[C['Request ID']]); } catch (e) { Logger.log('cxApplyDates_ sign ' + e); } // 5 Nov 2026
      if (askEarly) { sh.getRange(row, C['Short notice'] + 1).setValue('yes'); if (cxSelfApprover_(f.v[C['Taken by']])) { try { cxDecide_(row, sh.getRange(row, 1, 1, sh.getLastColumn()).getValues()[0], true, { name: String(f.v[C['Taken by']]) + ' (co-coordinator)' }); } catch (e) { Logger.log('self approve ' + e); cxAskApprovers_(String(f.v[C['Request ID']]), f.v, C, f.v[C['Wanted last class']], ends); } } else cxAskApprovers_(String(f.v[C['Request ID']]), f.v, C, f.v[C['Wanted last class']], ends); }
    }
    sh.getRange(row, C['Signed at'] + 1, 1, 2).setValues([[now, name]]);
    SpreadsheetApp.flush();
    const f2 = cxFind_(b.r);
    d = cxDetails_(f2);
    // The PDF goes to Drive if the script has Drive access, and is always uploaded to the parent's GHL conversation.
    let pdf = null, saved = '';
    try { pdf = cxPdf_(d, sig); } catch (err) { Logger.log('cxSign_ pdf: ' + err); }
    if (pdf) { try { saved = cxFolder_().createFile(pdf).getUrl(); } catch (err) { Logger.log('cxSign_ drive: ' + err); } }
    let emailed = '';
    try { emailed = cxSendSigned_(f2.v, C, d, pdf, function (u) { if (!saved) saved = u; }); } catch (err) { emailed = 'failed - ' + err; Logger.log('cxSign_ email: ' + err); }
    if (saved) sh.getRange(row, C['Agreement PDF'] + 1).setValue(saved);
    sh.getRange(row, C['Parent email'] + 1).setValue('Signed copy: ' + emailed);
    cxNotifyCoordinator_(d, askEarly);
    CacheService.getScriptCache().remove(HUBDASH.cacheKey);
    return { ok: true, doc: d, emailed: /^sent/.test(emailed) };
  } finally {
    lock.releaseLock();
  }
}

function cxFolder_() {
  const p = PropertiesService.getScriptProperties(), id = p.getProperty('CX_FOLDER_ID');
  if (id) { try { return DriveApp.getFolderById(id); } catch (e) {} }
  const folder = DriveApp.createFolder(CXSIGN.folderName); // drive.file scope: only files this script creates
  p.setProperty('CX_FOLDER_ID', folder.getId());
  return folder;
}

function cxPdf_(d, sig) {
  const row = function (k, v) { return v ? '<tr><td class="k">' + cxEsc_(k) + '</td><td>' + cxEsc_(v) + '</td></tr>' : ''; };
  const html = '<html><head><style>' +
    'body{font-family:Arial,Helvetica,sans-serif;color:#111;font-size:11pt;margin:28px}' +
    'h1{font-size:18pt;margin:0 0 4px}.sub{color:#555;margin:0 0 18px}' +
    'table{border-collapse:collapse;width:100%;margin:10px 0}td{border-bottom:1px solid #ddd;padding:7px 6px;vertical-align:top}' +
    'td.k{color:#555;width:34%}.box{border:1px solid #ccc;padding:10px 12px;margin:12px 0;font-size:10pt;color:#333}' +
    '.sig{margin-top:18px}.sig img{height:90px}.line{border-top:1px solid #333;width:260px;padding-top:4px}.small{font-size:9pt;color:#666}' +
    '</style></head><body>' +
    '<h1>Membership cancellation</h1>' +
    '<p class="sub">Australian Martial Arts Academy &middot; Signed confirmation &middot; Ref ' + cxEsc_(d.id) + '</p>' +
    '<table>' +
      row('Account holder', d.holder) + row('Students', d.students) + row('School', d.location) +
      row('Reason', d.reason) + row('What you told us', d.words) +
      row('Options discussed', d.offered ? d.offered + ' (declined)' : '') + row('Spoke with', d.staff) +
      row('Notice starts', d.noticeFrom) + row('Payments continue until', d.noticeEnds) +
      row('Last class', d.lastClass) + row('Uniform or equipment', d.uniform) +
    '</table>' +
    '<div class="box"><b>Membership terms</b><br>' + cxEsc_(d.terms) + '</div>' +
    '<p>I confirm this is my notice to cancel the membership above, and I agree to the dates and terms shown.</p>' +
    '<div class="sig"><img src="' + sig + '"><div class="line">' + cxEsc_(d.signedName) + '</div>' +
    '<span class="small">Signed ' + cxEsc_(d.signedAt) + '</span></div>' +
    '</body></html>';
  return Utilities.newBlob(html, 'text/html', 'agreement.html').getAs('application/pdf')
    .setName('AMA cancellation ' + d.id + ' - ' + d.holder + '.pdf');
}

function cxCanEmail_(email) {
  email = String(email || '').trim().toLowerCase();
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return false;
  return CANCEL.emailParents || CXSIGN.testEmails.indexOf(email) > -1;
}

// One email to a parent through GHL (no MailApp in this project).
function cxGhlEmail_(mobile, email, subject, text, extra) {
  email = String(email || '').trim();
  if (!cxCanEmail_(email)) {
    Logger.log('[parent email off] would email ' + email + ': ' + subject + ' / ' + text.replace(/\n/g, ' / '));
    return 'off - not sent';
  }
  const who = cxContactForEmail_(mobile, email);
  // No GHL contact yet (family never enquired through GHL): create one so the email can go.
  if (!who.id && (normalisePhone_(mobile) || email)) {
    try {
      const up = ghlPost_('/contacts/upsert', { locationId: CONFIG.locationId, phone: normalisePhone_(mobile) || undefined, email: email || undefined, tags: ['cancellation'], source: 'Hub - cancellation' });
      const c = (JSON.parse(up.body) || {}).contact || {};
      if (c.id) { who.id = c.id; who.match = true; } else Logger.log('cx upsert ' + up.code + ': ' + String(up.body).slice(0, 200));
    } catch (e) { Logger.log('cx upsert: ' + e); }
  }
  if (!who.id) return 'not sent - no GHL contact for that mobile or email';
  const contactId = who.id;
  if (!who.match && !CANCEL.emailParents) return 'not sent - that email is not on their GHL contact';
  if (!who.match) email = '';
  const html = text.split('\n').map(function (l) {
    return l ? cxEsc_(l).replace(/(https:\/\/[^\s<]+)/g, '<a href="$1">$1</a>') : '';
  }).join('<br>');
  const payload = { type: 'Email', contactId: contactId, subject: subject, html: html, message: text };
  if (email) payload.emailTo = email;
  if (extra && extra.cc && extra.cc.length) payload.emailCc = extra.cc;
  if (extra && extra.attachments && extra.attachments.length) payload.attachments = extra.attachments;
  let res = UF_.fetch(CONFIG.ghlBase + '/conversations/messages', {
    method: 'post', contentType: 'application/json', muteHttpExceptions: true,
    headers: { 'Authorization': 'Bearer ' + getToken_(), 'Version': CONFIG.ghlVersion },
    payload: JSON.stringify(payload)
  });
  let ok = res.getResponseCode() >= 200 && res.getResponseCode() < 300;
  // GHL compares emailTo exactly (e.g. capital letters). When the contact was matched on this email, send to its own email instead.
  if (!ok && who.match && /not under contact/i.test(res.getContentText())) {
    delete payload.emailTo;
    res = UF_.fetch(CONFIG.ghlBase + '/conversations/messages', { method: 'post', contentType: 'application/json', muteHttpExceptions: true,
      headers: { 'Authorization': 'Bearer ' + getToken_(), 'Version': CONFIG.ghlVersion }, payload: JSON.stringify(payload) });
    ok = res.getResponseCode() >= 200 && res.getResponseCode() < 300;
  }
  if (!ok) Logger.log('Parent email failed: ' + res.getResponseCode() + ' ' + res.getContentText().slice(0, 300));
  return ok ? 'sent ' + Utilities.formatDate(new Date(), CONFIG.timezone, 'd MMM h:mm a') : 'failed - GHL ' + res.getResponseCode() + ' ' + res.getContentText().replace(/\s+/g, ' ').slice(0, 160);
}

// GHL only emails an address that is on the contact. Find the contact for this parent:
// 1) the contact with their mobile, if that email is already on it (or it has no email yet - then add it);
// 2) otherwise a contact that has this email;
// 3) otherwise the mobile contact, sent to whatever email GHL already has for them (match: false).
function cxContactForEmail_(mobile, email) {
  const want = String(email || '').trim().toLowerCase();
  const pid = ghlContactIdByPhone_(normalisePhone_(mobile));
  if (pid && want) {
    let c = {};
    try { c = (ghlFetch_('/contacts/' + pid) || {}).contact || {}; } catch (e) {}
    const have = [c.email].concat((c.additionalEmails || []).map(function (x) { return x && x.email ? x.email : x; }))
      .filter(Boolean).map(function (x) { return String(x).toLowerCase(); });
    if (have.indexOf(want) > -1) return { id: pid, match: true };
    if (!c.email) {
      const r = UF_.fetch(CONFIG.ghlBase + '/contacts/' + pid, { method: 'put', contentType: 'application/json', muteHttpExceptions: true,
        headers: { 'Authorization': 'Bearer ' + getToken_(), 'Version': CONFIG.ghlVersion }, payload: JSON.stringify({ email: email }) });
      if (r.getResponseCode() < 300) return { id: pid, match: true };
    }
  }
  if (want) {
    try {
      const s = ghlFetch_('/contacts/', { locationId: CONFIG.locationId, query: want, limit: 10 }) || {};
      const hit = (s.contacts || []).filter(function (x) { return String(x.email || '').toLowerCase() === want; })[0];
      if (hit) return { id: hit.id, match: true };
    } catch (e) { Logger.log('cxContactForEmail_ search: ' + e); }
  }
  return { id: pid || '', match: false };
}

// Upload the PDF to the contact's GHL conversation so it goes as a real attachment.
function cxGhlUpload_(contactId, blob) {
  const conv = ghlFetch_('/conversations/search', { locationId: CONFIG.locationId, contactId: contactId });
  const list = (conv && conv.conversations) || [];
  if (!list.length) return '';
  const res = UF_.fetch(CONFIG.ghlBase + '/conversations/messages/upload', {
    method: 'post', muteHttpExceptions: true,
    headers: { 'Authorization': 'Bearer ' + getToken_(), 'Version': CONFIG.ghlVersion },
    payload: { conversationId: list[0].id, locationId: CONFIG.locationId, fileAttachment: blob }
  });
  if (res.getResponseCode() >= 300) { Logger.log('PDF upload failed: ' + res.getResponseCode() + ' ' + res.getContentText().slice(0, 300)); return ''; }
  const files = (JSON.parse(res.getContentText()) || {}).uploadedFiles || {};
  const k = Object.keys(files)[0];
  return k ? files[k] : '';
}

