      by: v[C['Taken by']], signed: v[C['Signed at']] ? holdYmdText_(v[C['Signed at']]) : '', pdf: String(v[C['Agreement PDF']] || ''), linkSent: String(v[C['Sign link sent']] || ''), email: String(v[C['Email']] || ''), approvedBy: v[C['Approved by']], outside: String(v[C['Meets terms']]) === 'no', ext: String(v[C['Extends']] || ''), endYmd: feD ? Utilities.formatDate(feD, CONFIG.timezone, 'yyyy-MM-dd') : '', canExtend: /^approved|^auto/i.test(st) && !String(v[C['Extended by']] || '') && !!feD && hubStartOfDay_(feD) >= today,
