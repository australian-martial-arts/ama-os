// Hub: the follow-up list for Mark and Mady.
function tcFollowUps_() {
  const sh = tcSheet_(), last = sh.getLastRow(), C = tcCols_();
  const today = hubStartOfDay_(new Date()), enrolled = tcEnrolled_();
  const items = [], reported = {}, stageBy = {}, enrNames = {}, enrMobs = {};
  try { chaseOpps_().forEach(function (o) { stageBy[o.cid] = o.stage; }); } catch (e) { Logger.log('tcFollowUps_ GHL: ' + e); }
  try { const en = hubRows_(SpreadsheetApp.openById(HOLD.sheetId), HUBDASH.enrolTab), nI = en.head.indexOf('Student name'), mI = en.head.indexOf('Mobile');
    en.rows.forEach(function (r) { const n = String(r[nI] || '').toLowerCase().replace(/\s+/g, ' ').trim(); if (n) enrNames[n] = 1; const m = String(r[mI] || '').replace(/\D/g, '').slice(-9); if (m.length === 9) enrMobs[m] = 1; }); } catch (e) { }
  if (last >= 2) {
    const v = sh.getRange(2, 1, last - 1, TRIALCHECK.headers.length).getValues();
    v.forEach(function (r, i) {
      reported[String(r[C['Event ID']])] = true;
      if (hubIsTest_(r[C['Parent']]) || hubIsTest_(r[C['Child']])) return;
      const fu = String(r[C['Follow-up']] || ''), next = hubDay_(r[C['Next follow-up']]);
      const open = !fu || (next && next <= today && /call again|no answer/i.test(fu));
      if (!open) return;
      const cid = String(r[C['Contact ID']] || '');
      if (enrolled[cid]) { sh.getRange(i + 2, C['Follow-up'] + 1, 1, 4).setValues([['Enrolled', '', 'auto', new Date()]]); return; }
      const st = stageBy[cid] || '';
      if (/^recommendation sent/i.test(st)) { sh.getRange(i + 2, C['Follow-up'] + 1, 1, 4).setValues([['Recommendation sent', '', 'auto (now on Close the sale)', new Date()]]); return; }
      if (st && !/dnd|stop|contact list|nrn/i.test(st)) { sh.getRange(i + 2, C['Follow-up'] + 1, 1, 4).setValues([['Enrolled', '', 'auto (GHL: ' + st + ')', new Date()]]); return; }
      const kids = String(r[C['Child']] || '').toLowerCase().split(/\s*(?:&|,| and )\s*/).map(function (s) { return s.replace(/\s+/g, ' ').trim(); }).filter(Boolean);
      const maybe = kids.some(function (k) { return enrNames[k]; }) ? 'This name is already on the Enrolments sheet' : enrMobs[String(r[C['Mobile']] || '').replace(/\D/g, '').slice(-9)] ? 'This family already has an enrolment (same mobile)' : '';
      const td = tcParseYmd_(String(r[C['Trial date']])) || hubDay_(r[C['Trial date']]);
      items.push({
        id: String(r[C['Event ID']]), kind: r[C['Attended']] === 'Absent' ? 'rebook' : r[C['Attended']] === 'Rebooked' ? 'rebooked' : 'attended',
        loc: r[C['Location']], child: r[C['Child']], parent: r[C['Parent']], mobile: String(r[C['Mobile']] || ''),
        cls: r[C['Class']], trialDate: td ? Utilities.formatDate(td, CONFIG.timezone, 'EEE d MMM') : String(r[C['Trial date']]),
        days: td ? Math.round((today - hubStartOfDay_(td)) / 86400000) : null,
        rec: r[C['Recommendation sent']], notes: r[C['Notes']], by: r[C['Reported by']],
        last: fu ? fu + (r[C['Follow-up note']] ? ' - ' + r[C['Follow-up note']] : '') : '',
        num: td ? tcTrialLabel_(cid, tcYmd_(td)) : '', maybe: maybe
      });
    });
  }
  items.sort(function (a, b) { return (b.days || 0) - (a.days || 0); });

  // Trials in the last few days (not today) with no report yet, and not already enrolled or rec sent.
  const missing = [], sctx = tcStatusCtx_();
  try {
    const groups = ghlGroups_();
    const from = new Date(today.getTime() - TRIALCHECK.missingLookbackDays * 86400000);
    HUBDASH.locations.forEach(function (loc) {
      if (!CONFIG.locations[loc]) return;
      const byDay = {};
      eventsForLocation_(loc, groups, from, today).forEach(function (e) {
        const t = new Date(e.startTime);
        if (t < from || t >= today || reported[e.id]) return;
        if (tcStatus_({ fu: {}, C: C, enrolled: sctx.enrolled }, { id: e.id, contactId: e.contactId }, ghlContact_(e.contactId), false)) return;
        const k = tcYmd_(new Date(e.startTime));
        byDay[k] = (byDay[k] || 0) + 1;
      });
      Object.keys(byDay).sort().forEach(function (k) {
        missing.push({ loc: loc, date: k, dayText: Utilities.formatDate(tcParseYmd_(k), CONFIG.timezone, 'EEE d MMM'), count: byDay[k] });
      });
    });
  } catch (err) { Logger.log('tcFollowUps_ missing: ' + err); }

  return { ok: true, items: items, missing: missing };
}

// Hub: record a follow-up outcome.
function tcDone_(b, who) {
  const outcomes = ['Enrolled', 'Already a member', 'Recommendation sent', 'Booked another trial', 'Call again', 'No answer - left message', 'Not interested', 'Contact list - not right now'];
  if (outcomes.indexOf(b.outcome) < 0) return { ok: false, error: 'Choose an outcome' };
  const have = tcRowsById_()[b.id];
  if (!have) return { ok: false, error: 'Not found' };
  const C = tcCols_(), sh = tcSheet_();
  /* 3 Nov 2026: Call again can say when (b.retry = days, or a yyyy-mm-dd date). Otherwise the usual TRIALCHECK.retryDays. */
  let retry = /call again|no answer/i.test(b.outcome) ? new Date(hubStartOfDay_(new Date()).getTime() + TRIALCHECK.retryDays * 86400000) : '';
  if (retry && /call again/i.test(b.outcome) && b.retry) {
    const r = String(b.retry).trim();
    if (/^\d{4}-\d{2}-\d{2}$/.test(r)) { const d = tcParseYmd_(r); if (d && d.getTime() > Date.now() - 86400000 && d.getTime() < Date.now() + 400 * 86400000) retry = hubStartOfDay_(d); }
    else if (/^\d{1,3}$/.test(r) && +r >= 1 && +r <= 365) retry = new Date(hubStartOfDay_(new Date()).getTime() + (+r) * 86400000);
  }
  sh.getRange(have.row, C['Follow-up'] + 1, 1, 5).setValues([[b.outcome, retry, who.name, new Date(), String(b.note || '').slice(0, 500)]]);
  // 2 Nov 2026 (Mark): "Contact list - not right now" also moves the family to the Contact list / NRN stage in GHL.
  if (/contact list/i.test(b.outcome)) {
    try {
      const cid = String(sh.getRange(have.row, C['Contact ID'] + 1).getValue() || '');
      const opp = cid ? chaseOpps_().filter(function (o) { return o.cid === cid; })[0] : null;
      if (!opp) return { ok: true, warn: 'Saved. No open GHL card was found to move.' };
      chaseMoveOpp_(opp.id, CHASE.lostStage);
    } catch (e) { return { ok: true, warn: 'Saved, but the GHL card did not move: ' + String(e.message).slice(0, 80) }; }
  }
  return { ok: true };
}

// ---- The after-trial text --------------------------------------------
function tcMessage_(loc, n, date) {
  return 'AMA ' + loc + ': thanks for running today\'s trials. Please fill in the after-trial check for the ' + n +
    (n === 1 ? ' trial' : ' trials') + ' (attended or absent, plus any notes). Takes 2 minutes: ' +
    TRIALCHECK.hubUrl + '#check/' + encodeURIComponent(loc) + '/' + date;
}

function tcPlan_(now) {
  const plan = [], rows = rosterRows_(now), date = tcYmd_(now), props = PropertiesService.getScriptProperties();
  const groups = ghlGroups_(), start = hubStartOfDay_(now), end = new Date(start.getTime() + 86400000);
  HUBDASH.locations.forEach(function (loc) {
    if (!CONFIG.locations[loc]) return;
    const all = eventsForLocation_(loc, groups, start, end).filter(function (x) { const t = new Date(x.startTime); return t >= start && t < end; });
    if (!all.length) return;
    // Only text about trials we still have no update for (not enrolled, no recommendation, no check saved).
    const sctx = tcStatusCtx_();
    const ev = all.filter(function (x) { return !tcStatus_(sctx, x, ghlContact_(x.contactId), false); });
    if (!ev.length) { plan.push({ loc: loc, n: 0, lastStart: 0, dueAt: 0, to: [], text: '', sent: true, allDone: all.length }); return; }
    const starts = all.map(function (x) { return new Date(x.startTime).getTime(); });
    const ends = all.map(function (x, i) { const f = x.endTime ? new Date(x.endTime).getTime() : NaN; return (isNaN(f) || f < starts[i]) ? starts[i] + 45 * 60000 : f; });
    const lastStart = Math.max.apply(null, starts), lastEnd = Math.max.apply(null, ends);
    const to = tcRecipients_(now, loc); // set list per day/school (TRIALCHECK_TO)
    const fixedAt = tcFixedAt_(now, loc);
    plan.push({ loc: loc, n: ev.length, lastStart: lastStart, dueAt: fixedAt || (lastEnd + TRIALCHECK.minutesAfterLastTrial * 60000), to: to,
      text: tcMessage_(loc, ev.length, date), sent: !!props.getProperty('tc_sent_' + loc + '_' + date) });
  });
  return plan;
}

// Run from the editor: shows exactly what would be sent today. Sends nothing.
function previewTrialChecks() {
  const now = new Date();
  tcPlan_(now).forEach(function (p) {
    Logger.log(p.loc + ' | ' + p.n + ' trials | sends at ' + Utilities.formatDate(new Date(p.dueAt), CONFIG.timezone, 'h:mm a') +
      ' | last trial starts ' + Utilities.formatDate(new Date(p.lastStart), CONFIG.timezone, 'h:mm a') + ' | to: ' + (p.to.map(function (r) { return r.name; }).join(', ') || 'NOBODY ROSTERED') + (p.sent ? ' | already sent' : ''));
    Logger.log('   "' + p.text + '"');
  });
}

// Time-driven (every 15 minutes once switched on). Sends each location's text once a day.
function sendTrialChecks() {
  const now = new Date();
  if (now.getHours() >= TRIALCHECK.latestSendHour || now.getHours() < 9) return;
  const props = PropertiesService.getScriptProperties();
  tcPlan_(now).forEach(function (p) {
    if (p.sent || now.getTime() < p.dueAt || !p.to.length) return;
    if (!TRIALCHECK.sendSms) { Logger.log('[sendSms off] would text ' + p.loc + ': ' + p.to.map(function (r) { return r.name; }).join(', ')); return; }
    p.to.forEach(function (r) { sendSms_(r.phone, p.text); });
    props.setProperty('tc_sent_' + p.loc + '_' + tcYmd_(now), String(Date.now()));
    Logger.log('Trial check sent for ' + p.loc + ' to ' + p.to.map(function (r) { return r.name; }).join(', '));
  });
}



