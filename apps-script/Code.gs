    if (!when || isNaN(when) || when.getTime() < cut) return;
    out.push({ id: v[C['Request ID']], holder: v[C['Account holder']], students: v[C['Students']], loc: v[C['Trains at']],
      outcome: stayed ? (/withdrawn/i.test(st) ? 'Stayed (withdrew notice)' : 'Stayed: ' + st.replace(/^saved - /i, '')) : 'Done in EFC',
      by: stayed ? String(v[C['Taken by']] || '') : String(v[C['EFC actioned by']] || ''),
      when: cxDateText_(when), t: when.getTime(), lastClass: v[C['Last class']] ? cxDateText_(new Date(v[C['Last class']])) : '' });
  });
  out.sort(function (a, b) { return b.t - a.t; });
  return { ok: true, items: out.slice(0, 80), canApprove: can };
}


