/* ===== VIDEO MESSAGES (6 Nov 2026) =====
   Staff record a short clip in the hub (absentee and Close the sale cards). The clip goes to a Drive folder in 4 MB pieces,
   the family gets a normal text from the GHL number with a link to train.australianmartialarts.com.au/video-message?v=<token>,
   and that page shows the clip. The card shows when the link was opened. */
const VID = {
  tab: 'Video messages',
  headers: ['Token', 'Created', 'By', 'Type', 'Ref', 'Family', 'Mobile', 'File id', 'Size MB', 'Sent at', 'Text', 'First opened', 'Opens', 'School', 'Students'],
  folder: 'AMA video messages',
  page: 'https://train.australianmartialarts.com.au/video-message',
  maxMb: 60,
  chunk: 4 * 1024 * 1024
};
// Signed-in staff (instructors too). Routed before actLog_ so upload pieces don't fill the activity log; vidSend_ logs the send itself.
function vidRoute_(b, who) {
  if (b.kind === 'vidstart') return vidStart_(who, b);
  if (b.kind === 'vidchunk') return vidChunk_(who, b);
  if (b.kind === 'vidsend') return vidSend_(who, b);
  if (b.kind === 'vidstatus') return vidStatus_(who, b);
  return { ok: false, error: 'unknown' };
}
function vidSheet_() { return stockSheetOf_(VID.tab, VID.headers); }
function vidFolder_() {
  const p = PropertiesService.getScriptProperties(); const id = p.getProperty('VID_FOLDER');
  if (id) { try { return DriveApp.getFolderById(id); } catch (e) {} }
  const f = DriveApp.createFolder(VID.folder); p.setProperty('VID_FOLDER', f.getId()); return f;
}
function vidFind_(tok) {
  const sh = vidSheet_(); const n = sh.getLastRow(); if (n < 2 || !tok) return null;
  const v = sh.getRange(2, 1, n - 1, VID.headers.length).getValues();
  for (let i = v.length - 1; i >= 0; i--) if (String(v[i][0]) === String(tok)) return { sh: sh, r: i + 2, v: v[i] };
  return null;
}
function vidStart_(who, b) {
  const size = Number(b.size) || 0; const type = String(b.type || 'video/mp4').slice(0, 60) || 'video/mp4';
  if (!/^video\//.test(type)) return { ok: false, error: 'That file is not a video.' };
  if (!size) return { ok: false, error: 'The video is empty. Please record it again.' };
  if (size > VID.maxMb * 1024 * 1024) return { ok: false, error: 'That video is too long to send. Keep it under about 90 seconds.' };
  const tok = Utilities.getUuid().replace(/-/g, '').slice(0, 12);
  const ext = (type.split('/')[1] || 'mp4').replace('quicktime', 'mov').replace(/[^a-z0-9]/gi, '').slice(0, 5) || 'mp4';
  const name = Utilities.formatDate(new Date(), 'Australia/Sydney', 'yyyy-MM-dd HHmm') + ' ' + String(b.family || 'family').replace(/[^\w ,'&-]/g, '').slice(0, 40) + ' (' + who.name + ').' + ext;
  const res = UF_.fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable&supportsAllDrives=true', {
    method: 'post', contentType: 'application/json; charset=UTF-8', muteHttpExceptions: true,
    headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken(), 'X-Upload-Content-Type': type, 'X-Upload-Content-Length': String(size) },
    payload: JSON.stringify({ name: name, parents: [vidFolder_().getId()], mimeType: type })
  });
  const h = res.getAllHeaders(); const loc = h['Location'] || h['location'];
  if (res.getResponseCode() !== 200 || !loc) { Logger.log('vidStart ' + res.getResponseCode() + ' ' + res.getContentText().slice(0, 300)); return { ok: false, error: 'Could not start the upload. Please try again.' }; }
  const u = { url: String(loc), size: size, done: 0, type: type, by: who.name, kind: String(b.vtype || '').slice(0, 20), ref: String(b.ref || '').slice(0, 80),
    family: String(b.family || '').slice(0, 80), mobile: String(b.mobile || '').slice(0, 30), school: String(b.school || '').slice(0, 40), students: String(b.students || '').slice(0, 200) };
  CacheService.getScriptCache().put('vidup_' + tok, JSON.stringify(u), 21600);
  return { ok: true, v: tok, chunk: VID.chunk };
}
function vidChunk_(who, b) {
  const c = CacheService.getScriptCache(); const key = 'vidup_' + b.v; const raw = c.get(key);
  if (!raw) return { ok: false, error: 'The upload timed out. Please try again.' };
  const u = JSON.parse(raw); const at = Number(b.at) || 0;
  if (u.fileId) return { ok: true, done: u.size, v: b.v, link: VID.page + '?v=' + b.v };
  if (at < u.done) return { ok: true, done: u.done };            // a retry of a piece we already have
  if (at > u.done) return { ok: false, error: 'Upload out of order. Please try again.', done: u.done };
  const bytes = Utilities.base64Decode(String(b.data || ''));
  if (!bytes.length) return { ok: false, error: 'Empty piece' };
  const end = at + bytes.length - 1;
  const res = UF_.fetch(u.url, { method: 'put', muteHttpExceptions: true, contentType: u.type, payload: bytes, headers: { 'Content-Range': 'bytes ' + at + '-' + end + '/' + u.size } });
  const code = res.getResponseCode();
  if (code === 308) {
    const h = res.getAllHeaders(); const rg = String(h['Range'] || h['range'] || '');
    u.done = rg ? Number(rg.split('-')[1]) + 1 : at + bytes.length;
    c.put(key, JSON.stringify(u), 21600);
    return { ok: true, done: u.done };
  }
  if (code === 200 || code === 201) {
    const j = JSON.parse(res.getContentText()); u.fileId = j.id; u.done = u.size;
    try { DriveApp.getFileById(j.id).setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); }
    catch (e) { Logger.log('vid share ' + e); return { ok: false, error: 'The video uploaded but could not be shared. Tell Mark (Drive sharing is blocked).' }; }
    vidSheet_().appendRow([b.v, new Date(), u.by, u.kind, u.ref, u.family, u.mobile, j.id, Math.round(u.size / 104857.6) / 10, '', '', '', 0, u.school, u.students]);
    c.put(key, JSON.stringify(u), 21600);
    return { ok: true, done: u.size, v: b.v, link: VID.page + '?v=' + b.v };
  }
  Logger.log('vidChunk ' + code + ' ' + res.getContentText().slice(0, 300));
  return { ok: false, error: 'The upload stopped (' + code + '). Please try again.' };
}
function vidSend_(who, b) {
  const f = vidFind_(b.v); if (!f) return { ok: false, error: 'Video not found. Please record it again.' };
  if (f.v[9]) return { ok: false, error: 'This video was already sent.' };
  const link = VID.page + '?v=' + b.v;
  let text = String(b.text || '').trim(); if (!text) return { ok: false, error: 'Write the text first.' };
  if (text.indexOf(link) < 0) text += ' ' + link;
  const mob = String(b.mobile || f.v[6] || ''); const e164 = normalisePhone_(mob);
  if (!e164) return { ok: false, error: 'No valid mobile for this family.' };
  const sent = sendSms_(e164, text);
  if (!sent) return { ok: false, error: 'The text did not send. Check the family has this mobile in GHL.' };
  f.sh.getRange(f.r, 7).setValue(mob); f.sh.getRange(f.r, 10, 1, 2).setValues([[new Date(), text]]);
  try { actRow_(who.name, 'Video message', 'Sent a video message', String(f.v[5] || ''), String(f.v[3] || '') + ' ' + String(f.v[4] || '')); } catch (e) {}
  return { ok: true, sentAt: Utilities.formatDate(new Date(), 'Australia/Sydney', 'EEE d MMM h:mma') };
}
function vidStatus_(who, b) {
  const sh = vidSheet_(); const n = sh.getLastRow(); if (n < 2) return { ok: true, items: [] };
  const from = Math.max(2, n - 400); const v = sh.getRange(from, 1, n - from + 1, 13).getValues();
  const tz = 'Australia/Sydney'; const items = [];
  v.forEach(function (r) {
    if (!r[9] || !r[4]) return;
    items.push({ ref: String(r[4]), by: String(r[2]), sent: Utilities.formatDate(new Date(r[9]), tz, 'EEE d MMM h:mma'),
      opened: r[11] ? Utilities.formatDate(new Date(r[11]), tz, 'EEE d MMM h:mma') : '', opens: Number(r[12]) || 0 });
  });
  return { ok: true, items: items };
}
// Public: the family's video page asks for the clip. Opening the page is counted (staff see "Opened").
function vidData_(b) {
  const tok = String(b.v || '').replace(/[^a-f0-9]/g, '').slice(0, 12); if (tok.length < 12) return { ok: false, error: 'This link is not complete.' };
  const f = vidFind_(tok); if (!f || !f.v[7]) return { ok: false, error: 'This video is no longer available.' };
  if (!b.peek && f.v[9]) { try { if (!f.v[11]) f.sh.getRange(f.r, 12).setValue(new Date()); f.sh.getRange(f.r, 13).setValue((Number(f.v[12]) || 0) + 1); } catch (e) {} }
  const fam = String(f.v[5] || '').split(/[ ,&]/)[0];
  return { ok: true, file: String(f.v[7]), from: String(f.v[2] || '').split(' ')[0], name: fam, school: String(f.v[13] || '') };
}
