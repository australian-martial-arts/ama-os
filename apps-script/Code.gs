// Texts the staff member; returns true if sent. Skips them if they are the one who just decided.
function staffTell_(name, text, deciderMobile) {
  const m = hubStaffMobile_(name);
  if (!m || (deciderMobile && holdLast9_(m) === holdLast9_(deciderMobile))) return false;
