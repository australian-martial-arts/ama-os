  else if (act === 'noanswer') logText = (stage ? stage.t : 'Call') + ': no answer, left a message';
  else if (act === 'back2') logText = 'Second class confirmed';
  else if (act === 'notback') logText = 'No second class yet: called';
  else if (act === 'concern') { if (!note) return { ok: false, error: 'Write what the concern is first.' }; status = 'Concern'; logText = 'Concern raised'; }
  else if (act === 'resolved') { status = ''; logText = 'Concern resolved'; }
  else if (act === 'remove') { status = 'Removed'; logText = 'Removed from the list: not a member (cancelled or never joined)'; }
  else return { ok: false, error: 'Unknown action' };
  if (stage && ['done', 'noanswer', 'back2', 'notback', 'concern'].indexOf(act) > -1 && done.indexOf(stage.k) < 0) done.push(stage.k);
  const line = Utilities.formatDate(new Date(), CONFIG.timezone, 'd MMM') + ' ' + who.name + ': ' + logText + (note ? ' - ' + note : '');
  T.sh.getRange(row, T.C['Done'] + 1).setValue(done.join(','));
  if (status !== null) T.sh.getRange(row, T.C['Status'] + 1).setValue(status);
