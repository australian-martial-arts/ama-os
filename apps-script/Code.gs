/* ---------- slots ---------- */
/* Open slots families can book. One open slot per school/day at most: the next one after the filled ones. */
function partySlots_(opt) {
  opt = opt || {};
  const rows = partyRows_().filter(partyLive_), av = partyAvailMap_(), staff = partyStaff_();
  const from = partyYmd_(new Date(Date.now() + (opt.all ? 0 : PARTY.minLeadDays) * 864e5));
  const out = [];
  partySessions_(from, PARTY.horizonDays - (opt.all ? 0 : PARTY.minLeadDays)).forEach(function (s) {
    if (opt.school && opt.school !== s.school) return;
    const yes = staff.filter(function (st) { return st.schools.indexOf(s.school) > -1 && ((av[s.date + '|' + s.school + '|' + s.period] || {})[st.id] === true); });
    const hosts = yes.filter(function (st) { return st.host; }).length;
    const booked = rows.filter(function (p) { return partyCell_(p.Date) === s.date && p.School === s.school; }).sort(function (a, b) { return partyMin_(partyHm_(a.Start)) - partyMin_(partyHm_(b.Start)); });
    let t = partyMin_(s.cfg.first), n = 0;
    const chain = [];
    booked.forEach(function (p) { chain.push({ start: partyHm_(p.Start), end: partyHm_(p.End), party: p.Id, stage: p.Stage, child: p.Child }); t = Math.max(t, partyMin_(partyHm_(p.End)) + PARTY.gapMins); n++; });
    const latest = partyMin_(s.cfg.latest), staffed = !PARTY.requireStaff || (yes.length >= 2 && hosts >= 1);
    const next = n < s.cfg.max && t + PARTY.pkg.mins <= latest ? { start: partyHmOf_(t), end: partyHmOf_(t + PARTY.pkg.mins), longOk: t + PARTY.pkg.mins + 30 <= latest } : null;
    out.push({ date: s.date, label: partyDayNice_(s.date), school: s.school, period: s.period, staff: yes.map(function (x) { return payFirst_(x.name); }), staffCount: yes.length, bigOk: yes.length >= 3, staffed: staffed, filled: chain, next: next, bookable: !!(next && staffed) });
  });
