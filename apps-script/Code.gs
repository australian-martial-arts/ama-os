/* ~~~~~ 23 Nov 2026 (Mark): SHOP LIST FOLLOWS THE WEBSITE. The website shop (WooCommerce) is the master: products and sizes
   added there appear in Shop and stock, ones removed there are hidden here (their counts are kept), and when a price is
   changed on the website the hub's price follows. The website still had the old prices on 23 Nov, so the first run only
   records each website price as a starting point and keeps the hub's new price-list prices; any later website change wins.
   Belts are hub-only (not sold on the website) and are never touched. Read only: nothing is written to the website. ~~~~~ */
const SHOPWEB = { api: 'https://australianmartialarts.com.au/wp-json/wc/store/v1/products', every: 60, cols: ['Web ID', 'Web price'] };
function shopWebDecode_(s) { return String(s || '').replace(/&#0?38;|&amp;/g, '&').replace(/&#8211;|&ndash;/g, '-').replace(/&#039;|&#8217;/g, "'").replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim().replace(/\.$/, ''); }
function shopWebCat_(name, cats) {
  const t = (name + ' ' + cats).toLowerCase();
  if (/uniform/.test(t)) return 'Uniforms'; if (/shirt|hoodie|hat|headband|clothing/.test(t)) return 'T-shirts and hoodies';
  if (/bag|backpack/.test(t)) return 'Bags'; return 'Equipment';
}
function shopWebNewPrice_(name, web) { // 23 Nov 2026 price list for items the website has not caught up with yet
  const n = name.toLowerCase();
  const L = [[/uniform/, 130], [/t[- ]?shirt/, 40], [/hoodie/, 70], [/string bag/, 20], [/^ama backpack/, 45], [/gloves/, 39], [/sword/, 70], [/kick pad/, 45]];
  for (let i = 0; i < L.length; i++) if (L[i][0].test(n) && !/anniversary/.test(n)) return L[i][1];
  return web;
}
function shopWebFetch_() {
  let all = [];
  for (let page = 1; page <= 5; page++) {
    const r = UF_.fetch(SHOPWEB.api + '?per_page=100&page=' + page, { muteHttpExceptions: true });
    if (r.getResponseCode() !== 200) throw new Error('website ' + r.getResponseCode());
    const j = JSON.parse(r.getContentText()); all = all.concat(j); if (j.length < 100) break;
  }
  const out = [], need = [];
  all.forEach(function (p) {
    const name = shopWebDecode_(p.name).replace(/\s*\([^)]*size[^)]*\)/ig, '').replace(/\s+size\s+\S+$/i, '').trim(), cats = (p.categories || []).map(function (c) { return shopWebDecode_(c.name); }).join(' '), base = Number(p.prices && p.prices.price) / Math.pow(10, (p.prices && p.prices.currency_minor_unit) || 2);
    if (!p.variations || !p.variations.length) { out.push({ id: String(p.id), item: name, opt: '', price: base, cat: shopWebCat_(name, cats) }); return; }
    const terms = {}; (p.attributes || []).forEach(function (a) { (a.terms || []).forEach(function (t) { terms[a.name + '|' + t.slug] = t.name; }); });
    p.variations.forEach(function (v) {
      const opt = (v.attributes || []).map(function (a) { return terms[a.name + '|' + a.value] || a.value; }).join(' / ');
      const o = { id: String(v.id), item: name, opt: shopWebDecode_(opt).replace(/^(Kids|Adults)\s*-\s*/i, '$1 '), price: base, cat: shopWebCat_(name, cats) }; out.push(o); need.push(o);
    });
  });
  for (let i = 0; i < need.length; i += 40) {
    const chunk = need.slice(i, i + 40), res = UF_.fetchAll(chunk.map(function (o) { return { url: SHOPWEB.api + '/' + o.id, muteHttpExceptions: true }; }));
    res.forEach(function (r, k) { try { if (r.getResponseCode() === 200) { const j = JSON.parse(r.getContentText()); const pr = Number(j.prices && j.prices.price) / Math.pow(10, (j.prices && j.prices.currency_minor_unit) || 2); if (pr > 0) chunk[k].price = pr; } } catch (e) { } });
  }
  return out;
}
function shopWebNorm_(s) { return String(s || '').toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, ''); }
function shopWebSync_(dry) {
  const web = shopWebFetch_(); if (!web.length) return { ok: false, error: 'The website returned no products.' };
  const sh = stockSheet_(); let head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(String);
  if (!dry) SHOPWEB.cols.forEach(function (c) { if (head.indexOf(c) < 0) { sh.getRange(1, head.length + 1).setValue(c).setFontWeight('bold'); head.push(c); } });
  const H = {}; head.forEach(function (h, i) { H[h] = i + 1; });
  const last = sh.getLastRow(), vals = last > 1 ? sh.getRange(2, 1, last - 1, head.length).getValues() : [];
  const rows = vals.map(function (r, i) { const o = { row: i + 2 }; head.forEach(function (h, j) { o[h] = r[j]; }); return o; });
  const byWeb = {}, byName = {}; rows.forEach(function (r) { if (r['Web ID']) byWeb[String(r['Web ID'])] = r; byName[shopWebNorm_(r.Item) + '|' + shopWebNorm_(r.Option)] = byName[shopWebNorm_(r.Item) + '|' + shopWebNorm_(r.Option)] || r; });
  const used = {}, log = { matched: 0, added: [], priced: [], hidden: [], kept: [] }, adds = [];
  web.forEach(function (w) {
    let r = byWeb[w.id] || byName[shopWebNorm_(w.item) + '|' + shopWebNorm_(w.opt)];
    if (r && used[r.row]) r = null;
    if (r) {
      used[r.row] = 1; log.matched++;
      const lastWeb = r['Web price'] === '' || r['Web price'] === undefined ? null : Number(r['Web price']);
      if (!dry) {
        sh.getRange(r.row, H['Web ID']).setValue(w.id); if (String(r.Active).toLowerCase() === 'no') sh.getRange(r.row, H.Active).setValue('Yes');
        if (lastWeb !== null && lastWeb !== w.price) { sh.getRange(r.row, H.Price).setValue(w.price); log.priced.push(r.Item + ' ' + r.Option + ' ' + r.Price + ' to ' + w.price); }
        sh.getRange(r.row, H['Web price']).setValue(w.price);
      } else if (lastWeb !== null && lastWeb !== w.price) log.priced.push(r.Item + ' ' + r.Option + ' ' + r.Price + ' to ' + w.price);
      return;
    }
    const price = shopWebNewPrice_(w.item, w.price);
    const row = head.map(function (h) { return { SKU: stockSku_(w.item, w.opt), Category: w.cat, Item: w.item, Option: w.opt, Price: price, 'Reorder at': 1, Marrickville: 0, Sydenham: 0, 'Marrickville counted': '', 'Sydenham counted': '', Active: 'Yes', 'Web ID': w.id, 'Web price': w.price }[h]; }).map(function (x) { return x === undefined ? '' : x; });
    adds.push(row); log.added.push(w.item + (w.opt ? ' ' + w.opt : '') + ' $' + price);
  });
  rows.forEach(function (r) {
    if (used[r.row] || String(r.Category) === 'Belts' || String(r.Active).toLowerCase() === 'no') return;
    const counted = STOCK.locs.some(function (l) { return r[l + ' counted'] && Number(r[l]) > 0; });
    if (counted) { log.kept.push(r.Item + ' ' + r.Option); return; }
    if (!dry) sh.getRange(r.row, H.Active).setValue('No'); log.hidden.push(r.Item + (r.Option ? ' ' + r.Option : ''));
  });
  if (!dry && adds.length) { const at = sh.getLastRow() + 1; sh.getRange(at, H.Option, adds.length, 1).setNumberFormat('@'); sh.getRange(at, 1, adds.length, head.length).setValues(adds); }
  if (!dry) { PropertiesService.getScriptProperties().setProperty('SHOP_WEB_SYNC_AT', String(Date.now())); try { actRow_('Hub', 'Stock', 'Synced with website', web.length + ' website items', log.added.length + ' added, ' + log.hidden.length + ' hidden, ' + log.priced.length + ' price changes'); } catch (e) { } }
  return { ok: true, web: web.length, log: log };
}
function shopWebTick_() { // from the 10-minute run: once an hour
  const P = PropertiesService.getScriptProperties(), at = Number(P.getProperty('SHOP_WEB_SYNC_AT') || 0);
  if (!at || Date.now() - at < SHOPWEB.every * 60000) return;
  try { shopWebSync_(false); } catch (e) { Logger.log('shopWebSync_ ' + e); }
}


