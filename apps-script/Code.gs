/* Completed in the last 60 days: done in EFC, or they stayed. Newest first. */
function cxDone_(who) {
  const sh = cxSheet_(), C = cxCols_(), last = sh.getLastRow(), out = [];
  const can = cxCanApprove_(who);
  if (last < 2) return { ok: true, items: [], canApprove: can };
  const cut = Date.now() - CXAPPROVE.doneDays * 86400000;
  sh.getRange(2, 1, last - 1, CANCEL.headers.length).getValues().forEach(function (v) {
    const st = String(v[C['Status']] || ''), efc = v[C['EFC actioned at']], logged = v[C['Logged at']];
    const stayed = /^saved|withdrawn/i.test(st);
    if (!efc && !stayed) return;
