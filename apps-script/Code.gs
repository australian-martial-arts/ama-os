// Screens opened: counted, not logged row by row.
function actSeen_(name, kind) {
  /* 5 Nov 2026: no script lock here any more. Every hub screen waited up to 3s for the lock (and the 5-minute
     timer holds it), which is what made the hub slow to open. Counts go to the cache and actSeenFlush_ saves them. */
  try {
    const C = CacheService.getScriptCache(), day = actDayKey_(), key = 'seen_' + day + '_' + String(name).toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 40), now = Date.now();
    let p = {}; try { p = JSON.parse(C.get(key) || '{}'); } catch (e) { p = {}; }
    if (!p.f) p.f = now; p.l = now; p.v = p.v || {}; const area = ACT.views[kind] || kind; p.v[area] = (p.v[area] || 0) + 1; p.n = name;
    C.put(key, JSON.stringify(p), 21600);
    const nk = 'seen_names_' + day; let names = []; try { names = JSON.parse(C.get(nk) || '[]'); } catch (e) { names = []; }
    if (names.indexOf(name) < 0) { names.push(name); C.put(nk, JSON.stringify(names), 21600); }
  } catch (e) { Logger.log('actSeen_: ' + e); }
}
/* every 5 minutes (from partyTick_): copy today's screen counts from the cache into the saved activity record */
function actSeenFlush_() {
  const C = CacheService.getScriptCache(), props = PropertiesService.getScriptProperties(), day = actDayKey_();
  let names = []; try { names = JSON.parse(C.get('seen_names_' + day) || '[]'); } catch (e) { }
  try { hubInviteRows_().forEach(function (r) { if (r.name && names.indexOf(r.name) < 0) names.push(r.name); }); } catch (e) { }
  const keys = names.map(function (n) { return 'seen_' + day + '_' + String(n).toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 40); });
  const got = keys.length ? C.getAll(keys) : {};
  let s = {}; try { s = JSON.parse(props.getProperty(day) || '{}'); } catch (e) { s = {}; }
  let changed = false;
  names.forEach(function (n, i) {
    const raw = got[keys[i]]; if (!raw) return;
    let c; try { c = JSON.parse(raw); } catch (e) { return; }
    const p = s[n] || (s[n] = { f: c.f, l: c.l, v: {} });
    p.f = Math.min(p.f || c.f, c.f); p.l = Math.max(p.l || 0, c.l); p.v = p.v || {};
    Object.keys(c.v || {}).forEach(function (k) { if ((c.v[k] || 0) > (p.v[k] || 0)) { p.v[k] = c.v[k]; } });
    changed = true;
  });
  if (changed) props.setProperty(day, JSON.stringify(s));
}

