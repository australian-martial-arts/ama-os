// Dashboard numbers.
function chaseStats_(a, b) {
  const R = chaseSheet_(), last = R.sh.getLastRow(), out = { worked: 0, attempts: 0, lost: 0, joined: 0, setupDone: 0, reasons: [] };
  if (last < 2) return out;
