  address: { Auburn: '27 Queen Street, Auburn', Concord: 'Concord Community Centre, Gipps Street, Concord', Marrickville: 'Studio 35, 142 Addison Road, Marrickville', Sydenham: '47-51 Unwins Bridge Road, Sydenham', Sylvania: '17 Bellingara Road, Sylvania' },
