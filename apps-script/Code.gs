// Hub: load the after-trial check for a location and day.
// ---------------------------------------------------------------- REMOVE A TRIAL (16 Nov 2026, Mark)
/* A "Remove" button on Today's trials for bookings that were never real: duplicates, tests or spam, or a booking made by mistake.
   Only Mark, Mady, Bianca, Sarah and Busra see it. The GHL booking is deleted (not cancelled, so the family gets no cancellation text),
   the trial report row for it (if any) is removed, and every removal is logged on the "Trials removed" tab and the activity log. */
const TRIALRM = { who: ['mark', 'mady', 'bianca', 'sarah', 'busra'], tab: 'Trials removed', reasons: ['Duplicate booking', 'Test or spam', 'Booked by mistake'] };
function trialRmCan_(who) { return TRIALRM.who.indexOf(String((who && who.name) || '').toLowerCase().split(' ')[0]) > -1; }
function trialRemove_(who, b) {
  if (!trialRmCan_(who)) return { ok: false, error: 'Only Mark, Mady, Bianca, Sarah and Busra can remove a trial.' };
  const reason = TRIALRM.reasons.indexOf(String(b.reason || '')) > -1 ? String(b.reason) : '';
  if (!reason) return { ok: false, error: 'Choose why it is being removed.' };
  const loc = String(b.loc || ''), id = String(b.id || ''), day = tcParseYmd_(b.date);
  if (!CONFIG.locations[loc] || !day || !/^[A-Za-z0-9_-]{8,60}$/.test(id)) return { ok: false, error: 'Missing details.' };
  const t = tcTrials_(loc, day).filter(function (x) { return x.id === id; })[0];
  if (!t) return { ok: false, error: 'That trial is no longer in the calendar. Reload the page.' };
  const res = UF_.fetch(CONFIG.ghlBase + '/calendars/events/' + encodeURIComponent(id), { method: 'delete', muteHttpExceptions: true, headers: { 'Authorization': 'Bearer ' + getToken_(), 'Version': CONFIG.ghlVersion, 'Accept': 'application/json' } });
  const code = res.getResponseCode();
  if (code < 200 || code >= 300) return { ok: false, error: 'GHL did not remove it (' + code + '). Nothing was changed.' };
  let had = '';
  try { const have = tcRowsById_()[id], C = tcCols_(); if (have) { had = String(have.v[C['Attended']] || ''); tcSheet_().deleteRow(have.row); } } catch (e) { Logger.log('trialRemove_ report row: ' + e); }
  try {
    const ss = SpreadsheetApp.openById(HOLD.sheetId); let sh = ss.getSheetByName(TRIALRM.tab);
    if (!sh) { sh = ss.insertSheet(TRIALRM.tab); sh.appendRow(['Removed at', 'Removed by', 'Reason', 'School', 'Trial date', 'Trial time', 'Child', 'Class', 'Parent', 'Mobile', 'Was marked', 'GHL event ID']); sh.setFrozenRows(1); sh.getRange(1, 1, 1, 12).setFontWeight('bold'); }
    sh.appendRow([new Date(), who.name, reason, loc, t.date || '', t.time || '', t.child || '', t.cls || '', t.parent || '', t.mobile || '', had, id]);
  } catch (e) { Logger.log('trialRemove_ log: ' + e); }
  try { actRow_(who.name, 'Trials', 'Removed trial: ' + reason, String(t.child || ''), loc + ' ' + (t.date || '') + ' ' + (t.time || '') + (had ? ' (was ' + had + ')' : '')); } catch (e) { }
  try { tcBump_(); CacheService.getScriptCache().remove(HUBDASH.cacheKey); } catch (e) { }
  return { ok: true };
}
function tcDayRaw_(b) {
  const loc = String(b.loc || ''), day = tcParseYmd_(b.date) || new Date();
  if (!CONFIG.locations[loc]) return { ok: false, error: 'Unknown location' };
  // 22 Nov 2026 (Mark): promotion families (e.g. Black Friday) show on Today's trials too, tagged, with no report or follow-up.
  const trials = tcTrials_(loc, day, true), have = tcRowsById_(), C = tcCols_(), sctx = tcStatusCtx_();
  let PA = null, PS = {}; try { promoCids_().forEach(function (id) { PS[id] = 1; }); } catch (e) { }
  trials.forEach(function (t) {
    // 23 Nov 2026 (Mark): hub-only School Readiness mark (PROMO_MANUAL) shows as the School readiness program, with Recommend later
    try { if (!t.prog && promoManualTags_(t.contactId).indexOf('school-readiness-paid') > -1) t.prog = { name: 'School readiness', n: 0, of: 6, later: true }; } catch (e) { }
    const h = have[t.id];
    if (h) { t.attended = h.v[C['Attended']]; t.rec = h.v[C['Recommendation sent']]; t.notes = h.v[C['Notes']]; t.by = h.v[C['Reported by']]; }
    const auto = tcStatus_({ fu: {}, C: C, enrolled: sctx.enrolled }, { id: t.id, contactId: t.contactId }, ghlContact_(t.contactId), false);
    if (auto) t.auto = auto;
    if (PS[t.contactId]) { let lb = ''; try { lb = String(trialTagLabel_(ghlContact_(t.contactId)) || '').replace(/^\s*\[|\]\s*$/g, '').trim(); } catch (e) { } t.promo = lb || 'Promotion: already paid'; try { const ar = (PA = PA || promoArrivals_(tcYmd_(day))).filter(function (r) { return r.cid === t.contactId; })[0]; if (ar) { const due = (ar.items || []).filter(function (x) { return x.due; }); const todo = due.filter(function (x) { return !x.given; }).map(function (x) { return String(x.item).toLowerCase(); }); const done = due.filter(function (x) { return x.given; }).map(function (x) { return String(x.item).toLowerCase(); }); let tx = (todo.length ? 'Still to hand them: ' + todo.join(' + ') : (done.length ? 'All handed out: ' + done.join(' + ') + ' ✓' : 'Nothing to hand out today')); if (todo.length && done.length) tx += ' (' + done.join(' + ') + ' already given)'; t.promo = ar.promo + ': ' + String(ar.collect || '').toLowerCase() + '. ' + tx; t.todo = todo.length; } } catch (e) { } try { const tg = ((ghlContact_(t.contactId) || {}).tags || []).map(function (x) { return String(x).toLowerCase(); }); const pp = promoTracked_().filter(function (x) { return x.tags.some(function (g) { return tg.indexOf(g) > -1; }); })[0]; t.pid = pp ? String(pp.id || pp.name || '') : ''; t.here = !!promoAtt_().ev[t.contactId + '|' + t.id]; t.noshow = !!PropertiesService.getScriptProperties().getProperty('promons_' + tcYmd_(day) + '_' + t.contactId); } catch (e) { } }
  });
  return { ok: true, loc: loc, date: tcYmd_(day), dayText: Utilities.formatDate(day, CONFIG.timezone, 'EEEE d MMMM'), trials: trials };
}

// Hub: save one trial's report (insert or update by event id).
function tcSaveRaw_(b, who) {
  const loc = String(b.loc || ''), day = tcParseYmd_(b.date);
  if (!CONFIG.locations[loc] || !day || !b.id) return { ok: false, error: 'Missing details' };
  const att = b.attended === 'Attended' || b.attended === 'Absent' || b.attended === 'Rebooked' ? b.attended : '';
  if (!att) return { ok: false, error: 'Choose Attended or Absent' };
  const rec = b.rec === 'Yes' || b.rec === 'No' || b.rec === 'Later' ? b.rec : '';
  const trial = tcTrials_(loc, day).filter(function (t) { return t.id === b.id; })[0];
  if (!trial) return { ok: false, error: 'That trial is no longer in the calendar' };
  const sh = tcSheet_(), C = tcCols_(), have = tcRowsById_()[b.id];
  const notes = String(b.notes || '').slice(0, 1000);
  if (have) {
    const r = have.v.slice();
    r[C['Attended']] = att; r[C['Recommendation sent']] = rec; r[C['Notes']] = notes;
    r[C['Reported by']] = who.name; r[C['Reported at']] = new Date();
    sh.getRange(have.row, 1, 1, r.length).setValues([r]);
  } else {
    const r = TRIALCHECK.headers.map(function () { return ''; });
    r[C['Event ID']] = trial.id; r[C['Trial date']] = trial.date; r[C['Trial time']] = trial.time; r[C['Location']] = loc;
    r[C['Child']] = trial.child; r[C['Class']] = trial.cls; r[C['Parent']] = trial.parent; r[C['Mobile']] = trial.mobile;
    r[C['Contact ID']] = trial.contactId; r[C['Attended']] = att; r[C['Recommendation sent']] = rec; r[C['Notes']] = notes;
    r[C['Reported by']] = who.name; r[C['Reported at']] = new Date();
    sh.appendRow(r);
  }
  CacheService.getScriptCache().remove(HUBDASH.cacheKey); // show the new status on the hub straight away
  if (att === 'Absent' && !(have && String(have.v[C['Attended']]) === 'Absent')) { try { call24AbsentText_(trial); } catch (e) { Logger.log('absent text: ' + e); } }
  return { ok: true };
}

